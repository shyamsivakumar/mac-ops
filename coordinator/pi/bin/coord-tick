#!/usr/bin/env python3
"""Run one coordinator tick as a fresh headless pi on DeepSeek.

launchd starts this every 30 minutes (dev.coordinator.tick). Each run is one
short-lived pi process on the coordinator config, inside the coordinator
sandbox, so a tick can do what the coordinator can and no more. The tick
follows loop/tick.md and replies with NOOP or ALERT lines: ALERT lines are
sent to the live pi coordinator terminal, NOOP goes nowhere. Only one tick
runs at a time (one lock file for every caller) and a run over ten minutes is
killed.

The run is ephemeral (pi --no-session), so it never becomes the newest
session that coord-ask, the phone relay or the Herdr panel read.

Environment knobs, all optional:
  COORD_TICK_PROMPT_OVERRIDE  replace the tick prompt (proofs and tests)
  COORD_TICK_LOG              log file (default ~/Library/Logs/coordinator/tick.log)
  COORD_TICK_LOCK             lock file (default ~/.local/state/mac-ops/coord-tick.lock)
  COORD_TICK_TIMEOUT          seconds before a run is killed (default 600)
  COORD_TICK_MODEL            model id (default morph/morph-dsv41flash)
"""

from __future__ import annotations

import fcntl
import json
import os
import signal
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "bin"))
from tick_health import tick_alarm
from hourly_selftest import tick_selftest

HOME = Path.home()
COORD_DIR = HOME / "Code/coordinator"
PI_DIR = HOME / ".pi/agent-coordinator"
SANDBOX_PROFILE = PI_DIR / "coordinator.sb"
LOG_PATH = Path(
    os.environ.get("COORD_TICK_LOG", HOME / "Library/Logs/coordinator/tick.log")
)
MODEL = os.environ.get("COORD_TICK_MODEL", "morph/morph-dsv41flash")
TIMEOUT_S = int(os.environ.get("COORD_TICK_TIMEOUT", "600"))
# The model check is an external call of its own. It gets a bound and a
# process group, so a check that hangs is killed and named in the tick log
# instead of holding the tick past the budget the tick has.
MODEL_CHECK_TIMEOUT = 60
DEFAULT_PROMPT = (
    "Tick (launchd). Run one tick per loop/tick.md. Read the whole board "
    "with `overnight board --json --action`: it returns every board ticket "
    "and every open pull request the coordinator may act on, in the order "
    "the night shift works them, and every item carries the one action it "
    "needs. Do not start tickets: the shift and `coordq`'s refill own board "
    "intake, so the tick decides, gates, routes failures and reports "
    "drift. Keep it cheap: filter command output, act only on what changed, "
    "reply NOOP or ALERT lines only. The coordinator's own calls are "
    "bounded, and a call of yours that hangs is bounded by the 120 seconds "
    "your shell gives it: skip it, name it in the reply and do not retry "
    "it, so the tick finishes its other work."
)
LOCK_NAME = "coord-tick.lock"
CHILD_PATH = ":".join(
    [
        str(HOME / ".local/bin"),
        str(HOME / ".bun/bin"),
        "/opt/homebrew/bin",
        "/usr/bin",
        "/bin",
    ]
)
# The pi process of the run in flight, so a signal can stop it.
RUNNING: list = []


def log(message: str) -> None:
    """Append one line to the tick log. The launcher writes the log itself:
    under launchd the stdout of the job is the same file, so printing the
    line as well would double it."""
    stamp = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    line = f"{stamp} | tick | {message}"
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG_PATH, "a") as stream:
            stream.write(line + "\n")
        return
    except OSError as exc:
        print(f"tick: cannot write {LOG_PATH}: {exc}", file=sys.stderr)
    print(line)


def prompt() -> str:
    """The tick prompt. The override exists so the launcher can be proved
    without running a real tick."""
    return os.environ.get("COORD_TICK_PROMPT_OVERRIDE") or DEFAULT_PROMPT


def child_env() -> dict:
    env = dict(os.environ)
    env.update(
        {
            "PI_CODING_AGENT_DIR": str(PI_DIR),
            # One-shot run: the wake timer has nothing to wake.
            "COORD_WAKE": "0",
            "HOME": str(HOME),
            "PATH": CHILD_PATH,
        }
    )
    return env


def model_available(env: dict) -> bool:
    """True when the provider still offers the tick model. A check that cannot
    answer says yes: the run itself reports a real failure.

    The check is bounded: the call runs in a process group of its own and
    gets a timeout, and a check that hangs has its group killed. The skip
    is named in the tick log, so a tick that ran on an unchecked model says
    so instead of looking like a clean run."""
    command = [
        "/usr/bin/sandbox-exec",
        "-f",
        str(SANDBOX_PROFILE),
        "pi",
        "--list-models",
    ]
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            start_new_session=True,
        )
    except OSError:
        return True
    try:
        stdout, stderr = process.communicate(timeout=MODEL_CHECK_TIMEOUT)
    except subprocess.TimeoutExpired:
        end_group(process)
        log(
            f"skipped: the model check for {MODEL} timed out after "
            f"{MODEL_CHECK_TIMEOUT}s"
        )
        return True
    output = (stdout or "") + (stderr or "")
    if not output.strip():
        return True
    return MODEL.split("/", 1)[-1] in output


def coordinator_terminal() -> str | None:
    """The live pi coordinator terminal, the same lookup coord-ask uses."""
    try:
        result = subprocess.run(
            ["hc", "ls"], capture_output=True, text=True, timeout=30
        )
        terminals = json.loads(result.stdout)["terminals"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        return None
    terms = [
        t
        for t in terminals
        if t.get("agent") == "pi"
        and str(t.get("cwd", "")).endswith("/Code/coordinator")
        and t.get("state") == "live"
    ]
    named = [t for t in terms if "Pi - Coordinator" in (t.get("where") or "")]
    pick = named or terms
    return pick[0]["address"] if pick else None


def alert_lines(reply: str) -> list[str]:
    """The ALERT lines of a tick reply, in order. A line counts when it says
    ALERT: after a list marker or markdown emphasis; the line that is
    delivered is the one as it was written."""
    found = []
    for line in reply.splitlines():
        stripped = line.strip()
        normalised = stripped.lstrip("-*•# \t").strip("*_` ")
        if normalised.startswith("ALERT:"):
            found.append(stripped)
    return found


def deliver(alerts: list[str]) -> None:
    """Send the alerts to the live coordinator terminal. No terminal, no
    message: the alerts stay in the tick log."""
    if not alerts:
        return
    address = coordinator_terminal()
    if not address:
        log(f"alert not delivered, no live coordinator terminal: {alerts[0]}")
        return
    for alert in alerts:
        try:
            subprocess.run(
                ["hc", "send", address, f"Tick alert: {alert}"],
                check=True,
                capture_output=True,
                timeout=30,
            )
            log(f"alert sent to {address}: {alert}")
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"alert not sent to {address}: {exc}: {alert}")


def kill_group(process, sig: int) -> None:
    """Signal the whole process group of the run. The child is its own
    session leader, so the group id is the child pid."""
    try:
        os.killpg(process.pid, sig)
    except OSError:
        pass


def end_group(process, grace: int = 5) -> tuple[str, str]:
    """End the whole group of the run and return what it wrote.

    The group is what has to die, and the group is emptied after the leader
    is gone and not only when the wait ends: a descendant that ignored the
    first signal and closed or redirected its output lets the wait finish
    while it keeps running, and it would then outlive the run."""
    kill_group(process, signal.SIGTERM)
    try:
        stdout, stderr = process.communicate(timeout=grace)
    except subprocess.TimeoutExpired:
        kill_group(process, signal.SIGKILL)
        try:
            stdout, stderr = process.communicate(timeout=grace)
        except subprocess.TimeoutExpired:
            # The pipes are still held by a descendant that the signals did
            # not reach, so they are closed here rather than left to the
            # collector: the run is over either way.
            stdout, stderr = "", ""
            for pipe in (process.stdout, process.stderr):
                if pipe is not None:
                    pipe.close()
    kill_group(process, signal.SIGKILL)
    return stdout or "", stderr or ""


def stop_on_signal(signum, _frame):
    """A stopped launcher (launchctl bootout, Ctrl-C) must not leave the pi
    it started running: that would be a second tick."""
    for process in RUNNING:
        kill_group(process, signal.SIGTERM)
    sys.exit(128 + signum)


def run_tick(env: dict, lock_fd: int) -> int:
    """Run the tick and return the exit code."""
    command = [
        "/usr/bin/sandbox-exec",
        "-f",
        str(SANDBOX_PROFILE),
        "pi",
        "-p",
        "--no-session",
        "--no-skills",
        "--model",
        MODEL,
        prompt(),
    ]
    # The lock fd goes to the child: the lock then lives as long as the pi
    # does, so an orphaned run still keeps the next tick out.
    process = subprocess.Popen(
        command,
        cwd=str(COORD_DIR),
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
        pass_fds=(lock_fd,),
    )
    RUNNING.append(process)
    try:
        try:
            stdout, stderr = process.communicate(timeout=TIMEOUT_S)
        except subprocess.TimeoutExpired:
            stdout, stderr = end_group(process, 10)
            log(f"tick killed after {TIMEOUT_S}s")
            deliver(alert_lines(stdout or ""))
            return 124
        reply = (stdout or "").strip()
        if reply:
            print(reply)
        if stderr and process.returncode != 0:
            log(f"pi exited {process.returncode}: {stderr.strip()[:500]}")
        deliver(alert_lines(reply))
        log(f"exit={process.returncode} reply={reply[:200] or '(empty)'}")
        return process.returncode
    finally:
        if process.poll() is None:
            kill_group(process, signal.SIGKILL)
        RUNNING.remove(process)


def lock_path() -> Path:
    """The lock file. One path for every caller: launchd jobs and shells see
    different TMPDIR values, so a TMPDIR lock would not exclude a manual run
    from the scheduled one."""
    override = os.environ.get("COORD_TICK_LOCK")
    if override:
        return Path(override)
    return HOME / ".local/state/mac-ops" / LOCK_NAME


def take_lock() -> int:
    """Take the tick lock and return its descriptor, or None when another tick
    holds it."""
    try:
        path = lock_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError as exc:
        log(f"cannot open the lock file: {exc}")
        raise
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.set_inheritable(fd, True)
    return fd


def main() -> int:
    alarm = tick_alarm()
    if alarm:
        print(alarm, flush=True)
    env = child_env()
    signal.signal(signal.SIGTERM, stop_on_signal)
    signal.signal(signal.SIGINT, stop_on_signal)
    try:
        lock_fd = take_lock()
    except OSError:
        return 1
    if lock_fd is None:
        log("skipped: another tick holds the lock")
        return 0
    try:
        log(f"overnight selftest: {tick_selftest()}")
        if not model_available(env):
            log(f"WAITING: {MODEL} is not available on the provider")
            return 75
        return run_tick(env, lock_fd)
    except OSError as exc:
        log(f"tick failed: {exc}")
        return 1
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        finally:
            os.close(lock_fd)


if __name__ == "__main__":
    sys.exit(main())
