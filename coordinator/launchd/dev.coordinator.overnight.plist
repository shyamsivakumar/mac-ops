<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The overnight shift (spec part T12, revision 3; T14). One job fires
     the shift every five minutes, every day: the shift runs 24x7, so
     there is no night window, no 22:30 start and no 06:00 deadline, and
     the shift is never unarmed. A cycle takes about a minute and a half
     on the current board, so a cycle ends long before the next one fires.

     The job runs real cycles (spec part T14): every cycle reads the whole
     board, works it with no item cap and writes a receipt for every item
     whose state changed. The first cycle of the morning writes the day's
     morning report, so Shyam reads one report in the morning.

     No RunAtLoad: the first cycle lands one interval after the job loads.
     The shift takes a lock of its own, so two cycles never run at once,
     whatever starts them: the scheduled job, or a person at a shell. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.coordinator.overnight</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/overnight</string>
        <string>shift</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COORDINATOR_GH_CACHE</key>
        <string>on</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/coordinator/overnight.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/coordinator/overnight.log</string>
</dict>
</plist>
