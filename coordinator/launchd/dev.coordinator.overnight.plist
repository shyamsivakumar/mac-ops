<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The overnight shift (spec part T12, revision 3). One job fires the
     shift on a fixed interval, every day: the shift runs 24x7, so there is
     no night window, no 22:30 start and no 06:00 deadline, and the shift
     is never unarmed. Every cycle reads the board. The morning report is
     on demand now (`overnight report`), so this job has no calendar entry
     for it.

     The job runs in dry-run mode until the arm and work parts (T4, T5)
     land, so a cycle reads the board, orders it and writes the cycle's
     line to the shift log, and nothing else.

     No RunAtLoad: the first cycle lands one interval after the job loads.
     launchd starts one copy of a job at a time, so two cycles never run
     at once. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.coordinator.overnight</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/overnight</string>
        <string>shift</string>
        <string>--dry-run</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/coordinator/overnight.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/coordinator/overnight.log</string>
</dict>
</plist>
