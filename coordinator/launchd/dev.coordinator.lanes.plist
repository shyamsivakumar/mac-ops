<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.coordinator.lanes</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/overnight</string>
        <string>shift</string>
    </array>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COORDINATOR_GH_CACHE</key>
        <string>on</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/coordinator/lanes.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/coordinator/lanes.log</string>
</dict>
</plist>
