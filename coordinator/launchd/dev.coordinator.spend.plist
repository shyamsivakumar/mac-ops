<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.coordinator.spend</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/coordq</string>
        <string>spend</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COORDINATOR_GH_CACHE</key>
        <string>on</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Code/coordinator/queue/spend.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Code/coordinator/queue/spend.log</string>
</dict>
</plist>
