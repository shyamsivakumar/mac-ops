)
# A receipt is markdown with `- Key: value` lines. The key is matched
# loosely so `Time used:` and `time used:` are the same field.
FIELD_LINE = re.compile(r"^-\s*(?P<key>[A-Za-z][A-Za-z ]*?)\s*:\s*(?P<value>.*)$")
# A check counts as run only when the records carry its exit code.
EXIT_CODE = re.compile(r"\bexit\s+(?P<code>\d+)\b", re.I)
# The command of a check is the backticked part of the line.
QUOTED = re.compile(r"`([^`]+)`")
# The intake summary line of the shift log carries how many items were in
# scope. Without it the planned count cannot be checked.
PLANNED = re.compile(r"planned\s+(?P<count>\d+)\s+items?\b", re.I)
# A receipt is one item of the shift. The morning report is not a
# receipt, and neither is a cycle receipt: a cycle receipt holds the
# health checks one cycle ran, not the state of an item.
RECEIPT_FILE = re.compile(r"^(?!morning-|cycle-).+\.md$")
# The shift log records the end of the shift with the word "stall".
STALL = re.compile(r"\bstall\b", re.I)
# The launchd job fires the shift on a fixed interval, every day (spec
# part T12, revision 3). There is no night window and no part of the
# night: every cycle is the same cycle, and the shift is never unarmed.
# The job's own interval lives in the plist.
# The shift's own lock keeps two cycles apart: the job fires every five
# minutes and a cycle takes about a minute and a half, so the next fire
# lands long after the cycle ended, and the lock covers the case where a
# person starts a cycle by hand.
SHIFT_LOCK_NAME = "overnight-shift.lock"
# The shift log states how the night ended, in one of the four ways the
# spec allows. The report reads that statement, but only when the records
# support it: a claim is never a proof.
# The shift runs 24x7 and never ends, so it has no window. The morning
# report has a time: the first cycle that lands in this window writes the
# day's report. The window is an hour and a half wide, so a Mac that wakes
# late still writes it.
REPORT_WINDOW = (6 * 60, 7 * 60 + 29)
ENDED = re.compile(r"(?:^|\|)\s*ended:\s*(?P<how>deadline|all done|stop|stall)\s*$", re.I)
# The states a receipt can name.
STATE_DONE = "done"
STATE_READY = "ready"
STATE_STUCK = "stuck"
STATE_PARKED = "parked"
STATE_UNREADABLE = "unreadable"
# The word the report uses for a count it cannot check.
UNVERIFIED = "UNVERIFIED"

try:
    from zoneinfo import ZoneInfo

    PT = ZoneInfo("America/Los_Angeles")
except (KeyError, OSError):
    PT = timezone(timedelta(hours=-8), "PT")


class RepoError(Exception):
    """A repository could not be read, so its counts are not known."""

    def __init__(self, message, stdout: str = "") -> None:
        super().__init__(message)
        self.stdout = stdout


def die(message: str, code: int = 1) -> NoReturn:
    emit(f"overnight: {message}", err=True)
    raise SystemExit(code)


def plural(count: int, one: str, many: str) -> str:
    """Return the word that fits the count."""
    return one if count == 1 else many


def config_path() -> Path:
    """Return the coordinator's board config.

    The checkout layout and the installed layout both resolve: the script
    sits in `coordinator/overnight/` next to `coordinator/config/`, and the
    installer copies the config to `~/.coordinator/`."""
    here = Path(__file__).resolve().parent
    for candidate in (
        here.parent / "config" / "tickets.json",
        Path.home() / ".coordinator" / "tickets.json",
    ):
        if candidate.is_file():
            return candidate
    die("tickets.json not found next to the module or in ~/.coordinator")


def load_config() -> dict:
    try:
        with open(config_path()) as stream:
            return json.load(stream)
    except (OSError, ValueError) as exc:
        die(f"cannot read the board config: {exc}")


def allowed_repos(cfg: dict) -> list[tuple[str, str]]:
    """Return the allowed repositories as (repo, key) pairs.

    The board config is the allow list: it names the repositories the
    coordinator works on today. The Ascend repositories are not in it."""
    repos = cfg.get("repos") or {}
    return sorted((repo, entry.get("key", "")) for repo, entry in repos.items())


def kill_group(process, number: int) -> None:
    """Signal the whole group of a call.

    The call runs in a process group of its own, so the group is what has
    to die: a descendant that ignored the first signal and closed its
    output would otherwise outlive the call and keep the tick's work
    alive behind it."""
    try:
        os.killpg(process.pid, number)
    except OSError:
        pass


def end_group(process, grace: int = 5) -> None:
    """End the whole group of a call and close what it wrote.

    The group is what has to die, and the group is emptied after the leader
    is gone and not only when the wait ends: a descendant that ignored the
    first signal and closed or redirected its output lets the wait finish
    while it keeps running, and it would then outlive the call."""
    kill_group(process, signal.SIGTERM)
    try:
        process.communicate(timeout=grace)
    except subprocess.TimeoutExpired:
        kill_group(process, signal.SIGKILL)
        try:
            process.communicate(timeout=grace)
        except subprocess.TimeoutExpired:
            # The pipes are still held by a descendant that the signals did
            # not reach, so they are closed here rather than left to the
            # collector: the call is over either way.
            for pipe in (process.stdout, process.stderr):
                if pipe is not None:
                    pipe.close()
    kill_group(process, signal.SIGKILL)


def run(
    argv: list[str], timeout: int, deadline: float, optional: bool = False
) -> str | None:
    """Run a command and return its stdout, or fail with the error tail.

    Every call is bounded: the command runs in a process group of its own
    and gets a timeout, and a call that hangs has its whole group killed,
    so the wait ends when the timeout ends and not later. A call the
    caller can do without is optional: it is skipped, the skip names the
    command that was skipped, and None comes back. The default still ends
    the read, because a call that failed is a refusal and never a pass."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the intake deadline passed before the next command could run")
    seconds = max(1, min(timeout, int(left)))
    command = " ".join(argv)
    hit = gh_gateway.cached(argv)
    if hit is not None:
        gh_gateway.record(argv, 1, free="hit")
        return hit
    # A formatted paginated read counts its pages from the response headers,
    # so the command may carry --include; the caller still gets the body it
    # asked for.
    run_argv, headers_counted = gh_gateway.prepare(argv)
    try:
        process = subprocess.Popen(
            run_argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
            env=gh_gateway.gateway_env(),
        )
    except FileNotFoundError:
        die(f"{argv[0]} is not on PATH")
    try:
        stdout, stderr = process.communicate(timeout=seconds)
    except subprocess.TimeoutExpired:
        # The bound is real: the whole group is killed, so a call that
        # hangs cannot hold the tick past the timeout it was given.
        end_group(process)
        if optional:
            line = (
                f"overnight: skipped {command} after {seconds}s "
                f"(the call timed out)"
            )
            emit(line, err=True)
            # The skip is written down where it cannot be lost: the
            # caller of a read may be a model, and a model may not
            # repeat it.
            try:
                SKIP_LOG.parent.mkdir(parents=True, exist_ok=True)
                with open(SKIP_LOG, "a") as stream:
                    stamp = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
                    stream.write(f"{stamp} | skipped | {command} after {seconds}s\n")
            except OSError:
                pass
            return None
        die(f"{command} timed out")
    # The page count is what a paginated read spent, and only a succeeded
    # read is stored: a cached failure would read as an empty board.
    body, count = gh_gateway.settle(argv, stdout, headers_counted,
                                    failed=process.returncode != 0)
    gh_gateway.record(argv, count)
    if process.returncode != 0:
        tail = (stderr or stdout or "").strip().splitlines()[-3:]
        raise RepoError(
            f"{command} failed ({process.returncode}): " + " | ".join(tail),
            stdout=stdout or "",
        )
    gh_gateway.store(argv, body)
    return body


def read_board(deadline: float) -> tuple[list[dict], bool]:
    """Return the board's tickets and whether the board is stale.

    The ticket CLI owns the cache and the labels, so intake asks it for the
    list instead of reading GitHub a second way."""
    try:
        raw = run([TICKET, "list", "--fresh", "--json"], TICKET_TIMEOUT, deadline)
    except RepoError as exc:
        die(str(exc))
    try:
        data = json.loads(raw)
    except ValueError as exc:
        die(f"the ticket CLI did not return JSON: {exc}")
    issues = data.get("issues") or []
    if data.get("stale"):
        emit(
            "overnight: the board list is stale ("
            + str((data.get("error") or {}).get("message", "unknown error"))
            + ")",
            err=True,
        )
    return issues, bool(data.get("stale"))


def read_pull_requests(repo: str, deadline: float) -> tuple[list[dict], bool]:
    """Return the open pull requests of one repository, and whether the list
    was cut off at the limit."""
    raw = run(
        [
            GH,
            "pr",
            "list",
            "-R",
            repo,
            "--state",
            "open",
            "--limit",
            str(PR_LIMIT),
            "--json",
            PR_FIELDS,
        ],
        GH_TIMEOUT,
        deadline,
    )
    try:
        rows = json.loads(raw)
    except ValueError as exc:
        raise RepoError(f"gh did not return JSON for {repo}: {exc}")
    if not isinstance(rows, list):
        raise RepoError(f"gh returned no list for {repo}")
    return rows, len(rows) >= PR_LIMIT


def linked_ticket(
    row: dict, by_number: dict[int, dict], by_key: dict[str, dict]
) -> tuple[dict | None, str]:
    """Return the board ticket a pull request names, and how it named it.

    A keyword reference names a GitHub issue number. A branch name carries
    a ticket key, whose number is a different counter, so the branch is
    looked up by key and never by issue number.

    The keyword is the stronger signal, so it decides when it names a
    ticket the board shows. Every keyword is read, so a body that names an
    issue the board does not show and then names one it does still links
    to the one it shows. When no keyword names a ticket the board shows,
    the branch is read: a pull request whose body points at a ticket that
    has left the board, and whose branch carries the key of a ticket that
    is on it, is that ticket's work. A pull request that names neither is
    a record of its own."""
    text = f"{row.get('title') or ''}\n{row.get('body') or ''}"
    for match in TICKET_REF.finditer(text):
        number = int(match.group(2))
        target = by_number.get(number)
        if target is not None:
            return target, f"{match.group(1).lower()} #{number}"
    for match in BRANCH_KEY.finditer(row.get("headRefName") or ""):
        key = f"{match.group(1)}-{match.group(2)}".upper()
        target = by_key.get(key)
        if target is not None:
            return target, f"branch {key}"
    return None, ""


def build_records(
    issues: list[dict], pull_requests: dict[str, list[dict]]
) -> dict[str, list[dict]]:
    """Turn the board and the pull requests into intake records, per repo.

    A ticket with open pull requests is one record that carries them. A
    pull request that no board ticket names is a record of its own. Nothing
    is filtered or ordered here: that is the next part."""
    records: dict[str, list[dict]] = {}
    for issue in issues:
        repo = issue.get("repo", "")
        records.setdefault(repo, []).append(
            {
                "kind": "ticket",
                "repo": repo,
                "key": issue.get("key") or "",
                "number": issue.get("number"),
                "title": issue.get("title") or "",
                "url": issue.get("url") or "",
                "stage": issue.get("stage"),
                "priority": issue.get("priority"),
                "type": issue.get("type"),
                "builder": issue.get("builder"),
                "reviewer": issue.get("reviewer"),
                "problems": issue.get("problems", []),
                "updatedAt": issue.get("updatedAt"),
                "prs": [],
            }
        )
    for repo, rows in pull_requests.items():
        bucket = records.setdefault(repo, [])
        by_number = {
            r["number"]: r for r in bucket if r["kind"] == "ticket" and r["number"]
        }
        by_key = {
            r["key"].upper(): r
            for r in bucket
            if r["kind"] == "ticket" and r["key"]
        }
        for row in rows:
            summary = {
                "number": row.get("number"),
                "title": row.get("title") or "",
                "url": row.get("url") or "",
                "isDraft": bool(row.get("isDraft")),
                "headRefName": row.get("headRefName") or "",
                "baseRefName": row.get("baseRefName") or "",
                "headRefOid": row.get("headRefOid") or "",
                "updatedAt": row.get("updatedAt"),
                "body": row.get("body") or "",
            }
            target, signal = linked_ticket(row, by_number, by_key)
            if target is not None:
                summary["linkedBy"] = signal
                target["prs"].append(summary)
                continue
            bucket.append(
                {
                    "kind": "pr",
                    "repo": repo,
                    "number": row.get("number"),
                    "title": row.get("title") or "",
                    "url": row.get("url") or "",
                    "isDraft": bool(row.get("isDraft")),
                    "headRefName": row.get("headRefName") or "",
                    "headRefOid": row.get("headRefOid") or "",
                    "updatedAt": row.get("updatedAt"),
                    "body": row.get("body") or "",
                }
            )
    return records


def cmd_intake(args: argparse.Namespace) -> int:
    if not args.dry_run:
        emit(
            "overnight: intake in this part reads only. Run "
            "`overnight intake --dry-run`.",
            err=True,
        )
        return 2
    deadline = time.monotonic() + args.deadline
    override = getattr(args, "allowed", None)
    if override:
        # The shift works under the allow list in its policy snapshot, so
        # the cycle reads the board under the snapshot and not under a
        # second list of its own.
        repos = [(repo, "") for repo in override]
    else:
        cfg = load_config()
        repos = allowed_repos(cfg)
        if not repos:
            die("the board config names no repositories")
    issues, stale = read_board(deadline)
    pull_requests: dict[str, list[dict]] = {}
    unread: dict[str, str] = {}
    for repo, _key in repos:
        try:
            rows, cut = read_pull_requests(repo, deadline)
        except RepoError as exc:
            unread[repo] = str(exc)
            emit(f"overnight: {repo}: {exc}", err=True)
            continue
        pull_requests[repo] = rows
        if cut:
            unread[repo] = f"more than {PR_LIMIT} open pull requests"
            emit(
                f"overnight: {repo}: the pull request list was cut off at "
                f"{PR_LIMIT}, so the counts are not known",
                err=True,
            )
    records = build_records(issues, pull_requests)
    outside = sorted(set(records) - {repo for repo, _ in repos})
    emit("Overnight intake - dry run (read only)")
    emit(f"Board: {len(issues)} tickets{' (stale)' if stale else ''}")
    emit(f"Allowed repositories: {len(repos)}")
    emit()
    emit(f"{'repository':<45}{'tickets':>9}{'prs':>6}{'linked':>8}{'records':>9}")
    total = 0
    clean = 0
    outside_total = 0
    outside_repos = 0
    for repo, _key in repos:
        bucket = records.get(repo, [])
        tickets = sum(1 for r in bucket if r["kind"] == "ticket")
        linked = sum(len(r["prs"]) for r in bucket if r["kind"] == "ticket")
        if repo in unread:
            emit(f"{repo:<45}{tickets:>9}{'ERR':>6}{'ERR':>8}{'ERR':>9}")
            continue
        clean += 1
        total += len(bucket)
        emit(
            f"{repo:<45}{tickets:>9}{len(pull_requests.get(repo, [])):>6}"
            f"{linked:>8}{len(bucket):>9}"
        )
    for repo in outside:
        bucket = records[repo]
        tickets = sum(1 for r in bucket if r["kind"] == "ticket")
        outside_total += len(bucket)
        outside_repos += 1
        emit(f"{repo:<45}{tickets:>9}{'n/a':>6}{'n/a':>8}{len(bucket):>9}  (not allowed)")
    emit()
    if unread:
        emit(
            f"Total: UNVERIFIED. {total} records from the {clean} repositories "
            f"that read cleanly; {len(unread)} repositories could not be read "
            f"fully: " + ", ".join(sorted(unread))
        )
    else:
        emit(f"Total: {total} records across {clean} repositories")
    if outside_repos:
        emit(
            f"{outside_total} more records in {outside_repos} "
            f"{plural(outside_repos, 'repository', 'repositories')} outside the "
            f"allow list, counted above and marked 'not allowed'."
        )
    emit(
        "A pull request that a board ticket names is part of that ticket's "
        "record, so it adds no record of its own. A pull request that names "
        "no ticket the board shows stays a record of its own."
    )
    return 1 if unread else 0


# --- Part T4: the policy snapshot ------------------------------------------
#
# The shift is never unarmed and has no deadline (spec revision 3), so the
# policy snapshot is the whole contract. `overnight policy` writes it and
# the shift reads it on every cycle.


def policy_path(root: Path) -> Path:
    """Return the path of the policy snapshot."""
    return root / "run" / "policy.json"


def load_policy(root: Path) -> tuple[dict | None, str]:
    """Return the policy snapshot and the reason it cannot be used.

    A missing snapshot, a snapshot that is not a JSON object and a
    snapshot that is missing one of the contract's fields are all
    failures: the shift has no contract to work under without one, so it
    says which one it found and stops."""
    path = policy_path(root)
    text = read_text(path)
    if not text.strip():
        return None, f"{path} does not exist"
    try:
        loaded = json.loads(text)
    except ValueError as exc:
        return None, f"{path} is not JSON: {exc}"
    if not isinstance(loaded, dict):
        return None, f"{path} is not a JSON object"
    problem = policy_problem(loaded)
    if problem:
        return None, f"{path} is not a contract: {problem}"
    return loaded, ""


def policy_snapshot(root: Path) -> dict:
    """Return the policy snapshot as a mapping, or an empty one.

    A snapshot that is missing, that is not JSON or that is not an object
    is no snapshot. The budget falls back to the turn cap's budget then,
    and the shift that needs a contract says so on its own."""
    text = read_text(policy_path(root))
    if not text.strip():
        return {}
    try:
        loaded = json.loads(text)
    except ValueError:
        return {}
    return loaded if isinstance(loaded, dict) else {}


def policy_problem(policy: dict) -> str:
    """Return why a snapshot is not a contract, or an empty string.

    The contract has five fields: the allow list, the slot cap, the stall
    cap, the retry cap and the verify level. A snapshot that is missing
    one of them, or that holds the wrong kind of value, is not a
    contract, and the shift refuses it instead of working under half a
    rule."""
    allow = policy.get("allow")
    if not isinstance(allow, list) or not allow:
        return "it names no repository"
    if not all(isinstance(name, str) and name.strip() for name in allow):
        return "its allow list is not a list of repository names"
    for name in ("slot_cap", "stall_cap", "retry_cap"):
        value = policy.get(name)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            return f"its {name.replace('_', ' ')} is not a number"
    level = policy.get("verify_level")
    if not isinstance(level, str) or not level.strip():
        return "its verify level is not a name"
    soft = policy.get("soft_budget_minutes", SOFT_BUDGET_MINUTES)
    hard = policy.get("hard_budget_minutes", HARD_BUDGET_MINUTES)
    for name, value in (("soft", soft), ("hard", hard)):
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            return f"its {name} builder-time budget is not a number"
    if soft > hard:
        return "its soft builder-time budget is above its hard one"
    if hard > TURN_CAP_MINUTES:
        return (
            f"its hard builder-time budget is above the {TURN_CAP_MINUTES} "
            "minute turn cap"
        )
    return ""


def write_policy(root: Path, policy: dict) -> Path:
    """Write the policy snapshot and return the path it went to.

    The write is atomic: a cycle that reads while the snapshot is being
    written reads the old one or the new one, never half of one."""
    path = policy_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f"{path.name}.tmp"
    write_record(tmp, json.dumps(policy, indent=2) + "\n")
    os.replace(tmp, path)
    return path


def build_policy() -> dict:
    """Return the policy snapshot the shift works under.

    The allow list is the board config's list of repositories. The slot
    cap is the queue's own cap, read from the coordq config and never
    written. The stall cap ends a shift that stops making progress, the
    retry cap parks an item that keeps failing and the verify level says
    how much each item is checked. There is no item cap and no allowance
    stop: the whole backlog is in scope and model use is never a stop
    condition."""
    cfg = load_config()
    repos = allowed_repos(cfg)
    if not repos:
        die("the board config names no repositories")
    cap = slot_cap()
    if not isinstance(cap, int) or isinstance(cap, bool):
        die(
            f"the queue's slot cap cannot be read from {SLOT_CAP_FILE}, so "
            "the shift's contract cannot be written without it"
        )
    return {
        "allow": sorted(repo for repo, _key in repos),
        "slot_cap": cap,
        "stall_cap": STALL_CAP,
        "retry_cap": RETRY_CAP,
        "soft_budget_minutes": SOFT_BUDGET_MINUTES,
        "hard_budget_minutes": HARD_BUDGET_MINUTES,
        "verify_level": VERIFY_LEVEL,
        "written_at": datetime.now(PT).strftime("%Y-%m-%d %H:%M %Z"),
    }


def policy_allow(policy: dict) -> list[str]:
    """Return the repositories the snapshot names."""
    allow = policy.get("allow")
    if not isinstance(allow, list):
        return []
    return [str(name) for name in allow if str(name)]


def cycle_allow(policy: dict) -> list[str]:
    """Return the repositories the shift may work this cycle.

    The snapshot names the repositories, and the Ascend rule still wins:
    a repository the merge gate would refuse is never read, whatever the
    snapshot says. So a hand-edited snapshot cannot make the shift read
    Ascend work."""
    names = policy_allow(policy)
    if not names:
        return []
    cfg = load_config()
    keys = {
        repo: entry.get("key", "")
        for repo, entry in (cfg.get("repos") or {}).items()
    }
    flagged = ascend_flags(cfg)
    return [
        name
        for name in names
        if ascend_reason(name, keys.get(name), name in flagged) is None
    ]


def policy_lines(policy: dict) -> list[str]:
    """Return the lines that say what the snapshot says."""
    names = policy_allow(policy)
    budget = budget_of(policy)
    cap = policy.get("slot_cap")
    cap_text = (
        str(cap) if isinstance(cap, int) and not isinstance(cap, bool) else "unknown"
    )
    allow_text = f" ({', '.join(names)})" if names else ""
    return [
        f"Allow list: {len(names)} repositories{allow_text}",
        f"Slot cap: {cap_text} (read only, from the coordq config; never raised)",
        f"Stall cap: {policy.get('stall_cap')} cycles with no new work",
        f"Retry cap: {policy.get('retry_cap')} fix tries per item, then it is parked",
        f"Builder-time budget: soft {budget['soft']} min, hard {budget['hard']} min "
        f"(inside the {TURN_CAP_MINUTES} minute turn cap)",
        f"Verify level: {policy.get('verify_level')}",
        "No item cap and no allowance stop: the whole backlog is in scope and "
        "model use is never a stop condition.",
    ]


def normalise_budget(budget: dict | None) -> dict:
    """Return a budget with its three numbers, whatever shape it came in.

    A number that is not a number is replaced by the turn cap's number,
    so a budget that cannot be read is never a limit of zero and never a
    limit nobody set."""
    budget = budget or {}

    def number(value: object, fallback: int) -> int:
        if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
            return value
        return fallback

    return {
        "soft": number(budget.get("soft"), SOFT_BUDGET_MINUTES),
        "hard": number(budget.get("hard"), HARD_BUDGET_MINUTES),
        "retry_cap": number(budget.get("retry_cap"), RETRY_CAP),
    }


def budget_of(policy: dict) -> dict:
    """Return the budget the shift works under.

    The snapshot may name a soft and a hard builder-time budget and the
    retry cap. A snapshot that names none of them gets the turn cap's
    budget, so a snapshot written before this part keeps working: the
    24x7 shift must not stop at the next install. A snapshot that names a
    budget outside the turn cap is refused by `policy_problem`, so a hand
    edited snapshot cannot widen the limit."""
    return normalise_budget(
        {
            "soft": policy.get("soft_budget_minutes"),
            "hard": policy.get("hard_budget_minutes"),
            "retry_cap": policy.get("retry_cap"),
        }
    )


# The verdicts the budget rule can return.
BUDGET_WITHIN = "within the budget"
BUDGET_SOFT = "over the soft budget"
BUDGET_HARD = "over the hard budget"
BUDGET_FIXES = "out of fix tries"


def budget_verdict(minutes: int, fix_tries: int, budget: dict) -> dict:
    """Return what the shift does with an item under the budget.

    The spec's rule (section 10): every item has a soft and a hard
    builder-time budget and at most two fix tries after a failed check.
    Over the soft budget the builder is asked to wrap up. At the hard
    budget the item is stopped and written up. Out of fix tries the item
    is parked.

    The rule lives in one function, so the receipt writer, the board and
    the budget command read the same rule and never disagree about when
    an item stops."""
    soft = budget["soft"]
    hard = budget["hard"]
    cap = budget["retry_cap"]
    reasons: list[str] = []
    if minutes >= hard:
        reasons.append(
            f"the builder used {minutes} min of its {hard} min hard budget"
        )
    if fix_tries >= cap:
        reasons.append(f"the item used its {cap} fix tries")
    if reasons:
        return {
            "verdict": BUDGET_HARD if minutes >= hard else BUDGET_FIXES,
            "parked": True,
            "state": STATE_PARKED,
            "why": " and ".join(reasons) + ", so the item was stopped and parked",
            "next": (
                "Shyam decides whether to give the item more time, to split it "
                "into a 5-minute part or to close it"
            ),
        }
    if minutes >= soft:
        return {
            "verdict": BUDGET_SOFT,
            "parked": False,
            "state": "",
            "why": (
                f"the builder used {minutes} min of its {soft} min soft budget, "
                "so the builder wraps up"
            ),
            "next": "the builder finishes what it has and the gate runs",
        }
    return {
        "verdict": BUDGET_WITHIN,
        "parked": False,
        "state": "",
        "why": "",
        "next": "",
    }


def apply_budget(facts: dict, fix_tries: int, budget: dict) -> dict:
    """Return the facts of an item with the budget applied to them.

    The budget can stop an item, so it decides the state the receipt
    holds: an item over its hard budget, or out of fix tries, is parked.
    An item over its soft budget keeps its state and says that the
    builder must wrap up.

    The budget stops work, so it says nothing about work that is already
    finished: a merged item and an item that waits for Shyam's merge keep
    their state, and the time they took stays in the receipt."""
    verdict = budget_verdict(facts.get("minutes", 0), fix_tries, budget)
    facts["budget"] = verdict["verdict"]
    if facts.get("state") in (STATE_DONE, STATE_READY):
        return facts
    if verdict["parked"]:
        facts["state"] = verdict["state"]
        facts["why"] = verdict["why"] + (f" ({facts['why']})" if facts["why"] else "")
        facts["next"] = verdict["next"]
    elif verdict["why"]:
        facts["why"] = (facts["why"] + "; " if facts["why"] else "") + verdict["why"]
        facts["next"] = verdict["next"] or facts["next"]
    return facts


def cmd_policy(args: argparse.Namespace) -> int:
    """Write the policy snapshot the shift reads on every cycle.

    The shift is never unarmed and has no deadline, so the snapshot is the
    whole contract: the repositories the shift may touch, the queue's slot
    cap (read only), the caps that end an item and the verify level. The
    command writes no `run/armed` and no `run/deadline`, and it never
    writes the queue's config.

    Writing it again replaces the snapshot with the same contract, so the
    command can run on every boot."""
    root = report_root(args.root)
    policy = build_policy()
    if args.dry_run:
        emit("Overnight policy - dry run (nothing written)")
        for line in policy_lines(policy):
            emit(line)
        emit(f"The snapshot would be written to {policy_path(root)}")
        return 0
    path = write_policy(root, policy)
    emit(f"overnight: wrote {path}")
    for line in policy_lines(policy):
        emit(line)
    emit(
        "The shift reads this snapshot on every cycle. It is never unarmed, it "
        "has no deadline, and run/STOP still stops it at the next cycle."
    )
    return 0


def cmd_redact(args: argparse.Namespace) -> int:
    """Print a text with every secret pattern redacted.

    The command is the redaction itself, made visible: it reads a fixture
    (a string, a file or standard input) and prints what a record under
    `.overnight/` would hold. It writes nothing.

    The fixture is the proof the ticket asks for: a fake key goes in and
    the key does not come out."""
    if args.text is not None:
        text = args.text
    elif args.file:
        path = Path(args.file).expanduser()
        text = read_text(path)
        if not text:
            die(f"the fixture {path} is empty or cannot be read")
    else:
        text = sys.stdin.read()
    redacted = redact(text)
    if redacted and not redacted.endswith("\n"):
        redacted += "\n"
    emit(redacted, end="")
    return 0


def report_window(now: datetime) -> bool:
    """Return True when a moment belongs to the morning report window.

    The shift has no window and never ends. The report has a time: it is
    written by the first cycle of the morning, so Shyam reads one report a
    day."""
    minutes = now.hour * 60 + now.minute
    return REPORT_WINDOW[0] <= minutes <= REPORT_WINDOW[1]


def write_morning_report(root: Path) -> int:
    """Write the day's morning report, once a day.

    The report is the record of the day the shift worked: what merged, what
    is ready, what is stuck and which decisions wait for Shyam. The first
    cycle that lands in the morning window writes it, and a later cycle
    leaves it alone, so a day has one report.

    The report is rendered by the report code, from the shift's own
    records, and it invents nothing."""
    day = datetime.now(PT).strftime("%Y-%m-%d")
    out = root / "receipts" / f"morning-{day}.md"
    if out.exists():
        emit(f"overnight: today's morning report {out} is already written")
        return 0
    return cmd_report(
        argparse.Namespace(root=str(root), date=day, dry_run=False)
    )


def shift_lock_path() -> Path:
    """The shift's lock file. One path for every caller: launchd jobs and
    shells see different TMPDIR values, so a TMPDIR lock would not exclude
    a hand-started cycle from the scheduled one."""
    override = os.environ.get("OVERNIGHT_SHIFT_LOCK")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".local" / "state" / "mac-ops" / SHIFT_LOCK_NAME


def take_shift_lock() -> tuple[int | None, str]:
    """Take the shift's lock. The pair is the descriptor and the reason it
    could not be taken: an empty reason means the lock is held.

    The lock is the shift's own, so a cycle that starts while another
    cycle runs does no work and says so. It is never left out: a lock
    that cannot be opened refuses the cycle, because a cycle that runs
    unlocked is a cycle that can overlap another one."""
    try:
        path = shift_lock_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError as exc:
        return None, f"the lock file cannot be opened: {exc}"
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None, ""
    return fd, ""


def release_shift_lock(fd: int) -> None:
    """Give the lock back."""
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    finally:
        os.close(fd)


def cmd_shift(args: argparse.Namespace) -> int:
    """Run one cycle of the shift under the shift's own lock.

    The lock comes before the board read, so a cycle that starts while
    another cycle runs exits without a single GitHub call. Two cycles never
    run at once, whatever starts them: the job fires every three minutes
    and a person can start a cycle by hand while the job's cycle runs."""
    if args.dry_run:
        return shift_cycle(args)
    lock_fd, lock_problem = take_shift_lock()
    stamp = datetime.now(PT).strftime("%Y-%m-%d %H:%M %Z")
    if lock_fd is None:
        if lock_problem:
            emit(
                f"overnight: {stamp} REFUSED: {lock_problem}; the cycle "
                "wrote no receipt",
                err=True,
            )
            return 1
        emit(
            f"overnight: {stamp} another cycle holds the lock, so this "
            "cycle did no work"
        )
        return 0
    try:
        return shift_cycle(args)
    finally:
        release_shift_lock(lock_fd)


def cmd_act(args: argparse.Namespace) -> int:
    """Run the lane's check on one pull request now, under the shift's own lock.

    The lane merges a gate PASS only in its own pass. This runs that same
    step (`act_on_pr`) for one pull request when its gate thread ends,
    instead of at the next timer. The shift's rules still hold: STOP, the
    policy's repository list and the lock. When any of them refuses, the
    scheduled pass decides, as before."""
    found = re.fullmatch(r"([\w.-]+/[\w.-]+)#(\d+)", args.ref)
    if not found:
        die(f"bad reference {args.ref!r}, expected owner/repo#number")
    repo, number = found[1], int(found[2])
    root = report_root(args.root)
    policy, _ = load_policy(root)
    if (root / "run" / "STOP").exists() or policy is None or repo not in cycle_allow(policy):
        emit(f"overnight: act {args.ref}: the shift may not work this repository now, so the scheduled pass decides")
        return 0
    import lane_driver

    give_up = time.monotonic() + args.wait
    while args.after and lane_driver.t3("t3_thread_read", {"threadId": args.after, "limit": 1}).get(
            "thread", {}).get("status") not in ("completed", "failed", "interrupted"):
        if time.monotonic() > give_up:
            emit(f"overnight: act {args.ref}: gate thread {args.after} did not end in {args.wait}s, so the scheduled pass decides")
            return 0
        time.sleep(10)
    lock_fd, problem = take_shift_lock()
    while lock_fd is None and not problem and time.monotonic() < give_up:
        time.sleep(5)
        lock_fd, problem = take_shift_lock()
    if lock_fd is None:
        emit(f"overnight: act {args.ref}: {problem or 'another cycle holds the lock'}, so the scheduled pass decides")
        return 1 if problem else 0
    try:
        with open(Path.home() / ".coordinator" / "tickets.json") as handle:
            lane_driver.CFG = json.load(handle)["repos"]
        lane_driver.LANE_REPOS = [repo]
        lane_driver.print = emit
        ledger = lane_driver.load_ledger()
        lane_driver.PASS_PRS.clear()
        lane_driver.PASS_WORKTREES.clear()
        lane_driver.SNAPSHOT = lane_driver.board_snapshot(ledger, force=True)
        with lane_driver.item_boundary(repo, number, ledger):
            result = lane_driver.act_on_pr(repo, number, ledger)
        emit(f"{lane_driver.CFG[repo]['key']:5} {result}" if result else f"overnight: act {args.ref}: nothing to do")
        lane_driver.save_ledger(ledger)
    finally:
        release_shift_lock(lock_fd)
    return 0


def shift_cycle(args: argparse.Namespace) -> int:
    """Run one cycle of the shift.

    The shift is never unarmed and has no deadline (spec revision 3): a
    cycle never waits for an arm and never ends on a clock. It reads the
    policy snapshot on every cycle, and `run/STOP` still stops it at the
    next cycle.

    The job fires the shift on a fixed interval, every day, so there is
    no night window and no part of the night: every run is one cycle. The
    cycle works the whole board: there is no item cap and no allowance
    stop. It writes a receipt for every item whose state changed.

    The morning report has a time even though the shift does not. The
    first cycle that lands in the morning window writes the day's report,
    so a day has one report and Shyam reads one thing in the morning.
    `--report` writes it on demand.

    The clock is the Mac's local clock, the clock launchd fires on. The
    shift log still says Pacific time, and a Mac that is not on Pacific
    time is told so.

    The cycle starts with the health checks: the tools under the
    interpreter launchd uses, the installed files, the board's drift. The
    checks are read only. Each finding is one line of the cycle's
    receipt, and an ALERT line in the shift log."""
    now_local = datetime.now().astimezone()
    now_pt = datetime.now(PT)
    stamp = now_pt.strftime("%Y-%m-%d %H:%M %Z")
    root = report_root(args.root)
    # The mute for the alarms lives in the shift's own records, beside
    # the stall state, so a board file the coordinator rewrites cannot
    # take the mute with it.
    alarms.MUTE_PATH = str(root / "run" / "mute-state.json")
    if now_local.utcoffset() != now_pt.utcoffset():
        emit(
            "overnight: the Mac's clock is not on Pacific time, so the job "
            "fires on the Mac's local clock, not Pacific time",
            err=True,
        )
    # The report cycle: the one cycle of the day that also leaves the
    # morning report. The shift has no window; the report has a time.
    report_cycle = report_window(now_local) or bool(getattr(args, "report", False))
    # STOP wins over every other rule: the shift ends at the next cycle.
    if (root / "run" / "STOP").exists():
        emit(
            f"overnight: {stamp} run/STOP exists, so the shift stops at "
            "this cycle"
        )
        # The report still runs: it is the record of the day, and it says
        # that the shift ended with STOP.
        if report_cycle and not args.dry_run:
            return write_morning_report(root)
        return 0
    # The shift reads its contract on every cycle.
    policy, policy_error = load_policy(root)
    # The budget the shift works under (part T8a). A snapshot that names
    # no budget gets the turn cap's budget, so a snapshot written before
    # this part keeps the shift working.
    budget = budget_of(policy or {})
    allowed = None
    if policy is None:
        if not args.dry_run:
            die(
                f"the shift has no usable policy snapshot: {policy_error}. "
                "Run `overnight policy` to write it."
            )
        emit(
            f"overnight: {policy_error}; a dry run reads the board only",
            err=True,
        )
    else:
        allowed = cycle_allow(policy)
        emit(f"overnight: {stamp} shift cycle under {policy_path(root)}")
        for line in policy_lines(policy):
            emit(line)
        dropped = len(policy_allow(policy)) - len(allowed)
        if dropped:
            emit(
                f"The snapshot names {dropped} Ascend "
                f"{plural(dropped, 'repository', 'repositories')}, and the "
                "shift never reads Ascend work."
            )
    # The cycle starts with the health checks the tick ran every tick,
    # before the shift acts on the board (spec part T14, loop/tick.md
    # section 1b). They read only: the tools under the interpreter
    # launchd uses, the installed files, the board's drift. The board is
    # read here because the checks need it.
    started = time.monotonic()
    cfg = load_config()
    repos = policy_repos(cfg, allowed)
    board, board_stale = read_board(started + args.deadline)
    if board_stale:
        emit(
            "overnight: the board list is stale, so the health checks cannot "
            "trust the board",
            err=True,
        )
    # The checks get half the cycle, so the board work still has time.
    health_deadline = started + max(60, args.deadline // 2)
    health_lines, health_findings = health_cycle(
        root, board, repos, health_deadline, board_stale
    )
    receipt = write_cycle_receipt(
        root, stamp, now_pt.strftime("%Y-%m-%d-%H%M"), health_lines, health_findings
    )
    emit(f"overnight: wrote {receipt}")
    emit(
        f"Health checks: {len(health_findings)} finding(s) from 4 checks"
        + (" (no finding)" if not health_findings else "")
    )
    for finding in health_findings:
        # The shift's board work is not built yet (spec part T5), so the
        # shift cannot resend or park a finding yet. Every finding is an
        # ALERT line, and the receipt names the action it would take.
        emit(
            f"ALERT: {finding['subject']}: {finding['detail']} "
            f"(action: {finding['action']})"
        )
        write_shift_line(
            root,
            f"health | ALERT: {finding['subject']}: {finding['detail']} "
            f"(action: {finding['action']})",
        )
    write_shift_line(
        root, f"health | {len(health_findings)} finding(s) from 4 checks"
    )
    # The checks spent part of the cycle, so the board work gets what is
    # left of it.
    left = max(1, int(args.deadline - (time.monotonic() - started)))
    import lane_driver

    selected = []
    for repo in lane_driver.LANE_REPOS:
        if allowed is None or repo not in allowed:
            emit(f"overnight: skip {repo}: excluded by policy")
            continue
        selected.append(repo)
        mode = "manual-merge" if lane_driver.merge_mode(repo, {}) in ("manual", "ascend") else "allowed"
        emit(f"overnight: lane {repo}: {mode}")
    lane_driver.LANE_REPOS = selected
    lane_driver.restrict_merge_repos(allowed)
    if args.dry_run:
        emit(f"overnight: {stamp} shift cycle (dry run, read only)")
        return cmd_order(
            argparse.Namespace(
                dry_run=True,
                root=args.root,
                deadline=left,
                allowed=allowed,
            )
        )
    lane_driver.print = emit
    # The shift measures the items against the state it kept, so
    # the pass knows how long each item has been idle.
    lane_driver.STALL_STATE = load_stall_state(root)
    try:
        lane_driver.main()
    finally:
        # The stall records of this pass are written even when the
        # pass failed an item: a reported stall and a stalled board
        # are the shift's own findings, not a side effect of the
        # pass's success. The records come before the state is
        # saved, so the state says the alert was delivered only
        # after it was delivered.
        try:
            for line in stall_records(
                root, lane_driver.STALL_EVENTS, None, lane_driver.STALL_STATE
            ):
                emit(f"overnight: {line}")
        finally:
            save_stall_state(root, lane_driver.STALL_STATE)
    write_shift_line(root, "lane pass finished; board reads use the lane snapshot")
    # Part T10: the cycle parks what it cannot decide and logs what
    # it found. A pending request is parked with its exact text and
    # is never answered.
    park_cycle(root, started + args.deadline)
    if report_cycle:
        return write_morning_report(root)
    return 0


def load_stall_state(root: Path) -> dict:
    """Return the stall state the shift keeps.

    The state is the shift's own record of how long every item has been
    idle. A state that cannot be read is an empty state: the shift measures
    the items again from this tick on."""
    text = read_text(stall.state_path(root))
    if not text.strip():
        return stall.new_state()
    try:
        data = json.loads(text)
    except ValueError:
        return stall.new_state()
    if not isinstance(data, dict):
        return stall.new_state()
    if not isinstance(data.get("items"), dict):
        data["items"] = {}
    return data


def save_stall_state(root: Path, state: dict) -> Path:
    """Write the stall state and return the path it went to.

    The write is atomic, so a cycle that reads while the state is being
    written reads the old state or the new one, never half of one."""
    path = stall.state_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f"{path.name}.tmp"
    write_record(tmp, json.dumps(state, indent=1) + "\n")
    os.replace(tmp, path)
    return path


def stall_records(
    root: Path,
    events: list[dict],
    board: str | None = None,
    state: dict | None = None,
) -> list[str]:
    """Write the records of the stall events of one pass and return them.

    An item that was reported as stalled gets a receipt that says so, so
    the morning report names it under "Stuck". A board that stopped moving
    gets a line in the shift log and an alert on the coordinator's board,
    the same board the merge alert uses.

    The board's alert flag is set only after the alert was written: a board
    whose alert could not be written asks again on the next tick instead of
    going quiet for good.

    The shift does not end here: the sweep ran again and the shift keeps
    running until every item is done or parked."""
    written: list[str] = []
    board_event = False
    for event in events:
        kind = event.get("kind")
        if kind == "item":
            item = {
                "kind": "ticket",
                "repo": event.get("repo") or "",
                "number": event.get("number") or 0,
                "key": event.get("key") or "",
                "title": event.get("title") or "",
                "url": event.get("url") or "",
            }
            body = receipt_text(
                item,
                STATE_STUCK,
                None,
                None,
                0,
                f"stall: no new commit or receipt for {event.get('idle')} ticks",
                "the shift keeps working the item; Shyam sees it in the morning report",
            )
            outcome = write_receipt(root, item, body)
            write_shift_line(
                root,
                f"stall: {event.get('item')} reported, no new commit or receipt "
                f"for {event.get('idle')} ticks; the shift keeps working it",
            )
            written.append(f"{receipt_path(root, item)} ({outcome})")
        elif kind == "board":
            board_event = True
            written.append(stall_alert(root, event.get("idle"), state, board))
    # A stall that continues: the board has not moved since the alert was
    # delivered, so the rule stops asking. The shift asks anyway, on every
    # tick, because the writer knows whether the alarm is due: it is quiet
    # while the mute runs, and it comes back when the four hours are over.
    if not board_event and stall.continues(state):
        written.append(stall_alert(root, int(state.get("board_idle") or 0), state, board))
    return written


def stall_alert(root, idle, state, board=None):
    """Write the board stall alarm and write the line that says what it did.

    The writer decides: the alarm is written, or it stays quiet for the
    same cause, or its item went off the board and the shift asks again
    on the next tick. The shift logs one line per tick either way."""
    reason = (
        f"The overnight shift saw no board progress for "
        f"{idle} ticks. The board was swept again and the "
        "shift keeps running until every item is done or parked."
    )
    cause = stall.alarm_cause(reason, state)
    target, action = stall.alert(reason, cause, board)
    if action == "wrote":
        if isinstance(state, dict):
            stall.delivered(state)
        write_shift_line(
            root,
            f"stall: no board progress for {idle} ticks; the "
            "board was swept again and Shyam was alerted",
        )
        return target
    if action == "quiet":
        # The alarm was answered or routed, so the same cause stays quiet
        # for four hours. The shift logs one line per tick and the board
        # holds no item for it.
        write_shift_line(
            root,
            f"stall: no board progress for {idle} ticks; the "
            "board was swept again and the alarm stays quiet for the same "
            "cause",
        )
        return "the alarm stays quiet for the same cause"
    write_shift_line(
        root,
        f"stall: no board progress for {idle} ticks; the "
        "board was swept again and the alert could not be written",
    )
    return "the alert could not be written"


def show_stall_state(explicit: str | None = None) -> int:
    """Print the stall state the shift keeps.

    The command reads only: it says which items are idle, for how many
    ticks, and which of them are stalled. A stalled item is not parked:
    the shift keeps working it."""
    root = report_root(explicit)
    state = load_stall_state(root)
    items = state.get("items") or {}
    if not items:
        emit(f"overnight: no item has been measured yet ({stall.state_path(root)})")
        return 0
    emit("Overnight stall state")
    for key, entry in sorted(items.items()):
        if not isinstance(entry, dict):
            continue
        idle = int(entry.get("idle") or 0)
        stalled = " stalled" if entry.get("stalled") else ""
        emit(f"{key}: idle {idle} tick(s){stalled}")
    emit(f"Board idle: {int(state.get('board_idle') or 0)} tick(s)")
    return 0


def run_stall_fixture(args: argparse.Namespace) -> int:
    """Run the stall rule over the ticks of a fixture.

    The fixture names its items and its ticks. A tick maps every item to
    its marker: the item's commit and the item's newest dispatch receipt.
    The command runs the real rule, so the stall line and the alert come
    from the same code the shift runs.

    The records go to `--root`, so a fixture run never touches the live
    records."""
    path = Path(args.fixture).expanduser()
    try:
        data = json.loads(read_text(path))
    except ValueError as exc:
        die(f"the fixture {path} is not JSON: {exc}")
    if not isinstance(data, dict):
        die(f"the fixture {path} is not a JSON object")
    items = data.get("items")
    ticks = data.get("ticks")
    if not isinstance(items, list) or not isinstance(ticks, list) or not ticks:
        die(f"the fixture {path} must name its items and its ticks")
    details: dict[str, dict] = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        key = f"{item.get('repo') or ''}#{item.get('number') or ''}"
        details[key] = item
    state = stall.new_state()
    events: list[dict] = []
    for index, tick in enumerate(ticks, start=1):
        if not isinstance(tick, dict):
            die(f"tick {index} of the fixture {path} is not a mapping")
        markers = {str(key): str(value) for key, value in tick.items()}
        fresh = stall.arrived(state, set(markers))
        progressed = any(
            stall.moved(state, key, marker) for key, marker in markers.items()
        ) or bool(fresh)
        board_event = stall.board(state, progressed, len(markers))
        for key, marker in sorted(markers.items()):
            event = stall.observe(state, key, marker)
            if not event:
                continue
            item = details.get(key) or {}
            event.update(
                {
                    "repo": item.get("repo") or "",
                    "number": item.get("number") or 0,
                    "key": item.get("key") or "",
                    "title": item.get("title") or "",
                    "url": item.get("url") or "",
                }
            )
            emit(
                f"STALL {key}: no new commit or receipt for {event['idle']} ticks; "
                "reported, the shift keeps working it"
            )
            events.append(event)
        if board_event:
            emit(
                f"STALL board: no board progress for {board_event['idle']} ticks; "
                "the board is swept again"
            )
            events.append(board_event)
    if args.root:
        root = Path(args.root).expanduser()
        for folder in ("run", "receipts", "inbox", "staging"):
            (root / folder).mkdir(parents=True, exist_ok=True)
        board = root / "decisions.json"
        if not board.exists():
            write_record(board, json.dumps({"items": []}, indent=1) + "\n")
        # The mute state belongs to the root the fixture chose, so a
        # fixture run never writes a synthetic alarm key into the live
        # state and never reads a live acknowledgement.
        alarms.MUTE_PATH = str(root / "run" / "mute-state.json")
        for line in stall_records(root, events, str(board), state):
            emit(f"wrote {line}")
        save_stall_state(root, state)
    else:
        emit("This run wrote nothing: give --root to write the records.")
    return 0


def cmd_stall(args: argparse.Namespace) -> int:
    """Show the stall state, or run the stall rule over a fixture.

    Without a fixture the command reads the shift's own stall state and
    says which items are idle and for how many ticks. It writes nothing.

    With `--fixture` the command runs the real rule over the ticks of the
    fixture and writes the records the rule produces: the receipt of a
    reported item, the line in the shift log and the alert on the
    coordinator's board."""
    if args.fixture:
        return run_stall_fixture(args)
    return show_stall_state(args.root)


def report_root(explicit: str | None) -> Path:
    """Return the folder that holds the shift's records.

    The default is the runtime folder the installer creates. A caller can
    point the report at another folder, which is how a dry night on a
    fixture folder is rendered. The installer can move the runtime folder
    with `MAC_OPS_COORDINATOR_DIR`, and the report follows it."""
    if explicit:
        return Path(explicit).expanduser()
    from_env = os.environ.get("OVERNIGHT_ROOT")
    if from_env:
        return Path(from_env).expanduser()
    coordinator = os.environ.get("MAC_OPS_COORDINATOR_DIR")
    if coordinator:
        return Path(coordinator).expanduser() / ".overnight"
    return Path(OVERNIGHT_ROOT).expanduser()


def read_text(path: Path) -> str:
    """Return a file's text, or an empty string when it cannot be read."""
    try:
        return path.read_text()
    except (OSError, UnicodeDecodeError):
        return ""


def split_checks(body: str) -> list[str]:
    """Return the parts of a checks line, split on the semicolons that sit
    outside a command."""
    parts = []
    current = ""
    in_command = False
    for char in body:
        if char == "`":
            in_command = not in_command
        if char == ";" and not in_command:
            parts.append(current)
            current = ""
            continue
        current += char
    parts.append(current)
    return [part.strip() for part in parts if part.strip()]


def parse_check_text(body: str) -> list[dict]:
    """Return the checks of one receipt line.

    A check line may hold several checks, separated by semicolons. Each
    check counts as run only when it names a command and an exit code."""
    checks = []
    for part in split_checks(body):
        quoted = QUOTED.search(part)
        code = EXIT_CODE.search(part)
        checks.append(
            {
                "raw": part,
                "command": quoted.group(1).strip() if quoted else "",
                "exit": int(code.group("code")) if code else None,
            }
        )
    return checks


def parse_receipt(path: Path) -> dict:
    """Return one receipt as its fields and its checks."""
    fields: dict[str, str] = {}
    checks: list[dict] = []
    for raw in read_text(path).splitlines():
        line = raw.strip()
        if not line.startswith("-"):
            continue
        match = FIELD_LINE.match(line)
        if not match:
            continue
        key = match.group("key").strip().lower()
        value = match.group("value").strip()
        if key.startswith("check"):
            checks.extend(parse_check_text(value))
            continue
        fields[key] = value
    return {"path": path, "fields": fields, "checks": checks}


def unrun_checks(checks: list[dict]) -> list[dict]:
    """Return the checks that did not run.

    A check with no command or no exit code is a claim, not a run. The
    report never reports such a check as passed."""
    return [
        check
        for check in checks
        if not check["command"] or check["exit"] is None
    ]


def classify(receipt: dict) -> tuple[str, str]:
    """Return the state of one receipt and the reason it is not what it claims.

    A receipt that claims it is done or ready needs proof: a check that ran
    with its exit code and passed, and a gate that passed. Without that
    proof the item is stuck, because the report never reports a check as
    passed unless it ran."""
    fields = receipt["fields"]
    state = (fields.get("state") or "").strip().lower()
    if state not in (STATE_DONE, STATE_READY, STATE_STUCK, STATE_PARKED):
        return STATE_UNREADABLE, "the receipt does not name a state"
    if state in (STATE_DONE, STATE_READY):
        holds, reason = evidence_holds(fields, receipt["checks"])
        if not holds:
            return STATE_STUCK, reason
    return state, ""


def evidence_holds(fields: dict, checks: list[dict]) -> tuple[bool, str]:
    """Return whether a receipt holds the evidence that makes an item done.

    The spec's rule: an item counts as done, and the coordinator closes
    its issue, only when the receipt records a command, its exit code and
    a gate PASS on the pull request. A check with no exit code is a
    claim, not a run, and a run that failed is not a pass. The rule lives
    here so the receipt writer, the morning report and the close step
    read it from one place."""
    if not checks:
        return False, "the receipt holds no check, so nothing ran"
    missing = unrun_checks(checks)
    if missing:
        names = ", ".join(check["raw"] for check in missing)
        return False, f"a check has no exit code, so it did not run ({names})"
    failed = [check for check in checks if check["exit"] != 0]
    if failed:
        unknown = [check for check in failed if check["exit"] == 2]
        if unknown:
            names = ", ".join(check["raw"] for check in unknown)
            return False, f"the check did not run, so it proved nothing ({names})"
        names = ", ".join(check["raw"] for check in failed)
        return False, f"a check failed ({names})"
    if (fields.get("gate") or "").strip().upper() != "PASS":
        return False, "the gate did not pass"
    return True, ""


def parse_shift_log(text: str) -> dict:
    """Return what the shift log records: the planned count, the full suite,
    a stall and the statement of how the night ended."""
    planned: int | None = None
    full_suite: dict | None = None
    stall = False
    ended: str | None = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        found = PLANNED.search(line)
        if found:
            planned = int(found.group("count"))
        if "full suite" in line.lower():
            body = line.split(":", 1)[1] if ":" in line else line
            quoted = QUOTED.search(body)
            code = EXIT_CODE.search(body)
            suite = {
                "command": quoted.group(1).strip() if quoted else "",
                "exit": int(code.group("code")) if code else None,
                "time": line.split("—", 1)[0].strip() if "—" in line else "",
            }
            # A later line without an exit code does not erase a run that
            # the log already records.
            if suite["exit"] is not None or full_suite is None:
                full_suite = suite
        if STALL.search(line):
            stall = True
        found_end = ENDED.match(line)
        if found_end:
            how = found_end.group("how").lower()
            ended = "STOP" if how == "stop" else how
    return {
        "planned": planned,
        "full_suite": full_suite,
        "stall": stall,
        "ended": ended,
    }


def parse_parking_lot(text: str) -> list[dict]:
    """Return the parked decisions, each with its default and its
    recommendation.

    A quoted request can hold a line that looks like a field or a
    heading, and it can hold a fence of its own, so the parser reads the
    fences: what is inside a fence is the quoted text of a request and
    never a field of the decision. A fence closes only on the exact
    delimiter that opened it, so a fence inside the quoted text cannot
    close the fence that quotes it and let the rest of the quote out."""
    entries: list[dict] = []
    title = ""
    body: list[str] = []
    fence = ""
    for raw in text.splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if fence:
            if stripped == fence:
                fence = ""
            continue
        run = FENCE_RUN.match(stripped)
        if run and len(run.group(0)) >= 3:
            fence = run.group(0)
            continue
        if line.startswith("## "):
            if title:
                entries.append({"title": title, "body": body})
            title = line[3:].strip()
            body = []
        elif title:
            body.append(line)
    if title:
        entries.append({"title": title, "body": body})
    for entry in entries:
        entry["default"] = ""
        entry["recommend"] = ""
        entry["parked"] = ""
        for line in entry["body"]:
            match = FIELD_LINE.match(line.strip())
            if not match:
                continue
            key = match.group("key").strip().lower()
            value = match.group("value").strip()
            if key.startswith("default"):
                entry["default"] = value
            elif key.startswith("recommend"):
                entry["recommend"] = value
            elif key.startswith("parked at"):
                entry["parked"] = value
    return entries


def receipt_minutes(receipt: dict) -> int | None:
    """Return the builder time of a receipt in minutes, or None."""
    text = (receipt["fields"].get("time used") or "").strip()
    found = re.search(r"(\d+)\s*min", text, re.I)
    return int(found.group(1)) if found else None


def format_minutes(total: int) -> str:
    """Return a number of minutes as hours and minutes."""
    hours, minutes = divmod(total, 60)
    if hours and minutes:
        return f"{hours} h {minutes} min"
    if hours:
        return f"{hours} h"
    return f"{minutes} min"


def pt_clock(moment: datetime) -> str:
    """Return a moment as a PT clock time."""
    return moment.astimezone(PT).strftime("%I:%M %p PT")


def item_label(receipt: dict) -> str:
    """Return the name of the item a receipt is about."""
    fields = receipt["fields"]
    label = fields.get("ticket") or fields.get("repo") or receipt["path"].stem
    item = fields.get("item") or ""
    return f"{label} — {item}" if item else label


def how_it_ended(root: Path, log: dict, receipts: list[dict], planned: int | None) -> str:
    """Return how the shift ended.

    The spec allows four answers: deadline, all done, STOP and stall. A
    shift that ended in none of those ways says UNVERIFIED rather than
    guessing.

    The shift log states how the night ended, and the report reads that
    statement. It reads it only when the records support it: "all done"
    needs every receipt to be done or parked, "deadline" needs the clock
    to be past the deadline, "STOP" needs the STOP file and "stall" needs
    the shift to say it ended with a stall. A claim the records do not
    support is never repeated.

    A stall in the log is not the end of the shift (spec part T8b): a
    stalled board is swept again and the shift keeps running until every
    item is done or parked. So a stall line alone ends nothing, and only
    a shift that states it ended with a stall ends that way."""
    if (root / "run" / "STOP").exists():
        return "STOP"
    states = [classify(receipt)[0] for receipt in receipts]
    all_done = (
        planned is not None
        and bool(receipts)
        and len(receipts) == planned
        and all(state in (STATE_DONE, STATE_PARKED) for state in states)
    )
    deadline_passed = False
    deadline = read_text(root / "run" / "deadline").strip()
    if deadline:
        try:
            deadline_passed = datetime.now(timezone.utc).timestamp() > float(deadline)
        except ValueError:
            deadline_passed = False
    claim = (log.get("ended") or "").strip()
    if claim == "all done" and all_done:
        return "all done"
    if claim == "deadline" and deadline_passed:
        return "deadline"
    if claim == "stall" and log["stall"]:
        return "stall"
    if all_done:
        return "all done"
    if deadline_passed:
        return "deadline"
    return UNVERIFIED


def render_report(snapshot: dict) -> str:
    """Return the morning report as markdown.

    Every count comes from the records. A count that cannot be checked is
    written as UNVERIFIED, and no check is reported as passed unless the
    records say it ran."""
    receipts = snapshot["receipts"]
    log = snapshot["log"]
    planned = log["planned"]
    counts = {STATE_DONE: 0, STATE_READY: 0, STATE_STUCK: 0, STATE_PARKED: 0}
    unreadable = 0
    merged: list[dict] = []
    ready: list[dict] = []
    stuck: list[dict] = []
    parked: list[dict] = []
    for receipt in receipts:
        state, reason = classify(receipt)
        fields = receipt["fields"]
        if state == STATE_UNREADABLE:
            unreadable += 1
            stuck.append({"receipt": receipt, "reason": reason})
            continue
        if state == STATE_DONE and fields.get("merged"):
            counts[STATE_DONE] += 1
            merged.append(receipt)
        elif state in (STATE_DONE, STATE_READY):
            # The work is done but nobody merged it, so it waits for Shyam.
            counts[STATE_READY] += 1
            ready.append(receipt)
        elif state == STATE_STUCK:
            counts[STATE_STUCK] += 1
            stuck.append({"receipt": receipt, "reason": reason})
        elif state == STATE_PARKED:
            counts[STATE_PARKED] += 1
            parked.append(receipt)

    lines: list[str] = []
    day = snapshot["date"]
    lines.append(f"# Overnight report — {day.strftime('%b %-d, %Y')} ({snapshot['window']})")
    lines.append("")
    ended = snapshot["ended"]
    disagree = planned is not None and planned < len(receipts)
    if planned is None or disagree:
        planned_text = UNVERIFIED
    else:
        planned_text = str(planned)
    counts_text = (
        f"{counts[STATE_DONE]} done, {counts[STATE_READY]} ready, "
        f"{counts[STATE_STUCK]} stuck, {counts[STATE_PARKED]} parked"
    )
    if unreadable:
        counts_text += f", {unreadable} {UNVERIFIED}"
    lines.append(f"How it ended: {ended}. Items: {planned_text} planned, {counts_text}.")
    lines.append("")

    lines.append("## Merged (checked on GitHub)")
    lines.append("")
    if merged:
        for receipt in merged:
            fields = receipt["fields"]
            lines.append(
                f"- {item_label(receipt)}. Merged {fields.get('merged', '')}."
            )
    else:
        lines.append("- None.")
    lines.append("")

    lines.append(
        "## Ready for you (gate PASS, waiting on a merge right the shift does not have)"
    )
    lines.append("")
    if ready:
        for receipt in ready:
            fields = receipt["fields"]
            waiting = fields.get("stopped because") or (
                "the shift has no merge right for this repository"
            )
            lines.append(f"- {item_label(receipt)}. Why waiting: {waiting}.")
    else:
        lines.append("- None.")
    lines.append("")

    lines.append("## Stuck (what stopped it, and the next step)")
    lines.append("")
    if stuck:
        for entry in stuck:
            receipt = entry["receipt"]
            fields = receipt["fields"]
            reason = entry["reason"] or fields.get("stopped because") or "the shift stopped it"
            nxt = fields.get("next") or "unknown"
            lines.append(f"- {item_label(receipt)}. Stopped: {reason}. Next: {nxt}.")
    else:
        lines.append("- None.")
    lines.append("")

    lines.append("## Decisions for you (one at a time, each with my recommendation)")
    lines.append("")
    decisions = []
    for entry in snapshot["parking_lot"]:
        recommendation = entry["recommend"] or f"{UNVERIFIED} (no recommendation recorded)"
        text = f"{entry['title']} — Recommend: {recommendation}."
        if entry["default"]:
            text += f" Default if you say nothing: {entry['default']}"
        decisions.append(text)
    for receipt in parked:
        fields = receipt["fields"]
        reason = fields.get("stopped because") or "the shift parked it"
        nxt = fields.get("next") or "unknown"
        decisions.append(f"{item_label(receipt)}. Stopped: {reason}. Next: {nxt}.")
    if decisions:
        for number, text in enumerate(decisions, start=1):
            lines.append(f"{number}. {text}")
    else:
        lines.append("1. None.")
    lines.append("")

    lines.append("## Not run, and why")
    lines.append("")
    not_run: list[str] = []
    for receipt in receipts:
        for check in unrun_checks(receipt["checks"]):
            label = item_label(receipt)
            if check["command"]:
                not_run.append(
                    f"- {label}: `{check['command']}` has no exit code in the receipt, "
                    "so it did not run."
                )
            else:
                not_run.append(
                    f"- {label}: a check is claimed with no command, so it did not run "
                    f"({check['raw']})."
                )
    suite = log["full_suite"]
    if suite and suite["command"] and suite["exit"] is not None:
        when = f"ran {suite['time']}" if suite["time"] else "ran"
        if suite["exit"] == 0:
            not_run.append(f"- Full suite: {when}, passed.")
        else:
            not_run.append(f"- Full suite: {when}, failed (exit {suite['exit']}).")
    elif suite:
        not_run.append(
            "- Full suite: the shift log records it without a command and an exit "
            "code, so it did not run."
        )
    else:
        not_run.append(
            f"- Full suite: {UNVERIFIED} (the shift log records no full suite run)."
        )
    if planned is not None and planned > len(receipts):
        not_run.append(
            f"- {planned - len(receipts)} planned items have no receipt. Which ones: "
            f"{UNVERIFIED}."
        )
    if disagree:
        not_run.append(
            f"- The shift log plans {planned} items and the receipts hold "
            f"{len(receipts)}. The planned count is {UNVERIFIED}."
        )
    if not_run:
        lines.extend(not_run)
    else:
        lines.append("- Nothing was left unrun.")

    lines.append("")
    lines.append("## Health and drift (the cycles)")
    lines.append("")
    cycles = snapshot.get("cycles") or []
    alerts = [
        (stamp, finding)
        for stamp, findings in cycles
        for finding in findings
    ]
    if alerts:
        for stamp, finding in alerts:
            lines.append(f"- {stamp}. {finding}.")
    else:
        lines.append("- None.")
    lines.append("")
    lines.append("## Cost")
    lines.append("")
    minutes = [receipt_minutes(receipt) for receipt in receipts]
    complete = (
        planned is not None
        and planned == len(receipts)
        and all(value is not None for value in minutes)
    )
    if complete:
        builder = format_minutes(sum(value or 0 for value in minutes))
    elif planned is None:
        builder = f"{UNVERIFIED} (the planned count is {UNVERIFIED})"
    elif planned != len(receipts):
        builder = (
            f"{UNVERIFIED} ({planned - len(receipts)} planned items have no "
            "receipt, so their time is unknown)"
        )
    else:
        builder = f"{UNVERIFIED} (a receipt records no time used)"
    allowance = snapshot["policy"].get("allowance_used_percent")
    if isinstance(allowance, (int, float)) and not isinstance(allowance, bool):
        model_use = f"{allowance:g}% of allowance"
    else:
        model_use = f"{UNVERIFIED} (the allowance was not readable)"
    lines.append(f"- Builder time: {builder}. Model use: {model_use}.")
    lines.append("")
    alarm = tick_alarm()
    if alarm:
        lines.append(alarm)
    return "\n".join(lines)


def report_day(value: str) -> str:
    """Return the night of the report, as YYYY-MM-DD."""
    try:
        datetime.strptime(value, "%Y-%m-%d")
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"{value!r} is not a date as YYYY-MM-DD"
        )
    return value


def cmd_report(args: argparse.Namespace) -> int:
    """Render the morning report from the shift's records."""
    root = report_root(args.root)
    if not root.is_dir():
        die(f"the overnight folder {root} does not exist")
    receipts_dir = root / "receipts"
    receipts = []
    if receipts_dir.is_dir():
        for path in sorted(receipts_dir.glob("*.md")):
            if RECEIPT_FILE.match(path.name):
                receipts.append(parse_receipt(path))
    policy: dict = {}
    policy_text = read_text(root / "run" / "policy.json")
    if policy_text:
        try:
            loaded = json.loads(policy_text)
            if isinstance(loaded, dict):
                policy = loaded
        except ValueError:
            policy = {}
    log = parse_shift_log(read_text(root / "run" / "shift-log.md"))
    parking_lot = parse_parking_lot(read_text(root / "inbox" / "parking-lot.md"))
    day = (
        datetime.strptime(args.date, "%Y-%m-%d").replace(tzinfo=PT)
        if args.date
        else datetime.now(PT)
    )
    start = ""
    armed = read_text(root / "run" / "armed")
    for line in armed.splitlines():
        if line.lower().startswith("start"):
            start = line.split(":", 1)[1].strip() if ":" in line else ""
    deadline_text = read_text(root / "run" / "deadline").strip()
    deadline_clock = ""
    if deadline_text:
        try:
            deadline_clock = pt_clock(
                datetime.fromtimestamp(float(deadline_text), tz=timezone.utc)
            )
        except ValueError:
            deadline_clock = ""
    if start and deadline_clock:
        window = f"{start}–{deadline_clock}"
    else:
        window = f"the window is {UNVERIFIED}"
    snapshot = {
        "receipts": receipts,
        "policy": policy,
        "log": log,
        "parking_lot": parking_lot,
        "cycles": cycle_receipts(receipts_dir),
        "date": day,
        "window": window,
        "ended": how_it_ended(root, log, receipts, log["planned"]),
    }
    report = render_report(snapshot)
    if args.dry_run:
        emit(report)
        return 0
    out = receipts_dir / f"morning-{day.strftime('%Y-%m-%d')}.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    write_record(out, report)
    emit(f"overnight: wrote {out}")
    return 0



# --- Part T3b: the filter -------------------------------------------------


def ascend_reason(repo: str, key: str | None, flagged: bool = False) -> str | None:
    """Return why the work is Ascend, or None when it is not.

    A key from the spec's Ascend list (AUH, MCP, OPS, DBT, OMN) is Ascend
    on its own. A repository the merge gate would refuse to merge is
    Ascend too: the gate's repository rule is the one in
    coordinator/bin/coordq, and the gate's own per-repository `ascend`
    flag is honoured here as well."""
    if key:
        prefix = key.split("-")[0].upper()
        if prefix in ASCEND_KEYS:
            return f"Ascend key {prefix}"
    if not repo:
        return None
    if flagged:
        return f"Ascend repo: the board config marks {repo} as Ascend"
    owner = repo.split("/")[0]
    if owner != PERSONAL_OWNER and repo != "digitized/Concerning":
        return f"Ascend repo: {repo} is not a {PERSONAL_OWNER} repository"
    if any(part in repo for part in ASCEND_REPO_PARTS):
        return f"Ascend repo: {repo} is an Ascend repository"
    return None


def ascend_flags(cfg: dict) -> set[str]:
    """Return the repositories the board config marks as Ascend.

    The merge gate honours a per-repository `ascend` flag in the board
    config (coordinator/bin/coordq). The shift reads the same flag, so
    the two agree on what Ascend is."""
    repos = cfg.get("repos") or {}
    return {repo for repo, entry in repos.items() if entry.get("ascend")}


def ascend_keys_in(text: str) -> list[str]:
    """Return the Ascend keys a text carries, such as a branch name.

    Every key in the text is read, so a branch such as
    "t3/fix-12-auh-3" still shows its Ascend key."""
    found: list[str] = []
    for match in BRANCH_KEY.finditer(text or ""):
        key = f"{match.group(1)}-{match.group(2)}".upper()
        if key.split("-")[0] in ASCEND_KEYS and key not in found:
            found.append(key)
    return found


def clip(text: str, width: int = 120) -> str:
    """Return one readable line of a matched mark."""
    flat = " ".join(text.split())
    return flat if len(flat) <= width else flat[: width - 3] + "..."


def read_bodies(
    issues: list[dict], deadline: float
) -> tuple[dict[tuple[str, int], str], list[str], dict[str, set[int]]]:
    """Return the board tickets' bodies, the repositories that failed and
    the open issue numbers of each repository.

    The ticket CLI's list carries no body, and the marks the shift reads
    live in the ticket's own text, so the module reads the bodies of the
    open issues of the repositories that hold board tickets. The open
    numbers come free with the same read: a blocker that is not on the
    open list is closed, so the shift knows which tickets are blocked."""
    bodies: dict[tuple[str, int], str] = {}
    unread: list[str] = []
    open_numbers: dict[str, set[int]] = {}
    wanted: dict[str, set[int]] = {}
    for issue in issues:
        repo = issue.get("repo") or ""
        number = issue.get("number")
        if repo and number:
            wanted.setdefault(repo, set()).add(number)

    def read_one(repo: str) -> tuple[dict[int, str], set[int], str]:
        """Return the bodies and the open numbers of one repository.

        The empty string is the reason the text is unknown: a repository
        whose list could not be read leaves its text unknown, and the
        caller says so instead of reading it as empty."""
        try:
            raw = run(
                [
                    GH,
                    "issue",
                    "list",
                    "-R",
                    repo,
                    "--state",
                    "open",
                    "--limit",
                    str(ISSUE_LIMIT),
                    "--json",
                    "number,title,body",
                ],
                GH_TIMEOUT,
                deadline,
                optional=True,
            )
        except (RepoError, ValueError) as exc:
            emit(f"overnight: {repo}: {exc}", err=True)
            return {}, set(), str(exc)
        if raw is None:
            return {}, set(), "the open issue list could not be read"
        try:
            rows = json.loads(raw)
        except ValueError as exc:
            emit(f"overnight: {repo}: {exc}", err=True)
            return {}, set(), str(exc)
        if not isinstance(rows, list):
            return {}, set(), "the open issue list did not return a list"
        if len(rows) >= ISSUE_LIMIT:
            emit(
                f"overnight: {repo}: the open issue list was cut off at "
                f"{ISSUE_LIMIT}, so the ticket text is not known",
                err=True,
            )
            return {}, set(), "the open issue list was cut off"
        found: dict[int, str] = {}
        numbers: set[int] = set()
        for row in rows:
            number = row.get("number")
            if isinstance(number, int):
                numbers.add(number)
                if number in wanted[repo]:
                    found[number] = (row.get("body") or "") + "\n" + (
                        row.get("title") or ""
                    )
        return found, numbers, ""

    # The repositories are read at the same time: one stalled repository
    # must not cost the tick a timeout for every repository in turn.
    with ThreadPoolExecutor(max_workers=6) as pool:
        futures = {
            repo: pool.submit(read_one, repo) for repo in sorted(wanted)
        }
        for repo, future in futures.items():
            found, numbers, reason = future.result()
            if reason:
                unread.append(repo)
                continue
            for number, text in found.items():
                bodies[(repo, number)] = text
            open_numbers[repo] = numbers
    return bodies, unread, open_numbers


def read_decisions() -> tuple[Path, list[str]]:
    """Return the coordinator's decisions log and its lines.

    The log is the coordinator's own parking lot, so it is read where the
    tick reads it. A missing log is not a crash: the filter drops every
    ticket it cannot check and refuses to return a list."""
    try:
        with open(DECISIONS_FILE) as stream:
            return DECISIONS_FILE, stream.read().splitlines()
    except OSError:
        return DECISIONS_FILE, []


def read_decisions_checked() -> tuple[Path, list[str], str]:
    """Return the decisions log, its lines and why it could not be read.

    A log that does not exist yet is not an error: the coordinator writes
    it the first time it parks a ticket. A log that exists and cannot be
    read is an error, because the tickets it parks are then not known."""
    try:
        with open(DECISIONS_FILE) as stream:
            return DECISIONS_FILE, stream.read().splitlines(), ""
    except FileNotFoundError:
        return DECISIONS_FILE, [], ""
    except OSError as exc:
        return DECISIONS_FILE, [], f"the log could not be read: {exc}"


def mark_reason(text: str) -> tuple[str, str] | None:
    """Return the mark a ticket body carries, with the line that carries it.

    A mark stands at the start of a line or of a clause, so a ticket that
    only talks about holding a position, or about a decision that needs
    Shyam later, is not marked."""
    for pattern, reason in (
        (HOLD_MARK, "marked hold"),
        (NEEDS_SHYAM_MARK, "marked needs Shyam"),
        (DESIGN_MARK, "marked design needed"),
    ):
        match = pattern.search(text)
        if match:
            start = text.rfind("\n", 0, match.start()) + 1
            end = text.find("\n", match.start())
            line = text[start : end if end != -1 else len(text)]
            return reason, clip(line)
    return None


def names_ticket(line: str, key: str | None, number: int | None) -> bool:
    """Return True when a decisions log line is about this ticket.

    A line is about a ticket when it names the ticket with its issue
    number, in either order ("SRW-685 #468", "#468 SRW-685", and the
    short form "685 #468"), or when the ticket is named right after the
    line's verb ("HOLD SRW-685", "OPEN (needs answer): SRW-1080 #990").
    A ticket named in passing ("once SRW-1067 merges") is not the subject
    of the line. A bare issue number is not enough: the same number can
    belong to a ticket in another repository."""
    if not key or not number:
        return False
    prefix, _, keynum = key.partition("-")
    if not prefix or not keynum:
        return False
    pairs = (
        rf"{re.escape(prefix)}-{re.escape(keynum)}\s*#\s*{number}\b",
        rf"#\s*{number}\s+{re.escape(prefix)}-{re.escape(keynum)}\b",
        rf"\b{re.escape(keynum)}\s*#\s*{number}\b",
    )
    for pattern in pairs:
        if re.search(pattern, line, re.I):
            return True
    for verb in DECISION_VERB.finditer(line):
        tail = line[verb.end() : verb.end() + SUBJECT_TAIL]
        if re.search(rf"\b{re.escape(prefix)}-{re.escape(keynum)}\b", tail, re.I):
            return True
    return False


def decision_reason(
    lines: list[str], key: str | None, number: int | None
) -> tuple[str, str] | None:
    """Return the open question a decisions log leaves for a ticket.

    The log is append-only history, so the last line that is about the
    ticket decides. The log writes an open item as a hold or a park
    ("HOLD SRW-685", "PARKED (needs Shyam)"), as "OPEN (needs answer)",
    as "Q: ...", or as a question that ends in a question mark. A line
    that answers the question closes it, but a hold outlives the question
    it was asked in."""
    last = None
    for line in lines:
        if names_ticket(line, key, number):
            last = line
    if last is None:
        return None
    if DECISION_HOLD.search(last):
        return "hold in the decisions log", clip(last)
    if DECISION_OPEN.search(last):
        return "open item in the decisions log", clip(last)
    if DECISION_STRONG.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_ASKS.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_ASKED.search(last) and not DECISION_CLOSED.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_QUESTION.search(last) and not DECISION_CLOSED.search(last):
        return "open question in the decisions log", clip(last)
    return None


def filter_issues(
    issues: list[dict],
    allowed: set[str],
    flagged: set[str],
    bodies: dict[tuple[str, int], str],
    lines: list[str],
) -> tuple[list[dict], list[tuple[dict, str]]]:
    """Return the tickets that survive the filter and the drops with their
    reasons.

    The rules are the spec's drop list: Ascend work, a repository off the
    allow list, a ticket marked hold, needs Shyam or design needed, and a
    ticket with an open question in the coordinator's decisions log. A
    ticket whose text could not be read is dropped, never kept: the filter
    fails closed."""
    kept: list[dict] = []
    drops: list[tuple[dict, str]] = []
    for issue in issues:
        repo = issue.get("repo") or ""
        key = issue.get("key") or ""
        number = issue.get("number")
        reason = ascend_reason(repo, key, repo in flagged)
        if reason is None and repo not in allowed:
            reason = f"repo not on the allow list: {repo}"
        body = bodies.get((repo, number))
        if reason is None and body is not None:
            mark = mark_reason(body)
            if mark:
                reason = f"{mark[0]}: {mark[1]}"
        if reason is None:
            found = decision_reason(lines, key, number)
            if found:
                reason = f"{found[0]}: {found[1]}"
        if reason is None and body is None:
            reason = "unverified: the ticket text could not be read"
        if reason is None and not lines:
            reason = "unverified: the decisions log could not be read"
        if reason:
            drops.append((issue, reason))
        else:
            kept.append(issue)
    return kept, drops


def cmd_filter(args: argparse.Namespace) -> int:
    """Filter the board and print every drop with its reason.

    The filter fails closed. A ticket whose text could not be read, or
    whose open question could not be checked, is dropped rather than
    kept, and the command exits non-zero so the shift knows the list it
    printed is not one it may work from."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    if stale:
        emit("Overnight filter - dry run (read only)")
        emit("REFUSED: the board list is stale, so the filter cannot be trusted.")
        emit("The ticket CLI could not reach GitHub and fell back to its cache.")
        return 1
    bodies, unread, _open = read_bodies(issues, deadline)
    path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {path} could not be read")
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    emit("Overnight filter - dry run (read only)")
    emit(f"Board: {len(issues)} tickets")
    emit(f"Allowed repositories: {len(repos)}")
    emit(f"Decisions log: {path}" + ("" if lines else " (not found)"))
    for problem in problems:
        emit(f"REFUSED: {problem}")
    emit()
    emit(f"Kept: {len(kept)}")
    emit(f"Dropped: {len(drops)}")
    outside = sorted({issue.get("repo") or "" for issue in issues} - allowed)
    emit(f"Board repositories outside the allow list: {len(outside)}")
    if drops:
        emit()
        emit("Drops (each with its reason)")
        for issue, reason in drops:
            key = issue.get("key") or "-"
            emit(
                f"  DROP {issue.get('repo')}#{issue.get('number')} {key} - {reason}"
            )
    emit()
    survived = [
        issue
        for issue in kept
        if ascend_reason(
            issue.get("repo") or "",
            issue.get("key") or "",
            (issue.get("repo") or "") in flagged,
        )
    ]
    emit(f"Ascend items kept: {len(survived)}")
    if survived:
        for issue in survived:
            emit(f"  FAIL {issue.get('repo')}#{issue.get('number')}")
        emit("FAIL: an Ascend item survived the filter.")
        return 1
    if problems:
        emit("REFUSED: the filter cannot return a list it could not fully check.")
        return 1
    return 0


def cmd_check_pr(args: argparse.Namespace) -> int:
    """Refuse any pull request that is Ascend work.

    This is the second check the spec asks for: intake drops Ascend work
    from the board, and this refuses an Ascend pull request before any
    work starts on it. The check fails closed: a pull request it could
    not read is refused, not passed."""
    deadline = time.monotonic() + args.deadline
    repo = args.repo
    number = args.number
    cfg = load_config()
    reason = ascend_reason(repo, None, repo in ascend_flags(cfg))
    if reason:
        emit(f"REFUSED: {repo}#{number}: {reason}")
        return 1
    try:
        raw = run(
            [
                GH,
                "pr",
                "view",
                str(number),
                "-R",
                repo,
                "--json",
                "headRefName,body",
            ],
            GH_TIMEOUT,
            deadline,
        )
        pull = json.loads(raw) or {}
    except (RepoError, ValueError) as exc:
        emit(f"overnight: {repo}#{number}: {exc}", err=True)
        emit(
            f"REFUSED: {repo}#{number}: the pull request could not be read, "
            "so the check cannot be trusted."
        )
        return 1
    branch = pull.get("headRefName") or ""
    body = pull.get("body") or ""
    keys = ascend_keys_in(branch)
    for key in ascend_keys_in(body):
        if key not in keys:
            keys.append(key)
    if keys:
        emit(f"REFUSED: {repo}#{number}: Ascend key {keys[0]}")
        if branch:
            emit(f"  branch {branch}")
        return 1
    emit(f"OK: {repo}#{number} is not an Ascend pull request")
    return 0

# --- Part T3c: the order --------------------------------------------------

# The T3 client. The gate verdict lives in a T3 thread, so the shift
# reads T3 for the same reason the coordinator's panel does.
T3MCP = os.environ.get("OVERNIGHT_T3MCP", "t3mcp")
T3_TIMEOUT = 60
# The coordinator's queue folder. The gate dispatches are recorded there,
# so the shift finds the gate thread of a pull request without guessing.
COORDQ_DIR = os.environ.get(
    "COORDQ_DIR", str(Path.home() / "Code" / "coordinator" / "queue")
)
# The dispatch receipts: a request id to its T3 thread. A gate request is
# "gate:<repo>#<pull request>:<head sha>", so the receipt names the head
# the gate looked at.
RECEIPTS_FILE = "dispatch-receipts.json"
# The queue's own file. It names every head a gate was queued for, so the
# coordinator never gates one head twice.
QUEUE_FILE = "queue.json"
# The board key in a thread's title. The builder threads are titled
# "<key> · <title>", so the key says which ticket a live thread owns.
THREAD_KEY = re.compile(r"^([A-Za-z]{2,5}-\d+)\s*[·:\-]")
# The marked forms of a ticket that is already a 5-minute part. The board
# writes them in the ticket's own words: a light build slice, a light
# chore, or a part that says how many minutes it takes.
SPLIT_MARK = re.compile(
    r"(?i)\b(?:light build slice|light chore|5[- ]minute (?:builder )?part)\b"
    r"|\bbudget\b[^.\n]{0,40}\bto 5 minutes\b"
)
# A check that failed, or that can no longer pass, makes its pull request
# a failing pull request.
FAILED_CHECK = frozenset(
    {
        "FAILURE",
        "FAIL",
        "ERROR",
        "TIMED_OUT",
        "ACTION_REQUIRED",
        "STARTUP_FAILURE",
    }
)
# How a commit status ended, in the words the checks command used.
STATUS_BUCKET = {
    "SUCCESS": "pass",
    "FAILURE": "fail",
    "ERROR": "fail",
    "PENDING": "pending",
    "EXPECTED": "skipping",
}
# How a check run ended. A cancelled run is inconclusive, so it is
# skipped, and a timed out run failed.
CHECK_BUCKET = {
    "SUCCESS": "pass",
    "FAILURE": "fail",
    "ACTION_REQUIRED": "fail",
    "TIMED_OUT": "fail",
    "STARTUP_FAILURE": "fail",
    "CANCELLED": "skipping",
    "SKIPPED": "skipping",
    "NEUTRAL": "skipping",
    "STALE": "skipping",
}
# The board's stage labels. A ready ticket is one the board says may be
# worked now.
READY_STAGE = "todo"
# The "Blocked by" section of a ticket's own text. The section is a
# heading of any level (`## Blocked by`) or a `Blocked by:` line with the
# list under it, the same markers the coordinator's own reader accepts.
BLOCKED_HEADING = re.compile(
    r"(?i)^(?P<hashes>#{1,6})[ \t]*blocked by\b[ \t]*:?[ \t]*(?P<rest>.*)$"
)
HEADING_LINE = re.compile(r"^#{1,6}[ \t]")
# The key of an issue, taken from its title: "SRW-1055 · ..." is SRW-1055.
TITLE_KEY = re.compile(r"^([A-Za-z][A-Za-z0-9]*)-(\d+)\b")
# A reference in a blocker section: a board key of this repository, a
# reference to another repository's issue, or a bare issue number.
BLOCK_KEY = re.compile(r"\b([A-Za-z]{2,5})-(\d+)\b")
BLOCK_REPO = re.compile(r"\b([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)\b")
BLOCK_BARE = re.compile(r"(?<![A-Za-z0-9_/-])#(\d+)\b")


def blocked_by_text(body: str) -> str:
    """Return the text of the ticket's own "Blocked by" section.

    The section is a heading of any level (`## Blocked by`) with the text
    under it, or a `Blocked by:` line with the list under the line. A
    section inside a `<details>` block is skipped, the way the
    coordinator's own reader skips it, because the board keeps a
    preserved contract in there."""
    cleaned = re.sub(r"(?is)<details\b.*?</details>", "", body or "")
    lines = cleaned.splitlines()
    for index, line in enumerate(lines):
        heading = BLOCKED_HEADING.match(line)
        if not heading:
            continue
        level = len(heading.group("hashes") or "")
        rest = (heading.group("rest") or "").strip()
        content = [rest] if rest else []
        for follow in lines[index + 1 :]:
            if level:
                if HEADING_LINE.match(follow):
                    break
                content.append(follow)
                continue
            text = follow.strip()
            if not text:
                content.append(follow)
                continue
            if not (follow[:1].isspace() or text[0] in "-*+"):
                break
            content.append(follow)
        body_text = re.sub(r"<!--.*?-->", "", "\n".join(content), flags=re.S)
        return body_text.strip()
    return ""


def issue_title_key(title: str) -> str:
    """Return the board key an issue title starts with, or nothing."""
    found = TITLE_KEY.match(title or "")
    if not found:
        return ""
    return f"{found.group(1).upper()}-{found.group(2)}"


def read_blocker_states(
    repo: str, numbers: set[int], deadline: float
) -> tuple[set[int], str]:
    """Return the closed numbers among the blockers a ticket names, and the
    reason the answer is not known.

    Only the blockers are read, a hundred to the query, so the shift no
    longer walks a repository's whole closed list. The first reason is
    kept: a blocker whose state is unread is not a met blocker."""
    owner, name = (repo.split("/") + [""])[:2]
    closed: set[int] = set()
    reason = ""
    ordered = sorted(numbers)
    for start in range(0, len(ordered), 100):
        chunk = ordered[start : start + 100]
        query = (
            "query BlockerStates { repository(owner: %s, name: %s) { "
            % (json.dumps(owner), json.dumps(name))
        ) + " ".join(
            f"i{n}: issue(number: {n}) {{ number state title }}" for n in chunk
        ) + " } }"
        try:
            raw = run(
                [GH, "api", "graphql", "-f", f"query={query}"],
                GH_TIMEOUT,
                deadline,
                optional=True,
            )
        except RepoError as exc:
            raw = exc.stdout
        try:
            repository = json.loads(raw or "")["data"]["repository"]
        except (ValueError, KeyError, TypeError):
            repository = None
        if not isinstance(repository, dict):
            if not reason:
                reason = f"{repo}: the blocker states could not be read"
            continue
        for value in repository.values():
            if not isinstance(value, dict):
                continue
            number = value.get("number")
            if value.get("state") == "CLOSED" and isinstance(number, int):
                closed.add(number)
    return closed, reason


def read_closed_keys(
    repo: str, keys: set[str], deadline: float
) -> set[str]:
    """Return the blocker keys that name a closed issue of the repository.

    A key is not an issue number, so each one is searched in the closed
    titles. A key whose search fails is not found, and a blocker that is
    not found closed is not a met blocker."""
    found: set[str] = set()
    for key in sorted(keys):
        try:
            raw = run(
                [
                    GH,
                    "issue",
                    "list",
                    "-R",
                    repo,
                    "--state",
                    "closed",
                    "--search",
                    f'"{key}" in:title',
                    "--limit",
                    "20",
                    "--json",
                    "number,title",
                ],
                GH_TIMEOUT,
                deadline,
                optional=True,
            )
        except RepoError:
            continue
        if raw is None:
            continue
        try:
            rows = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(rows, list):
            continue
        for row in rows:
            if issue_title_key(row.get("title") or "") == key:
                found.add(key)
                break
    return found


def named_blockers(
    body: str,
    repo: str,
    key: str,
    open_here: set[int],
    board_by_key: dict[str, dict],
) -> tuple[set[int], set[str]]:
    """Return the blocker numbers and the blocker keys a ticket names.

    The three reference forms are read the way `blockers_for` reads them,
    so only what a ticket names is looked up: a blocker the board already
    shows open needs no read, and a key the board does not show is
    searched in the closed titles."""
    text = blocked_by_text(body or "")
    if not text:
        return set(), set()
    first = text.splitlines()[0].strip().lower().rstrip(".:")
    if first in ("none", "n/a", "nil", "-"):
        return set(), set()
    numbers: set[int] = set()
    keys: set[str] = set()
    masked = BLOCK_REPO.sub(" ", text)
    for match in BLOCK_REPO.finditer(text):
        if match.group(1).lower() != repo.lower():
            continue
        number = int(match.group(2))
        if number not in open_here:
            numbers.add(number)
    for match in BLOCK_KEY.finditer(masked):
        label = f"{match.group(1).upper()}-{match.group(2)}"
        if not label.startswith((key or " ").upper()):
            continue
        ticket = board_by_key.get(label)
        if ticket is None:
            keys.add(label)
            continue
        number = ticket.get("number")
        if isinstance(number, int) and number not in open_here:
            numbers.add(number)
    for match in BLOCK_BARE.finditer(masked):
        number = int(match.group(1))
        if number not in open_here:
            numbers.add(number)
    return numbers, keys


def read_checks(repo: str, number: int, deadline: float) -> tuple[list[dict], str]:
    """Return the checks of one pull request and the reason none are known.

    `gh pr view` reads the checks of a pull request as a rollup. A commit
    status carries its context, and a check run carries the app that ran
    it. The board keeps both, because an agent check is named by the
    repository's own publisher and every other check is external.

    A pull request that carries no checks at all is not a failing pull
    request: the rollup is empty and that is an answer. A read that fails
    is a refusal, never a failure."""
    left = deadline - time.monotonic()
    if left <= 0:
        return [], "the deadline passed before the checks could be read"
    try:
        result = subprocess.run(
            [
                GH,
                "pr",
                "view",
                str(number),
                "-R",
                repo,
                "--json",
                "statusCheckRollup",
            ],
            capture_output=True,
            text=True,
            timeout=max(1, min(GH_TIMEOUT, int(left))),
            check=False,
        )
    except FileNotFoundError:
        return [], f"{GH} is not on PATH"
    except subprocess.TimeoutExpired:
        return [], f"gh pr view {repo}#{number} timed out"
    out = (result.stdout or "").strip()
    err = (result.stderr or "").strip()
    if result.returncode != 0:
        return [], (
            f"gh pr view {repo}#{number} failed ({result.returncode}): "
            + (err or out)[-200:]
        )
    try:
        payload = json.loads(out or "{}")
    except ValueError as exc:
        return [], f"gh pr view did not return JSON for {repo}#{number}: {exc}"
    entries = (
        payload.get("statusCheckRollup") if isinstance(payload, dict) else None
    )
    if not isinstance(entries, list):
        return [], f"gh pr view returned no check rollup for {repo}#{number}"
    return check_rows(entries), ""


def check_rows(entries: list) -> list[dict]:
    """Return the rollup of a pull request as check rows.

    Every row keeps its name, its context, its app, its state and its
    bucket. The name says which check it is, the context is the status
    name, and the app is the publisher that posted it. The state and the
    bucket say how the check ended, in the same words the checks command
    used: `fail`, `pass`, `pending` and `skipping`."""
    rows = []
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        context = str(entry.get("context") or "")
        name = str(entry.get("name") or "") or context
        state = str(entry.get("state") or "").upper()
        bucket = STATUS_BUCKET.get(state, "") if context else ""
        if not context:
            status = str(entry.get("status") or "").upper()
            conclusion = str(entry.get("conclusion") or "").upper()
            if status == "COMPLETED":
                state = conclusion
                bucket = CHECK_BUCKET.get(conclusion, "")
            else:
                state = ""
                bucket = "pending"
        app = ""
        publisher = entry.get("app")
        if isinstance(publisher, dict):
            app = str(publisher.get("slug") or publisher.get("name") or "")
        rows.append(
            {
                "name": name,
                "context": context,
                "app": app,
                "state": state,
                "bucket": bucket,
            }
        )
    return rows


def agent_check_names(key: str) -> frozenset[str]:
    """Return the agent check names of one repository.

    `srw/agent-check` is the agent check of strategy-replay-workbench, and
    `<key>/agent-check` is the same name for the other repositories. The
    gate reads these names, so the board copies them instead of inventing
    a wider rule of its own."""
    names = {AGENT_CHECK}
    if key:
        names.add(f"{key.strip().lower()}/agent-check")
    return frozenset(names)


def publisher_apps(rows: list[dict], agent_names: frozenset[str]) -> frozenset[str]:
    """Return the apps that publish a repository's own agent check.

    A check that one of these apps posted is an agent check, whatever its
    name says."""
    apps = set()
    for row in rows:
        if str(row.get("context") or "").strip().lower() not in agent_names:
            continue
        app = str(row.get("app") or "").strip().lower()
        if app:
            apps.add(app)
    return frozenset(apps)


def is_agent_check(
    row: dict, agent_names: frozenset[str], apps: frozenset[str]
) -> bool:
    """Return True when a check row is one of the repository's own checks.

    The agent check is the status the repository's own publisher posts on
    the head. Every other check is external: a deployment, a preview or a
    bot, none of which is an agent check of this repository."""
    for field in ("name", "context"):
        if str(row.get(field) or "").strip().lower() in agent_names:
            return True
    app = str(row.get("app") or "").strip().lower()
    return bool(app) and app in apps


def failing_checks(
    rows: list[dict], agent_names: frozenset[str], apps: frozenset[str]
) -> tuple[list[str], list[str]]:
    """Return the failing agent checks and the failing external checks.

    A cancelled check is inconclusive, not a failure, so it does not put
    the pull request in the failing group. An external check never blocks
    a pull request, but it is listed, so the failure stays visible."""
    agent_failed: list[str] = []
    external_failed: list[str] = []
    for row in rows:
        state = str(row.get("state") or "").upper()
        bucket = str(row.get("bucket") or "").upper()
        if state not in FAILED_CHECK and bucket not in FAILED_CHECK:
            continue
        if is_agent_check(row, agent_names, apps):
            agent_failed.append(f"{row.get('name') or '?'} ({state or bucket})")
            continue
        name = str(row.get("name") or "?").strip() or "?"
        if name not in external_failed:
            external_failed.append(name)
    return agent_failed, external_failed


def check_verdict(rows: list[dict], key: str) -> dict:
    """Return what the checks of one pull request say.

    `failed` are the failing agent checks, and they block the pull
    request. `external` are the failing checks that are not agent checks:
    they stay visible and never block."""
    names = agent_check_names(key)
    apps = publisher_apps(rows, names)
    failed, external = failing_checks(rows, names, apps)
    return {"failed": failed, "external": external, "blocks": bool(failed)}


def apply_checks(item: dict, rows: list[dict], key: str) -> bool:
    """Record the checks of a pull request on its board item.

    The item keeps the failing agent checks and the failing external
    checks. The answer is True when an agent check failed, and only then:
    an external failure stays visible but never blocks a pull request."""
    state = check_verdict(rows, key)
    item["checks"] = {"failed": state["failed"]}
    item["externalChecks"] = state["external"]
    return state["blocks"]


def read_receipts() -> tuple[dict[str, str], str]:
    """Return every dispatch receipt and the reason they are not known.

    The receipts are the queue's own record of what it dispatched. A
    receipt file that cannot be read is not a pass: the shift then calls
    no pull request gate PASS, and says so."""
    path = Path(COORDQ_DIR) / RECEIPTS_FILE
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        return {}, f"the dispatch receipts {path} could not be read: {exc}"
    if not isinstance(data, dict):
        return {}, f"the dispatch receipts {path} are not a mapping"
    return {str(key): str(value) for key, value in data.items()}, ""


def read_gate_receipts() -> tuple[dict[str, str], str]:
    """Return the gate dispatch receipts and the reason they are unknown."""
    receipts, error = read_receipts()
    if error:
        return {}, error
    return {
        key: value
        for key, value in receipts.items()
        if key.startswith("gate:")
    }, ""


def read_queue_state() -> dict:
    """Return the queue's own record: the gated heads and the queued tickets.

    The queue names every head it queued a gate for, queued or dispatched,
    so a head in it is a head the coordinator must not gate a second time.
    It names every ticket it holds too, so the coordinator does not start
    a ticket that is already on its way."""
    path = Path(COORDQ_DIR) / QUEUE_FILE
    state: dict = {
        "gatedHeads": set(),
        "queuedTickets": set(),
        "fixedHeads": {},
        "error": "",
    }
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        state["error"] = f"the queue {path} could not be read: {exc}"
        return state
    if not isinstance(data, dict):
        state["error"] = f"the queue {path} is not a mapping"
        return state
    heads = data.get("gatedHeads")
    if isinstance(heads, dict):
        state["gatedHeads"] = {str(key) for key in heads}
    for item in data.get("items") or []:
        if not isinstance(item, dict):
            continue
        args = item.get("args") or {}
        request_id = str(args.get("clientRequestId") or "")
        if request_id.startswith("ticket:"):
            state["queuedTickets"].add(request_id)
    fixed = data.get("fixedHeads")
    if isinstance(fixed, dict):
        state["fixedHeads"] = {
            str(key): str(value) for key, value in fixed.items()
        }
    return state


def fix_tries(queue_state: dict, repo: str, number: object) -> int:
    """Return how many times findings were sent back for one pull request.

    The queue records every fix it sent under the head it was sent for, so
    one key is one fix try. The count is the queue's own record: the shift
    keeps no count of its own."""
    heads = queue_state.get("fixedHeads") or {}
    prefix = f"fix:{repo}#{number}:"
    return sum(1 for key in heads if str(key).startswith(prefix))


def builder_thread(receipts: dict[str, str], repo: str, number: int) -> tuple[str, int]:
    """Return the builder thread of a ticket and the attempt that built it.

    The receipts name the thread of every attempt the coordinator started,
    so the last attempt is the builder that holds the work. A ticket with
    no attempt has no builder."""
    prefix = f"ticket:{repo}#{number}:a"
    thread = ""
    attempt = 0
    for key, value in receipts.items():
        if not key.startswith(prefix):
            continue
        try:
            number_of_attempt = int(key[len(prefix) :])
        except ValueError:
            continue
        if number_of_attempt > attempt:
            thread = value
            attempt = number_of_attempt
    return thread, attempt


def latest_run_id(data: dict) -> str:
    """Return the id of the thread's latest run, or nothing.

    The queue dispatches a gate for the same head under the same request
    id, so one thread can hold more than one run. The verdict of a thread
    is the verdict of its latest run: an earlier run's verdict does not
    survive a later one."""
    best = None
    for run in data.get("recentRuns") or []:
        if not isinstance(run, dict):
            continue
        ordinal = run.get("ordinal")
        if not isinstance(ordinal, int):
            continue
        if best is None or ordinal > best.get("ordinal", -1):
            best = run
    return str(best.get("runId") or "") if best else ""


def check_line_passes(lines: list[str], head: str) -> bool:
    """Return True when the gate checked this head and it passed.

    The gate's own rule is `CHECK: PASS <head>` before the verdict, so a
    verdict without that line is a verdict for a head nobody checked."""
    return f"CHECK: PASS {head}" in lines


def read_gate_report(
    thread_id: str, deadline: float, head: str = ""
) -> tuple[str, str, str]:
    """Return the verdict, the report and the update time of a gate thread.

    The verdict is the last line of the gate's own last message in the
    thread's latest run. A thread that cannot be read, a latest run with
    no message, and a message that ends with anything else, are all no
    verdict. When the head is known, the gate must also have checked that
    head: the line `CHECK: PASS <head>` has to be there. The report is
    that same message: it holds the findings the builder has to fix."""
    payload = json.dumps({"threadId": thread_id, "maxCharsPerItem": 20000})
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
    except RepoError:
        return "", "", ""
    try:
        data = json.loads(raw)
    except ValueError:
        return "", "", ""
    thread = data.get("thread") or {}
    updated = str(thread.get("updatedAt") or "")
    items = data.get("items") or []
    run_id = latest_run_id(data)
    texts = [
        item.get("text") or ""
        for item in items
        if item.get("type") == "assistant_message"
        and (not run_id or str(item.get("runId") or "") == run_id)
    ]
    if not texts:
        return "", "", updated
    text = texts[-1]
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    report = text
    if not lines:
        return "", report, updated
    if lines[-1] == "VERDICT: PASS":
        if head and not check_line_passes(lines, head):
            return "", report, updated
        return "PASS", report, updated
    if lines[-1] == "VERDICT: FAIL":
        return "FAIL", report, updated
    return "", report, updated


def read_verdict(thread_id: str, deadline: float) -> str:
    """Return the verdict of one gate thread: PASS, FAIL or nothing."""
    return read_gate_report(thread_id, deadline)[0]


def read_live_threads(deadline: float) -> dict:
    """Return the live threads: the board keys they own and their ids.

    A live builder owns its ticket, so the coordinator must not start it a
    second time. The keys come from the threads' own titles."""
    state: dict = {"keys": set(), "ids": set(), "error": ""}
    payload = json.dumps(
        {
            "allProjects": True,
            "statuses": ["running", "starting", "preparing", "queued"],
            "limit": 100,
        }
    )
    try:
        raw = run([T3MCP, "call", "t3_thread_list", payload], T3_TIMEOUT, deadline)
    except RepoError:
        state["error"] = "the live threads could not be read"
        return state
    try:
        data = json.loads(raw)
    except ValueError:
        state["error"] = "the live threads could not be read"
        return state
    for thread in data.get("threads") or []:
        thread_id = str(thread.get("threadId") or "")
        if thread_id:
            state["ids"].add(thread_id)
        title = str(thread.get("title") or "")
        match = THREAD_KEY.match(title)
        if match:
            state["keys"].add(match.group(1).upper())
    return state


def read_thread_messages(
    thread_id: str, deadline: float
) -> tuple[str, list[str], int]:
    """Return when a thread was last updated, what it said and how long it ran.

    The texts are the thread's own messages, so a caller can tell whether
    a message it wants to send was already sent. The minutes are the
    thread's own run time, from its created and updated times, so the
    budget reads a number the coordinator measured and not a claim."""
    payload = json.dumps(
        {"threadId": thread_id, "maxCharsPerItem": 20000, "runLimit": 50}
    )
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
        data = json.loads(raw)
    except (RepoError, ValueError):
        return "", [], 0
    thread = data.get("thread") or {}
    updated = str(thread.get("updatedAt") or "")
    texts = [
        item.get("text") or ""
        for item in (data.get("items") or [])
        if item.get("type") == "assistant_message"
    ]
    minutes = builder_minutes(data)
    return updated, texts, minutes


def shell_quote(text: str) -> str:
    """Return text as one shell word."""
    return "'" + text.replace("'", "'\"'\"'") + "'"


def gate_verdict(
    receipts: dict[str, str], repo: str, number: int, head: str, deadline: float
) -> str:
    """Return the gate verdict for one pull request head.

    The receipt names the head the gate looked at, so a gate for an older
    head is not a verdict for this one. A receipt without a verdict is no
    verdict: the shift never calls a pull request gate PASS it cannot read
    from the gate itself."""
    if not head:
        return ""
    thread_id = receipts.get(f"gate:{repo}#{number}:{head}")
    if not thread_id:
        return ""
    return read_gate_report(thread_id, deadline, head)[0]


def blockers_for(
    body: str,
    repo: str,
    key: str,
    open_numbers: dict[str, set[int]],
    closed_numbers: dict[str, set[int]],
    closed_keys: dict[str, set[str]],
    board_by_key: dict[str, dict],
) -> list[str]:
    """Return the blockers of a ticket that are not met yet.

    A blocker is met when its issue is closed, so it is neither on the
    open issue list nor missing from the closed one. A blocker that
    cannot be checked is not a met blocker: the shift does not treat work
    as free it cannot prove."""
    text = blocked_by_text(body or "")
    if not text:
        return []
    first = text.splitlines()[0].strip().lower().rstrip(".:")
    if first in ("none", "n/a", "nil", "-"):
        return []
    open_here = open_numbers.get(repo, set())
    closed_here = closed_numbers.get(repo, set())
    closed_key_here = closed_keys.get(repo, set())
    blockers: list[str] = []
    masked = BLOCK_REPO.sub(" ", text)
    for match in BLOCK_REPO.finditer(text):
        target_repo, number = match.group(1), int(match.group(2))
        if target_repo.lower() != repo.lower():
            blockers.append(f"{target_repo}#{number} (not checked)")
        elif number in open_here:
            blockers.append(f"{target_repo}#{number} is still open")
        elif number not in closed_here:
            blockers.append(f"{target_repo}#{number} could not be read")
    for match in BLOCK_KEY.finditer(masked):
        label = f"{match.group(1).upper()}-{match.group(2)}"
        if not label.startswith((key or " ").upper()):
            continue
        if label in closed_key_here:
            continue
        ticket = board_by_key.get(label)
        if ticket is None:
            blockers.append(f"{label} could not be read")
        elif ticket.get("number") in open_here:
            blockers.append(f"{label} (#{ticket.get('number')}) is still open")
        elif ticket.get("number") not in closed_here:
            blockers.append(f"{label} could not be read")
    for match in BLOCK_BARE.finditer(masked):
        number = int(match.group(1))
        if number in open_here:
            blockers.append(f"{repo}#{number} is still open")
        elif number not in closed_here:
            blockers.append(f"{repo}#{number} could not be read")
    return blockers


def order_key(item: dict) -> tuple:
    """Return the sort key of one item of the ordered list.

    Priority comes first: Shyam steers the night through the priority
    label. A blocked item waits for its blocker, so it follows the items
    that are ready. The repository and the issue number break the tie, so
    the same board always produces the same list. A blocked item is not
    left out: it stays in its group and is marked, so the night sees it
    and knows why it waits."""
    priority = item.get("priority")
    number = priority if isinstance(priority, int) else 99
    return (number, 1 if item.get("blockers") else 0, item.get("repo") or "",
            item.get("number") or 0)


def summarize(counts: dict[str, dict]) -> str:
    """Return the one-line summary of the order, per repository and state.

    Every state the order knows is counted, so the line says how many
    items are failing, gate-pass, split, unsplit, in flight and not
    ready. A count that could not be checked is written as UNVERIFIED by
    the caller, never as a zero."""
    parts = []
    for repo in sorted(counts):
        row = counts[repo]
        if not (row["total"] or row["in_flight"] or row["backlog"]):
            continue
        parts.append(
            f"{repo} {row['total']} (failing {row['failing']}, "
            f"gate-pass {row['gate']}, split {row['split']}, "
            f"unsplit {row['unsplit']}, in-flight {row['in_flight']}, "
            f"not-ready {row['backlog']})"
        )
    return "; ".join(parts) if parts else "no items"


def write_shift_line(root: Path, line: str) -> Path:
    """Append one line to the shift log and return the file.

    The shift log is the night's record, one line per event. It holds no
    list: the board is the list."""
    if not root.is_dir():
        die(
            f"the overnight folder {root} does not exist, so the shift log "
            "cannot be written"
        )
    path = root / "run" / "shift-log.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(PT).strftime("%Y-%m-%d %I:%M %p PT")
    append_record(path, f"{stamp} | {line}\n")
    return path


def read_all_checks(
    pairs: list[tuple[str, int]], deadline: float
) -> dict[tuple[str, int], tuple[list[dict], str]]:
    """Return the checks of every pull request, read at once.

    One call reads one pull request's checks and the board holds many open
    pull requests, so the calls run together: the board is read in
    seconds, not in minutes."""
    results: dict[tuple[str, int], tuple[list[dict], str]] = {}
    if not pairs:
        return results
    with ThreadPoolExecutor(max_workers=6) as pool:
        futures = {
            pair: pool.submit(read_checks, pair[0], pair[1], deadline)
            for pair in pairs
        }
        for pair, future in futures.items():
            try:
                results[pair] = future.result()
            except RepoError as exc:
                results[pair] = ([], str(exc))
    return results


def collect_items(
    deadline: float,
    repos: list[tuple[str, str]],
    issues: list[dict],
    bodies: dict[tuple[str, int], str],
    open_numbers: dict[str, set[int]],
    drops: list[tuple[dict, str]],
    receipts: dict[str, str],
    budget: dict | None = None,
) -> dict:
    """Return the board's items in the order the shift works them.

    This is the one order: `order` prints it and `board` returns it, so
    the day tick and the night shift work the same list. Every pull
    request carries its head, the gate that looked at it and the builder
    that holds it, and every ready ticket carries the one action the
    coordinator may take on it now, so no caller has to look a second
    time.

    The budget is the per-item builder-time budget (part T8a). It holds
    the work back here: an item that used its fix tries, or that is over
    its hard builder-time budget, gets no fix action, so the shift never
    spends a third fix on it."""
    budget = normalise_budget(budget)
    allowed = {repo for repo, _ in repos}
    keys = {repo: key for repo, key in repos}
    pull_requests: dict[str, list[dict]] = {}
    pr_error = ""
    with ThreadPoolExecutor(max_workers=6) as pool:
        futures = {
            repo: pool.submit(read_pull_requests, repo, deadline)
            for repo, _key in repos
        }
        for repo, future in futures.items():
            try:
                rows, cut = future.result()
            except RepoError as exc:
                pr_error = f"{repo}: {exc}"
                break
            pull_requests[repo] = rows
            if cut:
                pr_error = f"{repo}: more than {PR_LIMIT} open pull requests"
                break
    if pr_error:
        return {"pr_error": pr_error}

    board_repos = sorted({issue.get("repo") or "" for issue in issues})
    records = build_records(issues, pull_requests)
    dropped = {
        (issue.get("repo") or "", issue.get("number")) for issue, _reason in drops
    }
    board_by_key = {
        (issue.get("key") or "").upper(): issue
        for issue in issues
        if issue.get("key")
    }
    named_numbers: dict[str, set[int]] = {}
    named_keys: dict[str, set[str]] = {}
    for repo in board_repos:
        numbers = named_numbers.setdefault(repo, set())
        wanted = named_keys.setdefault(repo, set())
        for record in records.get(repo, []):
            if (record.get("repo"), record.get("number")) in dropped:
                continue
            if record.get("stage") != READY_STAGE:
                continue
            body = bodies.get((repo, record.get("number"))) or ""
            found, labels = named_blockers(
                body,
                repo,
                keys.get(repo, ""),
                open_numbers.get(repo, set()),
                board_by_key,
            )
            numbers |= found
            wanted |= labels
    closed_numbers: dict[str, set[int]] = {}
    closed_keys: dict[str, set[str]] = {}
    closed_unread: list[str] = []
    with ThreadPoolExecutor(max_workers=6) as pool:
        states = {
            repo: pool.submit(read_blocker_states, repo, numbers, deadline)
            for repo, numbers in named_numbers.items()
            if numbers
        }
        keyed = {
            repo: pool.submit(read_closed_keys, repo, labels, deadline)
            for repo, labels in named_keys.items()
            if labels
        }
        for repo, future in states.items():
            found, reason = future.result()
            if reason:
                closed_unread.append(repo)
            closed_numbers[repo] = found
        for repo, future in keyed.items():
            closed_keys[repo] = future.result()
    queue_state = read_queue_state()
    gated_heads = queue_state["gatedHeads"]
    queued_tickets = queue_state["queuedTickets"]
    live = read_live_threads(deadline)

    pairs: list[tuple[str, int]] = []
    for repo in sorted(allowed):
        for record in records.get(repo, []):
            if (record.get("repo"), record.get("number")) in dropped:
                continue
            prs = (
                [record]
                if record["kind"] == "pr"
                else (record.get("prs") or [])
            )
            for pull in prs:
                pairs.append((repo, pull["number"]))
    checks = read_all_checks(pairs, deadline)

    failing: list[dict] = []
    gate_pass: list[dict] = []
    split_items: list[dict] = []
    unsplit_items: list[dict] = []
    in_flight: list[dict] = []
    backlog: list[dict] = []
    counts: dict[str, dict] = {}
    unverified_prs: list[str] = []

    def count_for(repo: str) -> dict:
        return counts.setdefault(
            repo,
            {
                "total": 0,
                "failing": 0,
                "gate": 0,
                "split": 0,
                "unsplit": 0,
                "in_flight": 0,
                "backlog": 0,
            },
        )

    for repo in sorted(allowed):
        bucket = records.get(repo, [])
        for record in bucket:
            if (record.get("repo"), record.get("number")) in dropped:
                continue
            prs = (
                [record]
                if record["kind"] == "pr"
                else (record.get("prs") or [])
            )
            if prs:
                for pull in prs:
                    item = {
                        "kind": "pull-request",
                        "repo": repo,
                        "number": pull.get("number"),
                        "key": record.get("key") or "",
                        "title": pull.get("title") or "",
                        "url": pull.get("url") or "",
                        "priority": record.get("priority"),
                        "stage": record.get("stage"),
                        "ticket": ""
                        if record["kind"] == "pr"
                        else record.get("number"),
                        "standalone": record["kind"] == "pr",
                        "head": pull.get("headRefOid") or "",
                        "isDraft": bool(pull.get("isDraft")),
                        "action": "none",
                        "actionReason": "",
                        "actionCommand": "",
                    }
                    if item["isDraft"]:
                        item["reason"] = "draft pull request"
                        item["actionReason"] = "draft pull request"
                        in_flight.append(item)
                        count_for(repo)["in_flight"] += 1
                        continue
                    rows, unknown = checks.get(
                        (repo, pull["number"]), ([], "the checks were not read")
                    )
                    if unknown:
                        item["reason"] = unknown
                        unverified_prs.append(f"{repo}#{pull['number']}: {unknown}")
                        in_flight.append(item)
                        count_for(repo)["in_flight"] += 1
                        continue
                    blocked = apply_checks(item, rows, keys.get(repo, ""))
                    failed = (item.get("checks") or {}).get("failed") or []
                    external = item.get("externalChecks") or []
                    if blocked:
                        item["reason"] = "failing check: " + ", ".join(failed)
                        item["actionReason"] = "a check is failing"
                        failing.append(item)
                        count_for(repo)["failing"] += 1
                        count_for(repo)["total"] += 1
                        continue
                    head = item["head"]
                    request_id = f"gate:{repo}#{pull['number']}:{head}"
                    thread_id = receipts.get(request_id, "")
                    verdict = ""
                    report = ""
                    gate_updated = ""
                    if thread_id:
                        verdict, report, gate_updated = read_gate_report(
                            thread_id, deadline, head
                        )
                    status = "none"
                    if verdict == "PASS":
                        status = "pass"
                    elif verdict == "FAIL":
                        status = "fail"
                    elif thread_id:
                        status = "running"
                    if status == "none" and request_id in gated_heads:
                        status = "queued"
                    issue_number = refs_issue(pull.get("body") or "")
                    builder, attempt = (
                        builder_thread(receipts, repo, issue_number)
                        if issue_number
                        else ("", 0)
                    )
                    item["gate"] = {
                        "status": status,
                        "requestId": request_id,
                        "threadId": thread_id,
                        "updatedAt": gate_updated,
                    }
                    item["builder"] = {
                        "threadId": builder,
                        "attempt": attempt,
                        "live": bool(builder and builder in live["ids"]),
                    }
                    item["issue"] = issue_number
                    if status == "fail":
                        tries = fix_tries(queue_state, repo, pull["number"])
                        item["fixTries"] = tries
                        if not builder:
                            item["actionReason"] = (
                                "no builder thread is known for this ticket"
                            )
                        elif tries >= budget["retry_cap"]:
                            # The item used its fix tries, so it is parked
                            # (part T8a). The shift never sends a third fix.
                            item["actionReason"] = (
                                f"the item used its {budget['retry_cap']} fix "
                                "tries, so it is parked"
                            )
                        else:
                            (
                                builder_updated,
                                builder_texts,
                                builder_minutes,
                            ) = read_thread_messages(builder, deadline)
                            item["builder"]["updatedAt"] = builder_updated
                            item["builder"]["minutes"] = builder_minutes
                            if builder_minutes >= budget["hard"]:
                                item["actionReason"] = (
                                    f"the builder used {builder_minutes} min of "
                                    f"its {budget['hard']} min hard budget, so "
                                    "the item is parked"
                                )
                            else:
                                mark = (report or "")[:200]
                                if mark and any(
                                    mark in text for text in builder_texts
                                ):
                                    item["actionReason"] = (
                                        "the builder already has these findings"
                                    )
                                else:
                                    item["action"] = "fix"
                                    item["actionCommand"] = fix_command(
                                        repo,
                                        pull["number"],
                                        head,
                                        builder,
                                        report,
                                    )
                    elif status == "none":
                        if item["isDraft"]:
                            item["actionReason"] = "draft pull request"
                        elif not issue_number:
                            item["actionReason"] = (
                                "no board ticket names this pull request"
                            )
                        elif not builder_check_passes(pull, rows, head):
                            item["actionReason"] = (
                                "the builder check does not name this head"
                            )
                        else:
                            item["action"] = "gate"
                            item["actionCommand"] = (
                                f"coordq gate {repo}#{pull['number']}"
                            )
                    else:
                        item["actionReason"] = {
                            "pass": "gate PASS",
                            "running": "the gate is running",
                            "queued": "a gate for this head is on its way",
                        }.get(status, "")
                    if verdict == "PASS":
                        item["reason"] = "gate PASS"
                        if external:
                            item["reason"] += (
                                "; external checks failing: "
                                + ", ".join(external)
                            )
                        gate_pass.append(item)
                        count_for(repo)["gate"] += 1
                        count_for(repo)["total"] += 1
                        continue
                    if verdict == "FAIL":
                        item["reason"] = "gate FAIL"
                    else:
                        item["reason"] = (
                            "open pull request, no failing check and no gate "
                            "verdict"
                        )
                    if external:
                        item["reason"] += (
                            "; external checks failing: " + ", ".join(external)
                        )
                    in_flight.append(item)
                    count_for(repo)["in_flight"] += 1
                continue
            # A ticket with no open pull request.
            item = {
                "kind": "ticket",
                "repo": repo,
                "number": record.get("number"),
                "key": record.get("key") or "",
                "title": record.get("title") or "",
                "url": record.get("url") or "",
                "priority": record.get("priority"),
                "stage": record.get("stage"),
                "ticket": record.get("number"),
                "action": "none",
                "actionReason": "",
                "actionCommand": "",
            }
            if record.get("stage") == "started":
                item["reason"] = "stage started"
                item["actionReason"] = "the ticket is already started"
                in_flight.append(item)
                count_for(repo)["in_flight"] += 1
                continue
            if record.get("stage") != READY_STAGE:
                item["reason"] = f"stage {record.get('stage') or 'unknown'}"
                item["actionReason"] = "the board stage is not todo"
                backlog.append(item)
                count_for(repo)["backlog"] += 1
                continue
            body = bodies.get((repo, record.get("number"))) or ""
            item["blockers"] = blockers_for(
                body,
                repo,
                keys.get(repo, ""),
                open_numbers,
                closed_numbers,
                closed_keys,
                board_by_key,
            )
            split = bool(SPLIT_MARK.search(body))
            item["split"] = split
            if split:
                item["reason"] = "already a 5-minute part"
                split_items.append(item)
                count_for(repo)["split"] += 1
                count_for(repo)["total"] += 1
            else:
                item["reason"] = "split first, then add the parts"
                unsplit_items.append(item)
                count_for(repo)["unsplit"] += 1
                count_for(repo)["total"] += 1
            key = (record.get("key") or "").upper()
            queued = [
                request
                for request in queued_tickets
                if request.startswith(f"ticket:{repo}#{record.get('number')}:")
            ]
            if item["blockers"]:
                item["actionReason"] = (
                    "blocked: " + "; ".join(item["blockers"])
                )
            elif key and key in live["keys"]:
                item["actionReason"] = "a builder thread for this ticket is live"
            elif queued:
                item["actionReason"] = "the ticket is already queued"
            elif record.get("problems"):
                item["actionReason"] = "the board labels need a fix: " + ", ".join(
                    record["problems"]
                )
            else:
                item["action"] = "start"
                item["actionCommand"] = f"ticket start {repo}#{record.get('number')}"
                item["dryRunCommand"] = (
                    f"ticket start {repo}#{record.get('number')} --dry-run"
                )

    import lane_driver
    pulls = {(repo, pull["number"]): pull for repo, prs in pull_requests.items() for pull in prs}
    for item in failing + gate_pass + in_flight:
        if item.get("kind") != "pull-request":
            continue
        repo, number = item["repo"], item["number"]
        pull = dict(pulls[(repo, number)])
        pull["statusCheckRollup"] = [
            {"name": row.get("name"), "state": "SUCCESS" if row.get("bucket") == "pass" else row.get("state") or row.get("bucket", "").upper()}
            for row in checks.get((repo, number), ([], ""))[0]
        ]
        issue = refs_issue(pull.get("body") or "") or item.get("ticket") or 0
        if not issue:
            match = re.match(rf"{re.escape(keys.get(repo, ''))}[- #]+(\d+)", pull.get("title") or "")
            issue = int(match.group(1)) if match else 0
        builder, attempt = builder_thread(receipts, repo, int(issue)) if issue else ("", 0)
        if not builder and issue:
            payload = json.dumps({"allProjects": True, "titleContains": f"{keys.get(repo, '')}-{issue}", "limit": 100})
            try:
                threads = json.loads(run([T3MCP, "call", "t3_thread_list", payload], T3_TIMEOUT, deadline)).get("threads") or []
                candidates = [t for t in threads if re.match(rf"{re.escape(keys.get(repo, ''))}[- #]+{issue}\b", t.get("title") or "")
                              and not re.search(r"\b(review|gate)\b", t.get("title") or "", re.I)]
                if candidates:
                    builder = max(candidates, key=lambda t: t.get("updatedAt") or "")["threadId"]
            except (RepoError, ValueError, KeyError):
                builder = ""
        gate = item.get("gate") or {}
        if not gate:
            thread = receipts.get(f"gate:{repo}#{number}:{item['head']}", "")
            verdict = read_gate_report(thread, deadline, item["head"])[0] if thread else ""
            gate = {"threadId": thread, "status": verdict.lower() if verdict else "running" if thread in live["ids"] else "none" if thread else "absent"}
        status = gate.get("status") or "absent"
        verdict = {"pass": "PASS", "fail": "FAIL", "queued": "running"}.get(status, status)
        if status == "none" and not gate.get("threadId"):
            verdict = "absent"
        if status == "running" and gate.get("threadId") not in live["ids"]:
            verdict = "none"
        unread = checks.get((repo, number), ([], ""))[1]
        if unread:
            pull["body"] = re.sub(r"(?m)^Builder check: PASS .*?$", "", pull.get("body") or "")
            pull["statusCheckRollup"] = []
        state, action = lane_driver.pr_action(pull, builder, verdict,
            gate_live=gate.get("threadId") in live["ids"], builder_live=builder in live["ids"], repo=None if unread else repo)
        if verdict == "FAIL" and action == "fix":
            item.update(state=state, updatedAt=pull.get("updatedAt") or "",
                        builderLive=builder in live["ids"], gateThreadLive=gate.get("threadId") in live["ids"])
            continue
        item.update(state=state, action=action, actionReason=state.replace("-", " "), updatedAt=pull.get("updatedAt") or "",
                    builderLive=builder in live["ids"], gateThreadLive=gate.get("threadId") in live["ids"], issue=issue, builder={"threadId": builder, "attempt": attempt, "live": builder in live["ids"]}, gate=gate)
        item["actionCommand"] = ""
        if action == "gate":
            item["actionCommand"] = f"coordq gate {repo}#{number}"
        elif action not in {"none", "needs-you"}:
            target = gate.get("threadId") if action == "regate" else builder
            payload = {"threadId": target, "message": f"PR #{number} at {item['head']} needs {action}: {state}. Finish this action, run the repository check, update the exact-head check line, and report."}
            action_key = shlex.quote(f"{action}:{repo}#{number}:{item['head']}")
            item["actionCommand"] = f"coordq start {shlex.quote(json.dumps(payload))} --tool t3_thread_send --priority 800 --action-key {action_key}"

    failing.sort(key=order_key)
    gate_pass.sort(key=order_key)
    split_items.sort(key=order_key)
    unsplit_items.sort(key=order_key)
    return {
        "failing": failing,
        "gate_pass": gate_pass,
        "split": split_items,
        "unsplit": unsplit_items,
        "in_flight": in_flight,
        "backlog": backlog,
        "counts": counts,
        "unverified": unverified_prs,
        "closed_unread": closed_unread,
        "queue": queue_state,
        "live": live,
    }


def builder_check_passes(pull: dict, rows: list[dict], head: str) -> bool:
    """Return True when the builder's check names this head.

    The check is the line the builder wrote in the pull request body,
    `Builder check: PASS <head>`, or the agent check the repository
    publishes on the head. A trailing note after the head (the command
    that produced it) does not change the verdict. A check that does not
    name the head is no check for that head, so the head is not gated:
    a gate that cannot read the diff would only report the check."""
    if not head:
        return False
    for line in (pull.get("body") or "").splitlines():
        if line.strip().startswith(f"Builder check: PASS {head}"):
            return True
    for row in rows or []:
        if str(row.get("name") or "") != AGENT_CHECK:
            continue
        state = str(row.get("bucket") or row.get("state") or "").upper()
        if state in ("PASS", "SUCCESS"):
            return True
    return False


def refs_issue(body: str) -> int:
    """Return the issue a pull request body names, or 0 when it names none.

    The coordinator's own queue reads a "Refs #<n>" line, so this reads
    the same line: a pull request that names no ticket is one the
    coordinator has no task for."""
    for line in (body or "").splitlines():
        match = REFS_ISSUE.search(line)
        if match:
            return int(match.group(1))
    return 0


def fix_command(repo: str, number: int, head: str, builder: str, report: str) -> str:
    """Return the command that sends a failed gate's findings to the builder.

    The command is short on purpose: the queue reads the gate's own
    report and the builder thread, so the tick carries one line per item
    and not the whole report."""
    return f"coordq fix {repo}#{number}"


def policy_repos(cfg: dict, override: object) -> list[tuple[str, str]]:
    """Return the repositories a command may work in.

    The shift works under the allow list in its policy snapshot, so a
    command that is handed that list reads only those repositories and
    drops the rest. The board config still holds the key of each
    repository. Without the list, the board config's own list is the
    contract."""
    config_repos = allowed_repos(cfg)
    if not override:
        return config_repos
    keys_of = {repo: key for repo, key in config_repos}
    return [(repo, keys_of.get(repo, "")) for repo in override]


def cmd_order(args: argparse.Namespace) -> int:
    """Order the whole board and write one summary line to the shift log.

    The order is the spec's: the pull requests that are already open and
    failing a check, then the pull requests with a gate PASS, then the
    ready tickets that are already split into 5-minute parts, then the
    ready tickets that are not split yet. There is no cap and no list
    file: the board is the list, and the only file this command writes
    is one line of the shift log."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    budget = budget_of(policy_snapshot(report_root(getattr(args, "root", None))))
    repos = policy_repos(cfg, getattr(args, "allowed", None))
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    emit("Overnight order - dry run (read only)")
    if stale:
        emit("REFUSED: the board list is stale, so the order cannot be trusted.")
        emit("The ticket CLI could not reach GitHub and fell back to its cache.")
        return 1
    bodies, unread, open_numbers = read_bodies(issues, deadline)
    path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {path} could not be read")
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    if problems:
        for problem in problems:
            emit(f"REFUSED: {problem}")
        emit("REFUSED: the order cannot return a list it could not fully check.")
        return 1

    receipts, receipt_error = read_receipts()
    result = collect_items(
        deadline, repos, issues, bodies, open_numbers, drops, receipts, budget
    )
    if result.get("pr_error"):
        emit(f"REFUSED: {result['pr_error']}")
        emit("REFUSED: the order cannot return a list it could not fully check.")
        return 1
    failing = result["failing"]
    gate_pass = result["gate_pass"]
    split_items = result["split"]
    unsplit_items = result["unsplit"]
    in_flight = result["in_flight"]
    backlog = result["backlog"]
    counts = result["counts"]
    unverified_prs = result["unverified"]
    gate_error = receipt_error

    def show(title: str, items: list[dict], start: int) -> int:
        emit()
        emit(f"{title} ({len(items)})")
        for offset, item in enumerate(items):
            blockers = ""
            if item.get("blockers"):
                blockers = " [blocked: " + "; ".join(item["blockers"]) + "]"
            emit(
                f"  {start + offset}. {item['repo']}#{item['number']} "
                f"{item.get('key') or '-'} {item['title']} - {item.get('reason', '')}"
                f"{blockers}"
            )
        return start + len(items)

    planned = len(failing) + len(gate_pass) + len(split_items) + len(unsplit_items)
    emit(f"Board: {len(issues)} tickets")
    emit(f"Allowed repositories: {len(repos)}")
    emit(f"Decisions log: {path}")
    emit(f"Dropped by the filter: {len(drops)}")
    emit(f"Planned items: {planned}")
    if gate_error:
        emit(
            "The gate dispatches could not be read, so no pull request is "
            f"called gate PASS: {gate_error}"
        )
    if unverified_prs:
        for note in unverified_prs:
            emit(f"UNVERIFIED: {note}")
    if result.get("closed_unread"):
        emit(
            "UNVERIFIED: the closed issues of these repositories could not be "
            "read, so a blocker in them is not known to be met: "
            + ", ".join(result["closed_unread"])
        )
    index = 1
    index = show("Failing pull requests", failing, index)
    index = show("Pull requests with a gate PASS", gate_pass, index)
    index = show("Ready tickets already split into 5-minute parts", split_items, index)
    index = show("Ready tickets not yet split", unsplit_items, index)
    index = show("Not work items: a pull request is open", in_flight, index)
    show("Not ready: the board stage is not todo", backlog, index)
    line = f"planned {planned} items | {summarize(counts)}"
    if gate_error:
        line += " | gate-pass UNVERIFIED"
    if unverified_prs:
        line += f" | checks UNVERIFIED {len(unverified_prs)}"
    log = write_shift_line(report_root(args.root), line)
    emit()
    emit(f"Summary line written to {log}")
    emit(f"  {line}")
    emit(
        "No list file is written: the board is the list, and this run wrote "
        "one line of the shift log and nothing else."
    )
    return 0



# --- The attended first night (spec part T13) ------------------------------

# The types the attended night may work: one small part. These are the
# board's own types. A ticket Shyam holds never reaches the list, because
# the ticket CLI keeps it out, so the night needs no second hold rule.
SMALL_TYPES = {"chore", "standard"}
# The gate's verdict line, as the gate writes it.
GATE_VERDICT = re.compile(r"VERDICT:\s*(?P<verdict>PASS|FAIL)", re.I)
# The keys of the Ascend repositories. The allow list leaves them out; the
# check is here so the shift can say that it left them out.
ASCEND_KEYS = {"AUH", "MCP", "OPS", "DBT", "OMN"}
# The folders the attended night writes.
ATTEND_DIRS = ("run", "receipts", "inbox", "staging")


def run_read(argv: list[str], timeout: int, deadline: float) -> tuple[int, str]:
    """Run a read-only command and return its exit code and its output.

    A read-only command that fails is not fatal: the shift keeps the exit
    code and what it saw, and the receipt says so. Nothing here merges,
    pushes or writes to a repository."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the attended night ran out of time before the next command could run")
    hit = gh_gateway.cached(argv)
    if hit is not None:
        gh_gateway.record(argv, 1, free="hit")
        return 0, hit
    run_argv, headers_counted = gh_gateway.prepare(argv)
    try:
        result = subprocess.run(
            run_argv,
            capture_output=True,
            text=True,
            timeout=max(1, min(timeout, int(left))),
            check=False,
            env=gh_gateway.gateway_env(),
        )
    except FileNotFoundError:
        die(f"{argv[0]} is not on PATH")
    except subprocess.TimeoutExpired:
        return 124, f"{' '.join(argv)} timed out"
    # A failed read is never stored: a cached error would answer the next
    # identical read with a success, and a failed list would read as an
    # empty board. The page count is what the request actually spent.
    body, count = gh_gateway.settle(argv, result.stdout, headers_counted,
                                    failed=result.returncode != 0)
    gh_gateway.record(argv, count)
    if result.returncode == 0:
        gh_gateway.store(argv, body)
    return result.returncode, body + (result.stderr or "")


def slot_cap() -> int | None:
    """Return the queue's slot cap, read only.

    The shift never writes this file and never raises the cap. When the
    file cannot be read the cap is unknown, and the policy says so."""
    try:
        with open(SLOT_CAP_FILE) as stream:
            value = json.load(stream).get("cap")
    except (OSError, ValueError, AttributeError):
        return None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def select_items(issues: list[dict], allowed: set[str], limit: int) -> list[dict]:
    """Return the small board items the attended night may work.

    The board is the list. The attended night takes the first items the
    board shows that are small: on the todo stage, in an allowed
    repository, and of a type that is one small part. A ticket Shyam holds
    is not in the list at all, so the night never takes one. The Ascend
    keys are never taken."""
    picked: list[dict] = []
    for issue in issues:
        if len(picked) >= limit:
            break
        if issue.get("stage") != "todo":
            continue
        if issue.get("repo") not in allowed:
            continue
        key = (issue.get("key") or "").upper()
        if key.split("-")[0] in ASCEND_KEYS:
            continue
        if (issue.get("type") or "").lower() not in SMALL_TYPES:
            continue
        picked.append(issue)
    return picked


def pull_request_gate_verdict(repo: str, number: int, deadline: float) -> str:
    """Return the gate's verdict on a pull request: PASS, FAIL or UNKNOWN.

    The gate writes its verdict on the pull request, as a comment or as a
    review. When the shift cannot read one, the verdict is UNKNOWN, and a
    receipt with an UNKNOWN gate is never counted as passed.

    The name says which verdict this is: the one the gate wrote on the
    pull request. The module's other `gate_verdict` reads the gate's own
    receipts for a head, and the two are not the same read."""
    code, out = run_read(
        [GH, "pr", "view", str(number), "-R", repo, "--json", "comments,reviews"],
        GH_TIMEOUT,
        deadline,
    )
    if code != 0:
        return "UNKNOWN"
    found = GATE_VERDICT.findall(out)
    if not found:
        return "UNKNOWN"
    return str(found[-1]).upper()


def observe_pull_request(repo: str, number: int, deadline: float) -> dict:
    """Return what a pull request really shows.

    Every command here is read only. Each exit code is kept, because a
    check counts as run only when it names its command and its exit code."""
    checks_code, checks_out = run_read(
        [GH, "pr", "checks", str(number), "-R", repo], GH_TIMEOUT, deadline
    )
    files_code, files_out = run_read(
        [GH, "pr", "view", str(number), "-R", repo, "--json", "files"],
        GH_TIMEOUT,
        deadline,
    )
    files = 0
    if files_code == 0:
        try:
            rows = json.loads(files_out)
            if isinstance(rows, dict):
                rows = rows.get("files") or []
            files = len(rows) if isinstance(rows, list) else 0
        except ValueError:
            files = 0
    # "no checks reported" is not a failed check: the pull request has no
    # checks yet, and the receipt says that instead of claiming a failure.
    no_checks = "no checks reported" in checks_out.lower()
    return {
        "checks_exit": checks_code,
        "checks_out": checks_out,
        "no_checks": no_checks,
        "files": files,
        "gate": pull_request_gate_verdict(repo, number, deadline),
    }


def receipt_text(issue: dict, state: str, pr: dict | None, observation: dict | None,
                 observed: int, stopped: str, nxt: str) -> str:
    """Return one receipt of the attended night.

    The receipt holds what the shift really saw. A check that did not run
    has no exit code, and a gate that could not be read says UNKNOWN. No
    builder ran, so the builder time is zero and the time the shift spent
    looking is recorded apart from it."""
    fields = issue.get("title") or ""
    lines = [f"# {issue.get('key') or issue.get('number')}", ""]
    lines.append(f"- Item: {fields}")
    lines.append(f"- Repo: {issue.get('repo', '')}")
    lines.append(f"- Ticket: {issue.get('key', '')} (#{issue.get('number')})")
    lines.append(f"- State: {state}")
    if pr:
        lines.append(f"- PR: {pr.get('url', '')}")
    if observation:
        command = f"gh pr checks {pr.get('number')} -R {issue.get('repo', '')}"
        lines.append(f"- Checks: `{command}` exit {observation['checks_exit']}")
        lines.append(f"- Gate: {observation['gate']}")
        lines.append(f"- Files: {observation['files']}")
    lines.append("- Time used: 0 min")
    lines.append(f"- Observed: {observed} s")
    lines.append(f"- Stopped because: {stopped}")
    lines.append(f"- Next: {nxt}")
    return "\n".join(lines) + "\n"


def cmd_attend(args: argparse.Namespace) -> int:
    """Run the attended first night.

    This is the command a person runs when they sit down to watch the
    night. The shift arms itself in the folder it is given, reads the
    board, takes the small items the board shows and observes each one for
    real: the pull request it has, the checks it runs, the gate's verdict
    and the files it touches. It writes one receipt per item, the shift log
    and then the morning report.

    The night runs no merge, no push and no builder. The tick part (T5) is
    not built yet, so the attended night observes and records what it
    really saw, and every receipt says what stopped it."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _key in repos}
    if not allowed:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    items = select_items(issues, allowed, args.items)
    if len(items) < args.items:
        die(
            f"the board shows only {len(items)} small items, and the "
            f"attended night was asked for {args.items}"
        )
    root = Path(args.root).expanduser() if args.root else report_root(None) / (
        f"attended-{args.date or datetime.now(PT).strftime('%Y-%m-%d')}"
    )
    if args.dry_run:
        emit("Overnight attended night - dry run (read only)")
        emit(f"Board: {len(issues)} tickets{' (stale)' if stale else ''}")
        emit(f"Run by: {args.run_by}")
        emit(f"Planned items: {len(items)}")
        for issue in items:
            emit(
                f"- {issue.get('key')} (#{issue.get('number')}) "
                f"{issue.get('title', '')} [{issue.get('type')}] {issue.get('repo')}"
            )
        emit("A dry run writes no record and starts no work.")
        return 0
    for name in ATTEND_DIRS:
        (root / name).mkdir(parents=True, exist_ok=True)
    start = datetime.now(PT)
    close = start + timedelta(minutes=args.minutes)
    shift_id = f"attended-{start.strftime('%Y%m%d-%H%M')}"
    write_record(
        root / "run" / "armed",
        f"shift: {shift_id}\n"
        f"start: {pt_clock(start)}\n"
        f"run by: {args.run_by}\n"
        f"items: {len(items)}\n",
    )
    write_record(root / "run" / "deadline", f"{close.timestamp()}\n")
    policy = build_policy()
    policy.update(
        {
            "allowance_used_percent": None,
            "run_by": args.run_by,
            "window_minutes": args.minutes,
        }
    )
    write_policy(root, policy)
    log_lines = [
        f"{start.strftime('%Y-%m-%d %H:%M %Z')} | attended night | started, "
        f"run by {args.run_by}, planned {len(items)} items",
        f"{start.strftime('%Y-%m-%d %H:%M %Z')} | attended night | the shift "
        f"runs read-only commands only: no merge, no push, no builder",
    ]
    # The log exists from the start, so a night that stops early still
    # leaves a record of what it did.
    log_path = root / "run" / "shift-log.md"
    write_record(log_path, "\n".join(log_lines) + "\n")
    pr_cache: dict[str, list[dict]] = {}
    for issue in items:
        item_start = time.monotonic()
        repo = issue.get("repo", "")
        # The issue numbers of one repository are its own, so the board
        # maps are built per repository.
        by_number = {
            other["number"]: other
            for other in issues
            if other.get("repo") == repo and other.get("number")
        }
        by_key = {
            (other.get("key") or "").upper(): other
            for other in issues
            if other.get("repo") == repo and other.get("key")
        }
        if repo not in pr_cache:
            try:
                rows, _cut = read_pull_requests(repo, deadline)
            except RepoError as exc:
                rows = []
                emit(f"overnight: {repo}: {exc}", err=True)
            pr_cache[repo] = rows
        linked = []
        for row in pr_cache[repo]:
            target, _signal = linked_ticket(row, by_number, by_key)
            if target is not None and target.get("number") == issue.get("number"):
                linked.append(row)
        pr = linked[0] if linked else None
        observation = None
        if pr:
            observation = observe_pull_request(repo, pr["number"], deadline)
            checks_code = observation["checks_exit"]
            gate = observation["gate"]
            if observation["no_checks"]:
                state = "stuck"
                stopped = "the pull request has no checks yet"
                nxt = "the builder runs the checks for this pull request"
            elif checks_code != 0:
                state = "stuck"
                stopped = (
                    f"the checks on the pull request did not pass "
                    f"(exit {checks_code})"
                )
                nxt = "the builder fixes the failing check and the gate runs again"
            elif gate != "PASS":
                state = "stuck"
                stopped = f"the gate did not pass (gate {gate})"
                nxt = "the gate runs again on the pull request"
            else:
                state = "ready"
                stopped = (
                    "the shift has no merge right for this repository, so the "
                    "pull request waits for Shyam"
                )
                nxt = "Shyam merges the pull request in the morning"
        else:
            state = "stuck"
            stopped = "no pull request is open for this ticket"
            nxt = (
                "the tick part (T5) starts the builder for this item; the "
                "attended night only observes"
            )
        elapsed = time.monotonic() - item_start
        observed = int(elapsed + 0.5)
        receipt = root / "receipts" / f"{issue.get('key')}.md"
        write_record(
            receipt,
            receipt_text(issue, state, pr, observation, observed, stopped, nxt),
        )
        detail = (
            f"`gh pr checks {pr['number']} -R {repo}` exit {observation['checks_exit']}"
            f"{' (no checks yet)' if observation['no_checks'] else ''}, "
            f"gate {observation['gate']}"
            if observation
            else "no pull request is open"
        )
        log_lines.append(
            f"{datetime.now(PT).strftime('%Y-%m-%d %H:%M %Z')} | item "
            f"{issue.get('key')} (#{issue.get('number')}) | {state} | {detail}"
        )
    if args.wait:
        # The human is watching: the shift holds the door until its window
        # closes. It waits the whole window, so the night never ends early
        # and claims the deadline.
        remaining = close.timestamp() - time.time()
        while remaining > 0:
            time.sleep(min(remaining, 60))
            remaining = close.timestamp() - time.time()
    if (root / "run" / "STOP").exists():
        end = "ended: STOP"
    elif datetime.now(PT) >= close:
        end = "ended: deadline"
    else:
        end = "ended: the items were observed and the window is still open"
    log_lines.append(
        f"{datetime.now(PT).strftime('%Y-%m-%d %H:%M %Z')} | attended night | "
        f"{end}"
    )
    write_record(log_path, "\n".join(log_lines) + "\n")
    emit(f"overnight: attended night {shift_id} wrote {len(items)} receipts")
    for issue in items:
        emit(f"  - {issue.get('key')} (#{issue.get('number')})")
    return cmd_report(
        argparse.Namespace(root=str(root), date=args.date, dry_run=False)
    )


# --- Part T5b: the receipt per item state change ---------------------------
#
# A receipt is the only proof the shift has. It is written on every state
# change of an item, and it is built from what the pull requests and the
# threads really hold: the checks that ran and their exit codes, the gate's
# own verdict, the files the pull request touches and the builder's own
# times. A model claim is never a field: the receipt says what it read.


def receipt_path(root: Path, item: dict) -> Path:
    """Return the receipt file of one item.

    The receipt is named after the item: the board key when the item has
    one, and the repository and the number when it does not."""
    key = (item.get("key") or "").strip()
    if key:
        name = key
    else:
        repo = (item.get("repo") or "unknown").split("/")[-1]
        name = f"{repo}-{item.get('number')}"
    return root / "receipts" / f"{name}.md"


def receipt_items(result: dict) -> list[dict]:
    """Return the items a receipt can be about, in the shift's order.

    A receipt is about an item the shift works: the failing pull requests,
    the pull requests with a gate PASS, the ready tickets (split or not)
    and the pull requests that are in flight. A ticket that is not ready is
    not work, so it gets no receipt."""
    items: list[dict] = []
    for name in ("failing", "gate_pass", "split", "unsplit", "in_flight"):
        items.extend(result.get(name) or [])
    return items


def parse_moment(value: str) -> datetime | None:
    """Return an ISO time as a moment, or None when it cannot be read."""
    text = (value or "").strip()
    if not text:
        return None
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None


def run_seconds(runs: object) -> float:
    """Return the seconds the thread's own runs took.

    A run that has not finished runs until now. The time between two runs
    is idle time, not builder time, so it does not count: a builder that
    waited a day for its findings did not spend a day building."""
    total = 0.0
    now = datetime.now(timezone.utc)
    if not isinstance(runs, list):
        return total
    for run in runs:
        if not isinstance(run, dict):
            continue
        started = parse_moment(str(run.get("startedAt") or ""))
        if started is None:
            continue
        ended = parse_moment(str(run.get("completedAt") or ""))
        if ended is None:
            ended = now
        seconds = (ended - started).total_seconds()
        if seconds > 0:
            total += seconds
    return total


def builder_minutes(data: dict) -> int:
    """Return the builder's own time in minutes, from the thread's runs.

    The time is the sum of the runs the builder thread really made. The
    budget is measured against it, and the receipt reports it, so one
    number says how long the builder worked."""
    return int(run_seconds(data.get("recentRuns")) // 60)


def read_thread_facts(thread_id: str, deadline: float) -> dict:
    """Return what a thread really holds: its times, its status and its verdict.

    The verdict is the last line of the thread's own last message, so a
    receipt carries the gate's verdict and not a claim about it. The
    minutes are the thread's own run time, which is the builder time the
    budget is measured against."""
    facts = {
        "createdAt": "",
        "updatedAt": "",
        "status": "",
        "verdict": "",
        "minutes": 0,
    }
    if not thread_id:
        return facts
    payload = json.dumps(
        {"threadId": thread_id, "maxCharsPerItem": 20000, "runLimit": 50}
    )
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
    except RepoError:
        return facts
    try:
        data = json.loads(raw)
    except ValueError:
        return facts
    thread = data.get("thread") or {}
    facts["createdAt"] = str(thread.get("createdAt") or "")
    facts["updatedAt"] = str(thread.get("updatedAt") or "")
    facts["status"] = str(thread.get("status") or "")
    facts["minutes"] = builder_minutes(data)
    texts = [
        item.get("text") or ""
        for item in (data.get("items") or [])
        if item.get("type") == "assistant_message"
    ]
    for text in reversed(texts):
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        if not lines:
            continue
        found = GATE_VERDICT.search(lines[-1])
        if found:
            facts["verdict"] = found.group("verdict").upper()
        break
    return facts


def check_head_holds(repo: str, number: int, deadline: float) -> int:
    """Return what a pull request's head carries: 0, 1 or 2.

    0: a check ran on the head and passed. 1: a check ran on the head and
    did not pass. 2: no check ran on the head, or the head could not be
    read.

    Only a published check counts. The builder's own line in the pull
    request body, `Builder check: PASS <head>`, is a claim about the
    check and not the check, so it never makes a head pass. A repository
    that publishes no checks (CI is agent checks only, as in mac-ops) has
    no evidence on its heads, and the shift says so."""
    code, out = run_read(
        [
            GH,
            "pr",
            "checks",
            str(number),
            "-R",
            repo,
            "--json",
            "name,state,bucket",
        ],
        GH_TIMEOUT,
        deadline,
    )
    if code != 0:
        return 2
    try:
        rows = json.loads(out or "[]")
    except ValueError:
        return 2
    if not isinstance(rows, list) or not rows:
        return 2
    failed = [
        row
        for row in rows
        if str(row.get("bucket") or row.get("state") or "").upper()
        not in ("PASS", "SUCCESS")
    ]
    return 1 if failed else 0


def check_line(repo: str, number: int, deadline: float) -> str:
    """Return the receipt's check line: the command the shift ran, and its exit.

    A check counts as run only when the receipt names the command and its
    exit code, so the line holds the command that really ran: the shift
    asks `overnight check-head` what the pull request's head carries, and
    the command it records is the command it ran."""
    argv = [
        OVERNIGHT_BIN,
        "check-head",
        "--repo",
        repo,
        "--number",
        str(number),
    ]
    code, _out = run_read(argv, GH_TIMEOUT, deadline)
    return f"`{' '.join(argv)}` exit {code}"


def item_facts(
    item: dict,
    receipts: dict[str, str],
    deadline: float,
    budget: dict | None = None,
    fix_tries: int = 0,
) -> dict:
    """Return what one item really shows, from its pull request and its threads.

    Every field here is read: the checks with their exit code, the gate's
    own verdict, the files the pull request touches and the builder's own
    times. Nothing is taken from what a model said about the work.

    The budget is applied last (part T8a), because the budget can stop an
    item: an item over its hard builder-time budget, or out of fix tries,
    is parked, and the receipt says why."""
    facts = {
        "state": STATE_STUCK,
        "pr": "",
        "checks": "",
        "failing": [],
        "gate": "UNKNOWN",
        "files": 0,
        "minutes": 0,
        "builder": "",
        "why": "",
        "next": "",
        "budget": BUDGET_WITHIN,
    }
    budget = normalise_budget(budget)
    repo = item.get("repo") or ""
    number = item.get("number")
    if item.get("kind") != "pull-request":
        facts["why"] = "no pull request is open for this ticket"
        facts["next"] = (
            "the tick starts the builder for this item and the receipt is "
            "rewritten when the pull request appears"
        )
        thread, _attempt = builder_thread(receipts, repo, int(number or 0))
        facts["builder"] = thread
        if thread:
            builder = read_thread_facts(thread, deadline)
            facts["minutes"] = builder["minutes"]
            if builder["status"] in ("running", "starting", "preparing", "queued"):
                facts["why"] = (
                    f"the builder thread {thread} is still working on this ticket"
                )
                facts["next"] = "the builder finishes and the gate runs"
        return apply_budget(facts, fix_tries, budget)

    facts["pr"] = item.get("url") or ""
    facts["checks"] = check_line(repo, number, deadline)
    failed = (item.get("checks") or {}).get("failed") or []
    facts["failing"] = [str(name) for name in failed]

    merged = ""
    view_code, view_out = run_read(
        [
            GH,
            "pr",
            "view",
            str(number),
            "-R",
            repo,
            "--json",
            "files,mergedAt",
        ],
        GH_TIMEOUT,
        deadline,
    )
    # A pull request whose view cannot be read is not a pull request that
    # did not merge. The receipt says the view could not be read, so the
    # item is never counted as done on a guess.
    view_error = ""
    if view_code != 0:
        view_error = "the pull request's view could not be read"
    else:
        try:
            view = json.loads(view_out)
        except ValueError:
            view = {}
            view_error = "the pull request's view could not be parsed"
        else:
            files = view.get("files") or []
            facts["files"] = len(files) if isinstance(files, list) else 0
            merged = str(view.get("mergedAt") or "")

    verdict = ""
    gate_thread = (item.get("gate") or {}).get("threadId") or ""
    if gate_thread:
        verdict = read_thread_facts(gate_thread, deadline)["verdict"]
    if not verdict:
        verdict = pull_request_gate_verdict(repo, number, deadline)
    facts["gate"] = verdict or "UNKNOWN"

    builder_thread_id = (item.get("builder") or {}).get("threadId") or ""
    facts["builder"] = builder_thread_id
    if builder_thread_id:
        builder = read_thread_facts(builder_thread_id, deadline)
        facts["minutes"] = builder["minutes"]

    if view_error:
        facts["state"] = STATE_STUCK
        facts["why"] = view_error
        facts["next"] = "the shift reads the pull request again on the next cycle"
    elif failed:
        facts["state"] = STATE_STUCK
        facts["why"] = "a check is failing: " + ", ".join(facts["failing"])
        facts["next"] = "the builder fixes the failing check and the gate runs again"
    elif merged:
        # The spec's evidence rule (part T6): the merge alone is not the
        # proof. The receipt has to hold the command, its exit code and
        # the gate's PASS before the item counts as done, so a receipt
        # never claims a done item it cannot show.
        holds, reason = evidence_holds(
            {"gate": facts["gate"]}, parse_check_text(facts["checks"])
        )
        if holds:
            facts["state"] = STATE_DONE
            facts["why"] = "the pull request merged on GitHub"
            facts["next"] = "the ticket closes on the merge"
        else:
            facts["state"] = STATE_STUCK
            facts["why"] = (
                "the pull request merged, but the receipt does not hold the "
                f"evidence that makes the item done: {reason}"
            )
            facts["next"] = (
                "the checks and the gate verdict are read again on the next cycle"
            )
    elif facts["gate"] == "PASS":
        facts["state"] = STATE_READY
        facts["why"] = (
            "the gate passed and the shift has no merge right for this "
            "repository"
        )
        facts["next"] = "Shyam merges the pull request in the morning"
    elif facts["gate"] == "FAIL":
        facts["state"] = STATE_STUCK
        facts["why"] = "the gate did not pass"
        facts["next"] = "the builder fixes the gate findings and the gate runs again"
    else:
        facts["state"] = STATE_STUCK
        facts["why"] = "no gate verdict was read for this pull request"
        facts["next"] = "the gate runs on this pull request head"
    return apply_budget(facts, fix_tries, budget)


def issue_number(item: dict) -> object:
    """Return the number of the ticket's issue, or nothing when it has none.

    The board numbers its issues and GitHub numbers its pull requests in
    different counters, so an item that is a pull request carries the
    issue number in `ticket` and its own number in `number`. A pull
    request with no linked ticket has no issue to close, so it has no
    issue number here: the receipt leaves the number out and the close
    step finds no receipt for it."""
    ticket = item.get("ticket")
    if ticket:
        return ticket
    if item.get("kind") == "pull-request":
        return ""
    return item.get("number")


def ticket_text(number: object) -> str:
    """Return the issue number as a receipt's Ticket line writes it."""
    return f" (#{number})" if number else ""


def receipt_body(item: dict, facts: dict, observed: int) -> str:
    """Return the text of one receipt.

    The fields are the report's own fields, so the morning report reads the
    receipt without guessing what a line means."""
    title = " ".join(str(item.get("title") or "").split())
    label = item.get("key") or item.get("number")
    lines = [f"# {label}", ""]
    lines.append(f"- Item: {title}")
    lines.append(f"- Repo: {item.get('repo') or ''}")
    lines.append(f"- Ticket: {item.get('key') or ''}{ticket_text(issue_number(item))}")
    lines.append(f"- State: {facts['state']}")
    if item.get("kind") != "pull-request" and item.get("url"):
        lines.append(f"- Issue: {item['url']}")
    if facts["pr"]:
        lines.append(f"- PR: {facts['pr']}")
    if facts["checks"]:
        lines.append(f"- Checks: {facts['checks']}")
    if facts["failing"]:
        lines.append(f"- Failing checks: {', '.join(facts['failing'])}")
    lines.append(f"- Gate: {facts['gate']}")
    lines.append(f"- Files: {facts['files']}")
    if facts["builder"]:
        lines.append(f"- Builder thread: {facts['builder']}")
    lines.append(f"- Time used: {facts['minutes']} min")
    lines.append(f"- Observed: {observed} s")
    lines.append(f"- Stopped because: {facts['why']}")
    lines.append(f"- Next: {facts['next']}")
    return "\n".join(lines) + "\n"


def without_observed(text: str) -> str:
    """Return the receipt text without the observed line.

    The observed line is how long the shift looked, so it changes every
    cycle. Without it two receipts of the same item and the same state are
    the same receipt, and the shift writes nothing."""
    return "\n".join(
        line for line in text.splitlines() if not line.startswith("- Observed:")
    )


def write_receipt(root: Path, item: dict, body: str) -> str:
    """Write one receipt and return what happened: wrote, unchanged or failed.

    A receipt is rewritten when the item's state changed and when the
    evidence changed. A receipt that says the same thing is left alone, so
    the folder holds the record of the state changes and not a copy of the
    same state every cycle. The receipt is redacted before it is written
    and before it is compared, so the comparison is between what is on
    disk and what would be written."""
    safe = redact(body)
    path = receipt_path(root, item)
    if path.exists() and without_observed(read_text(path)) == without_observed(safe):
        return "unchanged"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        # The receipt is written to a scratch name and moved into place, so
        # a run that dies mid-write never leaves a half receipt for the
        # morning report to read.
        scratch = path.with_name(path.name + ".tmp")
        write_record(scratch, safe)
        os.replace(scratch, path)
    except OSError as exc:
        return f"failed: {exc}"
    return "wrote"


def find_receipt(root: Path, repo: str, number: int) -> Path | None:
    """Return the receipt file of one ticket, or None when there is none.

    The receipt is named after the board key, so the ticket is found by
    the fields the receipt holds: the repository and the issue number in
    its `Ticket` line. The folder holds the receipts themselves, so the
    shift keeps no second list of what it did."""
    folder = root / "receipts"
    if not folder.is_dir():
        return None
    for path in sorted(folder.glob("*.md")):
        if not RECEIPT_FILE.match(path.name):
            continue
        fields = parse_receipt(path)["fields"]
        if (fields.get("repo") or "").strip().lower() != repo.strip().lower():
            continue
        found = re.search(r"#(\d+)\s*\)?\s*$", (fields.get("ticket") or "").strip())
        if found and int(found.group(1)) == number:
            return path
    return None


def run_write(argv: list[str], timeout: int, deadline: float) -> tuple[int, str]:
    """Run a command that writes and return its exit code and its output.

    This is the one write the shift makes outside its own folder: it
    closes a ticket's issue, and only when the receipt holds the
    evidence. Every other command the shift runs is a read."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the deadline passed before the next command could run")
    try:
        result = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=max(1, min(timeout, int(left))),
            check=False,
        )
    except FileNotFoundError:
        die(f"{argv[0]} is not on PATH")
    except subprocess.TimeoutExpired:
        return 124, f"{' '.join(argv)} timed out"
    gh_gateway.record(argv, 1)
    return result.returncode, (result.stdout or "") + (result.stderr or "")


def cmd_check_head(args: argparse.Namespace) -> int:
    """Check a pull request's head against the checks that ran on it.

    A repository that publishes checks is checked with `gh pr checks`. A
    repository that publishes none (CI is agent checks only, as in
    mac-ops) has no check on its heads, so the shift knows that and says
    so. The builder's own line in the pull request body is a claim about
    the check and not the check, so it never counts.

    Exit 0: a check ran on the head and passed. Exit 1: a check ran on
    the head and did not pass. Exit 2: no check ran on the head, or the
    head could not be read, which is a refusal."""
    deadline = time.monotonic() + args.deadline
    code = check_head_holds(args.repo, args.number, deadline)
    if code == 0:
        emit(
            f"overnight: {args.repo}#{args.number} carries a check that ran "
            "and passed"
        )
    elif code == 1:
        emit(
            f"overnight: {args.repo}#{args.number} carries a check that ran "
            "and did not pass",
            err=True,
        )
    else:
        emit(
            f"overnight: REFUSED: no check ran on the head of "
            f"{args.repo}#{args.number}, so the check is unknown",
            err=True,
        )
    return code


def cmd_close(args: argparse.Namespace) -> int:
    """Close a ticket's issue when its receipt holds the evidence.

    The spec's rule (part T6): an item counts as done, and the
    coordinator closes its issue, only when the receipt records a
    command, its exit code and a gate PASS on the pull request. The
    receipt is the proof, so a receipt that holds a claim without an
    exit code leaves the issue open, and the command says which record
    is missing."""
    deadline = time.monotonic() + args.deadline
    root = report_root(args.root)
    path = find_receipt(root, args.repo, args.number)
    if path is None:
        emit(
            f"overnight: REFUSED: no receipt for {args.repo}#{args.number}, "
            "so there is no evidence to close on",
            err=True,
        )
        return 1
    receipt = parse_receipt(path)
    fields = receipt["fields"]
    state = (fields.get("state") or "").strip().lower()
    holds, reason = evidence_holds(fields, receipt["checks"])
    if state != STATE_DONE:
        holds = False
        reason = f"the receipt says {state or 'no state'}, not done"
    if not holds:
        emit(
            f"overnight: REFUSED: {path.name} does not hold the evidence: {reason}",
            err=True,
        )
        emit("overnight: the issue stays open.", err=True)
        return 1
    pull = (fields.get("pr") or "").strip()
    comment = (
        "Done. The receipt records the check command, its exit code and the "
        f"gate PASS on {pull}."
        if pull
        else "Done. The receipt records the check command, its exit code and "
        "the gate PASS."
    )
    argv = [
        GH,
        "issue",
        "close",
        str(args.number),
        "-R",
        args.repo,
        "--comment",
        comment,
    ]
    if args.dry_run:
        emit(f"overnight: {path.name} holds the evidence:")
        emit(f"  state: {state}")
        for check in receipt["checks"]:
            emit(f"  check: {check['raw']}")
        emit(f"  gate: {fields.get('gate')}")
        emit("overnight: the close would run:")
        emit("  " + " ".join(argv))
        return 0
    code, out = run_write(argv, GH_TIMEOUT, deadline)
    if code != 0:
        emit(
            f"overnight: the close failed ({code}): {out.strip()}",
            err=True,
        )
        return 1
    emit(
        f"overnight: closed {args.repo}#{args.number}; the receipt holds the "
        "evidence."
    )
    return 0


def cmd_receipt(args: argparse.Namespace) -> int:
    """Write the receipt of every item whose state the shift can see.

    The command reads the board and the open pull requests, then writes one
    receipt per item: the state, the pull request, the checks and their
    exit codes, the gate's verdict, the files it touches, the builder's
    own time and why the item stopped. Everything in a receipt is read
    from GitHub, the queue or a thread, so a receipt never carries a model
    claim where a proof belongs.

    With `--repo` and `--number` it writes the receipt of that one item.
    With `--items` it writes the receipts of the first items of the shift's
    order."""
    deadline = time.monotonic() + args.deadline
    if args.fixture:
        return cmd_fixture_receipt(args)
    root = report_root(args.root)
    budget = budget_of(policy_snapshot(root))
    items, receipts, _drops, error = read_work_items(
        deadline, getattr(args, "allowed", None), budget
    )
    if error:
        emit(f"overnight: REFUSED: {error}", err=True)
        return 1
    if bool(args.repo) != bool(args.number):
        die(
            "the receipt of one item needs both --repo and --number; without "
            "both the command would write the receipt of every item"
        )
    if args.repo and args.number:
        picked = [
            item
            for item in items
            if item.get("repo") == args.repo
            and int(item.get("number") or 0) == args.number
        ]
        if not picked:
            emit(
                f"overnight: {args.repo}#{args.number} is not an item the shift "
                "works, so it has no receipt",
                err=True,
            )
            return 1
        items = picked
    elif args.items > 0:
        items = items[: args.items]
    if not items:
        emit("overnight: the board shows no item to write a receipt for")
        return 0
    emit(f"Overnight receipts - {len(items)} item(s)")
    write_receipts(root, items, receipts, deadline, dry_run=args.dry_run, budget=budget)
    if args.dry_run:
        emit()
        emit("A dry run writes no receipt.")
    return 0


def cmd_fixture_receipt(args: argparse.Namespace) -> int:
    """Write the receipt of a fixture item, under the budget.

    A fixture is a JSON file that describes one item: how long its
    builder ran, how many fix tries it used and, when it names them, the
    budget it is measured against. The receipt is written like any other
    receipt, so the budget can be shown on the real path: an item over
    its hard budget is written up as parked, and the morning report reads
    it like any other receipt."""
    root = report_root(args.root)
    budget = budget_of(policy_snapshot(root))
    facts, tries, budget, data = read_budget_fixture(args.fixture, budget)
    item = {
        "kind": "ticket",
        "repo": str(data.get("repo") or ""),
        "number": data.get("number") or 0,
        "key": str(data.get("key") or ""),
        "title": str(data.get("item") or ""),
        "url": "",
    }
    body = receipt_body(item, facts, 0)
    if args.dry_run:
        emit("--- fixture (dry run, nothing written) ---")
        emit(body, end="")
        return 0
    outcome = write_receipt(root, item, body)
    emit(f"overnight: wrote the receipt of the fixture item ({outcome})")
    emit(body, end="")
    return 0


def read_budget_fixture(path: str, fallback: dict) -> tuple[dict, int, dict, dict]:
    """Return the facts, the fix tries, the budget and the record of a fixture.

    A fixture is a JSON file that describes one item: how long its
    builder ran, how many fix tries it used and, when it names them, the
    budget it is measured against. A fixture that cannot be read is a
    refusal: the command never guesses an item's time."""
    file = Path(path).expanduser()
    text = read_text(file)
    if not text.strip():
        die(f"the fixture {file} is empty or cannot be read")
    try:
        data = json.loads(text)
    except ValueError as exc:
        die(f"the fixture {file} is not JSON: {exc}")
    if not isinstance(data, dict):
        die(f"the fixture {file} is not a JSON object")

    def number(name: str, default: int) -> int:
        value = data.get(name, default)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            die(f"the fixture {file} has no {name} number")
        return value

    minutes = number("builder_minutes", 0)
    tries = number("fix_tries", 0)
    budget = normalise_budget(
        {
            "soft": data.get("soft_budget_minutes", fallback["soft"]),
            "hard": data.get("hard_budget_minutes", fallback["hard"]),
            "retry_cap": data.get("retry_cap", fallback["retry_cap"]),
        }
    )
    facts = {
        "state": str(data.get("state") or STATE_STUCK),
        "pr": "",
        "checks": "",
        "failing": [],
        "gate": "UNKNOWN",
        "files": 0,
        "builder": "",
        "why": str(data.get("why") or ""),
        "next": "",
        "minutes": minutes,
    }
    return apply_budget(facts, tries, budget), tries, budget, data


def show_budget(
    facts: dict, tries: int, budget: dict, label: str, repo: str, number: object
) -> None:
    """Print what the budget does with one item.

    The write-up is the receipt's own lines, so what a person reads here
    is what the morning report reads tomorrow."""
    emit(f"Item: {label}")
    emit(f"Repo: {repo}")
    if number:
        emit(f"Number: {number}")
    emit(f"Builder time: {facts['minutes']} min")
    emit(f"Soft budget: {budget['soft']} min")
    emit(f"Hard budget: {budget['hard']} min")
    emit(f"Fix tries: {tries} of {budget['retry_cap']}")
    emit(f"Verdict: {facts.get('budget', BUDGET_WITHIN)}")
    emit("The receipt would hold:")
    emit(f"- State: {facts['state']}")
    emit(f"- Stopped because: {facts['why']}")
    emit(f"- Next: {facts['next']}")


def cmd_budget(args: argparse.Namespace) -> int:
    """Show what the budget does with one item.

    The command reads one item (or a fixture that describes one) and says
    what the shift does with it under the budget: within the budget, over
    the soft budget, stopped at the hard budget, or parked for want of fix
    tries. It writes nothing: the cycle writes the receipt, and this
    command shows the rule on a fixture, so the stop can be seen before
    the night does it.

    A fixture is a JSON file:

        {
          "item": "MO-999 the work",
          "repo": "shyamsivakumar/mac-ops",
          "number": 217,
          "builder_minutes": 9,
          "fix_tries": 0,
          "soft_budget_minutes": 5,
          "hard_budget_minutes": 8,
          "retry_cap": 2
        }

    With `--repo` and `--number` it reads the real item: the builder's
    own time and the fix tries the queue recorded."""
    deadline = time.monotonic() + args.deadline
    root = report_root(args.root)
    budget = budget_of(policy_snapshot(root))
    if args.fixture:
        facts, tries, budget, data = read_budget_fixture(args.fixture, budget)
        label = str(data.get("item") or Path(args.fixture).stem)
        repo = str(data.get("repo") or "")
        number = data.get("number") or ""
        emit("Overnight budget - fixture (read only)")
    else:
        if not args.repo or not args.number:
            die(
                "the budget command needs a fixture, or both --repo and "
                "--number; without them it would look for no item"
            )
        items, receipts, _drops, error = read_work_items(deadline, None, budget)
        if error:
            emit(f"overnight: REFUSED: {error}", err=True)
            return 1
        picked = [
            item
            for item in items
            if item.get("repo") == args.repo
            and int(item.get("number") or 0) == args.number
        ]
        if not picked:
            emit(
                f"overnight: {args.repo}#{args.number} is not an item the "
                "shift works, so it has no budget",
                err=True,
            )
            return 1
        item = picked[0]
        queue_state = read_queue_state()
        tries = fix_tries(queue_state, args.repo, args.number)
        facts = item_facts(item, receipts, deadline, budget, tries)
        label = item.get("key") or f"{args.repo}#{args.number}"
        repo = args.repo
        number = args.number
        emit("Overnight budget - item (read only)")
    show_budget(facts, tries, budget, label, repo, number)
    if args.dry_run:
        emit()
        emit("A dry run writes no receipt.")
    else:
        emit()
        emit("This command writes nothing: the cycle writes the receipt.")
    return 0


def read_work_items(
    deadline: float, allowed: list[str] | None, budget: dict | None = None
) -> tuple[list[dict], dict[str, str], list[tuple[dict, str]], str]:
    """Return the items the shift works, the queue's receipts, the drops and
    an error.

    The board is read with the same helpers the rest of the module uses, so
    the receipts are about the items of the shift's own order and the shift
    keeps no second queue. A board that cannot be trusted is an error, not
    an empty list: a receipt about a board nobody could read is a claim.

    The drops come with the items: a ticket the filter drops for a reason
    that waits for Shyam is a decision the shift cannot make, and the
    parking lot (part T10) holds it."""
    cfg = load_config()
    repos = policy_repos(cfg, allowed)
    flagged = ascend_flags(cfg)
    if not repos:
        return [], {}, [], "the board config names no repositories"
    issues, stale = read_board(deadline)
    if stale:
        return [], {}, [], "the board list is stale, so the receipts cannot be trusted"
    bodies, unread, open_numbers = read_bodies(issues, deadline)
    decisions_path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {decisions_path} could not be read")
    _kept, drops = filter_issues(
        issues, {r for r, _k in repos}, flagged, bodies, lines
    )
    if problems:
        return [], {}, [], "; ".join(problems)
    receipts, _receipt_error = read_receipts()
    result = collect_items(
        deadline, repos, issues, bodies, open_numbers, drops, receipts, budget
    )
    if result.get("pr_error"):
        return [], {}, [], str(result["pr_error"])
    return receipt_items(result), receipts, drops, ""


def write_receipts(
    root: Path,
    items: list[dict],
    receipts: dict[str, str],
    deadline: float,
    dry_run: bool = False,
    budget: dict | None = None,
) -> int:
    """Write the receipt of every item and return how many were written.

    A receipt is rewritten when the item's state or its evidence changed.
    A receipt that says the same thing is left alone, so the folder holds
    the record of the state changes and not a copy of the same state every
    cycle. The shift log names every write and every state change.

    The budget is applied to every receipt (part T8a), so an item over its
    hard builder-time budget, or out of fix tries, is written up as
    parked. The fix tries come from the queue's own record of the fixes
    it sent, so the shift keeps no count of its own."""
    budget = normalise_budget(budget if budget is not None else budget_of(policy_snapshot(root)))
    queue_state = read_queue_state()
    written = 0
    for item in items:
        started = time.monotonic()
        tries = (
            fix_tries(queue_state, item.get("repo") or "", item.get("number"))
            if item.get("kind") == "pull-request"
            else 0
        )
        facts = item_facts(item, receipts, deadline, budget, tries)
        observed = int(time.monotonic() - started + 0.5)
        body = receipt_body(item, facts, observed)
        path = receipt_path(root, item)
        label = item.get("key") or f"{item.get('repo')}#{item.get('number')}"
        if dry_run:
            emit()
            emit(f"--- {label} (dry run, nothing written) ---")
            emit(body, end="")
            continue
        # The state the receipt held before this run, read before the file
        # is written: a receipt read after the write holds the new state
        # and would never show a change.
        previous = ""
        if path.exists():
            previous = (parse_receipt(path)["fields"].get("state") or "").strip()
        outcome = write_receipt(root, item, body)
        change = bool(previous) and previous != facts["state"]
        emit(
            f"  {label} | {facts['state']} | gate {facts['gate']} | "
            f"{outcome}"
            + (f" | state {previous} -> {facts['state']}" if change else "")
        )
        if outcome.startswith("failed"):
            emit(f"overnight: {outcome}", err=True)
            continue
        written += 1
        write_shift_line(
            root,
            f"receipt {label} | {facts['state']} | {outcome}"
            + (f" | state {previous} -> {facts['state']}" if change else ""),
        )
    return written


def board_item(order: int, group: str, item: dict) -> dict:
    """Return one board item for the tick, with the action it needs.

    The item is small on purpose: the tick reads the whole board in one
    command, so the list has to fit in what a tool result holds. The
    detail a caller needs to act (the head, the gate, the builder) is
    here; the detail nobody acts on is not."""
    action = item.get("action") or "none"
    row = {
        "order": order,
        "state": item.get("state") or group,
        "updatedAt": item.get("updatedAt") or "",
        "builderLive": bool(item.get("builderLive")),
        "gateThreadLive": bool(item.get("gateThreadLive")),
        "group": group,
        "kind": item.get("kind"),
        "repo": item.get("repo"),
        "number": item.get("number"),
        "key": item.get("key") or "",
        "title": item.get("title") or "",
        "stage": item.get("stage"),
        "action": action,
        "actionReason": item.get("actionReason") or "",
        "actionCommand": item.get("actionCommand") or "",
    }
    if action != "none" and item.get("reason"):
        row["reason"] = item["reason"]
    if item.get("blockers"):
        row["blockers"] = item["blockers"]
    if item.get("kind") == "pull-request":
        row["head"] = item.get("head") or ""
        row["issue"] = item.get("issue") or 0
        row["draft"] = bool(item.get("isDraft"))
        row["failed"] = (item.get("checks") or {}).get("failed") or []
        if item.get("externalChecks"):
            row["externalChecks"] = list(item["externalChecks"])
        gate = item.get("gate") or {}
        row["gate"] = gate.get("status") or "none"
        if gate.get("threadId"):
            row["gateThread"] = gate["threadId"]
        builder = item.get("builder") or {}
        if builder.get("threadId"):
            row["builder"] = builder["threadId"]
        if builder.get("minutes") is not None:
            row["builderMinutes"] = builder["minutes"]
    if item.get("fixTries") is not None:
        row["fixTries"] = item["fixTries"]
    if item.get("split") is not None:
        row["split"] = bool(item.get("split"))
    return row


BOARD_RULES = {
    "start": (
        "run the dry run first: <actionCommand> --dry-run, and start for "
        "real only when the dry run says 'checks passed'. The ticket CLI "
        "refuses a ticket it may not start, and a refusal starts nothing."
    ),
    "gate": (
        "the queue gates the head and records it, so a head is never gated "
        "twice. A head whose builder check does not name it is not gated."
    ),
    "fix": (
        "the queue reads the gate's own report and sends it to the thread "
        "that built the pull request."
    ),
}


def cmd_board(args: argparse.Namespace) -> int:
    """Return the whole board for the tick, as JSON.

    The command reads only: it writes no file and keeps no list. The board
    is the list. Every item carries the one action the coordinator may
    take on it now, so the tick works the whole board instead of a window
    of it: it starts the ready work, queues a gate for every open pull
    request head that has none, and sends a failed gate's findings back to
    the builder that holds the pull request."""
    deadline = time.monotonic() + min(args.deadline, BOARD_DEADLINE)
    # The probe gets what is left of the board deadline, so a stalled
    # quota read cannot outlast a shorter --deadline.
    left = deadline - time.monotonic()
    # A budget under a second is no budget: a one-second floor would spend
    # time the caller does not have.
    remaining = (gh_gateway.remaining_or_none(timeout=max(1, min(GH_TIMEOUT, int(left))))
                 if left >= 1 else None)
    if remaining and min(remaining.values()) < API_FLOOR:
        # The board command promises the tick a JSON board on stdout. A
        # success with nothing on stdout would be parsed as an empty board,
        # so this is a refusal, not a quiet skip.
        emit(f"overnight: REFUSED: the board read waits below the API floor "
             f"{API_FLOOR} {remaining}", err=True)
        return 1
    cfg = load_config()
    budget = budget_of(policy_snapshot(report_root(getattr(args, "root", None))))
    repos = policy_repos(cfg, getattr(args, "allowed", None))
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    if stale:
        emit(
            "overnight: REFUSED: the board list is stale, so the board "
            "cannot be trusted.",
            err=True,
        )
        return 1
    bodies, unread, open_numbers = read_bodies(issues, deadline)
    decisions_path, lines = read_decisions()
    problems: list[str] = []
    if not lines:
        problems.append(f"the decisions log {decisions_path} could not be read")
    # A repository whose ticket text could not be read is not on the board:
    # its tickets cannot be classified, and a ticket that cannot be
    # classified is never acted on. The repositories are named, so the tick
    # says that it did not see them instead of working a board it did not
    # read.
    if unread:
        emit(
            "overnight: the ticket text of these repositories could not be "
            "read, so they are not on the board: " + ", ".join(unread),
            err=True,
        )
        issues = [issue for issue in issues if issue.get("repo") not in unread]
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    if problems:
        for problem in problems:
            emit(f"overnight: REFUSED: {problem}", err=True)
        return 1
    receipts, receipt_error = read_receipts()
    result = collect_items(
        deadline, repos, issues, bodies, open_numbers, drops, receipts, budget
    )
    if result.get("pr_error"):
        emit(f"overnight: REFUSED: {result['pr_error']}", err=True)
        return 1
    groups = (
        ("failing", result["failing"]),
        ("gate-pass", result["gate_pass"]),
        ("ready-split", result["split"]),
        ("ready-unsplit", result["unsplit"]),
        ("in-flight", result["in_flight"]),
        ("backlog", result["backlog"]),
    )
    items: list[dict] = []
    order = 0
    for name, bucket in groups:
        for item in bucket:
            order += 1
            row = board_item(order, name, item)
            if args.action and row["action"] == "none":
                continue
            items.append(row)
    actions = {"start": 0, "gate": 0, "fix": 0, "none": 0}
    for item in items:
        actions[item["action"]] = actions.get(item["action"], 0) + 1
    pull_requests = sum(1 for item in items if item["kind"] == "pull-request")
    no_gate = [
        item
        for item in items
        if item["kind"] == "pull-request" and item.get("gate") == "none"
    ]
    queue = result["queue"]
    live = result["live"]
    pr_items = [item for item in items if item["kind"] == "pull-request"]
    states = {}
    oldest = {}
    for item in pr_items:
        state = item["state"]
        states[state] = states.get(state, 0) + 1
        if state not in oldest or item["updatedAt"] < oldest[state]["updatedAt"]:
            oldest[state] = {key: item[key] for key in ("repo", "number", "updatedAt")}
    payload = {
        "command": "overnight board",
        "states": states,
        "oldestByState": oldest,
        "noAction": sum(item["action"] == "none" and item["state"] != "gate-running" and not item.get("builderLive") and not item.get("gateThreadLive") for item in pr_items),
        "tickAlarm": tick_alarm(),
        "generatedAt": datetime.now(PT).strftime("%Y-%m-%d %H:%M %Z"),
        "rules": BOARD_RULES,
        "budget": budget,
        "board": {
            "tickets": len(issues),
            "repositories": len(repos),
            "dropped": len(drops),
            "openPullRequests": pull_requests,
            "pullRequestsWithoutAGate": len(no_gate),
        },
        "unreadRepositories": unread,
        "actions": actions,
        "groups": {name: len(bucket) for name, bucket in groups},
        "gates": {
            "queuedHeads": len(queue["gatedHeads"]),
            "queuedTickets": len(queue["queuedTickets"]),
            "queueError": queue["error"],
            "receiptsError": receipt_error,
        },
        "live": {
            "threads": len(live["ids"]),
            "keys": len(live["keys"]),
            "error": live["error"],
        },
        "items": items,
    }
    emit(json.dumps(payload, separators=(",", ":")))
    return 0


# --- The cycle health check (spec part T14) ---------------------------------
#
# The tick ran these checks every tick (loop/tick.md, section 1b). The
# tick is retired for the 24x7 shift (MO-240), so the shift runs them at
# the start of every cycle instead. They are read only: they read the
# tools, the installed files, the board and the queue's log, and they
# change nothing.
#
# A finding the shift may fix under its own rules (resend, park) it
# fixes; anything else becomes an ALERT line in the cycle's report. The
# shift's board work is not built yet (spec part T5), so today every
# finding is an ALERT and the receipt names the action each one would
# take.

# The queue's own folder, the one the dispatcher writes and the ticket
# CLI reads.
QUEUE_DIR = Path(
    os.environ.get(
        "COORDQ_DIR", str(Path.home() / "Code" / "coordinator" / "queue")
    )
)
# The mac-ops checkout the installed files are compared against.
MAC_OPS_DIR = Path(
    os.environ.get("MAC_OPS_DIR", str(Path.home() / "Code" / "mac-ops"))
)
# The launchd job that runs the coordinator tools. Its plist says which
# interpreter it runs them with.
DISPATCH_PLIST = (
    Path.home() / "Library" / "LaunchAgents" / "dev.coordinator.dispatch.plist"
)
# The lines of the queue logs the check reads for a crash.
LOG_TAIL = 40
# The lines of the dispatch log the check reads for the refusals the
# queue recorded.
REFUSAL_TAIL = 400
# A refusal older than this is not a refusal any more: the queue records
# the refusal of every ticket it will not start on every pass, so a
# refusal this old means the ticket is not refused now.
REFUSAL_FRESH_MINUTES = 15
# A ticket started this many times has a broken spec.
ATTEMPT_LIMIT = 3
# The comment the ticket CLI writes when it starts a builder.
STARTING = re.compile(r"^Starting\s+\S+\s+attempt\s+(\d+)\b")
# The refusal the queue records for a ticket it will not start.
REFUSAL = re.compile(
    r"^(?P<at>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) refill refused "
    r"(?P<repo>[^\s:]+/[^\s#]+)#(?P<number>\d+): refused: (?P<reason>.*)"
)
# The issue a text blocker refusal names, in the two forms the ticket
# CLI writes: "owner/repo#12" and "SRW-1061 (#910)".
NAMED_ISSUE = re.compile(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)")
NAMED_KEY = re.compile(r"\b([A-Z]{2,5}-\d+)\s+\(#(\d+)\)")


def names_bare(line: str, prefix: str, number: int) -> bool:
    """True when a decisions log line names this issue in a list of numbers.

    The log writes a group of tickets with the key of the repository and
    the bare issue numbers ("SRW #720, #716, #692, #492"), so the key and
    the list are read together. A number in another repository's list is
    not this ticket's."""
    if not prefix:
        return False
    for match in re.finditer(
        rf"\b{re.escape(prefix)}\s+#(\d+(?:\s*,\s*#?\d+)*)", line, re.I
    ):
        if str(number) in re.findall(r"\d+", match.group(1)):
            return True
    return False


def decision_open(lines: list[str], key: str | None, number: int | None) -> bool:
    """True when the decisions log holds an open item for this ticket.

    The log names a ticket two ways: with its key and its issue number
    ("SRW-685 #468") and with the key of the repository and a list of
    bare issue numbers ("SRW #720, #716, #692"). Both are read, so a
    ticket the log already parked is not new drift. Only the last line
    about the ticket counts: the log is append-only history, and a line
    that closes the item closes it."""
    prefix = (key or "").partition("-")[0]
    last = None
    for line in lines:
        if names_ticket(line, key, number) or names_bare(line, prefix, number):
            last = line
    if last is None:
        return False
    if DECISION_HOLD.search(last) or DECISION_OPEN.search(last):
        return True
    if DECISION_STRONG.search(last):
        return True
    if DECISION_ASKS.search(last):
        return True
    if DECISION_ASKED.search(last) and not DECISION_CLOSED.search(last):
        return True
    if DECISION_QUESTION.search(last) and not DECISION_CLOSED.search(last):
        return True
    return False


def launchd_python() -> tuple[str, str]:
    """Return the interpreter launchd runs the coordinator tools with.

    The dispatch job runs `~/.local/bin/coordq`, and that script's
    shebang names the interpreter. The job's own PATH decides which
    `python3` that name means, so the interpreter is read the way
    launchd reads it: the plist says the PATH, the script says the name.
    The shell's own `python3` is never used here: it is an older one, and
    it hides the errors the launchd interpreter raises (2026-11-13: a
    duplicate parser argument stopped the dispatcher for 14 minutes)."""
    program = ""
    launchd_path = ""
    try:
        with DISPATCH_PLIST.open("rb") as stream:
            plist = plistlib.load(stream)
    except (OSError, ValueError):
        plist = {}
    arguments = plist.get("ProgramArguments") or []
    if arguments:
        program = str(arguments[0])
    environment = plist.get("EnvironmentVariables") or {}
    launchd_path = str(environment.get("PATH", ""))
    script = (
        Path(program).expanduser()
        if program
        else Path.home() / ".local" / "bin" / "coordq"
    )
    shebang = ""
    try:
        with script.open("r", errors="replace") as stream:
            shebang = stream.readline().strip()
    except OSError:
        shebang = ""
    name = ""
    if shebang.startswith("#!"):
        parts = shebang[2:].split()
        if parts and parts[0].endswith("/env"):
            name = parts[1] if len(parts) > 1 else ""
        elif parts:
            name = parts[0]
    if name.startswith("/"):
        return name, f"the shebang of {script}"
    if name:
        for folder in launchd_path.split(os.pathsep):
            candidate = Path(folder).expanduser() / name
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return str(candidate), f"the PATH of {DISPATCH_PLIST}"
    return "", ""


# The most bytes one queue log tail reads. The queue logs grow all day
# and are never rotated, so the tail is read from the end with a fixed
# byte budget: a log that grew for weeks cannot spend the cycle's time
# or its memory.
LOG_TAIL_BYTES = 512 * 1024


def queue_log_tail(
    name: str, lines: int, deadline: float | None = None
) -> tuple[list[str], str]:
    """Return the last lines of one queue log, and why they are missing.

    The read is bounded: it seeks to the end of the log and reads at most
    `LOG_TAIL_BYTES` bytes, so a huge log costs the same as a small one
    and the cycle cannot run out of time or memory on a log. A log that
    cannot be read is not an empty log: the caller has to say the check
    is incomplete instead of reporting that the log holds nothing."""
    if deadline is not None and deadline - time.monotonic() <= 0:
        return [], "the cycle ran out of time before the log could be read"
    try:
        with open(QUEUE_DIR / name, "rb") as stream:
            size = stream.seek(0, os.SEEK_END)
            start = max(0, size - LOG_TAIL_BYTES)
            stream.seek(start)
            raw = stream.read(LOG_TAIL_BYTES)
    except OSError as exc:
        return [], f"the log could not be read: {exc}"
    text = raw.decode("utf-8", errors="replace")
    if start:
        # The read began in the middle of a line, so that line is not a
        # line of the log and is dropped rather than counted.
        text = text.split("\n", 1)[1] if "\n" in text else ""
    tail = text.splitlines()[-lines:]
    if start and len(tail) < lines:
        return tail, "the byte limit prevented reading the requested line count"
    return tail, ""


def log_read_finding(check: str, path: str, error: str) -> dict:
    """Return the finding of a log that could not be read.

    A read that failed is never a clean result: the check that needed
    the log is incomplete, and the receipt must say so."""
    return {
        "check": check,
        "subject": str(path),
        "detail": (
            f"the {check} check is incomplete for the log: {error}"
        ),
        "action": "read the log by hand and fix what it says",
    }


def health_run(argv: list[str], deadline: float) -> tuple[int, str, str]:
    """Run one read-only command for a health check.

    A command that cannot run is a finding, not a crash: the check says
    what it could not do and the cycle carries on."""
    left = deadline - time.monotonic()
    if left <= 0:
        return 124, "", "the cycle ran out of time before the check could run"
    hit = gh_gateway.cached(argv)
    if hit is not None:
        return 0, hit, ""
    run_argv, headers_counted = gh_gateway.prepare(argv)
    try:
        result = subprocess.run(
            run_argv,
            capture_output=True,
            text=True,
            timeout=max(1, min(GH_TIMEOUT, int(left))),
            check=False,
        )
    except FileNotFoundError:
        return 127, "", f"{argv[0]} is not on PATH"
    except subprocess.TimeoutExpired:
        return 124, "", f"{' '.join(argv)} timed out"
    body, count = gh_gateway.settle(argv, result.stdout, headers_counted,
                                    failed=result.returncode != 0)
    gh_gateway.record(argv, count)
    if result.returncode == 0:
        gh_gateway.store(argv, body)
    return result.returncode, body, result.stderr or ""


def check_tools(deadline: float) -> tuple[list[str], list[dict]]:
    """Check the coordinator tools under the interpreter launchd uses.

    The tools are run, not read: a tool that breaks under the launchd
    interpreter is the break this check exists for. The queue's logs are
    read for the same reason: a traceback in the last lines of the
    dispatch or gatekeep log is a tool that broke."""
    ran: list[str] = []
    probes: list[dict] = []
    interpreter, source = launchd_python()
    if not interpreter:
        return ran, [
            {
                "check": "tools",
                "subject": "the launchd interpreter",
                "detail": (
                    "the interpreter launchd runs the coordinator tools with "
                    f"could not be found: {DISPATCH_PLIST} does not say, and "
                    "the installed coordq has no shebang"
                ),
                "action": "read the dispatch plist and the installed coordq",
            }
        ]
    ran.append(f"the interpreter {interpreter} (from {source})")
    folder = Path.home() / ".local" / "bin"
    for name, arguments in (("coordq", ["status"]), ("overnight", ["--help"])):
        script = folder / name
        command = [interpreter, str(script), *arguments]
        code, out, err = health_run(command, deadline)
        ran.append(f"`{' '.join(command)}` exit {code}")
        probes.append(
            {
                "name": name,
                "command": " ".join(command),
                "exit": code,
                "output": err or out,
            }
        )
    logs: list[dict] = []
    for name in ("dispatch.log", "gatekeep.log"):
        path = QUEUE_DIR / name
        lines, error = queue_log_tail(name, LOG_TAIL, deadline)
        if error:
            ran.append(f"the last {LOG_TAIL} lines of {path} could not be read")
        else:
            ran.append(f"the last {LOG_TAIL} lines of {path}")
        logs.append({"path": str(path), "lines": lines, "error": error})
    return ran, tool_findings(probes, logs)


def tool_findings(probes: list[dict], logs: list[dict]) -> list[dict]:
    """Return the findings of the tool probes and the log tails.

    The probes and the log tails are injected: the caller reads them and
    this function only reads what it is given. The proof drives it with
    fixtures, so it never touches the machine."""
    findings: list[dict] = []
    for probe in probes:
        code = probe.get("exit")
        if not code:
            continue
        tail = (probe.get("output") or "").strip().splitlines()[-3:]
        findings.append(
            {
                "check": "tools",
                "subject": str(probe.get("name") or probe.get("command") or "the tool"),
                "detail": (
                    f"`{probe.get('command', '')}` failed (exit {code}) under "
                    "the launchd interpreter: " + " | ".join(tail)
                ),
                "action": (
                    "run the same command under the launchd interpreter and "
                    "fix what it raises"
                ),
            }
        )
    for entry in logs:
        error = entry.get("error")
        if error:
            # The log could not be read, so the crash check is
            # incomplete for it: a log nobody could read is not a log
            # without a traceback.
            findings.append(
                log_read_finding("tools", str(entry.get("path", "")), str(error))
            )
            continue
        for line in entry.get("lines") or []:
            if "Traceback" in line:
                findings.append(
                    {
                        "check": "tools",
                        "subject": Path(str(entry.get("path", ""))).name,
                        "detail": (
                            f"the last {LOG_TAIL} lines of {entry.get('path')} "
                            f"hold a traceback: {line.strip()[:160]}"
                        ),
                        "action": "read the traceback in the log and fix the tool",
                    }
                )
                break
    return findings


def check_install(deadline: float) -> tuple[list[str], list[dict]]:
    """Check that the installed coordinator matches the merged main.

    The installer's own status says it: it compares the installed files
    with the checkout and reports `in_sync` and `differs`. An installed
    file from an unmerged branch is drift (2026-11-13: the installed
    coordq came from a branch that was never merged)."""
    ran: list[str] = []
    script = MAC_OPS_DIR / "install_coordinator.py"
    interpreter, _source = launchd_python()
    python = interpreter or sys.executable
    command = [python, str(script), "status"]
    code, out, err = health_run(command, deadline)
    ran.append(f"`{' '.join(command)}` exit {code}")
    if code != 0:
        return ran, [
            {
                "check": "install",
                "subject": str(script),
                "detail": (
                    "the install status could not be read (exit "
                    f"{code}): "
                    + (
                        (err or out).strip().splitlines()[-1][:160]
                        if (err or out).strip()
                        else "no output"
                    )
                ),
                "action": "read the install status by hand",
            }
        ]
    try:
        status = json.loads(out)
    except ValueError:
        return ran, [
            {
                "check": "install",
                "subject": str(script),
                "detail": "the install status did not return JSON",
                "action": "read the install status by hand",
            }
        ]
    return ran, install_findings(status)


def install_findings(status: dict) -> list[dict]:
    """Return the findings of the install status.

    The status is injected: the caller reads it and this function only
    reads what it is given. The proof drives it with a fixture."""
    if status.get("in_sync"):
        return []
    differs = [str(item) for item in (status.get("differs") or [])]
    return [
        {
            "check": "install",
            "subject": str(MAC_OPS_DIR / "install_coordinator.py"),
            "detail": (
                "the installed coordinator differs from the merged main: "
                + (", ".join(differs) if differs else "the status does not say")
            ),
            "action": (
                "find the branch the installed file came from, tell that "
                "builder to stop installing, and reinstall from main once "
                "the pull requests merge"
            ),
        }
    ]


def check_attempts(
    issues: list[dict],
    repos: list[tuple[str, str]],
    deadline: float,
    stale: bool = False,
) -> tuple[list[str], list[dict]]:
    """Check the tickets that were started again and again with no pull request.

    A ticket the ticket CLI started three or more times has a broken
    spec: the builder reads the same brief and stops the same way. The
    check counts the `Starting ... attempt` comments and asks the open
    pull requests whether one of them carries the ticket.

    A stale board is not a board with no tickets: the list could not be
    refreshed, so the tickets it names are not known, and the check is
    incomplete rather than clean."""
    ran: list[str] = []
    findings: list[dict] = []
    if stale:
        # The board could not be refreshed. An empty stale board would
        # skip every repository and report no finding, so the receipt
        # would show a clean check that never ran.
        findings.append(
            {
                "check": "attempts",
                "subject": "the board",
                "detail": (
                    "the board list is stale, so the attempts check is "
                    "incomplete: no ticket is classified"
                ),
                "action": "read the board again and run the check again",
            }
        )
        ran.append("the board list is stale, so no ticket was classified")
        return ran, findings
    decisions_path, decisions, decisions_error = read_decisions_checked()
    if decisions_error:
        # The log that parks tickets could not be read, so which tickets
        # are already parked is not known: the check is incomplete and
        # classifies nothing, instead of reporting parked work as drift.
        findings.append(
            log_read_finding("attempts", str(decisions_path), decisions_error)
        )
        ran.append(
            f"{decisions_path} could not be read, so no ticket was classified"
        )
        return ran, findings
    board: dict[str, list[dict]] = {}
    for issue in issues:
        board.setdefault(issue.get("repo", ""), []).append(issue)
    records: list[dict] = []
    for repo, _key in repos:
        tickets = board.get(repo, [])
        if not tickets:
            continue
        try:
            raw = run(
                [
                    GH,
                    "issue",
                    "list",
                    "-R",
                    repo,
                    "--state",
                    "open",
                    "--limit",
                    str(ISSUE_LIMIT),
                    "--json",
                    "number,title,comments",
                ],
                GH_TIMEOUT,
                deadline,
            )
        except RepoError as exc:
            findings.append(
                {
                    "check": "attempts",
                    "subject": repo,
                    "detail": (
                        "the issue list could not be read, so the tickets of "
                        f"this repository are not classified: {exc}"
                    ),
                    "action": "read the board by hand and start what the shift can work",
                }
            )
            continue
        try:
            rows = json.loads(raw)
        except ValueError:
            findings.append(
                {
                    "check": "attempts",
                    "subject": repo,
                    "detail": (
                        "the issue list did not return JSON, so the tickets of "
                        "this repository are not classified"
                    ),
                    "action": "read the board by hand and start what the shift can work",
                }
            )
            continue
        rows = rows if isinstance(rows, list) else []
        ran.append(f"the open issues of {repo} with their comments")
        if len(rows) >= ISSUE_LIMIT:
            findings.append(
                {
                    "check": "attempts",
                    "subject": repo,
                    "detail": (
                        f"the issue list was cut off at {ISSUE_LIMIT}, so the "
                        "attempts of every ticket are not known"
                    ),
                    "action": "raise the issue limit and run the check again",
                }
            )
        attempts: dict[int, int] = {}
        truncated: set[int] = set()
        for row in rows:
            number = row.get("number")
            if not isinstance(number, int):
                continue
            comments = row.get("comments") or []
            if len(comments) >= ISSUE_COMMENT_LIMIT:
                # The issue list carries the first comments of an issue
                # only, so the starts past the limit are not known: the
                # ticket is not classified from a list that is not whole.
                truncated.add(number)
                continue
            count = 0
            for comment in comments:
                if STARTING.match((comment.get("body") or "").strip()):
                    count += 1
            attempts[number] = count
        for number in sorted(truncated):
            findings.append(
                {
                    "check": "attempts",
                    "subject": f"{repo}#{number}",
                    "detail": (
                        f"the issue's comments were cut off at "
                        f"{ISSUE_COMMENT_LIMIT}, so the number of starts is "
                        "not known and the ticket is not classified"
                    ),
                    "action": (
                        "read the issue's comments and count the starts"
                    ),
                }
            )
        try:
            pulls, cut = read_pull_requests(repo, deadline)
        except RepoError as exc:
            findings.append(
                {
                    "check": "attempts",
                    "subject": repo,
                    "detail": (
                        "the open pull requests could not be read, so the "
                        f"tickets of this repository are not classified: {exc}"
                    ),
                    "action": "read the pull requests by hand",
                }
            )
            # The tickets of this repository are not classified at all: a
            # missing pull request list is not the same as an empty one,
            # and a ticket with no open pull request must not be reported
            # from a list nobody could read.
            ran.append(f"the open pull requests of {repo} could not be read")
            continue
        if cut:
            # A list that was cut off at the limit is not a list with no
            # pull requests: the ones past the limit are missing, so a
            # ticket that has one would look like it has none. The
            # tickets of this repository are not classified at all.
            findings.append(
                {
                    "check": "attempts",
                    "subject": repo,
                    "detail": (
                        f"the open pull request list was cut off at {PR_LIMIT}, "
                        "so the tickets of this repository are not classified: "
                        "a pull request past the limit would look like none"
                    ),
                    "action": (
                        "raise the pull request limit and run the check again"
                    ),
                }
            )
            ran.append(
                f"the open pull requests of {repo} were cut off at {PR_LIMIT}"
            )
            continue
        ran.append(f"the open pull requests of {repo}")
        by_number = {item["number"]: item for item in tickets if item.get("number")}
        by_key = {
            (item.get("key") or "").upper(): item
            for item in tickets
            if item.get("key")
        }
        carried: set[int] = set()
        for row in pulls:
            target, _signal = linked_ticket(row, by_number, by_key)
            if target is not None and target.get("number"):
                carried.add(target["number"])
        for issue in tickets:
            number = issue.get("number")
            if number in truncated:
                # The comments of this issue were cut off, so its starts
                # are not known and the ticket is not classified.
                continue
            records.append(
                {
                    "repo": repo,
                    "number": number,
                    "key": issue.get("key") or "",
                    "attempts": attempts.get(number, 0),
                    "carried": number in carried,
                    "parked": bool(
                        decision_open(decisions, issue.get("key"), number)
                    ),
                }
            )
    return ran, findings + attempt_findings(records)


def attempt_findings(records: list[dict]) -> list[dict]:
    """Return the findings of the ticket records.

    The records are injected: the caller reads them and this function
    only reads what it is given. A record says how many times a ticket
    was started, whether an open pull request carries it and whether the
    decisions log holds an open item for it. The proof drives it with
    fixtures."""
    findings: list[dict] = []
    for record in records:
        count = record.get("attempts", 0)
        if count < ATTEMPT_LIMIT:
            continue
        if record.get("carried") or record.get("parked"):
            continue
        label = record.get("key") or record.get("number")
        findings.append(
            {
                "check": "attempts",
                "subject": f"{record.get('repo')}#{record.get('number')}",
                "detail": (
                    f"{label} was started {count} times and has no open "
                    "pull request"
                ),
                "action": (
                    "read the last builder report, then reword the brief "
                    "or park the ticket and open a re-spec ticket"
                ),
            }
        )
    return findings


def check_blockers(deadline: float) -> tuple[list[str], list[dict]]:
    """Check the text blocker refusals that name a closed issue.

    The queue records the refusal of every ticket it will not start. A
    refusal whose text blocker names an issue that is closed is a false
    blocker: the ticket waits for something that is already finished
    (2026-11-13: four FFBT tickets were held by a false text blocker)."""
    ran: list[str] = []
    path = QUEUE_DIR / "dispatch.log"
    lines, error = queue_log_tail("dispatch.log", REFUSAL_TAIL, deadline)
    if error:
        # The log could not be read, so the text blocker check is
        # incomplete: a log nobody could read is not a log without a
        # refusal. The receipt must not claim the log was read.
        ran.append(f"the last {REFUSAL_TAIL} lines of {path} could not be read")
        return ran, [log_read_finding("blockers", str(path), error)]
    ran.append(f"the last {REFUSAL_TAIL} lines of {path}")
    latest: dict[tuple[str, str], str] = {}
    now = datetime.now()
    for line in lines:
        match = REFUSAL.search(line)
        if not match:
            continue
        moment = None
        try:
            moment = datetime.strptime(match.group("at"), "%Y-%m-%d %H:%M:%S")
        except ValueError:
            moment = None
        if moment is not None:
            age = (now - moment).total_seconds() / 60
            if age > REFUSAL_FRESH_MINUTES:
                # The queue does not refuse this ticket any more, so the
                # refusal it left behind is history, not drift.
                continue
        latest[(match.group("repo"), match.group("number"))] = match.group("reason")
    refusals = [
        {"repo": repo, "number": number, "reason": reason}
        for (repo, number), reason in sorted(latest.items())
    ]
    states: dict[tuple[str, int], str] = {}
    unread: dict[tuple[str, int], str] = {}
    for refusal in refusals:
        for target, target_number in named_issues(refusal["reason"], refusal["repo"]):
            key = (target, target_number)
            if key in states or key in unread:
                continue
            code, out, _err = health_run(
                [GH, "api", f"repos/{target}/issues/{target_number}"],
                deadline,
            )
            state = ""
            if code == 0:
                try:
                    state = str(json.loads(out).get("state") or "")
                except ValueError:
                    state = ""
            if not state:
                # The state of the issue was never established, so this
                # check is incomplete for it. It says so instead of
                # reporting that the blocker is not false.
                unread[key] = (
                    f"the state of {target}#{target_number} could not be "
                    "read, so the text blocker check is incomplete for it"
                )
            else:
                states[key] = state
    return ran, blocker_findings(refusals, states, unread)


def named_issues(reason: str, repo: str) -> list[tuple[str, int]]:
    """Return the issues a refusal names.

    The two forms the ticket CLI writes are read: "owner/repo#12" and
    "SRW-1061 (#910)". The key form names an issue of the refused
    ticket's own repository."""
    tail = reason.split("text blockers:", 1)[1] if "text blockers:" in reason else reason
    named: list[tuple[str, int]] = [
        (match.group(1), int(match.group(2))) for match in NAMED_ISSUE.finditer(tail)
    ]
    named += [(repo, int(match.group(2))) for match in NAMED_KEY.finditer(tail)]
    return named


def blocker_findings(
    refusals: list[dict],
    states: dict[tuple[str, int], str],
    unread: dict[tuple[str, int], str] | None = None,
) -> list[dict]:
    """Return the findings of the recorded refusals.

    The refusals and the states are injected: the caller reads them and
    this function only reads what it is given. An issue whose state was
    never read is an incomplete check, not a blocker that is fine. The
    proof drives it with fixtures."""
    unread = unread or {}
    findings: list[dict] = []
    for refusal in refusals:
        if "text blockers:" not in refusal.get("reason", ""):
            continue
        subject = f"{refusal.get('repo')}#{refusal.get('number')}"
        for target, target_number in named_issues(refusal["reason"], refusal["repo"]):
            key = (target, target_number)
            if key in unread:
                findings.append(
                    {
                        "check": "blockers",
                        "subject": subject,
                        "detail": unread[key],
                        "action": (
                            "read the issue, then reword the body so the "
                            "Blocked by section names only real blockers"
                        ),
                    }
                )
                continue
            if states.get(key) != "closed":
                continue
            findings.append(
                {
                    "check": "blockers",
                    "subject": subject,
                    "detail": (
                        f"the refusal names {target}#{target_number}, which is "
                        "closed, so the text blocker is false"
                    ),
                    "action": (
                        "reword the body so the Blocked by section names only "
                        "real blockers"
                    ),
                }
            )
    return findings


def health_cycle(
    root: Path,
    issues: list[dict],
    repos: list[tuple[str, str]],
    deadline: float,
    stale: bool = False,
) -> tuple[list[str], list[dict]]:
    """Run the four health checks of one cycle.

    Every check says what it ran and what it found, so a reader can tell
    a check that passed from a check that never ran. The receipt holds
    one line per finding.

    The board is stale when it could not be refreshed: the check that
    reads the board is then incomplete, and says so."""
    lines: list[str] = []
    findings: list[dict] = []
    checks = (
        (
            "the coordinator tools under the interpreter launchd uses",
            lambda: check_tools(deadline),
        ),
        (
            "the installed coordinator matches the merged main",
            lambda: check_install(deadline),
        ),
        (
            "a ticket started three or more times with no open pull request",
            lambda: check_attempts(issues, repos, deadline, stale),
        ),
        (
            "a text blockers refusal that names a closed issue",
            lambda: check_blockers(deadline),
        ),
    )
    for title, run_check in checks:
        lines.append(f"- Check: {title}")
        ran, found = run_check()
        for line in ran:
            lines.append(f"- Ran: {line}")
        lines.append(
            f"- Result: {'no finding' if not found else f'{len(found)} finding(s)'}"
        )
        for finding in found:
            lines.append(
                f"- Finding: {finding['subject']}: {finding['detail']} "
                f"(action: {finding['action']})"
            )
        findings.extend(found)
    return lines, findings


def write_cycle_receipt(
    root: Path, stamp: str, name: str, lines: list[str], findings: list[dict]
) -> Path:
    """Write the receipt of one cycle's health checks and return its path."""
    path = root / "receipts" / f"cycle-{name}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    body = [f"# Cycle health - {stamp}", ""]
    body.append(f"- Cycle: {stamp}")
    body.append(f"- Findings: {len(findings)}")
    body.extend(lines)
    path.write_text("\n".join(body) + "\n")
    return path


def cycle_receipts(receipts_dir: Path) -> list[tuple[str, list[str]]]:
    """Return the health receipts of the shift, with their findings.

    A cycle receipt is not a ticket receipt: it is the record of the
    checks one cycle ran, so the report reads it apart from the items."""
    found: list[tuple[str, list[str]]] = []
    if not receipts_dir.is_dir():
        return found
    for path in sorted(receipts_dir.glob("cycle-*.md")):
        stamp = ""
        findings: list[str] = []
        for line in read_text(path).splitlines():
            if line.startswith("- Cycle: "):
                stamp = line[len("- Cycle: ") :].strip()
            elif line.startswith("- Finding: "):
                findings.append(line[len("- Finding: ") :].strip())
        found.append((stamp, findings))
    return found


# --- Part T10: the parking lot and the snag log ---------------------------
#
# The shift works the board on its own and cannot make every decision. A
# decision it cannot make is parked in `inbox/parking-lot.md`: the default
# that applies when Shyam says nothing, and a recommendation. A problem the
# shift finds is written to `inbox/snag-log.md` with what the shift did.
#
# The shift never answers an approval request. It reads the request from the
# thread that holds it, parks it with its exact text and moves on. This
# module has no call that answers a request, and the proof runs the command
# with a T3 stub that fails on every call but a read.

PARKING_FILE = "parking-lot.md"
SNAG_FILE = "snag-log.md"
# A thread that waits on a person says so in its status.
PENDING_STATUS = frozenset(
    {
        "waiting",
        "waiting_for_approval",
        "waiting_for_input",
        "awaiting_approval",
        "pending_approval",
        "needs_input",
        "needs_approval",
    }
)
# The item that holds a request says so in its type.
REQUEST_ITEM = frozenset(
    {
        "question",
        "user_question",
        "approval",
        "approval_request",
        "pending_request",
        "request",
    }
)
# The drops that are decisions the shift cannot make. A ticket the
# filter drops for one of these reasons waits for Shyam, so it belongs
# in the parking lot. A ticket dropped as Ascend work, or as being off
# the allow list, is not a decision: it is work the shift never touches.
DECISION_DROP = (
    "marked needs Shyam",
    "marked design needed",
    "open question in the decisions log",
    "open item in the decisions log",
    "hold in the decisions log",
)
# A quoted request can hold a fence of its own. The fence that quotes it
# is longer than any fence in the request, and the parser closes a fence
# only on the exact delimiter that opened it.
FENCE_RUN = re.compile(r"`+")


def code_fence(text: str) -> str:
    """Return a fence delimiter that no fence inside the text can close."""
    longest = 0
    for run in FENCE_RUN.findall(text or ""):
        longest = max(longest, len(run))
    return "`" * max(3, longest + 1)


def quoted_text(text: str) -> str:
    """Return the text quoted in a fence that cannot be closed early.

    The delimiter is longer than any fence in the text, so a fence inside
    the quote never closes the fence that holds the quote. The parser
    matches the delimiter exactly, so the quote ends where it ends."""
    fence = code_fence(text)
    return f"{fence}text\n{text}\n{fence}\n"


def stamp_line() -> str:
    """Return the time a record carries, in Pacific time."""
    return datetime.now(PT).strftime("%Y-%m-%d %I:%M %p PT")


def request_is_answered(item: dict) -> bool:
    """Return True when a request item was already answered.

    A request that carries an answer, a status that says it is closed or
    a flag that says it was resolved is not waiting for anybody, and the
    shift must not park it as if it were. The answer alone is enough: an
    item that holds the answer payload was answered, whatever its flags
    and its status say."""
    for name in ("resolved", "answered", "done", "closed"):
        if item.get(name) is True:
            return True
    status = str(item.get("status") or "").strip().lower()
    if status in (
        "answered",
        "resolved",
        "closed",
        "cancelled",
        "canceled",
        "done",
    ):
        return True
    return carries_answer(item)


# The fields an item can carry its answer in. An item that holds one of
# them, with something in it, was answered.
ANSWER_PAYLOAD_FIELDS = (
    "answer",
    "answerText",
    "answerPayload",
    "answeredText",
    "response",
    "reply",
    "resolution",
)
# A payload that says the answer is still to come is not an answer.
NO_ANSWER_YET = frozenset(
    {"", "none", "null", "nil", "pending", "unanswered", "waiting", "n/a", "-"}
)


def carries_answer(item: dict) -> bool:
    """Return True when an item holds the payload of an answer."""
    for name in ANSWER_PAYLOAD_FIELDS:
        if name not in item:
            continue
        value = item.get(name)
        if value is True:
            return True
        if isinstance(value, str):
            if value.strip().lower() not in NO_ANSWER_YET:
                return True
            continue
        if isinstance(value, (dict, list, tuple)) and value:
            return True
    return False


def pending_request_from(data: dict) -> dict:
    """Return the pending request of a thread, with its exact text.

    A thread that waits on a person holds a pending request: an approval
    it must be given, or a question it asked. The text is the request's
    own text, read from the thread and never paraphrased, so the person
    who answers it reads the same words the tool showed.

    The request that is parked is the last one the thread holds that is
    still open. A question that was answered is not a request any more,
    and the shift must not park an old question as if it waited for an
    answer. A thread that holds nothing but answered requests waits for
    nobody, even when it says it holds a pending one. A thread that
    waits on nobody holds no request at all."""
    thread = data.get("thread") or {}
    count = thread.get("pendingRequestCount")
    try:
        pending = int(count or 0) > 0
    except (TypeError, ValueError):
        pending = False
    status = str(thread.get("status") or "").strip().lower()
    if status in PENDING_STATUS:
        pending = True
    kind = "pending request"
    text = ""
    if pending:
        requests = [
            item
            for item in (data.get("items") or [])
            if isinstance(item, dict)
            and str(item.get("type") or "").strip().lower() in REQUEST_ITEM
        ]
        open_requests = [item for item in requests if not request_is_answered(item)]
        if requests and not open_requests:
            # Every request the thread holds was answered, so the thread
            # waits for nobody. A thread that says it holds a pending
            # request and shows only answered ones is not a request the
            # shift may park.
            pending = False
        if open_requests:
            # The request that is parked is the last open one the thread
            # holds. Its own text is the text that is parked: when it has
            # no readable text, the shift says so and logs the problem
            # instead of parking an older request in its place.
            latest = open_requests[-1]
            body = (
                latest.get("text")
                or latest.get("prompt")
                or latest.get("question")
                or latest.get("body")
                or ""
            )
            text = str(body).strip()
            item_type = str(latest.get("type") or "").strip().lower()
            if "approval" in item_type or "approv" in text.lower():
                kind = "pending approval request"
    return {"pending": pending, "text": text, "kind": kind}


def read_thread_record(thread_id: str, deadline: float) -> tuple[dict, str]:
    """Return a thread's own record, read from T3, and why it could not be
    read.

    The read is the only call the shift makes on a thread that holds a
    pending request. It never sends, approves or answers anything. A
    read that fails says so, because a thread the shift could not read
    may hold a request the shift does not know about."""
    if not thread_id:
        return {}, ""
    payload = json.dumps(
        {"threadId": thread_id, "maxCharsPerItem": 20000, "runLimit": 50}
    )
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
    except RepoError as exc:
        return {}, str(exc)
    try:
        data = json.loads(raw)
    except ValueError as exc:
        return {}, f"the thread {thread_id} did not return JSON: {exc}"
    if not isinstance(data, dict):
        return {}, f"the thread {thread_id} did not return an object"
    thread = data.get("thread")
    if (
        not isinstance(thread, dict)
        or not thread
        or not isinstance(thread.get("status"), str)
        or not thread["status"].strip()
    ):
        return {}, f"the thread {thread_id} returned an empty or malformed thread record"
    return data, ""


def item_threads(item: dict, receipts: dict[str, str]) -> list[str]:
    """Return the threads that hold one item: its builder and its gate.

    Two sources, and only two. The threads the board attaches to the item
    are taken as they are. The queue's dispatch receipts are looked up by
    the ticket's number and by nothing else, because a pull request has
    two numbers and its own number is not its ticket's: pull request #435
    linked to issue #188 would otherwise pick up the threads of an
    unrelated ticket #435, and park that ticket's pending request under
    #188. A pull request with no linked ticket therefore contributes no
    receipt thread at all."""
    threads: list[str] = []
    for name in ("builder", "gate"):
        entry = item.get(name)
        thread = str(entry.get("threadId") or "") if isinstance(entry, dict) else ""
        if thread and thread not in threads:
            threads.append(thread)
    repo = str(item.get("repo") or "")
    number = receipt_number(item)
    if number not in (None, ""):
        try:
            value = int(number)
        except (TypeError, ValueError):
            value = 0
        if value:
            builder, _attempt = builder_thread(receipts, repo, value)
            if builder and builder not in threads:
                threads.append(builder)
            prefix = f"gate:{repo}#{value}:"
            for key, receipt_thread in sorted(receipts.items()):
                if key.startswith(prefix) and receipt_thread:
                    if receipt_thread not in threads:
                        threads.append(receipt_thread)
    return threads


def parking_section(title: str, fields: list[tuple[str, str]]) -> str:
    """Return one parking lot entry.

    The entry is markdown with one `- Key: value` line per field, the
    shape the receipt holds, so the morning report reads the parking lot
    with the parser it already has: a `Default:` line and a `Recommend:`
    line are what make an entry a decision Shyam can take."""
    lines = [f"## {title}", ""]
    for key, value in fields:
        if value:
            lines.append(f"- {key}: {value}")
    return "\n".join(lines) + "\n"


def parking_lot_text(entries: list[str]) -> str:
    """Return the parking lot file: the decisions that wait for Shyam."""
    header = (
        "# Parking lot\n"
        "\n"
        "The decisions the shift could not make. Each entry names the default\n"
        "that applies when Shyam says nothing and a recommendation. The shift\n"
        "never answers an approval request: a pending request is parked with\n"
        "its exact text and left alone.\n"
        "\n"
    )
    if not entries:
        return header + (
            "No decision is parked. The shift made every decision it could.\n"
        )
    return header + "\n".join(entries)


def snag_section(title: str, fields: list[tuple[str, str]]) -> str:
    """Return one snag log entry."""
    lines = [f"## {title}", ""]
    for key, value in fields:
        if value:
            lines.append(f"- {key}: {value}")
    return "\n".join(lines) + "\n"


def snag_log_text(entries: list[str]) -> str:
    """Return the snag log file: the problems the shift found."""
    header = (
        "# Snag log\n"
        "\n"
        "The problems the shift found and what it did about them. One section\n"
        "per problem. A problem the shift finds twice is written once.\n"
        "\n"
    )
    if not entries:
        return header + "No problem was found.\n"
    return header + "\n".join(entries)


def parse_snags(text: str) -> list[dict]:
    """Return the snag entries the log holds.

    Each entry is a section: a heading with the time and the item, and
    the fields under it. The time changes every cycle, so the identity
    of an entry is the item and the problem, not the time."""
    entries: list[dict] = []
    title = ""
    body: list[str] = []
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.startswith("## "):
            if title:
                entries.append({"title": title, "body": body})
            title = line[3:].strip()
            body = []
        elif title:
            body.append(line)
    if title:
        entries.append({"title": title, "body": body})
    for entry in entries:
        fields = []
        for line in entry["body"]:
            match = FIELD_LINE.match(line.strip())
            if not match:
                continue
            fields.append(
                (match.group("key").strip(), match.group("value").strip())
            )
        entry["identity"] = snag_identity(entry["title"], fields)
    return entries


def snag_identity(
    title: str, fields: list[tuple[str, str]]
) -> tuple[str, str, str, str]:
    """Return what makes a snag entry the same problem as another.

    The identity is the repository, the ticket, the item's number and the
    problem. Two tickets that share a title and a failing check are two
    problems, so the identity holds the repository and the ticket as well
    as the title. The time is not part of it: a problem the shift finds
    every cycle is one problem, not one problem per cycle."""
    repo = ""
    ticket = ""
    problem = ""
    for key, value in fields:
        name = key.strip().lower()
        if name == "repo":
            repo = value.strip().lower()
        elif name == "ticket":
            ticket = value.strip().upper()
        elif name == "problem":
            problem = value.strip()
    number = ""
    found = re.search(r"#\s*(\d+)", title)
    if found:
        number = found.group(1)
    return (repo, ticket, number, problem)


def keep_first_seen(entry: str, seen: dict[str, str]) -> str:
    """Return the entry with the time the decision started waiting.

    A decision that waits keeps the time it was first parked, so the
    file does not change every cycle and the record says how long the
    decision has waited."""
    lines = entry.splitlines(keepends=True)
    if not lines or not lines[0].startswith("## "):
        return entry
    old = seen.get(lines[0][3:].strip())
    if not old:
        return entry
    for index, line in enumerate(lines):
        if line.startswith("- Parked at:"):
            lines[index] = f"- Parked at: {old}\n"
            break
    return "".join(lines)


def write_parking_lot(root: Path, entries: list[str]) -> str:
    """Write the parking lot and return what happened.

    The file holds the decisions that wait for Shyam now. It is written
    whole, so a decision that is no longer waiting leaves the file and
    the morning report never names a decision that is gone. A decision
    that is still waiting keeps the time it was first parked."""
    path = root / "inbox" / PARKING_FILE
    seen = {
        entry["title"]: entry["parked"]
        for entry in parse_parking_lot(read_text(path))
        if entry["parked"]
    }
    text = redact(
        parking_lot_text([keep_first_seen(entry, seen) for entry in entries])
    )
    if read_text(path) == text:
        return "unchanged"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        scratch = path.with_name(path.name + ".tmp")
        write_record(scratch, text)
        os.replace(scratch, path)
    except OSError as exc:
        return f"failed: {exc}"
    return "wrote"


def write_snag_log(root: Path, entries: list[tuple[str, list[tuple[str, str]]]]) -> str:
    """Write the snag log and return what happened.

    The log is a history: a problem the shift found is written once and
    stays. A problem that is still there is not written again, so the log
    holds the problems and not the cycles. The identity of a problem is
    the item and the problem itself, so the time in the heading does not
    make a new problem out of an old one."""
    path = root / "inbox" / SNAG_FILE
    text = read_text(path) or snag_log_text([])
    known = {entry["identity"] for entry in parse_snags(text)}
    added = []
    for title, fields in entries:
        identity = snag_identity(title, fields)
        if identity in known:
            continue
        known.add(identity)
        added.append(snag_section(title, fields))
    if not added:
        return "unchanged"
    body = text.rstrip("\n") + "\n\n" + "\n".join(added)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        scratch = path.with_name(path.name + ".tmp")
        write_record(scratch, redact(body))
        os.replace(scratch, path)
    except OSError as exc:
        return f"failed: {exc}"
    return f"wrote {len(added)}"


def item_title(item: dict) -> str:
    """Return the name a parked entry carries for one item.

    The board's title often starts with the ticket's own key, so the key
    is dropped from it: an entry names the item once."""
    key = str(item.get("key") or "")
    number = item.get("number")
    label = f"{key} (#{number})" if key else f"{item.get('repo')}#{number}"
    title = " ".join(str(item.get("title") or "").split())
    if key and title.upper().startswith(key.upper()):
        title = title[len(key) :].strip(" -:·")
    return f"{label} · {title}" if title else label


def read_shift_receipts(root: Path) -> dict[tuple[str, str], dict]:
    """Return the shift's own receipts, keyed by repository and ticket.

    A receipt is the record of what the shift did with an item: its state
    and why it stopped. A snag entry quotes it when there is one, so the
    entry can say what was recorded rather than what it assumes."""
    receipts: dict[tuple[str, str], dict] = {}
    folder = root / "receipts"
    if not folder.is_dir():
        return receipts
    for path in sorted(folder.glob("*.md")):
        if not RECEIPT_FILE.match(path.name):
            continue
        fields = parse_receipt(path)["fields"]
        repo = (fields.get("repo") or "").strip().lower()
        found = re.search(r"#(\d+)\s*\)?\s*$", (fields.get("ticket") or "").strip())
        if not repo or not found:
            continue
        receipts[(repo, found.group(1))] = fields
    return receipts


def receipt_number(item: dict) -> object:
    """Return the number of the ticket an item's receipt is filed under.

    A receipt is filed under a ticket's own issue number. A pull request
    has two numbers, and its own number is not its ticket's: a pull
    request #435 that belongs to issue #188 has a receipt under #188, and
    a receipt under #435 belongs to some other ticket. So a pull request
    is looked up by the issue it is linked to, and only a ticket is
    looked up by its own number.

    The linked issue is the number the item carries as `issue`, and the
    receipt's own `Ticket` line is the cross-check: a receipt whose
    ticket line names a different number is not this item's receipt."""
    linked = item.get("issue")
    if linked not in (None, ""):
        return linked
    if item.get("kind") == "pull-request":
        return ""
    return item.get("number")


def receipt_says(
    receipts: dict[tuple[str, str], dict], repo: str, number: object
) -> str:
    """Return what the shift's own receipt says about an item.

    The receipt holds the state the shift recorded and why it stopped, so
    an entry can quote the record instead of assuming what happened. An
    item with no receipt gets no claim: the entry says that nothing was
    recorded.

    The receipt is looked up by the number the caller passes, and the
    caller passes the ticket's number: an entry never quotes another
    ticket's state because the two numbers happened to collide."""
    if number in (None, ""):
        return ""
    try:
        key = (str(repo or "").strip().lower(), str(int(number)))
    except (TypeError, ValueError):
        return ""
    fields = receipts.get(key)
    if not fields:
        return ""
    state = (fields.get("state") or "").strip() or "no state"
    why = (fields.get("stopped because") or "").strip()
    if why:
        return f"the receipt records the state {state}: {why}"
    return f"the receipt records the state {state}"


def budget_observation(minutes: int, fix_tries: int, budget: dict) -> str:
    """Return what the shift observed about an item's budget.

    The observation is what was read: the builder's own time and the
    queue's own count of fix tries. It does not say the item was stopped
    or parked, because nothing here proves that: the shift's receipt
    holds the state it recorded, and the snag entry quotes it when there
    is one."""
    reasons = []
    if minutes >= budget["hard"]:
        reasons.append(
            f"the builder used {minutes} min of its {budget['hard']} min hard budget"
        )
    if fix_tries >= budget["retry_cap"]:
        reasons.append(
            f"the queue records {fix_tries} fix tries, the cap is "
            f"{budget['retry_cap']}"
        )
    if not reasons:
        reasons.append("the builder is within its budget")
    return "; ".join(reasons)


def park_decisions(
    items: list[dict],
    drops: list[tuple[dict, str]],
    receipts: dict[str, str],
    decision_lines: list[str],
    deadline: float,
    budget: dict,
    queue_state: dict,
    shift_receipts: dict[tuple[str, str], dict] | None = None,
) -> tuple[list[str], list[tuple[str, list[tuple[str, str]]]], str]:
    """Return the parking lot entries, the snag entries and what could not
    be read.

    Every entry is read: the pending request from the thread that holds
    it, the open decision from the coordinator's decisions log, the
    failing check from the pull request and the budget from the queue's
    own record. The shift parks what it cannot decide and logs what it
    found, and it never answers a request.

    The decisions that wait for Shyam are the tickets the filter drops:
    a ticket with an open question in the decisions log, a ticket marked
    as needing Shyam and a ticket marked as needing a design are all
    decisions the shift cannot make, so they are parked here.

    The last value is why the pass was not complete: a thread that could
    not be read may hold a request the shift does not know about, and a
    parking lot written from an incomplete read would drop a decision
    that is still waiting."""
    parked: list[str] = []
    snags: list[tuple[str, list[tuple[str, str]]]] = []
    incomplete = ""
    shift_receipts = shift_receipts or {}
    stamp = datetime.now(PT).strftime("%Y-%m-%d %I:%M %p PT")
    for issue, reason in drops:
        if not any(reason.startswith(prefix) for prefix in DECISION_DROP):
            continue
        key = str(issue.get("key") or "")
        number = issue.get("number")
        repo = str(issue.get("repo") or "")
        label = f"{key} (#{number})" if key else f"{repo}#{number}"
        title = " ".join(str(issue.get("title") or "").split())
        if key and title.upper().startswith(key.upper()):
            title = title[len(key) :].strip(" -:·")
        heading = f"{label} · {title}" if title else label
        if reason.startswith("marked"):
            quote = reason.split(": ", 1)[1] if ": " in reason else ""
            recommend = (
                "decide the ticket with Shyam, and the shift works it"
            )
        else:
            found = decision_reason(decision_lines, key, number)
            quote = found[1] if found else ""
            recommend = (
                "answer the open question in the decisions log, and the shift "
                "works the ticket"
            )
        kind = reason.split(": ", 1)[0]
        parked.append(
            parking_section(
                heading,
                [
                    ("Repo", repo),
                    ("Ticket", key),
                    ("Kind", f"{kind} — a decision the shift cannot make"),
                    ("Parked at", stamp),
                    (
                        "Default",
                        "the ticket stays as it is and the shift does not work it",
                    ),
                    ("Recommend", recommend),
                    ("Next", "Shyam answers, and the shift works the ticket"),
                ],
            )
            + "\n"
            + "The open question, quoted exactly:\n"
            + "\n"
            + quoted_text(quote)
        )
    for item in items:
        repo = str(item.get("repo") or "")
        number = item.get("number")
        key = str(item.get("key") or "")
        title = item_title(item)
        request: dict | None = None
        request_thread = ""
        minutes = 0
        for thread in item_threads(item, receipts):
            record, error = read_thread_record(thread, deadline)
            if error:
                incomplete = incomplete or error
                continue
            if not record:
                # A record that holds no thread is a read the shift cannot
                # trust, so the parking lot is not rewritten from it.
                incomplete = incomplete or (
                    f"the thread {thread} returned no record"
                )
                continue
            minutes = max(minutes, builder_minutes(record))
            found = pending_request_from(record)
            if found["pending"]:
                request = found
                request_thread = thread
                break
        if request is not None:
            fields = [
                ("Repo", repo),
                ("Ticket", key),
                ("Kind", request["kind"]),
                ("Thread", request_thread),
                ("Parked at", stamp),
                (
                    "Default",
                    "the request stays unanswered and the item stays parked",
                ),
                (
                    "Recommend",
                    "answer the request in the morning; the shift never answers one",
                ),
                (
                    "Next",
                    "Shyam answers the request, and the shift works the item again",
                ),
            ]
            parked.append(
                parking_section(title, fields)
                + "\n"
                + "The request, quoted exactly as the tool showed it:\n"
                + "\n"
                + quoted_text(request["text"])
            )
            if not request["text"]:
                snags.append(
                    (
                        f"{stamp} · {title}",
                        [
                            ("Repo", repo),
                            ("Ticket", key),
                            (
                                "Problem",
                                "a thread waits on a person and the request's text "
                                "could not be read",
                            ),
                            ("Thread", request_thread),
                            (
                                "What the shift did",
                                "the item was parked without the request's text, "
                                "and the request was not answered",
                            ),
                            ("Next", "Shyam reads the thread and answers it"),
                        ],
                    )
                )
            continue
        open_decision = decision_reason(decision_lines, key, number)
        if open_decision:
            reason, line = open_decision
            parked.append(
                parking_section(
                    title,
                    [
                        ("Repo", repo),
                        ("Ticket", key),
                        ("Kind", f"{reason} — a decision the shift cannot make"),
                        ("Parked at", stamp),
                        (
                            "Default",
                            "the ticket stays as it is and the shift does not work it",
                        ),
                        (
                            "Recommend",
                            "answer the open question in the decisions log, and the "
                            "shift works the ticket",
                        ),
                        ("Next", "Shyam answers the question in the decisions log"),
                    ],
                )
                + "\n"
                + "The open question, quoted exactly:\n"
                + "\n"
                + quoted_text(line)
            )
            continue
        failing = (item.get("checks") or {}).get("failed") or []
        if failing:
            snags.append(
                (
                    f"{stamp} · {title}",
                    [
                        ("Repo", repo),
                        ("Ticket", key),
                        ("Problem", "a check is failing: " + ", ".join(failing)),
                        (
                            "What the shift did",
                            receipt_says(
                                shift_receipts, repo, receipt_number(item)
                            )
                            or (
                                "the board reports a failing check; builder "
                                "delivery has not been verified"
                            ),
                        ),
                        ("Next", "the builder fixes the failing check"),
                    ],
                )
            )
            continue
        tries = (
            fix_tries(queue_state, repo, number)
            if item.get("kind") == "pull-request"
            else 0
        )
        verdict = budget_verdict(minutes, tries, budget)
        if verdict["parked"]:
            snags.append(
                (
                    f"{stamp} · {title}",
                    [
                        ("Repo", repo),
                        ("Ticket", key),
                        ("Problem", budget_observation(minutes, tries, budget)),
                        (
                            "What the shift did",
                            receipt_says(
                                shift_receipts, repo, receipt_number(item)
                            )
                            or (
                                "the recorded elapsed time or retry count meets "
                                "the parking threshold; stopping has not been "
                                "verified"
                            ),
                        ),
                        ("Next", verdict["next"]),
                    ],
                )
            )
    return parked, snags, incomplete


def cmd_park(args: argparse.Namespace) -> int:
    """Write the parking lot and the snag log (spec part T10).

    The command reads the board, the queue's own records and the threads
    that hold the work, and writes two files under the shift's folder:
    `inbox/parking-lot.md` holds the decisions the shift could not make,
    each with a default and a recommendation, and `inbox/snag-log.md`
    holds the problems it found and what it did about them.

    A pending approval request is parked with its exact text and is never
    answered: this module has no path that sends an answer, and the proof
    runs the command with a T3 stub that fails on every call but a read.

    With `--fixture` it parks the pending request of one fixture thread,
    which is how the rule is proved without a live approval dialog."""
    deadline = time.monotonic() + args.deadline
    root = report_root(args.root)
    if args.fixture:
        return cmd_fixture_park(args, root, deadline)
    policy = policy_snapshot(root)
    budget = budget_of(policy)
    allowed = cycle_allow(policy)
    items, receipts, drops, error = read_work_items(deadline, allowed or None, budget)
    if error:
        emit(f"overnight: REFUSED: {error}", err=True)
        return 1
    queue_state = read_queue_state()
    _decisions_path, decision_lines = read_decisions()
    parked, snags, incomplete = park_decisions(
        items,
        drops,
        receipts,
        decision_lines,
        deadline,
        budget,
        queue_state,
        read_shift_receipts(root),
    )
    # A thread that could not be read may hold a request the shift does
    # not know about, so the record is incomplete. Both modes say so and
    # refuse: a preview that hides a decision and calls itself complete is
    # the same failure as a write that erases one.
    if incomplete:
        snags.append(
            (
                f"{stamp_line()} · the parking lot",
                [
                    (
                        "Problem",
                        "a thread could not be read, so the parking lot was not "
                        "rewritten",
                    ),
                    ("What the shift did", incomplete),
                    (
                        "Next",
                        "the shift reads the thread again on the next cycle",
                    ),
                ],
            )
        )
    snag_text = snag_log_text(
        [snag_section(title, fields) for title, fields in snags]
    )
    if args.dry_run:
        if incomplete:
            emit(
                "overnight: the preview below is INCOMPLETE; a thread could not "
                f"be read: {incomplete}",
                err=True,
            )
        emit("--- parking lot (dry run, nothing written) ---")
        emit(parking_lot_text(parked))
        emit("--- snag log (dry run, nothing written) ---")
        emit(snag_text)
        if incomplete:
            emit(
                "overnight: REFUSED: the parking lot was not previewed in full: "
                f"{incomplete}",
                err=True,
            )
            emit(
                "overnight: a decision that is still waiting may be missing from "
                "the preview above.",
                err=True,
            )
            return 1
        return 0
    if incomplete:
        outcome = write_snag_log(root, snags)
        emit(
            f"overnight: REFUSED: the parking lot was not written: {incomplete}",
            err=True,
        )
        emit(f"overnight: snag log {outcome}")
        write_shift_line(root, f"park | refused | {incomplete}")
        return 1
    outcome = write_parking_lot(root, parked)
    snag_outcome = write_snag_log(root, snags)
    if outcome.startswith("failed") or snag_outcome.startswith("failed"):
        emit(
            f"overnight: the records were not written: {outcome}, {snag_outcome}",
            err=True,
        )
        write_shift_line(root, f"park | failed | {outcome}, {snag_outcome}")
        return 1
    emit(
        f"overnight: parking lot {outcome}; snag log {snag_outcome}; "
        f"{len(parked)} parked, {len(snags)} problems"
    )
    write_shift_line(root, f"park | {len(parked)} parked | {len(snags)} problems")
    return 0


def cmd_fixture_park(args: argparse.Namespace, root: Path, deadline: float) -> int:
    """Park a fixture's pending request, and never answer it.

    The fixture names the thread that holds the request. The command
    reads that thread through T3, exactly as it reads a real thread, so
    the request it parks is the request the real path would park. The
    proof runs it with a T3 stub that fails on every call but a read, so
    an answer would fail loudly instead of passing quietly."""
    file = Path(args.fixture).expanduser()
    text = read_text(file)
    if not text.strip():
        die(f"the fixture {file} is empty or cannot be read")
    try:
        data = json.loads(text)
    except ValueError as exc:
        die(f"the fixture {file} is not JSON: {exc}")
    if not isinstance(data, dict):
        die(f"the fixture {file} is not a JSON object")
    thread = str(data.get("thread") or "")
    if not thread:
        die(f"the fixture {file} names no thread")
    record, error = read_thread_record(thread, deadline)
    if error:
        snags = [
            (
                f"{stamp_line()} · {args.fixture}",
                [
                    (
                        "Problem",
                        "a thread could not be read, so the parking lot was not "
                        "rewritten",
                    ),
                    ("What the shift did", error),
                    (
                        "Next",
                        "the shift reads the thread again on the next cycle",
                    ),
                ],
            )
        ]
        if args.dry_run:
            emit(
                f"overnight: REFUSED: the parking lot was not written: {error}",
                err=True,
            )
            emit(snag_log_text([snag_section(title, fields) for title, fields in snags]))
            return 1
        outcome = write_snag_log(root, snags)
        emit(
            f"overnight: REFUSED: the parking lot was not written: {error}",
            err=True,
        )
        emit(f"overnight: snag log {outcome}")
        return 1
    if not record:
        emit(
            f"overnight: REFUSED: the thread {thread} could not be read",
            err=True,
        )
        return 1
    request = pending_request_from(record)
    if not request["pending"]:
        emit(
            f"overnight: REFUSED: the thread {thread} holds no pending request",
            err=True,
        )
        return 1
    repo = str(data.get("repo") or "")
    key = str(data.get("key") or "")
    number = data.get("number")
    label = f"{key} (#{number})" if key else f"{repo}#{number}"
    title = " ".join(str(data.get("title") or data.get("item") or "").split())
    stamp = datetime.now(PT).strftime("%Y-%m-%d %I:%M %p PT")
    fields = [
        ("Repo", repo),
        ("Ticket", key),
        ("Kind", request["kind"]),
        ("Thread", thread),
        ("Parked at", stamp),
        (
            "Default",
            "the request stays unanswered and the item stays parked",
        ),
        (
            "Recommend",
            "answer the request in the morning; the shift never answers one",
        ),
        (
            "Next",
            "Shyam answers the request, and the shift works the item again",
        ),
    ]
    heading = f"{label} · {title}" if title else label
    if request["text"]:
        parked = [
            parking_section(heading, fields)
            + "\n"
            + "The request, quoted exactly as the tool showed it:\n"
            + "\n"
            + quoted_text(request["text"])
        ]
        snags: list[tuple[str, list[tuple[str, str]]]] = []
    else:
        parked = [
            parking_section(
                heading,
                fields + [("Request", "the text of the request could not be read")],
            )
        ]
        snags = [
            (
                f"{stamp} · {heading}",
                [
                    ("Repo", repo),
                    ("Ticket", key),
                    (
                        "Problem",
                        "a thread waits on a person and the request's text could "
                        "not be read",
                    ),
                    ("Thread", thread),
                    (
                        "What the shift did",
                        "the item was parked without the request's text, and the "
                        "request was not answered",
                    ),
                    ("Next", "Shyam reads the thread and answers it"),
                ],
            )
        ]
    if args.dry_run:
        emit("--- parking lot (dry run, nothing written) ---")
        emit(parking_lot_text(parked))
        emit("--- snag log (dry run, nothing written) ---")
        emit(snag_log_text([snag_section(title, fields) for title, fields in snags]))
        return 0
    outcome = write_parking_lot(root, parked)
    snag_outcome = write_snag_log(root, snags)
    if outcome.startswith("failed") or snag_outcome.startswith("failed"):
        emit(
            f"overnight: the records were not written: {outcome}, {snag_outcome}",
            err=True,
        )
        return 1
    emit(f"overnight: parking lot {outcome}; snag log {snag_outcome}")
    emit(parking_lot_text(parked))
    if snags:
        emit(snag_log_text([snag_section(title, fields) for title, fields in snags]))
    return 0


def park_cycle(root: Path, deadline: float) -> None:
    """Park what this cycle cannot decide and log what it found.

    A cycle that cannot read the board says so and goes on: the parking
    lot and the snag log are records, and a record that is missing never
    ends the shift. Nothing here raises out of the cycle: the shift's
    own report is written after this step, and a parking problem must
    not take the report with it."""
    left = int(max(1, deadline - time.monotonic()))
    try:
        code = cmd_park(
            argparse.Namespace(
                dry_run=False, fixture=None, root=str(root), deadline=left
            )
        )
    except SystemExit as exc:
        emit(
            f"overnight: the parking lot was not written: {exc}",
            err=True,
        )
        return
    except Exception as exc:  # a record that cannot be written is not the shift
        emit(f"overnight: the parking lot was not written: {exc}", err=True)
        return
    if code:
        emit("overnight: the parking step did not write its records", err=True)
        return


