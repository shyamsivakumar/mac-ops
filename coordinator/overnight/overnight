# --- Part T7a: the secret redaction ---------------------------------------
#
# The shift writes its records under `.overnight/`: the receipts, the
# shift log, the parking lot, the policy snapshot and the morning report.
# A record quotes what it read: a pull request title, a branch name, a
# check's own output, a command line. Any of those can carry a token, a
# key, a cookie or a value out of a `.env` file. So every write under the
# root goes through one redaction function, and the pattern list lives in
# that one place (spec section 5, rule 4).
#
# The replacement says what was redacted and keeps no part of the value:
# `[REDACTED:github token]`. A record that says what it hid is still a
# record. A record that keeps the value is a leak.

# The pattern list. Each entry is a name and a pattern. A pattern with a
# named group `secret` keeps the rest of the match (the name of an
# environment variable, the header of a cookie line) and redacts only the
# group. A pattern without one is redacted whole.
#
# Every group starts with `(?!\[REDACTED:)`, so a value that is already
# redacted is not redacted again: the redaction of a text is the same
# text, and a record that is written twice is not damaged.
SECRET_PATTERNS: tuple[tuple[str, re.Pattern[str]], ...] = (
    (
        "private key",
        re.compile(
            r"-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----[\s\S]*?"
            r"-----END (?:[A-Z0-9 ]+ )?PRIVATE KEY-----"
        ),
    ),
    (
        # A key block that was cut short: the check's own output often
        # ends in the middle of the key. It runs to the end of the text,
        # unless an END marker follows it.
        "private key",
        re.compile(
            r"-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----"
            r"(?:(?!-----END)[\s\S])*$"
        ),
    ),
    ("aws key", re.compile(r"\b(?:AKIA|ASIA|AGPA|AIDA|AROA)[0-9A-Z]{16}\b")),
    (
        "github token",
        re.compile(
            r"\b(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,})\b"
        ),
    ),
    ("gitlab token", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b")),
    ("anthropic key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{16,}\b")),
    (
        "openai key",
        re.compile(r"\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}"),
    ),
    ("slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("google api key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("huggingface token", re.compile(r"\bhf_[A-Za-z0-9]{30,}\b")),
    ("npm token", re.compile(r"\bnpm_[A-Za-z0-9]{30,}\b")),
    ("stripe key", re.compile(r"\b(?:sk|pk|rk)_(?:test|live)_[A-Za-z0-9]{10,}\b")),
    (
        "jwt",
        re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}\b"),
    ),
    (
        "authorization header",
        re.compile(
            r"(?i)\b(?:authorization|proxy-authorization|x-api-key)[ \t]*[:=][ \t]*"
            r"(?P<secret>(?!\[REDACTED:)[^\s\"']+"
            r"(?:[ \t]+(?!\[REDACTED:)[^\s\"']+)?)"
        ),
    ),
    (
        "bearer token",
        re.compile(
            r"(?i)\bbearer[ \t]+(?P<secret>(?!\[REDACTED:)[A-Za-z0-9._~+/-]{8,}=*)"
        ),
    ),
    (
        "cookie",
        re.compile(
            r"(?i)\b(?:set-)?cookie[ \t]*[:=][ \t]*"
            r"(?P<secret>(?!\[REDACTED:)[^\s;]+)"
        ),
    ),
    (
        # A session cookie on its own. It needs a cookie context (the
        # start of a line, a space or a `;`) and a value that is long
        # enough to be a token, so prose like "session = 3 of 5" is left
        # alone.
        "session cookie",
        re.compile(
            r"(?i)(?:^|[;\s])(?:session|sessionid|sid|jsessionid|phpsessid|csrf"
            r"|xsrf)[ \t]*=[ \t]*"
            r"(?P<secret>(?!\[REDACTED:)[A-Za-z0-9._~+/-]{8,})"
        ),
    ),
    (
        "url credentials",
        re.compile(
            r"://[^/\s:@]*:(?P<secret>(?!\[REDACTED:)[^/\s@]+(?:\@[^/\s@]*)?)@"
        ),
    ),
    (
        # A field that names a secret, in JSON, in YAML or in a command
        # line. The name may be quoted, and the value may be quoted.
        "secret field",
        re.compile(
            r"(?i)(?<![A-Za-z0-9_])[\"']?"
            r"(?:api[_-]?key|apikey|access[_-]?token|auth[_-]?token"
            r"|gh[_-]?token|secret[_-]?key|client[_-]?secret|password|passwd"
            r"|passphrase|token|secret)"
            r"[\"']?[ \t]*[:=][ \t]*"
            r"(?P<secret>(?!\[REDACTED:)(?:\"[^\"]*\"|'[^']*'|[^\s,;]+))"
        ),
    ),
    (
        # An environment variable whose name ends in a secret word. The
        # name has an underscore, so prose like "the token: expired" is
        # left alone.
        "environment secret",
        re.compile(
            r"(?i)(?<![A-Za-z0-9_])(?:export[ \t]+)?[A-Za-z0-9]+_[A-Za-z0-9_]*"
            r"(?:TOKEN|SECRET|KEY|PASSWORD|PASSWD|PASSPHRASE|CREDENTIALS?)"
            r"[ \t]*[:=][ \t]*(?P<secret>(?!\[REDACTED:)[^\s]+)"
        ),
    ),
    (
        # The same, for a name that is the secret word itself. The name
        # has to be followed by `=`, so a heading that says "Secret:" is
        # left alone.
        "environment secret",
        re.compile(
            r"(?i)(?<![A-Za-z0-9_])(?:export[ \t]+)?"
            r"(?:TOKEN|SECRET|KEY|PASSWORD|PASSWD|PASSPHRASE|CREDENTIALS?)"
            r"[ \t]*=[ \t]*(?P<secret>(?!\[REDACTED:)[^\s]+)"
        ),
    ),
    (
        # A `.env` line: the name is an environment variable's name and
        # the line holds nothing else.
        ".env value",
        re.compile(
            r"(?m)^[ \t]*(?:export[ \t]+)?[A-Z][A-Z0-9_]*_[A-Z0-9_]*[ \t]*=[ \t]*"
            r"(?P<secret>(?!\[REDACTED:)\S+)[ \t]*$"
        ),
    ),
)


def redact(text: str) -> str:
    """Return the text with every secret pattern replaced.

    One function, one pattern list, one replacement shape. Every record
    the shift writes under `.overnight/` goes through this function, so a
    receipt, a shift log line and the morning report cannot hold a token,
    a key, a cookie or a `.env` value. The replacement names the pattern
    and keeps no part of the value.

    Every pattern is matched against the text as it came in, never
    against the text another pattern already changed: a replacement is
    not a secret, and a replacement that a later pattern reads again
    would leave half a secret behind. The spans that match are merged
    and the merged span is replaced once, under the name of the pattern
    that comes first in the list."""
    spans: list[tuple[int, int, int, str]] = []
    for priority, (name, pattern) in enumerate(SECRET_PATTERNS):
        for match in pattern.finditer(text):
            if "secret" in pattern.groupindex:
                start, end = match.span("secret")
            else:
                start, end = match.span()
            if end > start:
                spans.append((start, end, priority, name))
    if not spans:
        return text
    spans.sort(key=lambda span: (span[0], span[2], span[1]))
    merged: list[list] = []
    for start, end, priority, name in spans:
        if merged and start <= merged[-1][1]:
            current = merged[-1]
            current[1] = max(current[1], end)
        else:
            merged.append([start, end, priority, name])
    out: list[str] = []
    last = 0
    for start, end, _priority, name in merged:
        out.append(text[last:start])
        out.append(f"[REDACTED:{name}]")
        last = end
    out.append(text[last:])
    return "".join(out)


def emit(text: str = "", err: bool = False, end: str = "\n") -> None:
    """Print the shift's own output with every secret redacted.

    The console is a writer too. Launchd writes everything the module
    prints to the job's own log, and a printed line can carry a secret:
    a gate thread's report, a command's own output tail, a pull request
    title, a receipt body. So the console goes through the same redaction
    function as the records under `.overnight/`, and the job log holds no
    more than the records do.

    The whole text is redacted at once, not line by line, so a secret
    that spans lines (a private key block) is redacted as one thing."""
    print(redact(text), file=sys.stderr if err else sys.stdout, end=end)


def write_record(path: Path, text: str) -> Path:
    """Write a record under the overnight root and return the path.

    Every write under `.overnight/` goes through this function, so the
    redaction is not a rule each writer has to remember: it happens here,
    once, for the receipt, the shift log, the parking lot, the policy
    snapshot and the morning report alike."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(redact(text), encoding="utf-8")
    return path


def append_record(path: Path, text: str) -> Path:
    """Append to a record under the overnight root and return the path.

    The append is a write like any other, so it is redacted the same way."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(redact(text))
    return path


