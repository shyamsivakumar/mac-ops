#!/usr/bin/env python3
"""The overnight shift's command line.

Part T3a reads the board and the open pull requests and turns them into
intake records. Part T3b filters those records: it drops the Ascend work,
the holds, the tickets that need Shyam and the tickets with an open
question in the coordinator's decisions log, and it refuses any pull
request in an Ascend repository. It reads only: it writes no record and
keeps no list of its own. The ticket CLI refreshes its own cache when it
reads the board, and that cache is the ticket CLI's, not a queue of the
shift's.

    overnight intake --dry-run
    overnight filter --dry-run
    overnight check-pr --repo <repo> --number <n>

The board is the list. Intake reads `ticket list --fresh --json` for the
tickets and `gh pr list` for each allowed repository, and holds the records
in memory for the run. The later parts of the spec (ordering, arming, the
tick and the morning report) build on the same records.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn

TICKET = os.environ.get("OVERNIGHT_TICKET", "ticket")
GH = os.environ.get("OVERNIGHT_GH", "gh")
TICKET_TIMEOUT = 300
GH_TIMEOUT = 60
# The whole intake runs inside the turn cap, so every subprocess gets what
# is left of one overall deadline.
DEFAULT_DEADLINE = 540
PR_LIMIT = 100
# The open issues of one repository, read for the marks a ticket body
# carries. The board's tickets are a small part of that list.
ISSUE_LIMIT = 500
PR_FIELDS = "number,title,url,isDraft,headRefName,baseRefName,updatedAt,body"
# A ticket reference in a pull request body or title. Only the GitHub
# keywords count: a bare "#123" is often a pull request, not a ticket.
TICKET_REF = re.compile(r"\b(refs|fixes|closes|resolves)\s+#(\d+)\b", re.I)
# A board key in a branch name, such as "mo-208" or "ffbt-9". The number in
# it is a ticket key number, not a GitHub issue number.
BRANCH_KEY = re.compile(r"\b([A-Za-z]{2,5})-(\d+)\b")

# --- Part T3b: the filter -------------------------------------------------
#
# The Ascend rule is the one the merge gate already uses (coordinator/bin/
# coordq, the `ascend` line in the gate prompt): a repository the gate
# would refuse to merge is a repository the shift never touches. The
# spec's key list (AUH, MCP, OPS, DBT, OMN) is added, so a ticket whose
# key is an Ascend key is dropped even when it sits in a personal repo.
ASCEND_KEYS = frozenset({"AUH", "MCP", "OPS", "DBT", "OMN"})
ASCEND_REPO_PARTS = (
    "action-underwriting-hub",
    "ascend-mcp",
    "data-ops",
    "/dbt",
    "/omni",
)
PERSONAL_OWNER = "shyamsivakumar"
# The marked words a ticket body may carry. The marks stand at the start
# of a line or of a clause, so prose that uses the word ("hold counts",
# "needs Shyam's OK after the backtest") is not a mark.
HOLD_MARK = re.compile(r"(?im)^[ \t]*(?:[-*+>#]+[ \t]*)*HOLD[ \t]*(?:[:\-–]|$)")
NEEDS_SHYAM_MARK = re.compile(
    r"(?im)(?:^[ \t]*(?:[-*+>#]+[ \t]*)*|[.;:!?][ \t]+)needs[ \t]+shyam\b"
)
DESIGN_MARK = re.compile(
    r"(?im)(?:^[ \t]*(?:[-*+>#]+[ \t]*)*|[.;:!?][ \t]+)design[ \t]+needed\b"
)
# A decisions log line that leaves a question open. "answered", "closed",
# "resolved" and "unparked" close a question; a hold and a park outlive
# the question they were asked in.
DECISION_QUESTION = re.compile(r"(?i)\bquestion\b")
DECISION_CLOSED = re.compile(r"(?i)\b(answered|closed|resolved|unparked)\b")
DECISION_STRONG = re.compile(r"(?i)\b(hold|parked|park|question)\b|needs[ \t]+shyam")
# The subject of a decisions log line: the ticket the line is about. It
# is the ticket named right after the line's verb ("HOLD SRW-685"), or the
# first "KEY #number" pair in the line. A ticket that is only named in
# passing ("once SRW-1067 merges") is not the subject.
DECISION_SUBJECT = re.compile(r"\b([A-Za-z]{2,5})-(\d+)\s*#\s*(\d+)\b")
DECISION_VERB = re.compile(r"(?i)\b(hold|holds|held|parked|park|question)\b")
SUBJECT_TAIL = 80
# The coordinator's loop folder holds the decisions log the tick reads.
LOOP_DIR = Path(
    os.environ.get(
        "OVERNIGHT_LOOP_DIR", str(Path.home() / "Code" / "coordinator" / "loop")
    )
)
DECISIONS_FILE = Path(
    os.environ.get(
        "OVERNIGHT_DECISIONS", str(LOOP_DIR / "decisions.md")
    )
)


class RepoError(Exception):
    """A repository could not be read, so its counts are not known."""


def die(message: str, code: int = 1) -> NoReturn:
    print(f"overnight: {message}", file=sys.stderr)
    raise SystemExit(code)


def plural(count: int, one: str, many: str) -> str:
    """Return the word that fits the count."""
    return one if count == 1 else many


def config_path() -> Path:
    """Return the coordinator's board config.

    The checkout layout and the installed layout both resolve: the script
    sits in `coordinator/overnight/` next to `coordinator/config/`, and the
    installer copies the config to `~/.coordinator/`."""
    here = Path(__file__).resolve().parent
    for candidate in (
        here.parent / "config" / "tickets.json",
        Path.home() / ".coordinator" / "tickets.json",
    ):
        if candidate.is_file():
            return candidate
    die("tickets.json not found next to the module or in ~/.coordinator")


def load_config() -> dict:
    try:
        with open(config_path()) as stream:
            return json.load(stream)
    except (OSError, ValueError) as exc:
        die(f"cannot read the board config: {exc}")


def allowed_repos(cfg: dict) -> list[tuple[str, str]]:
    """Return the allowed repositories as (repo, key) pairs.

    The board config is the allow list: it names the repositories the
    coordinator works on today. The Ascend repositories are not in it."""
    repos = cfg.get("repos") or {}
    return sorted((repo, entry.get("key", "")) for repo, entry in repos.items())


def run(argv: list[str], timeout: int, deadline: float) -> str:
    """Run a command and return its stdout, or fail with the error tail."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the intake deadline passed before the next command could run")
    try:
        result = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=max(1, min(timeout, int(left))),
            check=False,
        )
    except FileNotFoundError:
        die(f"{argv[0]} is not on PATH")
    except subprocess.TimeoutExpired:
        die(f"{' '.join(argv)} timed out")
    if result.returncode != 0:
        tail = (result.stderr or result.stdout or "").strip().splitlines()[-3:]
        raise RepoError(
            f"{' '.join(argv)} failed ({result.returncode}): " + " | ".join(tail)
        )
    return result.stdout


def read_board(deadline: float) -> tuple[list[dict], bool]:
    """Return the board's tickets and whether the board is stale.

    The ticket CLI owns the cache and the labels, so intake asks it for the
    list instead of reading GitHub a second way."""
    try:
        raw = run([TICKET, "list", "--fresh", "--json"], TICKET_TIMEOUT, deadline)
    except RepoError as exc:
        die(str(exc))
    try:
        data = json.loads(raw)
    except ValueError as exc:
        die(f"the ticket CLI did not return JSON: {exc}")
    issues = data.get("issues") or []
    if data.get("stale"):
        print(
            "overnight: the board list is stale ("
            + str((data.get("error") or {}).get("message", "unknown error"))
            + ")",
            file=sys.stderr,
        )
    return issues, bool(data.get("stale"))


def read_pull_requests(repo: str, deadline: float) -> tuple[list[dict], bool]:
    """Return the open pull requests of one repository, and whether the list
    was cut off at the limit."""
    raw = run(
        [
            GH,
            "pr",
            "list",
            "-R",
            repo,
            "--state",
            "open",
            "--limit",
            str(PR_LIMIT),
            "--json",
            PR_FIELDS,
        ],
        GH_TIMEOUT,
        deadline,
    )
    try:
        rows = json.loads(raw)
    except ValueError as exc:
        raise RepoError(f"gh did not return JSON for {repo}: {exc}")
    if not isinstance(rows, list):
        raise RepoError(f"gh returned no list for {repo}")
    return rows, len(rows) >= PR_LIMIT


def linked_ticket(
    row: dict, by_number: dict[int, dict], by_key: dict[str, dict]
) -> tuple[dict | None, str]:
    """Return the board ticket a pull request names, and how it named it.

    A keyword reference names a GitHub issue number. A branch name carries
    a ticket key, whose number is a different counter, so the branch is
    looked up by key and never by issue number.

    The keyword is the stronger signal, so it decides when it names a
    ticket the board shows. Every keyword is read, so a body that names an
    issue the board does not show and then names one it does still links
    to the one it shows. When no keyword names a ticket the board shows,
    the branch is read: a pull request whose body points at a ticket that
    has left the board, and whose branch carries the key of a ticket that
    is on it, is that ticket's work. A pull request that names neither is
    a record of its own."""
    text = f"{row.get('title') or ''}\n{row.get('body') or ''}"
    for match in TICKET_REF.finditer(text):
        number = int(match.group(2))
        target = by_number.get(number)
        if target is not None:
            return target, f"{match.group(1).lower()} #{number}"
    for match in BRANCH_KEY.finditer(row.get("headRefName") or ""):
        key = f"{match.group(1)}-{match.group(2)}".upper()
        target = by_key.get(key)
        if target is not None:
            return target, f"branch {key}"
    return None, ""


def build_records(
    issues: list[dict], pull_requests: dict[str, list[dict]]
) -> dict[str, list[dict]]:
    """Turn the board and the pull requests into intake records, per repo.

    A ticket with open pull requests is one record that carries them. A
    pull request that no board ticket names is a record of its own. Nothing
    is filtered or ordered here: that is the next part."""
    records: dict[str, list[dict]] = {}
    for issue in issues:
        repo = issue.get("repo", "")
        records.setdefault(repo, []).append(
            {
                "kind": "ticket",
                "repo": repo,
                "key": issue.get("key") or "",
                "number": issue.get("number"),
                "title": issue.get("title") or "",
                "url": issue.get("url") or "",
                "stage": issue.get("stage"),
                "priority": issue.get("priority"),
                "type": issue.get("type"),
                "builder": issue.get("builder"),
                "reviewer": issue.get("reviewer"),
                "problems": issue.get("problems", []),
                "updatedAt": issue.get("updatedAt"),
                "prs": [],
            }
        )
    for repo, rows in pull_requests.items():
        bucket = records.setdefault(repo, [])
        by_number = {
            r["number"]: r for r in bucket if r["kind"] == "ticket" and r["number"]
        }
        by_key = {
            r["key"].upper(): r
            for r in bucket
            if r["kind"] == "ticket" and r["key"]
        }
        for row in rows:
            summary = {
                "number": row.get("number"),
                "title": row.get("title") or "",
                "url": row.get("url") or "",
                "isDraft": bool(row.get("isDraft")),
                "headRefName": row.get("headRefName") or "",
                "baseRefName": row.get("baseRefName") or "",
                "updatedAt": row.get("updatedAt"),
            }
            target, signal = linked_ticket(row, by_number, by_key)
            if target is not None:
                summary["linkedBy"] = signal
                target["prs"].append(summary)
                continue
            bucket.append(
                {
                    "kind": "pr",
                    "repo": repo,
                    "number": row.get("number"),
                    "title": row.get("title") or "",
                    "url": row.get("url") or "",
                    "isDraft": bool(row.get("isDraft")),
                    "headRefName": row.get("headRefName") or "",
                    "updatedAt": row.get("updatedAt"),
                }
            )
    return records


def cmd_intake(args: argparse.Namespace) -> int:
    if not args.dry_run:
        print(
            "overnight: intake in this part reads only. Run "
            "`overnight intake --dry-run`.",
            file=sys.stderr,
        )
        return 2
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    pull_requests: dict[str, list[dict]] = {}
    unread: dict[str, str] = {}
    for repo, _key in repos:
        try:
            rows, cut = read_pull_requests(repo, deadline)
        except RepoError as exc:
            unread[repo] = str(exc)
            print(f"overnight: {repo}: {exc}", file=sys.stderr)
            continue
        pull_requests[repo] = rows
        if cut:
            unread[repo] = f"more than {PR_LIMIT} open pull requests"
            print(
                f"overnight: {repo}: the pull request list was cut off at "
                f"{PR_LIMIT}, so the counts are not known",
                file=sys.stderr,
            )
    records = build_records(issues, pull_requests)
    outside = sorted(set(records) - {repo for repo, _ in repos})
    print("Overnight intake - dry run (read only)")
    print(f"Board: {len(issues)} tickets{' (stale)' if stale else ''}")
    print(f"Allowed repositories: {len(repos)}")
    print()
    print(f"{'repository':<45}{'tickets':>9}{'prs':>6}{'linked':>8}{'records':>9}")
    total = 0
    clean = 0
    outside_total = 0
    outside_repos = 0
    for repo, _key in repos:
        bucket = records.get(repo, [])
        tickets = sum(1 for r in bucket if r["kind"] == "ticket")
        linked = sum(len(r["prs"]) for r in bucket if r["kind"] == "ticket")
        if repo in unread:
            print(f"{repo:<45}{tickets:>9}{'ERR':>6}{'ERR':>8}{'ERR':>9}")
            continue
        clean += 1
        total += len(bucket)
        print(
            f"{repo:<45}{tickets:>9}{len(pull_requests.get(repo, [])):>6}"
            f"{linked:>8}{len(bucket):>9}"
        )
    for repo in outside:
        bucket = records[repo]
        tickets = sum(1 for r in bucket if r["kind"] == "ticket")
        outside_total += len(bucket)
        outside_repos += 1
        print(f"{repo:<45}{tickets:>9}{'n/a':>6}{'n/a':>8}{len(bucket):>9}  (not allowed)")
    print()
    if unread:
        print(
            f"Total: UNVERIFIED. {total} records from the {clean} repositories "
            f"that read cleanly; {len(unread)} repositories could not be read "
            f"fully: " + ", ".join(sorted(unread))
        )
    else:
        print(f"Total: {total} records across {clean} repositories")
    if outside_repos:
        print(
            f"{outside_total} more records in {outside_repos} "
            f"{plural(outside_repos, 'repository', 'repositories')} outside the "
            f"allow list, counted above and marked 'not allowed'."
        )
    print(
        "A pull request that a board ticket names is part of that ticket's "
        "record, so it adds no record of its own. A pull request that names "
        "no ticket the board shows stays a record of its own."
    )
    return 1 if unread else 0


# --- Part T3b: the filter -------------------------------------------------


def ascend_reason(repo: str, key: str | None) -> str | None:
    """Return why the work is Ascend, or None when it is not.

    A key from the spec's Ascend list (AUH, MCP, OPS, DBT, OMN) is Ascend
    on its own. A repository the merge gate would refuse to merge is
    Ascend too: the gate's rule is the one in coordinator/bin/coordq, so
    the shift and the gate never disagree about what Ascend is."""
    if key:
        prefix = key.split("-")[0].upper()
        if prefix in ASCEND_KEYS:
            return f"Ascend key {prefix}"
    if not repo:
        return None
    owner = repo.split("/")[0]
    if owner != PERSONAL_OWNER:
        return f"Ascend repo: {repo} is not a {PERSONAL_OWNER} repository"
    if any(part in repo for part in ASCEND_REPO_PARTS):
        return f"Ascend repo: {repo} is an Ascend repository"
    return None


def clip(text: str, width: int = 120) -> str:
    """Return one readable line of a matched mark."""
    flat = " ".join(text.split())
    return flat if len(flat) <= width else flat[: width - 3] + "..."


def read_bodies(
    issues: list[dict], deadline: float
) -> tuple[dict[tuple[str, int], str], list[str]]:
    """Return the board tickets' bodies and the repositories that failed.

    The ticket CLI's list carries no body, and the marks the shift reads
    live in the ticket's own text, so the module reads the bodies of the
    open issues of the repositories that hold board tickets."""
    bodies: dict[tuple[str, int], str] = {}
    unread: list[str] = []
    wanted: dict[str, set[int]] = {}
    for issue in issues:
        repo = issue.get("repo") or ""
        number = issue.get("number")
        if repo and number:
            wanted.setdefault(repo, set()).add(number)
    for repo in sorted(wanted):
        try:
            raw = run(
                [
                    GH,
                    "issue",
                    "list",
                    "-R",
                    repo,
                    "--state",
                    "open",
                    "--limit",
                    str(ISSUE_LIMIT),
                    "--json",
                    "number,title,body",
                ],
                GH_TIMEOUT,
                deadline,
            )
            rows = json.loads(raw)
        except (RepoError, ValueError) as exc:
            unread.append(repo)
            print(f"overnight: {repo}: {exc}", file=sys.stderr)
            continue
        for row in rows if isinstance(rows, list) else []:
            number = row.get("number")
            if number in wanted[repo]:
                bodies[(repo, number)] = (row.get("body") or "") + "\n" + (
                    row.get("title") or ""
                )
    return bodies, unread


def read_decisions() -> tuple[Path, list[str]]:
    """Return the coordinator's decisions log and its lines.

    The log is the coordinator's own parking lot, so it is read where the
    tick reads it. A missing log is not a crash: the filter says so and
    the question check is then unverified."""
    try:
        with open(DECISIONS_FILE) as stream:
            return DECISIONS_FILE, stream.read().splitlines()
    except OSError:
        return DECISIONS_FILE, []


def mark_reason(text: str) -> tuple[str, str] | None:
    """Return the mark a ticket body carries, with the line that carries it.

    A mark stands at the start of a line or of a clause, so a ticket that
    only talks about holding a position, or about a decision that needs
    Shyam later, is not marked."""
    for pattern, reason in (
        (HOLD_MARK, "marked hold"),
        (NEEDS_SHYAM_MARK, "marked needs Shyam"),
        (DESIGN_MARK, "marked design needed"),
    ):
        match = pattern.search(text)
        if match:
            start = text.rfind("\n", 0, match.start()) + 1
            end = text.find("\n", match.start())
            line = text[start : end if end != -1 else len(text)]
            return reason, clip(line)
    return None


def names_ticket(line: str, key: str | None, number: int | None) -> bool:
    """Return True when a decisions log line is about this ticket.

    A line is about a ticket when the ticket is its subject: the ticket
    named right after the line's verb ("HOLD SRW-685"), or the first
    "KEY #number" pair in the line. A ticket named in passing ("once
    SRW-1067 merges") is not the subject of the line."""
    if key and number:
        subject = DECISION_SUBJECT.search(line)
        if (
            subject
            and subject.group(1).upper() == key.split("-")[0].upper()
            and int(subject.group(3)) == number
        ):
            return True
    for verb in DECISION_VERB.finditer(line):
        tail = line[verb.end() : verb.end() + SUBJECT_TAIL]
        if key and re.search(rf"\b{re.escape(key)}\b", tail, re.I):
            return True
        if number and re.search(rf"#\s*{number}\b", tail):
            return True
    return False


def decision_reason(
    lines: list[str], key: str | None, number: int | None
) -> tuple[str, str] | None:
    """Return the open question a decisions log leaves for a ticket.

    The log is append-only history, so the last line that is about the
    ticket decides. A line that holds or parks the ticket leaves it open;
    a line that only asks a question leaves it open until the question is
    answered, closed or resolved."""
    last = None
    for line in lines:
        if names_ticket(line, key, number):
            last = line
    if last is None:
        return None
    strong = re.search(r"\b(HOLD|PARKED|PARK)\b", last) or re.search(
        r"(?i)needs[ \t]+shyam", last
    )
    if strong:
        return "hold in the decisions log", clip(last)
    if DECISION_QUESTION.search(last) and not DECISION_CLOSED.search(last):
        return "open question in the decisions log", clip(last)
    return None


def cmd_filter(args: argparse.Namespace) -> int:
    """Filter the board and print every drop with its reason."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _ in repos}
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    bodies, unread = read_bodies(issues, deadline)
    path, lines = read_decisions()
    kept: list[dict] = []
    drops: list[tuple[dict, str]] = []
    for issue in issues:
        repo = issue.get("repo") or ""
        key = issue.get("key") or ""
        reason = ascend_reason(repo, key)
        if reason is None and repo not in allowed:
            reason = f"repo not on the allow list: {repo}"
        if reason is None:
            body = bodies.get((repo, issue.get("number")))
            if body is None:
                mark = None
            else:
                mark = mark_reason(body)
            if mark:
                reason = f"{mark[0]}: {mark[1]}"
            elif body is not None:
                found = decision_reason(lines, key, issue.get("number"))
                if found:
                    reason = f"{found[0]}: {found[1]}"
        if reason:
            drops.append((issue, reason))
        else:
            kept.append(issue)
    print("Overnight filter - dry run (read only)")
    print(f"Board: {len(issues)} tickets{' (stale)' if stale else ''}")
    print(f"Allowed repositories: {len(repos)}")
    print(f"Decisions log: {path}" + ("" if lines else " (not found)"))
    if unread:
        print(
            "Unread repositories: "
            + ", ".join(unread)
            + " (their ticket marks could not be read, so they are unverified)"
        )
    print()
    print(f"Kept: {len(kept)}")
    print(f"Dropped: {len(drops)}")
    outside = sorted({issue.get("repo") or "" for issue in issues} - allowed)
    print(f"Board repositories outside the allow list: {len(outside)}")
    if drops:
        print()
        print("Drops (each with its reason)")
        for issue, reason in drops:
            key = issue.get("key") or "-"
            print(
                f"  DROP {issue.get('repo')}#{issue.get('number')} {key} - {reason}"
            )
    print()
    survived = [
        issue
        for issue in kept
        if ascend_reason(issue.get("repo") or "", issue.get("key") or "")
    ]
    print(f"Ascend items kept: {len(survived)}")
    if survived:
        for issue in survived:
            print(f"  FAIL {issue.get('repo')}#{issue.get('number')}")
        print("FAIL: an Ascend item survived the filter.")
        return 1
    if not lines:
        print("The decisions log was not found, so the question check is UNVERIFIED.")
    return 0


def cmd_check_pr(args: argparse.Namespace) -> int:
    """Refuse any pull request that is Ascend work.

    This is the second check the spec asks for: intake drops Ascend work
    from the board, and this refuses an Ascend pull request before any
    work starts on it."""
    deadline = time.monotonic() + args.deadline
    repo = args.repo
    number = args.number
    reason = ascend_reason(repo, None)
    if reason:
        print(f"REFUSED: {repo}#{number}: {reason}")
        return 1
    branch = ""
    try:
        raw = run(
            [GH, "pr", "view", str(number), "-R", repo, "--json", "headRefName"],
            GH_TIMEOUT,
            deadline,
        )
        branch = (json.loads(raw) or {}).get("headRefName") or ""
    except (RepoError, ValueError) as exc:
        print(f"overnight: {repo}#{number}: {exc}", file=sys.stderr)
        print("The pull request could not be read, so the check is UNVERIFIED.")
    key = None
    match = BRANCH_KEY.search(branch)
    if match:
        key = f"{match.group(1)}-{match.group(2)}".upper()
    reason = ascend_reason(repo, key)
    if reason:
        print(f"REFUSED: {repo}#{number}: {reason}")
        if branch:
            print(f"  branch {branch}")
        return 1
    print(f"OK: {repo}#{number} is not an Ascend pull request")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="overnight", description="The overnight shift's command line."
    )
    sub = parser.add_subparsers(dest="command", required=True)
    intake = sub.add_parser(
        "intake",
        help="read the board and the open pull requests into intake records",
    )
    intake.add_argument(
        "--dry-run",
        action="store_true",
        help="read only; no records are written (the only mode in this part)",
    )
    intake.add_argument(
        "--deadline",
        type=int,
        default=DEFAULT_DEADLINE,
        help=f"seconds the whole intake may take (default {DEFAULT_DEADLINE})",
    )
    intake.set_defaults(func=cmd_intake)
    filt = sub.add_parser(
        "filter",
        help="drop the Ascend, held and needs-Shyam work from the board",
    )
    filt.add_argument(
        "--dry-run",
        action="store_true",
        help="read only; nothing is written (the only mode in this part)",
    )
    filt.add_argument(
        "--deadline",
        type=int,
        default=DEFAULT_DEADLINE,
        help=f"seconds the whole filter may take (default {DEFAULT_DEADLINE})",
    )
    filt.set_defaults(func=cmd_filter)
    check = sub.add_parser(
        "check-pr",
        help="refuse any pull request that is Ascend work",
    )
    check.add_argument("--repo", required=True, help="the repository of the pull request")
    check.add_argument("--number", required=True, type=int, help="the pull request number")
    check.add_argument(
        "--deadline",
        type=int,
        default=DEFAULT_DEADLINE,
        help=f"seconds the check may take (default {DEFAULT_DEADLINE})",
    )
    check.set_defaults(func=cmd_check_pr)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
