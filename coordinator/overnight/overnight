def ascend_reason(repo: str, key: str | None, flagged: bool = False) -> str | None:
    """Return why the work is Ascend, or None when it is not.

    A key from the spec's Ascend list (AUH, MCP, OPS, DBT, OMN) is Ascend
    on its own. A repository the merge gate would refuse to merge is
    Ascend too: the gate's repository rule is the one in
    coordinator/bin/coordq, and the gate's own per-repository `ascend`
    flag is honoured here as well."""
    if key:
        prefix = key.split("-")[0].upper()
        if prefix in ASCEND_KEYS:
            return f"Ascend key {prefix}"
    if not repo:
        return None
    if flagged:
        return f"Ascend repo: the board config marks {repo} as Ascend"
    owner = repo.split("/")[0]
    if owner != PERSONAL_OWNER:
        return f"Ascend repo: {repo} is not a {PERSONAL_OWNER} repository"
    if any(part in repo for part in ASCEND_REPO_PARTS):
        return f"Ascend repo: {repo} is an Ascend repository"
    return None


def ascend_flags(cfg: dict) -> set[str]:
    """Return the repositories the board config marks as Ascend.

    The merge gate honours a per-repository `ascend` flag in the board
    config (coordinator/bin/coordq). The shift reads the same flag, so
    the two agree on what Ascend is."""
    repos = cfg.get("repos") or {}
    return {repo for repo, entry in repos.items() if entry.get("ascend")}


def ascend_keys_in(text: str) -> list[str]:
    """Return the Ascend keys a text carries, such as a branch name.

    Every key in the text is read, so a branch such as
    "t3/fix-12-auh-3" still shows its Ascend key."""
    found: list[str] = []
    for match in BRANCH_KEY.finditer(text or ""):
        key = f"{match.group(1)}-{match.group(2)}".upper()
        if key.split("-")[0] in ASCEND_KEYS and key not in found:
            found.append(key)
    return found


def clip(text: str, width: int = 120) -> str:
    """Return one readable line of a matched mark."""
    flat = " ".join(text.split())
    return flat if len(flat) <= width else flat[: width - 3] + "..."


def read_bodies(
    issues: list[dict], deadline: float
) -> tuple[dict[tuple[str, int], str], list[str], dict[str, set[int]]]:
    """Return the board tickets' bodies, the repositories that failed and
    the open issue numbers of each repository.

    The ticket CLI's list carries no body, and the marks the shift reads
    live in the ticket's own text, so the module reads the bodies of the
    open issues of the repositories that hold board tickets. The open
    numbers come free with the same read: a blocker that is not on the
    open list is closed, so the shift knows which tickets are blocked."""
    bodies: dict[tuple[str, int], str] = {}
    unread: list[str] = []
    open_numbers: dict[str, set[int]] = {}
    wanted: dict[str, set[int]] = {}
    for issue in issues:
        repo = issue.get("repo") or ""
        number = issue.get("number")
        if repo and number:
            wanted.setdefault(repo, set()).add(number)
    for repo in sorted(wanted):
        try:
            raw = run(
                [
                    GH,
                    "issue",
                    "list",
                    "-R",
                    repo,
                    "--state",
                    "open",
                    "--limit",
                    str(ISSUE_LIMIT),
                    "--json",
                    "number,title,body",
                ],
                GH_TIMEOUT,
                deadline,
            )
            rows = json.loads(raw)
        except (RepoError, ValueError) as exc:
            unread.append(repo)
            print(f"overnight: {repo}: {exc}", file=sys.stderr)
            continue
        rows = rows if isinstance(rows, list) else []
        if len(rows) >= ISSUE_LIMIT:
            unread.append(repo)
            print(
                f"overnight: {repo}: the open issue list was cut off at "
                f"{ISSUE_LIMIT}, so the ticket text is not known",
                file=sys.stderr,
            )
            continue
        numbers = open_numbers.setdefault(repo, set())
        for row in rows:
            number = row.get("number")
            if isinstance(number, int):
                numbers.add(number)
            if number in wanted[repo]:
                bodies[(repo, number)] = (row.get("body") or "") + "\n" + (
                    row.get("title") or ""
                )
    return bodies, unread, open_numbers


def read_decisions() -> tuple[Path, list[str]]:
    """Return the coordinator's decisions log and its lines.

    The log is the coordinator's own parking lot, so it is read where the
    tick reads it. A missing log is not a crash: the filter drops every
    ticket it cannot check and refuses to return a list."""
    try:
        with open(DECISIONS_FILE) as stream:
            return DECISIONS_FILE, stream.read().splitlines()
    except OSError:
        return DECISIONS_FILE, []


def mark_reason(text: str) -> tuple[str, str] | None:
    """Return the mark a ticket body carries, with the line that carries it.

    A mark stands at the start of a line or of a clause, so a ticket that
    only talks about holding a position, or about a decision that needs
    Shyam later, is not marked."""
    for pattern, reason in (
        (HOLD_MARK, "marked hold"),
        (NEEDS_SHYAM_MARK, "marked needs Shyam"),
        (DESIGN_MARK, "marked design needed"),
    ):
        match = pattern.search(text)
        if match:
            start = text.rfind("\n", 0, match.start()) + 1
            end = text.find("\n", match.start())
            line = text[start : end if end != -1 else len(text)]
            return reason, clip(line)
    return None


def names_ticket(line: str, key: str | None, number: int | None) -> bool:
    """Return True when a decisions log line is about this ticket.

    A line is about a ticket when it names the ticket with its issue
    number, in either order ("SRW-685 #468", "#468 SRW-685", and the
    short form "685 #468"), or when the ticket is named right after the
    line's verb ("HOLD SRW-685", "OPEN (needs answer): SRW-1080 #990").
    A ticket named in passing ("once SRW-1067 merges") is not the subject
    of the line. A bare issue number is not enough: the same number can
    belong to a ticket in another repository."""
    if not key or not number:
        return False
    prefix, _, keynum = key.partition("-")
    if not prefix or not keynum:
        return False
    pairs = (
        rf"{re.escape(prefix)}-{re.escape(keynum)}\s*#\s*{number}\b",
        rf"#\s*{number}\s+{re.escape(prefix)}-{re.escape(keynum)}\b",
        rf"\b{re.escape(keynum)}\s*#\s*{number}\b",
    )
    for pattern in pairs:
        if re.search(pattern, line, re.I):
            return True
    for verb in DECISION_VERB.finditer(line):
        tail = line[verb.end() : verb.end() + SUBJECT_TAIL]
        if re.search(rf"\b{re.escape(prefix)}-{re.escape(keynum)}\b", tail, re.I):
            return True
    return False


def decision_reason(
    lines: list[str], key: str | None, number: int | None
) -> tuple[str, str] | None:
    """Return the open question a decisions log leaves for a ticket.

    The log is append-only history, so the last line that is about the
    ticket decides. The log writes an open item as a hold or a park
    ("HOLD SRW-685", "PARKED (needs Shyam)"), as "OPEN (needs answer)",
    as "Q: ...", or as a question that ends in a question mark. A line
    that answers the question closes it, but a hold outlives the question
    it was asked in."""
    last = None
    for line in lines:
        if names_ticket(line, key, number):
            last = line
    if last is None:
        return None
    if DECISION_HOLD.search(last):
        return "hold in the decisions log", clip(last)
    if DECISION_OPEN.search(last):
        return "open item in the decisions log", clip(last)
    if DECISION_STRONG.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_ASKS.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_ASKED.search(last) and not DECISION_CLOSED.search(last):
        return "open question in the decisions log", clip(last)
    if DECISION_QUESTION.search(last) and not DECISION_CLOSED.search(last):
        return "open question in the decisions log", clip(last)
    return None


def filter_issues(
    issues: list[dict],
    allowed: set[str],
    flagged: set[str],
    bodies: dict[tuple[str, int], str],
    lines: list[str],
) -> tuple[list[dict], list[tuple[dict, str]]]:
    """Return the tickets that survive the filter and the drops with their
    reasons.

    The rules are the spec's drop list: Ascend work, a repository off the
    allow list, a ticket marked hold, needs Shyam or design needed, and a
    ticket with an open question in the coordinator's decisions log. A
    ticket whose text could not be read is dropped, never kept: the filter
    fails closed."""
    kept: list[dict] = []
    drops: list[tuple[dict, str]] = []
    for issue in issues:
        repo = issue.get("repo") or ""
        key = issue.get("key") or ""
        number = issue.get("number")
        reason = ascend_reason(repo, key, repo in flagged)
        if reason is None and repo not in allowed:
            reason = f"repo not on the allow list: {repo}"
        body = bodies.get((repo, number))
        if reason is None and body is not None:
            mark = mark_reason(body)
            if mark:
                reason = f"{mark[0]}: {mark[1]}"
        if reason is None:
            found = decision_reason(lines, key, number)
            if found:
                reason = f"{found[0]}: {found[1]}"
        if reason is None and body is None:
            reason = "unverified: the ticket text could not be read"
        if reason is None and not lines:
            reason = "unverified: the decisions log could not be read"
        if reason:
            drops.append((issue, reason))
        else:
            kept.append(issue)
    return kept, drops


def cmd_filter(args: argparse.Namespace) -> int:
    """Filter the board and print every drop with its reason.

    The filter fails closed. A ticket whose text could not be read, or
    whose open question could not be checked, is dropped rather than
    kept, and the command exits non-zero so the shift knows the list it
    printed is not one it may work from."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    if stale:
        print("Overnight filter - dry run (read only)")
        print("REFUSED: the board list is stale, so the filter cannot be trusted.")
        print("The ticket CLI could not reach GitHub and fell back to its cache.")
        return 1
    bodies, unread, _open = read_bodies(issues, deadline)
    path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {path} could not be read")
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    print("Overnight filter - dry run (read only)")
    print(f"Board: {len(issues)} tickets")
    print(f"Allowed repositories: {len(repos)}")
    print(f"Decisions log: {path}" + ("" if lines else " (not found)"))
    for problem in problems:
        print(f"REFUSED: {problem}")
    print()
    print(f"Kept: {len(kept)}")
    print(f"Dropped: {len(drops)}")
    outside = sorted({issue.get("repo") or "" for issue in issues} - allowed)
    print(f"Board repositories outside the allow list: {len(outside)}")
    if drops:
        print()
        print("Drops (each with its reason)")
        for issue, reason in drops:
            key = issue.get("key") or "-"
            print(
                f"  DROP {issue.get('repo')}#{issue.get('number')} {key} - {reason}"
            )
    print()
    survived = [
        issue
        for issue in kept
        if ascend_reason(
            issue.get("repo") or "",
            issue.get("key") or "",
            (issue.get("repo") or "") in flagged,
        )
    ]
    print(f"Ascend items kept: {len(survived)}")
    if survived:
        for issue in survived:
            print(f"  FAIL {issue.get('repo')}#{issue.get('number')}")
        print("FAIL: an Ascend item survived the filter.")
        return 1
    if problems:
        print("REFUSED: the filter cannot return a list it could not fully check.")
        return 1
    return 0


def cmd_check_pr(args: argparse.Namespace) -> int:
    """Refuse any pull request that is Ascend work.

    This is the second check the spec asks for: intake drops Ascend work
    from the board, and this refuses an Ascend pull request before any
    work starts on it. The check fails closed: a pull request it could
    not read is refused, not passed."""
    deadline = time.monotonic() + args.deadline
    repo = args.repo
    number = args.number
    cfg = load_config()
    reason = ascend_reason(repo, None, repo in ascend_flags(cfg))
    if reason:
        print(f"REFUSED: {repo}#{number}: {reason}")
        return 1
    try:
        raw = run(
            [
                GH,
                "pr",
                "view",
                str(number),
                "-R",
                repo,
                "--json",
                "headRefName,body",
            ],
            GH_TIMEOUT,
            deadline,
        )
        pull = json.loads(raw) or {}
    except (RepoError, ValueError) as exc:
        print(f"overnight: {repo}#{number}: {exc}", file=sys.stderr)
        print(
            f"REFUSED: {repo}#{number}: the pull request could not be read, "
            "so the check cannot be trusted."
        )
        return 1
    branch = pull.get("headRefName") or ""
    body = pull.get("body") or ""
    keys = ascend_keys_in(branch)
    for key in ascend_keys_in(body):
        if key not in keys:
            keys.append(key)
    if keys:
        print(f"REFUSED: {repo}#{number}: Ascend key {keys[0]}")
        if branch:
            print(f"  branch {branch}")
        return 1
    print(f"OK: {repo}#{number} is not an Ascend pull request")
    return 0

# --- Part T3c: the order --------------------------------------------------

# The T3 client. The gate verdict lives in a T3 thread, so the shift
# reads T3 for the same reason the coordinator's panel does.
T3MCP = os.environ.get("OVERNIGHT_T3MCP", "t3mcp")
T3_TIMEOUT = 60
# The coordinator's queue folder. The gate dispatches are recorded there,
# so the shift finds the gate thread of a pull request without guessing.
COORDQ_DIR = os.environ.get(
    "COORDQ_DIR", str(Path.home() / "Code" / "coordinator" / "queue")
)
# The dispatch receipts: a request id to its T3 thread. A gate request is
# "gate:<repo>#<pull request>:<head sha>", so the receipt names the head
# the gate looked at.
RECEIPTS_FILE = "dispatch-receipts.json"
# The queue's own file. It names every head a gate was queued for, so the
# coordinator never gates one head twice.
QUEUE_FILE = "queue.json"
# The board key in a thread's title. The builder threads are titled
# "<key> · <title>", so the key says which ticket a live thread owns.
THREAD_KEY = re.compile(r"^([A-Za-z]{2,5}-\d+)\s*[·:\-]")
# The marked forms of a ticket that is already a 5-minute part. The board
# writes them in the ticket's own words: a light build slice, a light
# chore, or a part that says how many minutes it takes.
SPLIT_MARK = re.compile(
    r"(?i)\b(?:light build slice|light chore|5[- ]minute (?:builder )?part)\b"
    r"|\bbudget\b[^.\n]{0,40}\bto 5 minutes\b"
)
# A check that failed, or that can no longer pass, makes its pull request
# a failing pull request.
FAILED_CHECK = frozenset(
    {
        "FAILURE",
        "ERROR",
        "TIMED_OUT",
        "ACTION_REQUIRED",
        "STARTUP_FAILURE",
        "CANCELLED",
    }
)
# The board's stage labels. A ready ticket is one the board says may be
# worked now.
READY_STAGE = "todo"
# The "Blocked by" section of a ticket's own text.
BLOCKED_SECTION = re.compile(
    r"(?mi)^##[ \t]*blocked by[ \t]*$(.*?)(?=^##[ \t]|\Z)"
)
# A reference in a blocker section: a board key of this repository, a
# reference to another repository's issue, or a bare issue number.
BLOCK_KEY = re.compile(r"\b([A-Za-z]{2,5})-(\d+)\b")
BLOCK_REPO = re.compile(r"\b([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)\b")
BLOCK_BARE = re.compile(r"(?<![A-Za-z0-9_/-])#(\d+)\b")


def read_checks(repo: str, number: int, deadline: float) -> tuple[list[dict], str]:
    """Return the checks of one pull request and the reason none are known.

    `gh pr checks` exits non-zero when a check failed and when the pull
    request has no checks at all. Both are answers, not refusals, so this
    reads the command itself and tells the two apart by its message."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the deadline passed before the pull request checks could be read")
    try:
        result = subprocess.run(
            [
                GH,
                "pr",
                "checks",
                str(number),
                "-R",
                repo,
                "--json",
                "name,state,bucket",
            ],
            capture_output=True,
            text=True,
            timeout=max(1, min(GH_TIMEOUT, int(left))),
            check=False,
        )
    except FileNotFoundError:
        die(f"{GH} is not on PATH")
    except subprocess.TimeoutExpired:
        die(f"gh pr checks {repo}#{number} timed out")
    out = (result.stdout or "").strip()
    err = (result.stderr or "").strip()
    if result.returncode == 0:
        try:
            rows = json.loads(out or "[]")
        except ValueError as exc:
            raise RepoError(
                f"gh pr checks did not return JSON for {repo}#{number}: {exc}"
            )
        return (rows if isinstance(rows, list) else []), ""
    if "no checks reported" in err or "no checks reported" in out:
        return [], ""
    raise RepoError(
        f"gh pr checks {repo}#{number} failed ({result.returncode}): "
        + (err or out)[-200:]
    )


def failing_checks(rows: list[dict]) -> list[str]:
    """Return the checks of a pull request that failed."""
    failed = []
    for row in rows:
        state = str(row.get("state") or "").upper()
        bucket = str(row.get("bucket") or "").upper()
        if state in FAILED_CHECK or bucket in FAILED_CHECK:
            failed.append(f"{row.get('name') or '?'} ({state or bucket})")
    return failed


def read_receipts() -> tuple[dict[str, str], str]:
    """Return every dispatch receipt and the reason they are not known.

    The receipts are the queue's own record of what it dispatched. A
    receipt file that cannot be read is not a pass: the shift then calls
    no pull request gate PASS, and says so."""
    path = Path(COORDQ_DIR) / RECEIPTS_FILE
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        return {}, f"the dispatch receipts {path} could not be read: {exc}"
    if not isinstance(data, dict):
        return {}, f"the dispatch receipts {path} are not a mapping"
    return {str(key): str(value) for key, value in data.items()}, ""


def read_gate_receipts() -> tuple[dict[str, str], str]:
    """Return the gate dispatch receipts and the reason they are unknown."""
    receipts, error = read_receipts()
    if error:
        return {}, error
    return {
        key: value
        for key, value in receipts.items()
        if key.startswith("gate:")
    }, ""


def read_queue_state() -> dict:
    """Return the queue's own record: the gated heads and the queued tickets.

    The queue names every head it queued a gate for, queued or dispatched,
    so a head in it is a head the coordinator must not gate a second time.
    It names every ticket it holds too, so the coordinator does not start
    a ticket that is already on its way."""
    path = Path(COORDQ_DIR) / QUEUE_FILE
    state: dict = {"gatedHeads": set(), "queuedTickets": set(), "error": ""}
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        state["error"] = f"the queue {path} could not be read: {exc}"
        return state
    if not isinstance(data, dict):
        state["error"] = f"the queue {path} is not a mapping"
        return state
    heads = data.get("gatedHeads")
    if isinstance(heads, dict):
        state["gatedHeads"] = {str(key) for key in heads}
    for item in data.get("items") or []:
        if not isinstance(item, dict):
            continue
        args = item.get("args") or {}
        request_id = str(args.get("clientRequestId") or "")
        if request_id.startswith("ticket:"):
            state["queuedTickets"].add(request_id)
    return state


def builder_thread(receipts: dict[str, str], repo: str, number: int) -> tuple[str, int]:
    """Return the builder thread of a ticket and the attempt that built it.

    The receipts name the thread of every attempt the coordinator started,
    so the last attempt is the builder that holds the work. A ticket with
    no attempt has no builder."""
    prefix = f"ticket:{repo}#{number}:a"
    thread = ""
    attempt = 0
    for key, value in receipts.items():
        if not key.startswith(prefix):
            continue
        try:
            number_of_attempt = int(key[len(prefix) :])
        except ValueError:
            continue
        if number_of_attempt > attempt:
            thread = value
            attempt = number_of_attempt
    return thread, attempt


def read_gate_report(thread_id: str, deadline: float) -> tuple[str, str, str]:
    """Return the verdict, the report and the update time of a gate thread.

    The verdict is the last line of the gate's own message. A thread that
    cannot be read, or that ends with anything else, is no verdict. The
    report is that same message: it holds the findings the builder has to
    fix."""
    payload = json.dumps({"threadId": thread_id, "maxCharsPerItem": 20000})
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
    except RepoError:
        return "", "", ""
    try:
        data = json.loads(raw)
    except ValueError:
        return "", "", ""
    thread = data.get("thread") or {}
    updated = str(thread.get("updatedAt") or "")
    items = data.get("items") or []
    texts = [
        item.get("text") or ""
        for item in items
        if item.get("type") == "assistant_message"
    ]
    report = ""
    for text in reversed(texts):
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        if not lines:
            continue
        report = text
        if lines[-1] == "VERDICT: PASS":
            return "PASS", report, updated
        if lines[-1] == "VERDICT: FAIL":
            return "FAIL", report, updated
    return "", report, updated


def read_verdict(thread_id: str, deadline: float) -> str:
    """Return the verdict of one gate thread: PASS, FAIL or nothing."""
    return read_gate_report(thread_id, deadline)[0]


def read_live_threads(deadline: float) -> dict:
    """Return the live threads: the board keys they own and their ids.

    A live builder owns its ticket, so the coordinator must not start it a
    second time. The keys come from the threads' own titles."""
    state: dict = {"keys": set(), "ids": set(), "error": ""}
    payload = json.dumps(
        {
            "allProjects": True,
            "statuses": ["running", "starting", "preparing", "queued"],
            "limit": 100,
        }
    )
    try:
        raw = run([T3MCP, "call", "t3_thread_list", payload], T3_TIMEOUT, deadline)
    except RepoError:
        state["error"] = "the live threads could not be read"
        return state
    try:
        data = json.loads(raw)
    except ValueError:
        state["error"] = "the live threads could not be read"
        return state
    for thread in data.get("threads") or []:
        thread_id = str(thread.get("threadId") or "")
        if thread_id:
            state["ids"].add(thread_id)
        title = str(thread.get("title") or "")
        match = THREAD_KEY.match(title)
        if match:
            state["keys"].add(match.group(1).upper())
    return state


def read_thread_messages(thread_id: str, deadline: float) -> tuple[str, list[str]]:
    """Return when a thread was last updated and what it said.

    The texts are the thread's own messages, so a caller can tell whether
    a message it wants to send was already sent."""
    payload = json.dumps({"threadId": thread_id, "maxCharsPerItem": 20000})
    try:
        raw = run([T3MCP, "call", "t3_thread_read", payload], T3_TIMEOUT, deadline)
        data = json.loads(raw)
    except (RepoError, ValueError):
        return "", []
    thread = data.get("thread") or {}
    updated = str(thread.get("updatedAt") or "")
    texts = [
        item.get("text") or ""
        for item in (data.get("items") or [])
        if item.get("type") == "assistant_message"
    ]
    return updated, texts


def shell_quote(text: str) -> str:
    """Return text as one shell word."""
    return "'" + text.replace("'", "'\"'\"'") + "'"


def gate_verdict(
    receipts: dict[str, str], repo: str, number: int, head: str, deadline: float
) -> str:
    """Return the gate verdict for one pull request head.

    The receipt names the head the gate looked at, so a gate for an older
    head is not a verdict for this one. A receipt without a verdict is no
    verdict: the shift never calls a pull request gate PASS it cannot read
    from the gate itself."""
    if not head:
        return ""
    thread_id = receipts.get(f"gate:{repo}#{number}:{head}")
    if not thread_id:
        return ""
    return read_verdict(thread_id, deadline)


def blockers_for(
    body: str,
    repo: str,
    key: str,
    open_numbers: dict[str, set[int]],
    board_by_key: dict[str, dict],
) -> list[str]:
    """Return the blockers of a ticket that are not met yet.

    A blocker is met when its issue is closed, so it is not on the open
    issue list of its repository. A blocker that cannot be checked is
    treated as unmet: the shift does not start work whose order it cannot
    prove."""
    found = BLOCKED_SECTION.search(body or "")
    if not found:
        return []
    text = re.sub(r"<!--.*?-->", "", found.group(1), flags=re.S).strip()
    if not text:
        return []
    first = text.splitlines()[0].strip().lower().rstrip(".:")
    if first in ("none", "n/a", "nil", "-"):
        return []
    open_here = open_numbers.get(repo, set())
    blockers: list[str] = []
    masked = BLOCK_REPO.sub(" ", text)
    for match in BLOCK_REPO.finditer(text):
        target_repo, number = match.group(1), int(match.group(2))
        if target_repo.lower() != repo.lower():
            blockers.append(f"{target_repo}#{number} (not checked)")
            continue
        if number in open_here:
            blockers.append(f"{repo}#{number} is still open")
    for match in BLOCK_KEY.finditer(masked):
        label = f"{match.group(1).upper()}-{match.group(2)}"
        if label.startswith((key or " ").upper()):
            ticket = board_by_key.get(label)
            if ticket is None:
                blockers.append(f"{label} (not on the board)")
            elif ticket.get("number") in open_here:
                blockers.append(f"{label} (#{ticket.get('number')}) is still open")
    for match in BLOCK_BARE.finditer(masked):
        number = int(match.group(1))
        if number in open_here:
            blockers.append(f"{repo}#{number} is still open")
    return blockers


def order_key(item: dict) -> tuple:
    """Return the sort key of one item of the ordered list.

    Priority comes first: Shyam steers the night through the priority
    label. A blocked item waits for its blocker, so it follows the items
    that are ready. The board's own order breaks the tie, so the same
    board always produces the same list."""
    priority = item.get("priority")
    number = priority if isinstance(priority, int) else 99
    return (number, 1 if item.get("blockers") else 0, item.get("repo") or "",
            item.get("number") or 0)


def summarize(counts: dict[str, dict]) -> str:
    """Return the one-line summary of the order, per repository and state."""
    parts = []
    for repo in sorted(counts):
        row = counts[repo]
        if not row["total"]:
            continue
        parts.append(
            f"{repo} {row['total']} (failing {row['failing']}, "
            f"gate-pass {row['gate']}, split {row['split']}, "
            f"unsplit {row['unsplit']})"
        )
    return "; ".join(parts) if parts else "no items"


def write_shift_line(root: Path, line: str) -> Path:
    """Append one line to the shift log and return the file.

    The shift log is the night's record, one line per event. It holds no
    list: the board is the list."""
    if not root.is_dir():
        die(
            f"the overnight folder {root} does not exist, so the shift log "
            "cannot be written"
        )
    path = root / "run" / "shift-log.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(PT).strftime("%Y-%m-%d %I:%M %p PT")
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"{stamp} | {line}\n")
    return path


def read_all_checks(
    pairs: list[tuple[str, int]], deadline: float
) -> dict[tuple[str, int], tuple[list[dict], str]]:
    """Return the checks of every pull request, read at once.

    One call reads one pull request's checks and the board holds many open
    pull requests, so the calls run together: the board is read in
    seconds, not in minutes."""
    results: dict[tuple[str, int], tuple[list[dict], str]] = {}
    if not pairs:
        return results
    with ThreadPoolExecutor(max_workers=6) as pool:
        futures = {
            pair: pool.submit(read_checks, pair[0], pair[1], deadline)
            for pair in pairs
        }
        for pair, future in futures.items():
            try:
                results[pair] = future.result()
            except RepoError as exc:
                results[pair] = ([], str(exc))
    return results


def collect_items(
    deadline: float,
    repos: list[tuple[str, str]],
    issues: list[dict],
    bodies: dict[tuple[str, int], str],
    open_numbers: dict[str, set[int]],
    drops: list[tuple[dict, str]],
    receipts: dict[str, str],
) -> dict:
    """Return the board's items in the order the shift works them.

    This is the one order: `order` prints it and `board` returns it, so
    the day tick and the night shift work the same list. Every pull
    request carries its head, the gate that looked at it and the builder
    that holds it, and every ready ticket carries the one action the
    coordinator may take on it now, so no caller has to look a second
    time."""
    allowed = {repo for repo, _ in repos}
    keys = {repo: key for repo, key in repos}
    pull_requests: dict[str, list[dict]] = {}
    pr_error = ""
    with ThreadPoolExecutor(max_workers=6) as pool:
        futures = {
            repo: pool.submit(read_pull_requests, repo, deadline)
            for repo, _key in repos
        }
        for repo, future in futures.items():
            try:
                rows, cut = future.result()
            except RepoError as exc:
                pr_error = f"{repo}: {exc}"
                break
            pull_requests[repo] = rows
            if cut:
                pr_error = f"{repo}: more than {PR_LIMIT} open pull requests"
                break
    if pr_error:
        return {"pr_error": pr_error}

    records = build_records(issues, pull_requests)
    dropped = {
        (issue.get("repo") or "", issue.get("number")) for issue, _reason in drops
    }
    board_by_key = {
        (issue.get("key") or "").upper(): issue
        for issue in issues
        if issue.get("key")
    }
    queue_state = read_queue_state()
    gated_heads = queue_state["gatedHeads"]
    queued_tickets = queue_state["queuedTickets"]
    live = read_live_threads(deadline)

    pairs: list[tuple[str, int]] = []
    for repo in sorted(allowed):
        for record in records.get(repo, []):
            if (record.get("repo"), record.get("number")) in dropped:
                continue
            prs = (
                [record]
                if record["kind"] == "pr"
                else (record.get("prs") or [])
            )
            for pull in prs:
                pairs.append((repo, pull["number"]))
    checks = read_all_checks(pairs, deadline)

    failing: list[dict] = []
    gate_pass: list[dict] = []
    split_items: list[dict] = []
    unsplit_items: list[dict] = []
    in_flight: list[dict] = []
    backlog: list[dict] = []
    counts: dict[str, dict] = {}
    unverified_prs: list[str] = []

    def count_for(repo: str) -> dict:
        return counts.setdefault(
            repo,
            {
                "total": 0,
                "failing": 0,
                "gate": 0,
                "split": 0,
                "unsplit": 0,
                "in_flight": 0,
                "backlog": 0,
            },
        )

    for repo in sorted(allowed):
        bucket = records.get(repo, [])
        for record in bucket:
            if (record.get("repo"), record.get("number")) in dropped:
                continue
            prs = (
                [record]
                if record["kind"] == "pr"
                else (record.get("prs") or [])
            )
            if prs:
                for pull in prs:
                    item = {
                        "kind": "pull-request",
                        "repo": repo,
                        "number": pull.get("number"),
                        "key": record.get("key") or "",
                        "title": pull.get("title") or "",
                        "url": pull.get("url") or "",
                        "priority": record.get("priority"),
                        "ticket": record.get("number"),
                        "standalone": record["kind"] == "pr",
                        "head": pull.get("headRefOid") or "",
                        "isDraft": bool(pull.get("isDraft")),
                        "action": "none",
                        "actionReason": "",
                        "actionCommand": "",
                    }
                    rows, unknown = checks.get(
                        (repo, pull["number"]), ([], "the checks were not read")
                    )
                    if unknown and "could not be read" in unknown:
                        unverified_prs.append(f"{repo}#{pull['number']}: {unknown}")
                        in_flight.append(item)
                        count_for(repo)["in_flight"] += 1
                        continue
                    failed = failing_checks(rows)
                    item["checks"] = {"failed": failed}
                    if failed:
                        item["reason"] = "failing check: " + ", ".join(failed)
                        item["actionReason"] = "a check is failing"
                        failing.append(item)
                        count_for(repo)["failing"] += 1
                        count_for(repo)["total"] += 1
                        continue
                    head = item["head"]
                    request_id = f"gate:{repo}#{pull['number']}:{head}"
                    thread_id = receipts.get(request_id, "")
                    verdict = ""
                    report = ""
                    gate_updated = ""
                    if thread_id:
                        verdict, report, gate_updated = read_gate_report(
                            thread_id, deadline
                        )
                    status = "none"
                    if verdict == "PASS":
                        status = "pass"
                    elif verdict == "FAIL":
                        status = "fail"
                    elif thread_id:
                        status = "running"
                    if status == "none" and request_id in gated_heads:
                        status = "queued"
                    issue_number = refs_issue(pull.get("body") or "")
                    builder, attempt = (
                        builder_thread(receipts, repo, issue_number)
                        if issue_number
                        else ("", 0)
                    )
                    item["gate"] = {
                        "status": status,
                        "requestId": request_id,
                        "threadId": thread_id,
                        "updatedAt": gate_updated,
                    }
                    item["builder"] = {
                        "threadId": builder,
                        "attempt": attempt,
                        "live": bool(builder and builder in live["ids"]),
                    }
                    item["issue"] = issue_number
                    if status == "fail":
                        if not builder:
                            item["actionReason"] = (
                                "no builder thread is known for this ticket"
                            )
                        else:
                            builder_updated, builder_texts = read_thread_messages(
                                builder, deadline
                            )
                            item["builder"]["updatedAt"] = builder_updated
                            mark = (report or "")[:200]
                            if mark and any(mark in text for text in builder_texts):
                                item["actionReason"] = (
                                    "the builder already has these findings"
                                )
                            else:
                                item["action"] = "fix"
                                item["actionCommand"] = fix_command(
                                    repo,
                                    pull["number"],
                                    head,
                                    builder,
                                    report,
                                )
                    elif status == "none":
                        if item["isDraft"]:
                            item["actionReason"] = "draft pull request"
                        elif not issue_number:
                            item["actionReason"] = (
                                "no board ticket names this pull request"
                            )
                        elif not builder_check_passes(pull, rows, head):
                            item["actionReason"] = (
                                "the builder check does not name this head"
                            )
                        else:
                            item["action"] = "gate"
                            item["actionCommand"] = (
                                f"coordq gate {repo}#{pull['number']}"
                            )
                    else:
                        item["actionReason"] = {
                            "pass": "gate PASS",
                            "running": "the gate is running",
                            "queued": "a gate for this head is on its way",
                        }.get(status, "")
                    if verdict == "PASS":
                        item["reason"] = "gate PASS"
                        gate_pass.append(item)
                        count_for(repo)["gate"] += 1
                        count_for(repo)["total"] += 1
                        continue
                    if verdict == "FAIL":
                        item["reason"] = "gate FAIL"
                    elif unknown:
                        item["reason"] = unknown
                    else:
                        item["reason"] = (
                            "open pull request, no failing check and no gate "
                            "verdict"
                        )
                    in_flight.append(item)
                    count_for(repo)["in_flight"] += 1
                continue
            # A ticket with no open pull request.
            item = {
                "kind": "ticket",
                "repo": repo,
                "number": record.get("number"),
                "key": record.get("key") or "",
                "title": record.get("title") or "",
                "url": record.get("url") or "",
                "priority": record.get("priority"),
                "stage": record.get("stage"),
                "ticket": record.get("number"),
                "action": "none",
                "actionReason": "",
                "actionCommand": "",
            }
            if record.get("stage") != READY_STAGE:
                item["reason"] = f"stage {record.get('stage') or 'unknown'}"
                item["actionReason"] = "the board stage is not todo"
                backlog.append(item)
                count_for(repo)["backlog"] += 1
                continue
            body = bodies.get((repo, record.get("number"))) or ""
            item["blockers"] = blockers_for(
                body, repo, keys.get(repo, ""), open_numbers, board_by_key
            )
            split = bool(SPLIT_MARK.search(body))
            item["split"] = split
            if split:
                item["reason"] = "already a 5-minute part"
                split_items.append(item)
                count_for(repo)["split"] += 1
                count_for(repo)["total"] += 1
            else:
                item["reason"] = "split first, then add the parts"
                unsplit_items.append(item)
                count_for(repo)["unsplit"] += 1
                count_for(repo)["total"] += 1
            key = (record.get("key") or "").upper()
            queued = [
                request
                for request in queued_tickets
                if request.startswith(f"ticket:{repo}#{record.get('number')}:")
            ]
            if item["blockers"]:
                item["actionReason"] = (
                    "blocked: " + "; ".join(item["blockers"])
                )
            elif key and key in live["keys"]:
                item["actionReason"] = "a builder thread for this ticket is live"
            elif queued:
                item["actionReason"] = "the ticket is already queued"
            elif record.get("problems"):
                item["actionReason"] = "the board labels need a fix: " + ", ".join(
                    record["problems"]
                )
            else:
                item["action"] = "start"
                item["actionCommand"] = f"ticket start {repo}#{record.get('number')}"
                item["dryRunCommand"] = (
                    f"ticket start {repo}#{record.get('number')} --dry-run"
                )

    failing.sort(key=order_key)
    gate_pass.sort(key=order_key)
    split_items.sort(key=order_key)
    unsplit_items.sort(key=order_key)
    return {
        "failing": failing,
        "gate_pass": gate_pass,
        "split": split_items,
        "unsplit": unsplit_items,
        "in_flight": in_flight,
        "backlog": backlog,
        "counts": counts,
        "unverified": unverified_prs,
        "queue": queue_state,
        "live": live,
    }


def builder_check_passes(pull: dict, rows: list[dict], head: str) -> bool:
    """Return True when the builder's check names this head.

    The check is the line the builder wrote in the pull request body,
    `Builder check: PASS <head>`, or the agent check the repository
    publishes on the head. A trailing note after the head (the command
    that produced it) does not change the verdict. A check that does not
    name the head is no check for that head, so the head is not gated:
    a gate that cannot read the diff would only report the check."""
    if not head:
        return False
    for line in (pull.get("body") or "").splitlines():
        if line.strip().startswith(f"Builder check: PASS {head}"):
            return True
    for row in rows or []:
        if str(row.get("name") or "") != AGENT_CHECK:
            continue
        state = str(row.get("bucket") or row.get("state") or "").upper()
        if state in ("PASS", "SUCCESS"):
            return True
    return False


def refs_issue(body: str) -> int:
    """Return the issue a pull request body names, or 0 when it names none.

    The coordinator's own queue reads a "Refs #<n>" line, so this reads
    the same line: a pull request that names no ticket is one the
    coordinator has no task for."""
    for line in (body or "").splitlines():
        match = REFS_ISSUE.search(line)
        if match:
            return int(match.group(1))
    return 0


def fix_command(
    repo: str, number: int, head: str, builder: str, report: str
) -> str:
    """Return the command that sends a failed gate's findings to the builder.

    The command is one shell word per argument, so the tick can run it as
    it is written."""
    message = (
        f"The Opus gate on PR #{number} at {head} returned VERDICT: FAIL. "
        "Fix every critical and major finding below (minors if small), run "
        "the check, push, update the PR body's Builder check line to the new "
        "head, and report.\n\n" + (report or "")[-6000:]
    )
    payload = {"threadId": builder, "message": message}
    return (
        "coordq start "
        + shell_quote(json.dumps(payload))
        + " --tool t3_thread_send --priority 300"
    )


def cmd_order(args: argparse.Namespace) -> int:
    """Order the whole board and write one summary line to the shift log.

    The order is the spec's: the pull requests that are already open and
    failing a check, then the pull requests with a gate PASS, then the
    ready tickets that are already split into 5-minute parts, then the
    ready tickets that are not split yet. There is no cap and no list
    file: the board is the list, and the only file this command writes
    is one line of the shift log."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    print("Overnight order - dry run (read only)")
    if stale:
        print("REFUSED: the board list is stale, so the order cannot be trusted.")
        print("The ticket CLI could not reach GitHub and fell back to its cache.")
        return 1
    bodies, unread, open_numbers = read_bodies(issues, deadline)
    path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {path} could not be read")
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    if problems:
        for problem in problems:
            print(f"REFUSED: {problem}")
        print("REFUSED: the order cannot return a list it could not fully check.")
        return 1

    receipts, receipt_error = read_receipts()
    result = collect_items(
        deadline, repos, issues, bodies, open_numbers, drops, receipts
    )
    if result.get("pr_error"):
        print(f"REFUSED: {result['pr_error']}")
        print("REFUSED: the order cannot return a list it could not fully check.")
        return 1
    failing = result["failing"]
    gate_pass = result["gate_pass"]
    split_items = result["split"]
    unsplit_items = result["unsplit"]
    in_flight = result["in_flight"]
    backlog = result["backlog"]
    counts = result["counts"]
    unverified_prs = result["unverified"]
    gate_error = receipt_error

    def show(title: str, items: list[dict], start: int) -> int:
        print()
        print(f"{title} ({len(items)})")
        for offset, item in enumerate(items):
            blockers = ""
            if item.get("blockers"):
                blockers = " [blocked: " + "; ".join(item["blockers"]) + "]"
            print(
                f"  {start + offset}. {item['repo']}#{item['number']} "
                f"{item.get('key') or '-'} {item['title']} - {item.get('reason', '')}"
                f"{blockers}"
            )
        return start + len(items)

    planned = len(failing) + len(gate_pass) + len(split_items) + len(unsplit_items)
    print(f"Board: {len(issues)} tickets")
    print(f"Allowed repositories: {len(repos)}")
    print(f"Decisions log: {path}")
    print(f"Dropped by the filter: {len(drops)}")
    print(f"Planned items: {planned}")
    if gate_error:
        print(
            "The gate dispatches could not be read, so no pull request is "
            f"called gate PASS: {gate_error}"
        )
    if unverified_prs:
        for note in unverified_prs:
            print(f"UNVERIFIED: {note}")
    index = 1
    index = show("Failing pull requests", failing, index)
    index = show("Pull requests with a gate PASS", gate_pass, index)
    index = show("Ready tickets already split into 5-minute parts", split_items, index)
    index = show("Ready tickets not yet split", unsplit_items, index)
    index = show("Not work items: a pull request is open", in_flight, index)
    show("Not ready: the board stage is not todo", backlog, index)
    line = f"planned {planned} items | {summarize(counts)}"
    log = write_shift_line(report_root(args.root), line)
    print()
    print(f"Summary line written to {log}")
    print(f"  {line}")
    print(
        "No list file is written: the board is the list, and this run wrote "
        "one line of the shift log and nothing else."
    )
    return 0



# --- The attended first night (spec part T13) ------------------------------

# The types the attended night may work: one small part. These are the
# board's own types. A ticket Shyam holds never reaches the list, because
# the ticket CLI keeps it out, so the night needs no second hold rule.
SMALL_TYPES = {"chore", "standard"}
# The gate's verdict line, as the gate writes it.
GATE_VERDICT = re.compile(r"VERDICT:\s*(?P<verdict>PASS|FAIL)", re.I)
# The keys of the Ascend repositories. The allow list leaves them out; the
# check is here so the shift can say that it left them out.
ASCEND_KEYS = {"AUH", "MCP", "OPS", "DBT", "OMN"}
# The folders the attended night writes.
ATTEND_DIRS = ("run", "receipts", "inbox", "staging")


def run_read(argv: list[str], timeout: int, deadline: float) -> tuple[int, str]:
    """Run a read-only command and return its exit code and its output.

    A read-only command that fails is not fatal: the shift keeps the exit
    code and what it saw, and the receipt says so. Nothing here merges,
    pushes or writes to a repository."""
    left = deadline - time.monotonic()
    if left <= 0:
        die("the attended night ran out of time before the next command could run")
    try:
        result = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=max(1, min(timeout, int(left))),
            check=False,
        )
    except FileNotFoundError:
        die(f"{argv[0]} is not on PATH")
    except subprocess.TimeoutExpired:
        return 124, f"{' '.join(argv)} timed out"
    return result.returncode, (result.stdout or "") + (result.stderr or "")


def slot_cap() -> int | None:
    """Return the queue's slot cap, read only.

    The shift never writes this file and never raises the cap. When the
    file cannot be read the cap is unknown, and the policy says so."""
    try:
        with open(SLOT_CAP_FILE) as stream:
            value = json.load(stream).get("cap")
    except (OSError, ValueError, AttributeError):
        return None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def select_items(issues: list[dict], allowed: set[str], limit: int) -> list[dict]:
    """Return the small board items the attended night may work.

    The board is the list. The attended night takes the first items the
    board shows that are small: on the todo stage, in an allowed
    repository, and of a type that is one small part. A ticket Shyam holds
    is not in the list at all, so the night never takes one. The Ascend
    keys are never taken."""
    picked: list[dict] = []
    for issue in issues:
        if len(picked) >= limit:
            break
        if issue.get("stage") != "todo":
            continue
        if issue.get("repo") not in allowed:
            continue
        key = (issue.get("key") or "").upper()
        if key.split("-")[0] in ASCEND_KEYS:
            continue
        if (issue.get("type") or "").lower() not in SMALL_TYPES:
            continue
        picked.append(issue)
    return picked


def pull_request_gate_verdict(repo: str, number: int, deadline: float) -> str:
    """Return the gate's verdict on a pull request: PASS, FAIL or UNKNOWN.

    The gate writes its verdict on the pull request, as a comment or as a
    review. When the shift cannot read one, the verdict is UNKNOWN, and a
    receipt with an UNKNOWN gate is never counted as passed.

    The name says which verdict this is: the one the gate wrote on the
    pull request. The module's other `gate_verdict` reads the gate's own
    receipts for a head, and the two are not the same read."""
    code, out = run_read(
        [GH, "pr", "view", str(number), "-R", repo, "--json", "comments,reviews"],
        GH_TIMEOUT,
        deadline,
    )
    if code != 0:
        return "UNKNOWN"
    found = GATE_VERDICT.findall(out)
    if not found:
        return "UNKNOWN"
    return str(found[-1]).upper()


def observe_pull_request(repo: str, number: int, deadline: float) -> dict:
    """Return what a pull request really shows.

    Every command here is read only. Each exit code is kept, because a
    check counts as run only when it names its command and its exit code."""
    checks_code, checks_out = run_read(
        [GH, "pr", "checks", str(number), "-R", repo], GH_TIMEOUT, deadline
    )
    files_code, files_out = run_read(
        [GH, "pr", "view", str(number), "-R", repo, "--json", "files"],
        GH_TIMEOUT,
        deadline,
    )
    files = 0
    if files_code == 0:
        try:
            rows = json.loads(files_out)
            if isinstance(rows, dict):
                rows = rows.get("files") or []
            files = len(rows) if isinstance(rows, list) else 0
        except ValueError:
            files = 0
    # "no checks reported" is not a failed check: the pull request has no
    # checks yet, and the receipt says that instead of claiming a failure.
    no_checks = "no checks reported" in checks_out.lower()
    return {
        "checks_exit": checks_code,
        "checks_out": checks_out,
        "no_checks": no_checks,
        "files": files,
        "gate": pull_request_gate_verdict(repo, number, deadline),
    }


def receipt_text(issue: dict, state: str, pr: dict | None, observation: dict | None,
                 observed: int, stopped: str, nxt: str) -> str:
    """Return one receipt of the attended night.

    The receipt holds what the shift really saw. A check that did not run
    has no exit code, and a gate that could not be read says UNKNOWN. No
    builder ran, so the builder time is zero and the time the shift spent
    looking is recorded apart from it."""
    fields = issue.get("title") or ""
    lines = [f"# {issue.get('key') or issue.get('number')}", ""]
    lines.append(f"- Item: {fields}")
    lines.append(f"- Repo: {issue.get('repo', '')}")
    lines.append(f"- Ticket: {issue.get('key', '')} (#{issue.get('number')})")
    lines.append(f"- State: {state}")
    if pr:
        lines.append(f"- PR: {pr.get('url', '')}")
    if observation:
        command = f"gh pr checks {pr.get('number')} -R {issue.get('repo', '')}"
        lines.append(f"- Checks: `{command}` exit {observation['checks_exit']}")
        lines.append(f"- Gate: {observation['gate']}")
        lines.append(f"- Files: {observation['files']}")
    lines.append("- Time used: 0 min")
    lines.append(f"- Observed: {observed} s")
    lines.append(f"- Stopped because: {stopped}")
    lines.append(f"- Next: {nxt}")
    return "\n".join(lines) + "\n"


def cmd_attend(args: argparse.Namespace) -> int:
    """Run the attended first night.

    This is the command a person runs when they sit down to watch the
    night. The shift arms itself in the folder it is given, reads the
    board, takes the small items the board shows and observes each one for
    real: the pull request it has, the checks it runs, the gate's verdict
    and the files it touches. It writes one receipt per item, the shift log
    and then the morning report.

    The night runs no merge, no push and no builder. The tick part (T5) is
    not built yet, so the attended night observes and records what it
    really saw, and every receipt says what stopped it."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _key in repos}
    if not allowed:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    items = select_items(issues, allowed, args.items)
    if len(items) < args.items:
        die(
            f"the board shows only {len(items)} small items, and the "
            f"attended night was asked for {args.items}"
        )
    root = Path(args.root).expanduser() if args.root else report_root(None) / (
        f"attended-{args.date or datetime.now(PT).strftime('%Y-%m-%d')}"
    )
    if args.dry_run:
        print("Overnight attended night - dry run (read only)")
        print(f"Board: {len(issues)} tickets{' (stale)' if stale else ''}")
        print(f"Run by: {args.run_by}")
        print(f"Planned items: {len(items)}")
        for issue in items:
            print(
                f"- {issue.get('key')} (#{issue.get('number')}) "
                f"{issue.get('title', '')} [{issue.get('type')}] {issue.get('repo')}"
            )
        print("A dry run writes no record and starts no work.")
        return 0
    for name in ATTEND_DIRS:
        (root / name).mkdir(parents=True, exist_ok=True)
    start = datetime.now(PT)
    close = start + timedelta(minutes=args.minutes)
    shift_id = f"attended-{start.strftime('%Y%m%d-%H%M')}"
    (root / "run" / "armed").write_text(
        f"shift: {shift_id}\n"
        f"start: {pt_clock(start)}\n"
        f"run by: {args.run_by}\n"
        f"items: {len(items)}\n"
    )
    (root / "run" / "deadline").write_text(f"{close.timestamp()}\n")
    policy = build_policy()
    policy.update(
        {
            "allowance_used_percent": None,
            "run_by": args.run_by,
            "window_minutes": args.minutes,
        }
    )
    write_policy(root, policy)
    log_lines = [
        f"{start.strftime('%Y-%m-%d %H:%M %Z')} | attended night | started, "
        f"run by {args.run_by}, planned {len(items)} items",
        f"{start.strftime('%Y-%m-%d %H:%M %Z')} | attended night | the shift "
        f"runs read-only commands only: no merge, no push, no builder",
    ]
    # The log exists from the start, so a night that stops early still
    # leaves a record of what it did.
    log_path = root / "run" / "shift-log.md"
    log_path.write_text("\n".join(log_lines) + "\n")
    pr_cache: dict[str, list[dict]] = {}
    for issue in items:
        item_start = time.monotonic()
        repo = issue.get("repo", "")
        # The issue numbers of one repository are its own, so the board
        # maps are built per repository.
        by_number = {
            other["number"]: other
            for other in issues
            if other.get("repo") == repo and other.get("number")
        }
        by_key = {
            (other.get("key") or "").upper(): other
            for other in issues
            if other.get("repo") == repo and other.get("key")
        }
        if repo not in pr_cache:
            try:
                rows, _cut = read_pull_requests(repo, deadline)
            except RepoError as exc:
                rows = []
                print(f"overnight: {repo}: {exc}", file=sys.stderr)
            pr_cache[repo] = rows
        linked = []
        for row in pr_cache[repo]:
            target, _signal = linked_ticket(row, by_number, by_key)
            if target is not None and target.get("number") == issue.get("number"):
                linked.append(row)
        pr = linked[0] if linked else None
        observation = None
        if pr:
            observation = observe_pull_request(repo, pr["number"], deadline)
            checks_code = observation["checks_exit"]
            gate = observation["gate"]
            if observation["no_checks"]:
                state = "stuck"
                stopped = "the pull request has no checks yet"
                nxt = "the builder runs the checks for this pull request"
            elif checks_code != 0:
                state = "stuck"
                stopped = (
                    f"the checks on the pull request did not pass "
                    f"(exit {checks_code})"
                )
                nxt = "the builder fixes the failing check and the gate runs again"
            elif gate != "PASS":
                state = "stuck"
                stopped = f"the gate did not pass (gate {gate})"
                nxt = "the gate runs again on the pull request"
            else:
                state = "ready"
                stopped = (
                    "the shift has no merge right for this repository, so the "
                    "pull request waits for Shyam"
                )
                nxt = "Shyam merges the pull request in the morning"
        else:
            state = "stuck"
            stopped = "no pull request is open for this ticket"
            nxt = (
                "the tick part (T5) starts the builder for this item; the "
                "attended night only observes"
            )
        elapsed = time.monotonic() - item_start
        observed = int(elapsed + 0.5)
        receipt = root / "receipts" / f"{issue.get('key')}.md"
        receipt.write_text(
            receipt_text(issue, state, pr, observation, observed, stopped, nxt)
        )
        detail = (
            f"`gh pr checks {pr['number']} -R {repo}` exit {observation['checks_exit']}"
            f"{' (no checks yet)' if observation['no_checks'] else ''}, "
            f"gate {observation['gate']}"
            if observation
            else "no pull request is open"
        )
        log_lines.append(
            f"{datetime.now(PT).strftime('%Y-%m-%d %H:%M %Z')} | item "
            f"{issue.get('key')} (#{issue.get('number')}) | {state} | {detail}"
        )
    if args.wait:
        # The human is watching: the shift holds the door until its window
        # closes. It waits the whole window, so the night never ends early
        # and claims the deadline.
        remaining = close.timestamp() - time.time()
        while remaining > 0:
            time.sleep(min(remaining, 60))
            remaining = close.timestamp() - time.time()
    if (root / "run" / "STOP").exists():
        end = "ended: STOP"
    elif datetime.now(PT) >= close:
        end = "ended: deadline"
    else:
        end = "ended: the items were observed and the window is still open"
    log_lines.append(
        f"{datetime.now(PT).strftime('%Y-%m-%d %H:%M %Z')} | attended night | "
        f"{end}"
    )
    log_path.write_text("\n".join(log_lines) + "\n")
    print(f"overnight: attended night {shift_id} wrote {len(items)} receipts")
    for issue in items:
        print(f"  - {issue.get('key')} (#{issue.get('number')})")
    return cmd_report(
        argparse.Namespace(root=str(root), date=args.date, dry_run=False)
    )


def board_item(order: int, group: str, item: dict) -> dict:
    """Return one board item for the tick, with the action it needs."""
    row = {
        "order": order,
        "group": group,
        "kind": item.get("kind"),
        "repo": item.get("repo"),
        "number": item.get("number"),
        "key": item.get("key") or "",
        "ticket": item.get("ticket"),
        "title": item.get("title") or "",
        "url": item.get("url") or "",
        "priority": item.get("priority"),
        "stage": item.get("stage"),
        "reason": item.get("reason") or "",
        "blockers": item.get("blockers") or [],
        "action": item.get("action") or "none",
        "actionReason": item.get("actionReason") or "",
        "actionCommand": item.get("actionCommand") or "",
    }
    if item.get("dryRunCommand"):
        row["dryRunCommand"] = item["dryRunCommand"]
    if item.get("kind") == "pull-request":
        row["head"] = item.get("head") or ""
        row["isDraft"] = bool(item.get("isDraft"))
        row["issue"] = item.get("issue") or 0
        row["checks"] = item.get("checks") or {"failed": []}
        row["gate"] = item.get("gate") or {}
        row["builder"] = item.get("builder") or {}
    if item.get("split") is not None:
        row["split"] = bool(item.get("split"))
    return row


def cmd_board(args: argparse.Namespace) -> int:
    """Return the whole board for the tick, as JSON.

    The command reads only: it writes no file and keeps no list. The board
    is the list. Every item carries the one action the coordinator may
    take on it now, so the tick works the whole board instead of a window
    of it: it starts the ready work, queues a gate for every open pull
    request head that has none, and sends a failed gate's findings back to
    the builder that holds the pull request."""
    deadline = time.monotonic() + args.deadline
    cfg = load_config()
    repos = allowed_repos(cfg)
    allowed = {repo for repo, _ in repos}
    flagged = ascend_flags(cfg)
    if not repos:
        die("the board config names no repositories")
    issues, stale = read_board(deadline)
    if stale:
        print(
            "overnight: REFUSED: the board list is stale, so the board "
            "cannot be trusted.",
            file=sys.stderr,
        )
        return 1
    bodies, unread, open_numbers = read_bodies(issues, deadline)
    decisions_path, lines = read_decisions()
    problems: list[str] = []
    if unread:
        problems.append(
            "the ticket text of these repositories could not be read: "
            + ", ".join(unread)
        )
    if not lines:
        problems.append(f"the decisions log {decisions_path} could not be read")
    kept, drops = filter_issues(issues, allowed, flagged, bodies, lines)
    if problems:
        for problem in problems:
            print(f"overnight: REFUSED: {problem}", file=sys.stderr)
        return 1
    receipts, receipt_error = read_receipts()
    result = collect_items(
        deadline, repos, issues, bodies, open_numbers, drops, receipts
    )
    if result.get("pr_error"):
        print(f"overnight: REFUSED: {result['pr_error']}", file=sys.stderr)
        return 1
    groups = (
        ("failing", result["failing"]),
        ("gate-pass", result["gate_pass"]),
        ("ready-split", result["split"]),
        ("ready-unsplit", result["unsplit"]),
        ("in-flight", result["in_flight"]),
        ("backlog", result["backlog"]),
    )
    items: list[dict] = []
    order = 0
    for name, bucket in groups:
        for item in bucket:
            order += 1
            items.append(board_item(order, name, item))
    actions = {"start": 0, "gate": 0, "fix": 0, "none": 0}
    for item in items:
        actions[item["action"]] = actions.get(item["action"], 0) + 1
    pull_requests = sum(1 for item in items if item["kind"] == "pull-request")
    no_gate = [
        item
        for item in items
        if item["kind"] == "pull-request"
        and item.get("gate", {}).get("status") == "none"
    ]
    queue = result["queue"]
    live = result["live"]
    payload = {
        "command": "overnight board",
        "generatedAt": datetime.now(PT).strftime("%Y-%m-%d %H:%M %Z"),
        "board": {
            "tickets": len(issues),
            "repositories": len(repos),
            "dropped": len(drops),
            "openPullRequests": pull_requests,
            "pullRequestsWithoutAGate": len(no_gate),
        },
        "actions": actions,
        "groups": {name: len(bucket) for name, bucket in groups},
        "gates": {
            "queuedHeads": len(queue["gatedHeads"]),
            "queuedTickets": len(queue["queuedTickets"]),
            "queueError": queue["error"],
            "receiptsError": receipt_error,
        },
        "live": {
            "threads": len(live["ids"]),
            "keys": len(live["keys"]),
            "error": live["error"],
        },
        "items": items,
    }
    print(json.dumps(payload, indent=1))
    return 0


