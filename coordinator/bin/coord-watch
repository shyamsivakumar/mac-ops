#!/usr/bin/env python3
"""Emit one read-only BOARD snapshot; invoke again for the next cycle."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import time

MAX_REPOS = 40
MAX_PAGES = 3
TTL = 300
MAX_BYTES = 8 * 1024 * 1024


def read_json(path):
    with open(path) as stream:
        raw = stream.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        raise ValueError("source exceeds byte limit")
    return json.loads(raw)


def command(argv, deadline, data=None):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise ValueError("cycle deadline exhausted")
    result = subprocess.run(argv, input=data, capture_output=True, text=True,
                            timeout=min(15, remaining))
    if result.returncode:
        raise ValueError("source command failed")
    if len(result.stdout) > MAX_BYTES:
        raise ValueError("source exceeds byte limit")
    return json.loads(result.stdout)


def pages(repo, kind, deadline):
    rows = []
    for page in range(1, MAX_PAGES + 1):
        batch = command(["gh", "api", f"repos/{repo}/{kind}?state=open&per_page=100&page={page}"], deadline)
        if not isinstance(batch, list):
            raise ValueError("expected GitHub list")
        for row in batch:
            if kind == "pulls":
                references = " ".join(re.findall(r"\b(?:refs|fixes|closes|resolves)\s+#\d+\b",
                                                   row.get("body") or "", re.I))
                rows.append({"number": row["number"], "title": row.get("title", ""),
                             "body": references, "head": row.get("head", {})})
            else:
                rows.append({key: row[key] for key in
                             ("number", "title", "labels", "updated_at", "html_url", "pull_request")
                             if key in row})
        if len(batch) < 100:
            return rows, True
    return rows, False


def threads(deadline):
    rows, cursor = [], None
    for _ in range(MAX_PAGES):
        args = {"allProjects": True, "limit": 100, "includeSubagents": False}
        if cursor is not None:
            args["cursor"] = cursor
        result = command(["t3mcp", "call", "t3_thread_list", "-"], deadline, json.dumps(args))
        batch = result["threads"]
        if not isinstance(batch, list):
            raise ValueError("expected T3 threads")
        rows.extend(batch)
        next_cursor = result.get("nextCursor")
        if next_cursor is None:
            return rows, True
        if next_cursor == cursor:
            raise ValueError("T3 cursor did not advance")
        cursor = next_cursor
    return rows, False


def queue_sources(root):
    result = {}
    for name in ("queue.json", "dispatch-receipts.json"):
        try:
            result[name] = read_json(root / name)
        except (OSError, ValueError):
            result[name] = None
    try:
        with open(root / "dispatch.log", "rb") as stream:
            stream.seek(0, 2)
            stream.seek(max(0, stream.tell() - 65536))
            result["log"] = stream.read(65536).decode("utf-8", errors="replace")
    except OSError:
        result["log"] = None
    return result


def collect(cfg, previous, deadline, now, read_gate):
    sources = {}
    for repo in list(cfg["repos"])[:MAX_REPOS]:
        old = previous.get("github", {}).get(repo, {})
        if 0 <= now - old.get("checkedAt", 0) < TTL:
            sources[repo] = old
            continue
        entry = {"checkedAt": now, "issues": old.get("issues", []),
                 "pulls": old.get("pulls", []), "complete": False}
        try:
            issues, issues_complete = pages(repo, "issues", deadline)
            pulls, pulls_complete = pages(repo, "pulls", deadline)
            entry.update(issues=issues, pulls=pulls, complete=issues_complete and pulls_complete)
        except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
            pass
        sources[repo] = entry
    try:
        live, complete = threads(deadline)
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        live, complete = [], False
    queue = queue_sources(Path(os.environ.get("COORDQ_DIR", str(Path.home() / "Code/coordinator/queue"))))
    gates = []
    receipts = queue.get("dispatch-receipts.json") or {}
    for repo, source in sources.items():
        for pull in source.get("pulls", []) if source.get("complete") else []:
            head = pull.get("head", {}).get("sha")
            thread = receipts.get(f"gate:{repo}#{pull['number']}:{head}")
            if isinstance(thread, str):
                verdict, _, _ = read_gate(thread, deadline, head)
                gates.append({"repo": repo, "pr": pull["number"], "head": head,
                              "thread": thread, "verdict": verdict})
    return {"github": sources, "threads": live, "threadsComplete": complete,
            "queue": queue, "gates": gates}


def snapshot(cfg, raw, previous, normalize, link):
    items = {}
    statuses = {}
    queue = raw.get("queue") or {}
    receipts = queue.get("dispatch-receipts.json")
    receipts = receipts if isinstance(receipts, dict) else {}
    for repo in cfg["repos"]:
        source = raw.get("github", {}).get(repo, {})
        complete = source.get("complete") is True
        statuses[repo] = "complete" if complete else "unknown"
        by_number, by_key = {}, {}
        for issue in source.get("issues", []):
            if "pull_request" in issue:
                continue
            normalized = normalize(cfg, repo, {**issue, "url": issue.get("html_url", ""),
                                               "updatedAt": issue.get("updated_at", "")})
            number = normalized["number"]
            row = {"repo": repo, "issue": number, "stage": normalized["stage"] if complete else "unknown",
                   "thread": None, "pr": None, "head": None, "attempt": None,
                   "threadStatus": "unknown",
                   "parked": any(label.get("name") in {"stage:backlog", "stage:hold"}
                                 for label in issue.get("labels", []))}
            items[f"{repo}#{number}"] = row
            by_number[number] = normalized
            if normalized.get("key"):
                by_key[normalized["key"]] = normalized
        if not complete:
            for old in previous.get("items", []):
                if old["repo"] == repo:
                    key = f"{repo}#{old['issue']}"
                    items.setdefault(key, {**old, "stage": "unknown", "pr": None, "head": None,
                                           "threadStatus": "unknown"})
        for pull in source.get("pulls", []) if complete else []:
            target, _ = link({**pull, "headRefName": pull.get("head", {}).get("ref", "")}, by_number, by_key)
            if target:
                row = items[f"{repo}#{target['number']}"]
                if row["pr"] is None or pull["number"] > row["pr"]:
                    row.update(pr=pull["number"], head=pull.get("head", {}).get("sha"))
    for key, row in items.items():
        attempts = []
        for request, thread in receipts.items():
            match = re.fullmatch(r"ticket:" + re.escape(key) + r":a(\d+)", request)
            if match and isinstance(thread, str):
                attempts.append((int(match[1]), thread))
        pending = queue.get("queue.json") or {}
        for entry in pending.get("items", []):
            request = entry.get("args", {}).get("clientRequestId", "")
            match = re.fullmatch(r"ticket:" + re.escape(key) + r":a(\d+)", request)
            if match:
                attempts.append((int(match[1]), entry.get("args", {}).get("threadId")))
        if attempts:
            attempt = max(a for a, _ in attempts)
            row.update(attempt=attempt, thread=next((t for a, t in attempts if a == attempt and t), None))
        for thread in raw.get("threads", []):
            if row["thread"] and thread.get("threadId") == row["thread"]:
                row["threadStatus"] = thread.get("status") or "unknown"
    return {"schema": 1, "items": sorted(items.values(), key=lambda r: (r["repo"], r["issue"])),
            "sources": {"github": statuses, "t3": "complete" if raw.get("threadsComplete") is True else "unknown",
                        "queue": "complete" if all(queue.get(k) is not None for k in
                            ("queue.json", "dispatch-receipts.json", "log")) else "unknown"}}


def detect(board, raw, previous):
    seen = set(previous.get("events", []))
    idle = dict(previous.get("idle", {}))
    events = []
    terminal = {"completed", "complete", "idle", "stopped", "error", "errored", "failed"}
    for repo, status in board["sources"]["github"].items():
        complete = (status == "complete" and board["sources"]["t3"] == "complete"
                    and board["sources"]["queue"] == "complete")
        if not complete:
            idle[repo] = 0
            seen.discard(f"EVENT lane-idle {repo}")
            continue
        rows = [row for row in board["items"] if row["repo"] == repo]
        for row in rows:
            if (not row.get("parked") and row["stage"] not in {"backlog", "hold", "unknown"} and not row["pr"]
                    and row["thread"] and row["threadStatus"] in {"completed", "complete", "idle"}):
                events.append(f"EVENT builder-stopped {repo}#{row['issue']} thread={row['thread']}")
        heads = {pull["number"]: pull.get("head", {}).get("sha")
                 for pull in raw["github"][repo].get("pulls", [])}
        for gate in raw.get("gates", []):
            if gate.get("repo") == repo and gate.get("head") and gate.get("verdict") == "FAIL":
                request = f"gate:{repo}#{gate['pr']}:{gate['head']}"
                if (heads.get(gate.get("pr")) == gate["head"] and
                        raw["queue"]["dispatch-receipts.json"].get(request) == gate.get("thread")):
                    events.append(f"EVENT gate-fail {repo}#{gate['pr']} {gate['head']}")
        pending = raw["queue"]["queue.json"].get("items", [])
        queued = any(repo in json.dumps(entry.get("args", {})) for entry in pending)
        gate_threads = {gate.get("thread") for gate in raw.get("gates", []) if gate.get("repo") == repo}
        gate_active = any(thread.get("threadId") in gate_threads and thread.get("status") not in terminal
                          for thread in raw.get("threads", []))
        active = queued or gate_active or any(row["thread"] and row["threadStatus"] not in terminal for row in rows)
        work = any(not row.get("parked") and (row["stage"] == "todo" or
                   (row["stage"] in {None, "started"} and not row["pr"])) for row in rows)
        idle[repo] = idle.get(repo, 0) + 1 if work and not active else 0
        if idle[repo] >= 2:
            events.append(f"EVENT lane-idle {repo}")
        else:
            seen.discard(f"EVENT lane-idle {repo}")
    fresh = [event for event in events if event not in seen]
    seen.update(events)
    return fresh, {"events": sorted(seen), "idle": idle}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="collect one cycle (also the default)")
    parser.add_argument("--fake-input", type=Path, help="JSON source envelope; no network calls; persists --state")
    parser.add_argument("--config", type=Path)
    parser.add_argument("--state", type=Path, default=Path.home() / ".coordinator/coord-watch.json")
    args = parser.parse_args()
    here = Path(__file__).resolve().parent
    ticket = runpy.run_path(str(here / "ticket"))
    overnight = here / "overnight"
    if not overnight.exists():
        overnight = here.parent / "overnight/overnight"
    adapter = runpy.run_path(str(overnight))
    cfg = read_json(args.config) if args.config else ticket["load_config"]()
    args.state.parent.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(args.state, os.O_RDWR | os.O_CREAT, 0o600), "r+") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        content = stream.read(MAX_BYTES + 1)
        if len(content) > MAX_BYTES:
            raise ValueError("state exceeds byte limit")
        previous = json.loads(content) if content else {}
        raw = read_json(args.fake_input) if args.fake_input else collect(
            cfg, previous, time.monotonic() + 120, time.time(), adapter["read_gate_report"])
        if args.fake_input and not previous:
            previous = raw.get("previous", {})
        board = snapshot(cfg, raw, previous, ticket["normalize_issue"], adapter["linked_ticket"])
        events, detection = detect(board, raw, previous)
        state = {"github": raw["github"], "items": board["items"], **detection}
        stream.seek(0)
        json.dump(state, stream)
        stream.truncate()
    for event in events:
        print(event)
    print("BOARD " + json.dumps(board, separators=(",", ":")))


if __name__ == "__main__":
    main()
