#!/usr/bin/env python3
"""The daily factory scorecard: a replay of the event journal, checked against GitHub.

    scorecard --date 2026-11-19
    scorecard --date 2026-11-19 --json
    scorecard backfill --since 2026-11-13

A metric is `{"value", "status", "why"}`. The status is `unknown` whenever the
evidence for the metric is missing, and an unknown metric never carries a 0.
Days are America/Los_Angeles days.
"""
import argparse
import collections
import json
import math
import os
import random
import re
import sqlite3
import statistics
import subprocess
import sys
from datetime import date as Date, datetime, time as Time, timedelta
from zoneinfo import ZoneInfo

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gh_gateway
import journal

TZ = ZoneInfo("America/Los_Angeles")
CALLER = "scorecard"
CALL_LIMIT = 60
REVERT_DAYS = 7
LIVE_FILE = re.compile(r"^events-\d{4}-\d{2}\.jsonl$")
BACKFILL_FILE = "events-backfill.jsonl"
TIME = r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)"
LOG_STARTED = re.compile(rf"^{TIME} started #(\d+) (\w+) .*\(was (\d+)/(\d+)\)(?: key \S+)?$")
LOG_FAILED = re.compile(rf"^{TIME} FAILED #(\d+) attempt (\d+):")
LOG_DROPPED = re.compile(rf"^{TIME} DROPPED #(\d+) after (\d+) attempts")
LOG_AT_CAP = re.compile(rf"^{TIME} at cap (\d+)/(\d+), (\d+) waiting$")
COMMON = ("repo", "ticket", "pr", "head", "thread", "item", "attempt", "kind")


class Unavailable(Exception):
    pass


def metric(value, why="", **extra):
    return {"value": value, "status": "ok", "why": why, **extra}


def unknown(why):
    return {"value": None, "status": "unknown", "why": why}


def day_bounds(day):
    start = datetime.combine(day, Time.min, TZ)
    end = datetime.combine(day + timedelta(days=1), Time.min, TZ)
    return start.timestamp(), end.timestamp()


def local_hour(ts):
    return datetime.fromtimestamp(ts, TZ).strftime("%Y-%m-%d %H")


def ref(repo, number):
    return f"{repo}#{number}"


def read_events(path):
    rows, bad = [], 0
    try:
        with open(path) as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    bad += 1
                    continue
                if isinstance(row, dict) and isinstance(row.get("ts"), (int, float)) and row.get("event"):
                    rows.append(row)
                else:
                    bad += 1
    except FileNotFoundError:
        pass
    return rows, bad


def clean_rows(rows):
    kept, seen = [], set()
    for row in rows:
        head = row.get("head")
        if isinstance(head, str) and len(head) == 40 and len(set(head)) == 1:
            continue
        if head:
            key = (row.get("event"), row.get("repo"), row.get("pr"), head)
        else:
            key = (row.get("event"), row.get("repo"), row.get("pr"), row.get("ts"))
        if key in seen:
            continue
        seen.add(key)
        kept.append(row)
    return kept


def load_journal(directory):
    live, backfill, bad = [], [], 0
    if os.path.isdir(directory):
        for name in sorted(os.listdir(directory)):
            if LIVE_FILE.match(name):
                rows, unreadable = read_events(os.path.join(directory, name))
                live += rows
                bad += unreadable
    backfill, unreadable = read_events(os.path.join(directory, BACKFILL_FILE))
    live = clean_rows(sorted(live, key=lambda row: row["ts"]))
    backfill = clean_rows(sorted(backfill, key=lambda row: row["ts"]))
    return live, backfill, bad + unreadable


def data_of(row):
    return row.get("data") or {}


def first_gate_verdicts(rows, start=None, end=None):
    assigned = {}
    for row in rows:
        ts = row.get("ts", 0)
        if row["event"] == "assigned" and (start is None or start <= ts < end):
            assigned.setdefault((row["repo"], row["ticket"]), ts)
    pr_ticket = {(row["repo"], row["pr"]): row["ticket"] for row in rows
                 if row.get("ticket") is not None and row.get("pr") is not None}
    first = {}
    for row in rows:
        if row["event"] != "gate_verdict":
            continue
        ticket = row.get("ticket")
        if ticket is None:
            ticket = pr_ticket.get((row["repo"], row.get("pr")))
        key = (row["repo"], ticket)
        if key in assigned and row.get("ts", 0) >= assigned[key]:
            first.setdefault(key, data_of(row).get("verdict"))
    return assigned, first


def first_gate_pass(rows, start=None, end=None):
    assigned, first = first_gate_verdicts(rows, start, end)
    if not assigned:
        return None
    return sum(1 for key in assigned if first.get(key) == "PASS") / len(assigned)


class GitHub:
    def __init__(self, repos):
        self.repos = set(repos)
        self.owners = sorted({repo.split("/")[0] for repo in repos})
        self.calls = 0

    def search(self, kind, flags, fields, query=()):
        if self.calls >= CALL_LIMIT:
            raise Unavailable(f"the {CALL_LIMIT} call limit for one report was reached")
        self.calls += 1
        argv = ["gh", "search", kind, *query, *flags, "--limit", "1000", "--json", fields + ",repository"]
        for owner in self.owners:
            argv += ["--owner", owner]
        result = gh_gateway.run(argv, timeout=90, caller_name=CALLER)
        if result.returncode:
            raise Unavailable(f"gh search {kind} failed: {result.stderr.strip()[:120]}")
        rows = json.loads(result.stdout)
        if len(rows) >= 1000:
            raise Unavailable(f"gh search {kind} hit the 1000 result limit")
        names = {repo.lower(): repo for repo in self.repos}
        grouped = {repo: [] for repo in self.repos}
        for row in rows:
            name = names.get(row["repository"]["nameWithOwner"].lower())
            if name:
                grouped[name].append(row)
        return grouped

    def merged_prs(self, start, end):
        return self.search("prs", ["--merged", "--merged-at", span(start, end)], "number,title,body,closedAt")

    def closed_issues(self, start, end):
        return self.search("issues", ["--state", "closed", "--closed", span(start, end)], "number,title,closedAt")

    def reverts(self, start, end):
        return self.search("prs", ["--match", "title", "--merged", "--merged-at", span(start, end)],
                           "number,title,body,closedAt", query=["Revert"])

    def fixes(self, start, end):
        return self.search("prs", ["--merged", "--merged-at", span(start, end)], "number,title,body,createdAt,closedAt")

    def event_page(self, repo, page):
        if self.calls >= CALL_LIMIT:
            raise Unavailable(f"the {CALL_LIMIT} call limit for one report was reached")
        self.calls += 1
        result = gh_gateway.run(["gh", "api", f"repos/{repo}/issues/events?per_page=100&page={page}",
                                 "--jq", ".[] | {event: .event, number: .issue.number, at: .created_at}"],
                                timeout=90, caller_name=CALLER)
        if result.returncode:
            raise Unavailable(f"gh api issues/events failed for {repo}: {result.stderr.strip()[:120]}")
        return [json.loads(line) for line in result.stdout.splitlines() if line.strip()]

    def reopened(self, start, end):
        found = {}
        for repo in sorted(self.repos):
            found[repo] = []
            page = 1
            while True:
                rows = self.event_page(repo, page)
                found[repo] += [{"number": row["number"], "at": row["at"]} for row in rows
                                if row["event"] == "reopened" and start <= iso_ts(row["at"]) <= end]
                if len(rows) < 100 or iso_ts(rows[-1]["at"]) < start:
                    break
                page += 1
        return found


def span(start, end):
    return "..".join(datetime.fromtimestamp(ts, TZ).isoformat() for ts in (start, end))


def fetch_github(repos, start, end, revert_window_closed):
    github = GitHub(repos)
    try:
        merged = github.merged_prs(start, end)
        closed = github.closed_issues(start, end)
        reverted = github.reverts(start, end + REVERT_DAYS * 86400) if revert_window_closed else None
        fixes = github.fixes(start, end + REVERT_DAYS * 86400) if revert_window_closed else None
        tickets = github.closed_issues(start, end + REVERT_DAYS * 86400) if revert_window_closed else None
        reopened = github.reopened(start, end + REVERT_DAYS * 86400) if revert_window_closed else None
        return {"merged": merged, "closed": closed, "reverts": reverted, "fixes": fixes,
                "tickets": tickets, "reopened": reopened, "calls": github.calls}
    except (Unavailable, gh_gateway.ApiBudgetExhausted, json.JSONDecodeError,
            subprocess.TimeoutExpired, OSError) as exc:
        return {"error": f"GitHub read failed: {exc}", "calls": github.calls}


def reverted_merges(merged, reverts):
    found = []
    for repo, prs in merged.items():
        for pr in prs:
            quoted = f'Revert "{pr["title"]}"'
            for revert in reverts.get(repo, []):
                names_it = re.search(rf"Reverts\s+\S*#{pr['number']}\b", revert.get("body") or "")
                within = 0 <= iso_ts(revert["closedAt"]) - iso_ts(pr["closedAt"]) <= REVERT_DAYS * 86400
                if (revert["title"] == quoted or names_it) and within:
                    found.append(ref(repo, pr["number"]))
                    break
    return found


def escaped_merges(merged, reverts, fixes, reopened, closed_tickets=None):
    found = {}
    for repo, prs in merged.items():
        for pr in prs:
            tickets = {int(n) for n in re.findall(r"(?:Refs|Fixes|Closes)\s+\S*#(\d+)", pr.get("body") or "")}
            closed = iso_ts(pr["closedAt"])
            best = None
            for revert in reverts.get(repo, []):
                names_it = re.search(rf"Reverts\s+\S*#{pr['number']}\b", revert.get("body") or "")
                at = iso_ts(revert["closedAt"])
                if (revert["title"] == f'Revert "{pr["title"]}"' or names_it) and 0 <= at - closed <= REVERT_DAYS * 86400:
                    if best is None or (at, 0) < best[:2]:
                        best = (at, 0, "revert")
            ticket_closed = {row["number"]: iso_ts(row["closedAt"]) for row in (closed_tickets or {}).get(repo, [])}
            for fix in fixes.get(repo, []):
                if fix["number"] == pr["number"]:
                    continue
                named = {int(n) for n in re.findall(r"(?:Fixes|Follow-up to|Follow up to)\s+\S*#(\d+)",
                                                    fix.get("body") or "")}
                at = iso_ts(fix["closedAt"])
                after_close = any(ticket_closed.get(n, at + 1) <= iso_ts(fix["createdAt"]) for n in named & tickets)
                if (pr["number"] in named or after_close) and 0 <= at - closed <= REVERT_DAYS * 86400:
                    if best is None or (at, 1) < best[:2]:
                        best = (at, 1, "fix")
            for row in reopened.get(repo, []):
                at = iso_ts(row["at"])
                if row["number"] in tickets and 0 <= at - closed <= REVERT_DAYS * 86400:
                    if best is None or (at, 2) < best[:2]:
                        best = (at, 2, "reopen")
            if best:
                found[ref(repo, pr["number"])] = best[2]
    return found


def iso_ts(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()


def percentile(sorted_values, fraction):
    return sorted_values[max(0, math.ceil(fraction * len(sorted_values)) - 1)]


TOKEN_KINDS = ("input", "output", "cacheRead", "cacheWrite")


def thread_usage(path):
    tokens, billed = 0, 0.0
    try:
        with open(path) as handle:
            for line in handle:
                try:
                    message = json.loads(line).get("message")
                except (ValueError, AttributeError):
                    continue
                usage = message.get("usage") if isinstance(message, dict) and message.get("role") == "assistant" else None
                if not isinstance(usage, dict):
                    continue
                tokens += sum(usage[kind] for kind in TOKEN_KINDS if isinstance(usage.get(kind), (int, float)))
                cost = usage.get("cost")
                paid = cost.get("total") if isinstance(cost, dict) else None
                if isinstance(paid, (int, float)) and paid > 0:
                    billed += paid
    except OSError:
        return None
    return {"tokens": tokens, "billed": billed}


def spread(values, digits):
    ordered = sorted(values)
    if not ordered:
        return {"total": None, "median": None, "p90": None}
    return {"total": round(sum(ordered), digits), "median": round(statistics.median(ordered), digits),
            "p90": round(percentile(ordered, 0.9), digits)}


def ticket_costs(accepted, receipts, journal_rows, db_path):
    prs = collections.defaultdict(set)
    for row in journal_rows:
        if row.get("ticket") is not None and row.get("pr") is not None:
            prs[(row.get("repo"), row["ticket"])].add(row["pr"])
    wanted = set(accepted)
    threads = collections.defaultdict(set)
    for key, thread in receipts.items():
        if match := re.match(r"^ticket:([^#]+)#(\d+):a\d+$", key):
            ticket = (match.group(1), int(match.group(2)))
            if ticket in wanted:
                threads[ticket].add(thread)
        elif match := re.match(r"^(?:gate|fix):([^#]+)#(\d+):[0-9a-f]+$", key):
            repo, pr = match.group(1), int(match.group(2))
            for ticket in wanted:
                if ticket[0] == repo and pr in prs.get(ticket, ()):
                    threads[ticket].add(thread)
    connection = sqlite3.connect("file:" + db_path + "?mode=ro", uri=True)
    usage = {}
    for thread in {thread for found in threads.values() for thread in found}:
        row = connection.execute(
            "select json_extract(payload_json,'$.nativeThreadRef.nativeId') "
            "from orchestration_v2_projection_provider_threads where thread_id=? and driver='pi'",
            (thread,)).fetchone()
        found = thread_usage(row[0]) if row and row[0] else None
        if found is not None:
            usage[thread] = found
    connection.close()
    per_ticket = {"tokens": [], "billed": []}
    unpriced = 0
    no_usage = 0
    for ticket in accepted:
        found = threads.get(ticket, ())
        have = [usage[thread] for thread in found if thread in usage]
        unpriced += sum(1 for thread in found if thread not in usage or usage[thread]["billed"] <= 0)
        tokens = sum(item["tokens"] for item in have)
        if tokens > 0:
            per_ticket["tokens"].append(tokens)
        else:
            no_usage += 1
        billed = sum(item["billed"] for item in have)
        if billed > 0:
            per_ticket["billed"].append(billed)
    return {"tickets": len(accepted), "no_usage_tickets": no_usage,
            "tokens": spread(per_ticket["tokens"], 0),
            "dollars": {**spread(per_ticket["billed"], 2), "tickets": len(per_ticket["billed"])},
            "unpriced_threads": unpriced}


def slot_peak(rows):
    peak, lines = None, []
    for row in rows:
        data = data_of(row)
        occupied = data["occupied"] if "occupied" in data else (data["live"] or 0) + (data["reserved"] or 0)
        if peak is None or occupied > peak:
            peak, lines = occupied, []
        if occupied == peak and "line" in data and len(lines) < 5:
            lines.append(f"dispatch.log:{data['line']} ({data['reading']})")
    return peak, lines


def minutes_over_cap(history, start, end):
    held, since, total = None, start, 0.0
    for row in history:
        ts = min(max(row["ts"], start), end)
        if held and held["data"].get("over_cap"):
            total += ts - since
        held, since = row, ts
    if held and held["data"].get("over_cap"):
        total += end - since
    return round(total / 60, 1)


def alarms_open(events, end):
    state = {}
    for row in events:
        if row["ts"] >= end:
            break
        if row["event"] in ("alarm_raised", "alarm_withdrawn"):
            state[data_of(row).get("alarm")] = row["event"] == "alarm_raised"
    return sorted(alarm for alarm, raised in state.items() if raised)


def pick(covered, live_day, backfill_day, name):
    if covered:
        return [row for row in live_day if row["event"] == name], "journal"
    return [row for row in backfill_day if row["event"] == name], "backfill"


def coverage_state(first, start, end, matched, total):
    if first is None or first >= end:
        return "none"
    if total is None or total == 0:
        return "full" if first <= start else "partial"
    return "full" if matched / total >= 0.95 else "partial"


def build(day, live, backfill, bad_lines, github, window_closed, repos, cost_sources=None):
    start, end = day_bounds(day)
    live_day = [row for row in live if start <= row["ts"] < end]
    backfill_day = [row for row in backfill if start <= row["ts"] < end]
    hours = len({local_hour(row["ts"]) for row in live_day})
    first = min((row["ts"] for row in live), default=None)
    gh_ok = "error" not in github
    gh_why = "" if gh_ok else github["error"]
    merged = github["merged"] if gh_ok else {}
    merged_refs = {ref(repo, pr["number"]) for repo, prs in merged.items() for pr in prs}
    lane_merged = {ref(row["repo"], row["pr"]) for row in live if row["event"] == "merged"}
    outside = {ref(row["repo"], row["pr"]) for row in live if row["event"] == "merged_outside_lane"}
    matched_refs = (merged_refs & lane_merged) | (merged_refs & outside)
    state = coverage_state(first, start, end, len(matched_refs) if gh_ok else None,
                           len(merged_refs) if gh_ok else None)
    covered = state == "full"
    if state == "partial":
        no_journal = f"journal started {datetime.fromtimestamp(first, TZ).strftime('%H:%M')} into the day"
    elif first is None:
        no_journal = "no journal"
    else:
        no_journal = f"no journal on {day} (it starts {datetime.fromtimestamp(first, TZ).date()})"
    seen = f"journal ran the whole day ({hours} of 24 hours had events)"

    def counted(name):
        if not covered:
            return unknown(no_journal)
        return metric(sum(1 for row in live_day if row["event"] == name), seen)

    def with_backfill(name):
        rows, source = pick(covered, live_day, backfill_day, name)
        if source == "backfill" and not backfill_day:
            return unknown(no_journal + " and no backfill")
        why = seen if source == "journal" else "from dispatch.log backfill"
        return metric(len(rows), why)

    closes = {}
    for row in live_day:
        if row["event"] == "ticket_closed":
            closes[(row["repo"], row["ticket"])] = row["ts"]
    restarted = {(row["repo"], row["ticket"]): row["ts"] for row in live if row["event"] == "ticket_started"}
    accepted = sorted(key for key, ts in closes.items() if not restarted.get(key, 0) > ts)
    first_start = {}
    for row in live:
        if row["event"] == "ticket_started":
            first_start.setdefault((row["repo"], row["ticket"]), row["ts"])
    lead = sorted((closes[key] - first_start[key]) / 60 for key in accepted if key in first_start)

    if not covered:
        headline = unknown(no_journal)
        lead_metric = unknown(no_journal)
    else:
        headline = metric(len(accepted), seen + "; a ticket started again after its close is not counted",
                          items=[ref(*key) for key in accepted])
        if lead:
            lead_metric = metric({"p50_minutes": round(percentile(lead, 0.5), 1),
                                  "p90_minutes": round(percentile(lead, 0.9), 1), "tickets": len(lead)},
                                 f"{len(accepted) - len(lead)} accepted tickets had no ticket_started event")
        else:
            lead_metric = unknown("no accepted ticket with a ticket_started event")

    closed_refs = {ref(repo, issue["number"]) for repo, issues in (github["closed"] if gh_ok else {}).items()
                   for issue in issues}

    if not window_closed:
        change_failure = unknown("window open")
    elif not gh_ok:
        change_failure = unknown(gh_why)
    else:
        reverted = reverted_merges(merged, github["reverts"] or {})
        escaped = escaped_merges(merged, github["reverts"] or {}, github["fixes"] or {},
                                 github["reopened"] or {}, github["tickets"] or {})
        change_failure = metric({"reverted": reverted, "merges": len(merged_refs), "escaped": len(escaped),
                                 "kinds": escaped},
                                f"a merged PR with a revert, a fix PR or a reopened ticket within {REVERT_DAYS} days")

    closed_in_journal = {ref(row["repo"], row["ticket"]) for row in live
                         if row["event"] in ("ticket_closed", "ticket_abandoned")}
    if not covered:
        touches = unknown(no_journal)
    elif not gh_ok:
        touches = unknown(gh_why)
    else:
        merge_touches = sorted(merged_refs - lane_merged)
        close_touches = sorted(closed_refs - closed_in_journal)
        touches = metric(len(merge_touches) + len(close_touches),
                         "outside the lane (hand or reviewer): every agent uses the same GitHub login",
                         merges=merge_touches, closes=close_touches)

    launches, launch_source = pick(covered, live_day, backfill_day, "launched")
    gate_launches = [row for row in live_day if row["event"] == "launched" and row["kind"] == "gate"]
    heads = collections.Counter((row["repo"], row["pr"], row["head"]) for row in gate_launches)
    merges_in_day = {ref(row["repo"], row["pr"]) for row in live_day if row["event"] == "merged"}
    if not covered:
        per_accepted = per_merge = gate_heads = duplicates = fix_rounds = capped = verdicts = unknown(no_journal)
    else:
        per_accepted = (metric(round(len(launches) / len(accepted), 2), f"{len(launches)} launches, {len(accepted)} accepted tickets")
                        if accepted else unknown("no accepted ticket"))
        per_merge = (metric(round(len(gate_launches) / len(merges_in_day), 2),
                            f"{len(gate_launches)} gate launches, {len(merges_in_day)} lane merges")
                     if merges_in_day else unknown("no lane merge"))
        gate_heads = metric(len(heads), seen)
        duplicates = metric(sum(1 for count in heads.values() if count > 1),
                            "gate heads with more than one gate launch; a new head after a fix is not one")
        fix_rounds = metric(sum(1 for row in live_day if row["event"] == "fix_sent"), seen)
        capped = metric(len({(row["repo"], row["pr"]) for row in live_day if row["event"] == "round_cap"}), seen)
        mix = collections.Counter(data_of(row).get("verdict") for row in live_day if row["event"] == "gate_verdict")
        verdicts = metric({name: mix.get(name, 0) for name in ("PASS", "FAIL", "SPLIT")},
                          "one verdict per gate thread and head; none and absent are not journaled")

    if covered:
        history = [row for row in live if row["event"] == "slots" and row["ts"] < end]
        carried = [row for row in history if row["ts"] < start][-1:]
        slot_rows = carried + [row for row in history if row["ts"] >= start]
        if not slot_rows:
            peak = over = unknown("no slots event in the journal yet")
        else:
            top, lines = slot_peak(slot_rows)
            peak = metric(top, "from slots events, seeded with the state carried into the day",
                          lines=lines, cap=max(data_of(row)["cap"] for row in slot_rows))
            over = metric(minutes_over_cap(slot_rows, start, min(end, today_ts())),
                          "from the slots state held between changes, seeded with the state carried into the day")
    else:
        slot_rows = [row for row in backfill_day if row["event"] == "slots"]
        if not slot_rows:
            peak = over = unknown(no_journal + " and no backfill")
        else:
            top, lines = slot_peak(slot_rows)
            peak = metric(top, "from drain `at cap n/m` lines and the `(was n/m)` on starts, not the refill's count",
                          lines=lines, cap=max(data_of(row)["cap"] for row in slot_rows))
            above = sum(1 for row in slot_rows if data_of(row)["occupied"] > data_of(row)["cap"])
            over = unknown(f"backfill readings are samples, not changes ({above} readings above the cap)")

    if not covered:
        raised = withdrawn = still_open = unknown(no_journal)
    else:
        raised = metric(sum(1 for row in live_day if row["event"] == "alarm_raised"), seen)
        withdrawn = metric(sum(1 for row in live_day if row["event"] == "alarm_withdrawn"), seen)
        still_open = metric(alarms_open(live, end), "alarms whose last journal event is a raise")

    matched = sorted(matched_refs)
    journal_merged_day = {ref(row["repo"], row["pr"]) for row in live_day
                          if row["event"] in ("merged", "merged_outside_lane")}
    if not gh_ok:
        reconcile = unknown(gh_why)
    else:
        reconcile = metric({"github_merges": len(merged_refs), "matched": len(matched),
                            "ratio": round(len(matched) / len(merged_refs), 3) if merged_refs else None,
                            "on_github_not_in_journal": sorted(merged_refs - lane_merged - outside),
                            "in_journal_not_on_github": sorted(journal_merged_day - merged_refs)},
                           "every PR merged that day on GitHub across the configured repos, by repo and number")

    if cost_sources is None:
        per_ticket = unknown("receipts file or T3 database unreadable")
    else:
        per_ticket = metric(ticket_costs(accepted, cost_sources[0], live, cost_sources[1]),
                            "tokens are input+output+cache; dollars are recorded cost, 0 on flat plans; unpriced_threads have zero or absent recorded cost or no pi session")

    report = {
        "date": str(day), "timezone": "America/Los_Angeles", "repos": len(repos),
        "headline": {"accepted_tickets": headline},
        "guardrails": {"change_failure": change_failure, "lead_time": lead_metric,
                       "audit_disagreement": unknown("no audit yet")},
        "cost": {"human_touches": touches, "per_ticket": per_ticket},
        "flow": {"merges_github": metric(len(merged_refs), "PRs merged that day on GitHub") if gh_ok else unknown(gh_why),
                 "merges_journal": counted("merged"),
                 "launches": with_backfill("launched"),
                 "launches_per_accepted": per_accepted, "gate_launches_per_merge": per_merge,
                 "gate_heads": gate_heads, "duplicate_gate_heads": duplicates, "fix_rounds": fix_rounds,
                 "prs_at_round_cap": capped, "launch_failures": with_backfill("launch_failed"),
                 "dropped": with_backfill("dropped"), "verdict_mix": verdicts,
                 "assigned": counted("assigned"),
                 "first_gate_pass": (metric(round(first_gate_pass(live, start, end), 3), "tickets assigned that day whose first gate verdict is PASS, over all assigned tickets (blocked and abandoned included); a ticket counts once a closing row links its PR")
                                     if covered and any(row["event"] == "assigned" for row in live_day)
                                     else unknown(no_journal if not covered else "no assigned event"))},
        "machine": {"peak_concurrent_threads": peak, "minutes_over_cap": over},
        "board": {"alarms_raised": raised, "alarms_withdrawn": withdrawn, "alarms_open_at_end": still_open},
        "reconcile": reconcile,
        "coverage": {"state": state, "journal_first_event": datetime.fromtimestamp(first, TZ).isoformat() if first else None,
                     "hours_with_journal_events": hours, "of": 24, "unreadable_lines": bad_lines},
        "github_calls": github.get("calls", 0),
    }
    report["unknown_metrics"] = sorted(
        f"{section}.{name}" for section in ("headline", "guardrails", "cost", "flow", "machine", "board")
        for name, item in report[section].items() if item["status"] == "unknown")
    if reconcile["status"] == "unknown":
        report["unknown_metrics"].append("reconcile")
    return report


INTERIM_P, FINAL_P, SLOWER_LIMIT, BOOTSTRAP_DRAWS = 0.005, 0.048, 1.15, 4000


NAME_FIELD = {"builder": "experiment", "gate": "gate_experiment"}
DEFAULT_TARGET = 260


def experiment_side(rows, name):
    for side, field in NAME_FIELD.items():
        if any(row["event"] == "assigned" and data_of(row).get(field) == name for row in rows):
            return side
    return "builder"


def arm_outcomes(rows, name, side):
    assigned, first = first_gate_verdicts(rows)
    arms = {}
    for row in rows:
        key = (row.get("repo"), row.get("ticket"))
        if row["event"] != "assigned" or key not in assigned or assigned[key] != row["ts"]:
            continue
        if data_of(row).get(NAME_FIELD[side]) != name:
            continue
        arm = data_of(row).get("gate_arm") if side == "gate" else row.get("arm") or data_of(row).get("arm")
        if arm in ("control", "treatment"):
            arms[key] = (arm, data_of(row).get("cluster") or ref(*key))
    pr_ticket = {(row["repo"], row["pr"]): row["ticket"] for row in rows
                 if row.get("ticket") is not None and row.get("pr") is not None}
    merged = {}
    for row in rows:
        if row["event"] == "merged":
            merged.setdefault((row["repo"], pr_ticket.get((row["repo"], row.get("pr")))), row["ts"])
    out = {"control": {}, "treatment": {}}
    for key, (arm, cluster) in arms.items():
        wait = merged[key] - assigned[key] if key in merged else None
        out[arm].setdefault(cluster, []).append((first.get(key) == "PASS", wait))
    return out


def pass_rate(clusters):
    tickets = [won for items in clusters for won, _ in items]
    return sum(tickets) / len(tickets)


def bootstrap_p(control, treatment, seed=7):
    rng = random.Random(seed)
    below = above = 0
    for _ in range(BOOTSTRAP_DRAWS):
        draw = pass_rate(rng.choices(treatment, k=len(treatment))) - pass_rate(rng.choices(control, k=len(control)))
        below += draw <= 0
        above += draw >= 0
    return min(1.0, 2 * (min(below, above) + 1) / (BOOTSTRAP_DRAWS + 1))


def decide(p, gap, tickets, target, merge_ok):
    if tickets >= target:
        threshold = FINAL_P
    elif tickets >= target / 2:
        threshold = INTERIM_P
    else:
        return "continue"
    if p >= threshold:
        return "no difference" if tickets >= target else "continue"
    if gap > 0:
        return "treatment wins" if merge_ok else "no difference"
    return "control wins"


def median_wait(clusters):
    waits = [wait for items in clusters for _, wait in items if wait is not None]
    return statistics.median(waits) if waits else None


def cmd_compare(args):
    experiment = next((e for e in journal.factory_experiments() if e["name"] == args.experiment), None)
    live, _, _ = load_journal(args.journal_dir or journal.journal_dir())
    side = experiment["side"] if experiment else experiment_side(live, args.experiment)
    arms = arm_outcomes(live, args.experiment, side)
    target = args.target or (experiment or {}).get("target") or DEFAULT_TARGET
    if not arms["control"] or not arms["treatment"]:
        sys.exit(f"compare: no arm assignments for {args.experiment} in the journal, "
                 "so no experiment has run (register one in coordinator/config/factory.json)")
    control, treatment = list(arms["control"].values()), list(arms["treatment"].values())
    count = {name: sum(len(items) for items in group) for name, group in (("control", control), ("treatment", treatment))}
    gap, p = pass_rate(treatment) - pass_rate(control), bootstrap_p(control, treatment)
    slow, fast = median_wait(treatment), median_wait(control)
    merge_ok = slow is None or fast is None or slow <= fast * SLOWER_LIMIT
    for name, group in (("control", control), ("treatment", treatment)):
        print(f"{name}: {count[name]} tickets in {len(group)} clusters, first-gate PASS {pass_rate(group):.1%}")
    print(f"target {target} tickets, {sum(count.values())} assigned")
    print(f"gap {gap * 100:+.1f} points, cluster-bootstrap p {p:.4f} ({BOOTSTRAP_DRAWS} draws, seed 7)")
    print(f"time to merge median: control {fast}, treatment {slow}, " +
          ("non-inferior" if merge_ok else f"more than {SLOWER_LIMIT - 1:.0%} slower"))
    print(decide(p, gap, sum(count.values()), target, merge_ok))


def today_ts():
    return datetime.now(TZ).timestamp()


def baseline(out_dir, day, days):
    values = collections.defaultdict(list)
    for back in range(1, days + 1):
        path = os.path.join(out_dir, f"{day - timedelta(days=back)}.json")
        try:
            with open(path) as handle:
                prior = json.load(handle)
        except (OSError, ValueError):
            continue
        for section in ("headline", "guardrails", "cost", "flow", "machine", "board"):
            for name, item in prior.get(section, {}).items():
                if item["status"] == "ok" and isinstance(item["value"], (int, float)):
                    values[f"{section}.{name}"].append(item["value"])
    return {key: {"median": statistics.median(found), "days": len(found)} for key, found in values.items()}


def show(value):
    return json.dumps(value, separators=(",", ":")) if isinstance(value, (dict, list)) else str(value)


def summary(report):
    lines = [f"Factory scorecard {report['date']} ({report['timezone']}), "
             f"journal coverage {report['coverage']['state']}, "
             f"{report['github_calls']} GitHub calls"]
    for section in ("headline", "guardrails", "cost", "flow", "machine", "board"):
        lines.append(f"[{section}]")
        for name, item in report[section].items():
            base = report["baseline"].get(f"{section}.{name}")
            tail = f"  (baseline median {base['median']} over {base['days']} days)" if base else ""
            if item["status"] == "unknown":
                lines.append(f"  {name}: unknown ({item['why']})")
            else:
                lines.append(f"  {name}: {show(item['value'])}{tail}")
    rec = report["reconcile"]
    lines.append("[reconcile]")
    if rec["status"] == "unknown":
        lines.append(f"  unknown ({rec['why']})")
    else:
        value = rec["value"]
        ratio = value["ratio"]
        lines.append(f"  GitHub merges {value['github_merges']}, matched to a journal merge {value['matched']} "
                     f"(ratio {ratio if ratio is not None else 'n/a'})")
        lines.append(f"  on GitHub, not in journal: {len(value['on_github_not_in_journal'])}")
        lines.append(f"  in journal, not on GitHub: {len(value['in_journal_not_on_github'])}")
    lines.append(f"unknown metrics ({len(report['unknown_metrics'])}): " + ", ".join(report["unknown_metrics"]))
    return "\n".join(lines)


def configured_repos():
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.expanduser("~/.coordinator/tickets.json"),
                      os.path.join(here, "..", "config", "tickets.json")):
        if os.path.exists(candidate):
            with open(candidate) as handle:
                return sorted(json.load(handle)["repos"])
    sys.exit("tickets.json not found next to the script or in ~/.coordinator")


def cmd_report(args):
    today = datetime.now(TZ).date()
    day = Date.fromisoformat(args.date) if args.date else today - timedelta(days=1)
    directory = args.journal_dir or journal.journal_dir()
    live, backfill, bad = load_journal(directory)
    repos = configured_repos()
    start, end = day_bounds(day)
    window_closed = today_ts() >= end + REVERT_DAYS * 86400
    if args.no_github:
        github = {"error": "GitHub reads skipped (--no-github)", "calls": 0}
    else:
        github = fetch_github(repos, start, end, window_closed)
    queue = os.environ.get("COORDQ_DIR", os.path.expanduser("~/Code/coordinator/queue"))
    db_path = os.environ.get("T3_STATE_DB", os.path.expanduser("~/.t3/userdata/statev2.sqlite"))
    try:
        with open(os.path.join(queue, "dispatch-receipts.json")) as handle:
            receipts = json.load(handle)
        if not isinstance(receipts, dict):
            raise ValueError("dispatch receipts is not a JSON object")
        connection = sqlite3.connect("file:" + db_path + "?mode=ro", uri=True)
        connection.execute("select thread_id from orchestration_v2_projection_provider_threads limit 1").fetchall()
        connection.close()
        cost_sources = (receipts, db_path)
    except (OSError, ValueError, sqlite3.Error):
        cost_sources = None
    report = build(day, live, backfill, bad, github, window_closed, repos, cost_sources)
    report["baseline"] = baseline(args.out_dir, day, args.baseline_days)
    if "error" in github and not args.no_github:
        print(summary(report))
        sys.exit(f"scorecard: {github['error']}; the report for {day} was not written")
    os.makedirs(args.out_dir, exist_ok=True)
    target = os.path.join(args.out_dir, f"{day}.json")
    with open(target + ".tmp", "w") as handle:
        json.dump(report, handle, indent=1)
    os.replace(target + ".tmp", target)
    print(json.dumps(report, indent=1) if args.json else summary(report))


def backfill_rows(path, since_ts):
    rows = []
    with open(path) as handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n")
            event = None
            if match := LOG_STARTED.match(line):
                stamp, item, tool, was, cap = match.groups()
                event = ("launched", int(item), {"tool": tool, "was": int(was), "cap": int(cap)})
                slot = {"occupied": int(was), "cap": int(cap), "reading": "start (was n/m)"}
            elif match := LOG_FAILED.match(line):
                stamp, item, tries = match.groups()
                event = ("launch_failed", int(item), {"tries": int(tries)})
            elif match := LOG_DROPPED.match(line):
                stamp, item, tries = match.groups()
                event = ("dropped", int(item), {"tries": int(tries)})
            elif match := LOG_AT_CAP.match(line):
                stamp, occupied, cap, waiting = match.groups()
                event = ("slots", None, {"occupied": int(occupied), "cap": int(cap), "waiting": int(waiting),
                                         "reading": "drain at cap n/m"})
            if event is None:
                continue
            ts = datetime.strptime(stamp, "%Y-%m-%d %H:%M:%S").replace(tzinfo=TZ).timestamp()
            if ts < since_ts:
                continue
            name, item, data = event
            rows.append(backfill_row(name, ts, item, {**data, "line": number}))
            if name == "launched":
                rows.append(backfill_row("slots", ts, item, {**slot, "line": number}))
    return rows


def backfill_row(name, ts, item, data):
    row = {"v": journal.VERSION, "ts": ts, "event": name, "actor": "backfill"}
    row.update({key: None for key in COMMON})
    row["item"] = item
    row["data"] = data
    return row


def merge_rows(directory, since_ts):
    live = load_journal(directory)[0]
    known = {ref(row["repo"], row["pr"]) for row in live
             if row["event"] in ("merged", "merged_outside_lane")}
    rows = []
    for repo, prs in GitHub(configured_repos()).merged_prs(since_ts, today_ts()).items():
        for pr in prs:
            if ref(repo, pr["number"]) in known:
                continue
            row = backfill_row("merged", iso_ts(pr["closedAt"]), None, {"source": "backfill"})
            row["repo"] = repo
            row["pr"] = pr["number"]
            rows.append(row)
    return rows


def cmd_backfill(args):
    log = args.dispatch_log or os.path.join(
        os.environ.get("COORDQ_DIR", os.path.expanduser("~/Code/coordinator/queue")), "dispatch.log")
    if not os.path.isfile(log):
        sys.exit(f"scorecard: the dispatch log {log} does not exist")
    since_ts = day_bounds(Date.fromisoformat(args.since))[0]
    directory = args.journal_dir or journal.journal_dir()
    rows = backfill_rows(log, since_ts)
    if args.merges:
        rows += merge_rows(directory, since_ts)
    os.makedirs(directory, exist_ok=True)
    target = os.path.join(directory, BACKFILL_FILE)
    kept = [row for row in read_events(target)[0] if row["ts"] < since_ts]
    with open(target + ".tmp", "w") as handle:
        for row in kept + rows:
            handle.write(json.dumps(row, separators=(",", ":")) + "\n")
    os.replace(target + ".tmp", target)
    counts = collections.Counter(row["event"] for row in rows)
    print(f"backfill: {len(rows)} events since {args.since} written to {target} ({len(kept)} earlier rows kept): " + ", ".join(
        f"{name} {count}" for name, count in sorted(counts.items())))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--date")
    parser.add_argument("--baseline-days", type=int, default=7)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--no-github", action="store_true")
    parser.add_argument("--journal-dir")
    parser.add_argument("--out-dir", default=os.environ.get(
        "SCORECARD_DIR", os.path.expanduser("~/Code/coordinator/scorecard")))
    commands = parser.add_subparsers(dest="command")
    fill = commands.add_parser("backfill")
    fill.add_argument("--since", required=True)
    fill.add_argument("--dispatch-log")
    fill.add_argument("--journal-dir")
    fill.add_argument("--merges", action="store_true")
    compare = commands.add_parser("compare")
    compare.add_argument("--experiment", required=True)
    compare.add_argument("--journal-dir")
    compare.add_argument("--target", type=int)
    args = parser.parse_args()
    if args.command == "compare":
        cmd_compare(args)
    elif args.command == "backfill":
        cmd_backfill(args)
    else:
        cmd_report(args)


if __name__ == "__main__":
    main()
