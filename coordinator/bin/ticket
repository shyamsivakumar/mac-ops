class Refuse(Exception):
    pass


class Overlap(Refuse):
    def __init__(self, overlaps):
        super().__init__(f"overlaps #{overlaps[0][0]} on {overlaps[0][1]}")
        self.overlaps = overlaps


class GhError(Exception):
    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).strftime(TIME_FORMAT)[:-4] + "Z"


def parse_time(text):
    return datetime.strptime(text, TIME_FORMAT)


def config_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.join(here, "..", "config", "tickets.json"), os.path.expanduser("~/.coordinator/tickets.json")):
        if os.path.exists(candidate):
            return candidate
    die("tickets.json not found next to the script or in ~/.coordinator")


def load_config():
    with open(config_path()) as f:
        return json.load(f)


def label_names(cfg):
    names = []
    for stage in cfg["labels"]["stage"]:
        names.append(("stage", f"stage:{stage}"))
    names.append((HOLD_FAMILY, HOLD_LABEL))
    for p in cfg["labels"]["priority"]:
        names.append(("priority", f"priority:{p}"))
    for t in cfg["labels"]["type"]:
        names.append(("type", f"type:{t}"))
    for alias in builder_ids():
        names.append(("builder", f"builder:{alias}"))
    for alias in reviewer_ids():
        names.append(("reviewer", f"reviewer:{alias}"))
    return names


def builder_ids():
    return [e["id"] for e in model_list.entries("build")]


# A ticket labelled before the router entry existed names the Morph model it
# wanted. Both Morph models now run through the router entry, so the retired
# labels are read as that entry instead of refused.
LEGACY_BUILDER_ALIASES = {"deepseek": "router", "kimi": "router"}


def builder_alias(name):
    """The builder entry a label names, with the retired Morph labels read as the router."""
    return LEGACY_BUILDER_ALIASES.get(name, name)


def reviewer_ids():
    return [e["id"] for e in model_list.entries("review")]


def run(cmd, timeout, stdin=None):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)


def classify(stderr):
    text = stderr.lower()
    if "rate limit" in text or "secondary rate" in text or "abuse" in text or ("403" in text and "limit" in text):
        return "rate_limit"
    if "401" in text or "bad credentials" in text or "gh auth login" in text or "not logged in" in text or "authentication" in text or "requires authentication" in text:
        return "auth"
    if "error connecting" in text or "no such host" in text or "dial tcp" in text or "network" in text or "timeout" in text or "tls" in text or "connection" in text:
        return "offline"
    return "error"


def gh(args, stdin=None, fresh=False, optional=False):
    """Run one GitHub command through the shared helper.

    The helper counts the call for the usage report, serves a repeated
    list read from its cache, and makes a single-page read conditional so
    GitHub answers 304 and does not charge the core quota for it. A `fresh`
    read goes past the helper's cache as well, because the board cache
    above it can only be as fresh as the list it was built from; it then
    refreshes that entry."""
    try:
        result = gh_gateway.run(["gh"] + args, timeout=GH_TIMEOUT, stdin=stdin,
                                fresh=fresh,
                                limit=gh_gateway.floor() if optional else None)
    except gh_gateway.ApiBudgetExhausted as exc:
        raise GhError("budget", f"the shared floor stopped this optional read: {exc}")
    except subprocess.TimeoutExpired:
        raise GhError("offline", f"gh {' '.join(args[:2])} timed out after {GH_TIMEOUT}s")
    if result.returncode != 0:
        raise GhError(classify(result.stderr), result.stderr.strip() or f"gh exited {result.returncode}")
    return result.stdout


def gh_json(args, fresh=False, optional=False):
    return json.loads(gh(args, fresh=fresh, optional=optional))


def t3_call(tool, args):
    try:
        result = run([T3MCP, "call", tool, "-"], CALL_TIMEOUT, json.dumps(args))
    except subprocess.TimeoutExpired:
        raise Refuse(f"t3 call {tool} timed out after {CALL_TIMEOUT}s")
    if result.returncode != 0:
        if tool == "t3_thread_read":
            try:
                errors = json.loads(result.stderr)
                missing = any(json.loads(e["text"]).get("code") == "thread_not_found"
                              for e in errors if e.get("type") == "text")
            except (ValueError, TypeError, KeyError, AttributeError):
                missing = False
            if missing:
                return {"thread": {"threadId": args["threadId"], "status": "not running (thread not found)"}}
        raise Refuse(f"t3 call {tool} failed: {result.stderr.strip()}")
    return json.loads(result.stdout)


def parse_ref(ref):
    match = re.fullmatch(r"([^/\s#]+/[^/\s#]+)#(\d+)", ref)
    if not match:
        die(f"bad ticket reference {ref!r}, expected owner/repo#number", 2)
    return match.group(1), int(match.group(2))


def repo_config(cfg, repo):
    if repo not in cfg["repos"]:
        raise Refuse(f"repo {repo} is not configured in tickets.json")
    return cfg["repos"][repo]


def ensure_labels(a):
    cfg = load_config()
    wanted = label_names(cfg) + [("stage", STARTED_LABEL)]
    for repo in cfg["repos"]:
        existing = {l["name"].lower(): l for l in gh_json(["label", "list", "-R", repo, "--limit", "1000", "--json", "name,color"])}
        create, recolor, ok = [], [], 0
        for family, name in wanted:
            color = FAMILY_COLORS[family]
            have = existing.get(name.lower())
            if have is None:
                create.append((name, color))
            elif have["color"].lower() != color:
                recolor.append((name, color))
            else:
                ok += 1
        line = f"{repo}: {ok} ok, {len(create)} to create, {len(recolor)} to recolor"
        if create and len(create) < len(wanted):
            line += " [create: " + ", ".join(n for n, _ in create) + "]"
        if recolor:
            line += " [recolor: " + ", ".join(n for n, _ in recolor) + "]"
        print(line)
        if not a.apply:
            continue
        for name, color in create:
            gh(["label", "create", name, "-R", repo, "--color", color])
        for name, color in recolor:
            gh(["label", "edit", name, "-R", repo, "--color", color])
    if not a.apply:
        print(f"plan only ({len(wanted)} labels per repo); rerun with --apply to create and recolor")


def split_labels(cfg, names):
    groups = {f: [] for f in FAMILIES}
    other = []
    for name in names:
        if name.lower() == HOLD_LABEL:
            groups[HOLD_FAMILY].append(HOLD_FAMILY)
            continue
        family, _, value = name.partition(":")
        if family in groups and value:
            groups[family].append(value)
        else:
            other.append(name)
    return groups, other


def label_problems(cfg, groups):
    problems = []
    valid = {
        "stage": set(cfg["labels"]["stage"]),
        HOLD_FAMILY: {HOLD_FAMILY},
        "priority": set(cfg["labels"]["priority"]),
        "type": set(cfg["labels"]["type"]),
        "builder": set(builder_ids()) | set(LEGACY_BUILDER_ALIASES),
        "reviewer": set(reviewer_ids()),
    }
    for family, values in groups.items():
        if len(values) > 1:
            problems.append(f"duplicate {family} labels: {', '.join(values)}")
        for value in values:
            if value not in valid[family]:
                problems.append(f"unknown {family} label: {value}")
    return problems


def key_problems(rcfg, title):
    match = TITLE_KEY.match(title)
    if rcfg["key"] is None:
        return (match.group(0) if match else None), []
    if not match:
        return None, ["missing key in title"]
    key = match.group(0)
    if match.group(1) != rcfg["key"]:
        return key, [f"key prefix {match.group(1)} does not match repo key {rcfg['key']}"]
    return key, []


def one(values):
    return values[0] if len(values) == 1 else None


def normalize_issue(cfg, repo, raw):
    rcfg = cfg["repos"][repo]
    groups, _ = split_labels(cfg, [l["name"] for l in raw["labels"]])
    key, problems = key_problems(rcfg, raw["title"])
    problems = label_problems(cfg, groups) + problems
    priority = one(groups["priority"])
    return {
        "repo": repo,
        "number": raw["number"],
        "url": raw["url"],
        "key": key,
        "title": raw["title"],
        "stage": one(groups["stage"]),
        "priority": int(priority) if priority and priority.isdigit() else None,
        "type": one(groups["type"]),
        "builder": builder_alias(one(groups["builder"])),
        "reviewer": one(groups["reviewer"]),
        "problems": problems,
        "updatedAt": raw["updatedAt"],
    }


def search_owner(owner, stage):
    limit = 100
    while True:
        rows = gh_json(["search", "issues", "--owner", owner, "--state", "open", "--label", stage, "--limit", str(limit),
                        "--json", "repository,number,title,labels,updatedAt,url"])
        if len(rows) < limit or limit >= 1000:
            return rows
        limit = min(limit * 2, 1000)


def fetch_list(cfg, fresh=False, optional=True):
    """Read every board list.

    A board refresh is optional work: it takes the shared floor, so below it
    the caller keeps its stale cache instead of spending the last calls. A
    required read passes `optional=False`."""
    seen = {}
    for repo in cfg["repos"]:
        pages = gh_json(["api", "--paginate", "--slurp",
                         f"repos/{repo}/issues?state=open&per_page=100"],
                        fresh=fresh, optional=optional)
        if not isinstance(pages, list) or any(not isinstance(page, list) for page in pages):
            raise GhError("invalid_response", f"invalid open issue pages for {repo}")
        for page in pages:
            for row in page:
                if "pull_request" in row:
                    continue
                raw = {**row, "url": row["html_url"], "updatedAt": row["updated_at"]}
                seen[(repo, row["number"])] = normalize_issue(cfg, repo, raw)
    issues = sorted(seen.values(), key=lambda i: (i["priority"] is None, i["priority"] or 0, i["updatedAt"]))
    return issues


def read_cache():
    try:
        with open(os.path.join(CACHE_DIR, "list.json")) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def write_cache(data):
    tmp = os.path.join(CACHE_DIR, "list.json.tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, os.path.join(CACHE_DIR, "list.json"))


def cache_age(cache):
    return time.time() - parse_time(cache["fetchedAt"]).replace(tzinfo=timezone.utc).timestamp()


def repo_issues(repo):
    """Every issue of the repo, open and closed, with the titles that hold keys.

    The pages are read one by one: a single truncated page would let a key
    that is used by an older issue look free, and would let a mint land on
    a number that is already taken. Pull requests come back from the same
    endpoint and are dropped, because a PR title is not a ticket.
    """
    rows = []
    complete = False
    for page in range(1, ISSUE_PAGES + 1):
        # The key is allocated from this list, so it is read fresh: a
        # cached list from before the last create would mint the key again.
        batch = gh_json(["api", f"repos/{repo}/issues?state=all&per_page=100&page={page}"],
                        fresh=True)
        if not batch:
            complete = True
            break
        rows += [issue for issue in batch if "pull_request" not in issue]
        if len(batch) < ISSUE_PAGE_SIZE:
            complete = True
            break
    if not complete:
        raise Refuse(f"the issue list of {repo} runs past {ISSUE_PAGES} pages, so its keys cannot be checked")
    return [{"number": issue["number"], "title": issue["title"]} for issue in rows]


def keys_in_use(rcfg, issues):
    """The `<KEY>-<n>` numbers this repo already uses, mapped to their issue number."""
    used = {}
    for issue in issues:
        match = TITLE_KEY.match(issue["title"])
        if match and match.group(1) == rcfg["key"]:
            used[int(match.group(2))] = issue["number"]
    return used


def mint_key(rcfg, issues, last=0):
    """The next free key for the repo: one past the highest key it has given out.

    The key prefix comes from tickets.json and the number from the repo's
    own issues, so a minted key never collides with a ticket that exists.
    The issue list can lag a create by a few seconds, so the number is also
    read from the last key this repo gave out, which is written under the
    open lock: a list that has not caught up cannot hand out a key twice.
    """
    used = keys_in_use(rcfg, issues)
    number = max([last, *used]) + 1
    while number in used:
        number += 1
    return f"{rcfg['key']}-{number}"


# A create that failed with one of these is known not to have made an issue,
# so its key is free again. Every other failure may have landed, so the key
# stays pending and the next open refuses until a human checks the repo. A
# generic `error` is in that second group: `gh` can fail locally after GitHub
# has already made the issue, so it does not establish a rejection.
REJECTED_FAILURES = ("auth", "budget", "rate_limit")


def last_key_path(repo, prefix):
    """Where the keys this repo gave out under one prefix are kept.

    The prefix is part of the name, so a repo whose key in tickets.json
    changes starts the new prefix at one instead of carrying the old
    sequence over, and switching back finds the old sequence again."""
    return os.path.join(CACHE_DIR, f"last-key-{repo.replace('/', '_')}-{prefix}.json")


def read_last_key(repo, prefix):
    """The key state of this repo under this prefix.

    A missing file is a repo that has not opened a ticket under this prefix
    yet. A file that cannot be read, or that does not hold a valid state, is
    a refusal: minting from the list alone is what gave two opens the same
    key, so a record that cannot be trusted must not be read as zero."""
    path = last_key_path(repo, prefix)
    try:
        with open(path) as f:
            state = json.load(f)
    except FileNotFoundError:
        return {"number": 0, "unconfirmed": [], "pending": None}
    except (OSError, ValueError) as e:
        raise Refuse(f"the key record {path} cannot be read: {e}")
    number = state.get("number") if isinstance(state, dict) else None
    unconfirmed = state.get("unconfirmed", []) if isinstance(state, dict) else None
    pending = state.get("pending") if isinstance(state, dict) else None
    valid = (isinstance(number, int) and not isinstance(number, bool) and number >= 0
             and isinstance(unconfirmed, list)
             and all(isinstance(n, int) and not isinstance(n, bool) and n > 0 for n in unconfirmed)
             and (pending is None or (isinstance(pending, int) and not isinstance(pending, bool) and pending > 0)))
    if not valid:
        raise Refuse(f"the key record {path} is not a valid state")
    return {"number": number, "unconfirmed": unconfirmed, "pending": pending}


def write_last_key(repo, prefix, state, fatal=False):
    """Write the key state of this repo under this prefix, atomically.

    The write before a create is fatal: a create must never run without the
    record that protects its key. A write after the create only warns, and
    the pending key it leaves behind still stops the next open from reusing
    the key."""
    path = last_key_path(repo, prefix)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    except OSError as e:
        if fatal:
            raise Refuse(f"the key {prefix}-{state['pending']} could not be recorded before the create: {e}")
        print(f"warning: the key state of {repo} was not recorded: {e}", file=sys.stderr)


def with_open_lock(repo):
    """One minter per repo: a second open for the same repo is refused."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    f = open(os.path.join(CACHE_DIR, f"open-{repo.replace('/', '_')}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Refuse("another ticket open for this repo is running")
    return f


def run_proof_on_main(body, repo_dir):
    """red, or prose for a docs ticket; a proof that is not red on origin/main is refused."""
    try:
        spec = proof_run.parse_body(body)
    except ValueError as e:
        raise Refuse(str(e))
    if spec["cmd"].lower().startswith("none (prose)"):
        return "prose"
    if not spec["signature"]:
        raise Refuse("a behavior ticket needs an `Expected red signature:` line under its proof command")
    try:
        re.compile(spec["signature"])
    except re.error as e:
        raise Refuse(f"the expected red signature is not a valid regex: {e}")
    fetch = subprocess.run(["git", "-C", repo_dir, "fetch", "origin", "main"], capture_output=True, text=True)
    if fetch.returncode:
        raise Refuse(f"cannot fetch origin/main in {repo_dir}: {fetch.stderr.strip()[-200:]}")
    fd, record = tempfile.mkstemp(prefix="proof-record-")
    os.close(fd)
    try:
        result = proof_run.run("red", repo_dir, "origin/main", spec["cmd"], spec["signature"], record)
        with open(record, encoding="utf-8") as handle:
            tail = handle.read()[-600:]
    finally:
        os.unlink(record)
    if result["state"] == "red":
        return "red"
    if result["exit"] == 0:
        raise Refuse("proof passes on main: nothing to build")
    raise Refuse(f"proof is unresolved on main (exit {result['exit']}, signature matched: {result['matched']}): {tail}")


def cmd_open(a):
    """Open a ticket. The key is minted here, so a ticket is born startable."""
    cfg = load_config()
    repo = a.repo
    try:
        rcfg = repo_config(cfg, repo)
    except Refuse as e:
        die(f"refused: {e}", 2)
    if rcfg.get("key") is None:
        die(f"refused: repo {repo} has no key in tickets.json", 2)
    title = " ".join(a.title.split())
    if not title:
        die("refused: the title is empty", 2)
    body = a.body or ""
    if a.body_file:
        with open(a.body_file) as handle:
            body = handle.read()
    refusal = check_body(cfg, body, [n.strip() for n in (a.label or "").split(",")])
    if refusal:
        die(f"refused: {refusal}", 2)
    allowed = {name for _, name in label_names(cfg)}
    labels = [name.strip() for name in (a.label or "").split(",") if name.strip()]
    unknown = [name for name in labels if name not in allowed]
    if unknown:
        die(f"refused: unknown labels: {', '.join(unknown)}", 2)
    try:
        proof = run_proof_on_main(body, a.repo_dir or os.getcwd())
    except Refuse as e:
        die(f"refused: {e}", 2)
    try:
        lock = with_open_lock(repo)
        state = read_last_key(repo, rcfg["key"])
        if state["pending"] is not None:
            raise Refuse(f"the last open of {repo} did not finish, so {rcfg['key']}-{state['pending']} may exist: "
                         f"check the repo, then clear `pending` in {last_key_path(repo, rcfg['key'])} "
                         f"(lower `number` too if {rcfg['key']}-{state['pending']} does not exist)")
        issues = repo_issues(repo)
        used = keys_in_use(rcfg, issues)
        # A key this repo gave out that the list has not shown yet is still
        # taken: the list can lag a create by a few seconds.
        unconfirmed = [n for n in state["unconfirmed"] if n not in used]
        match = TITLE_KEY.match(title)
        if match:
            if match.group(1) != rcfg["key"]:
                die(f"refused: key prefix {match.group(1)} does not match repo key {rcfg['key']}", 2)
            key = match.group(0)
            number = int(match.group(2))
            clash = used.get(number)
            if clash is not None:
                die(f"refused: {key} is already used by issue #{clash}", 2)
            if number in unconfirmed:
                die(f"refused: {key} was given out by an earlier open and the issue list has not shown it yet", 2)
        else:
            if a.require_key:
                die(f"refused: missing key in title (the title must start with {rcfg['key']}-<n>)", 2)
            key = mint_key(rcfg, issues, state["number"])
            number = int(TITLE_KEY.match(key).group(2))
            title = f"{key}{KEY_SEPARATOR}{title}"
        duplicate = next((i for i in issues if i["title"].strip() == title), None)
        if duplicate is not None:
            die(f"refused: issue #{duplicate['number']} already has this title", 2)
        if a.dry_run:
            print(json.dumps({"repo": repo, "key": key, "title": title, "labels": labels, "proof": proof, "dryRun": True}))
            return
        # The key is recorded before the create, so a create that lands and
        # then loses its answer is never handed out again: the record stays
        # pending and the next open refuses until a human checks the repo.
        after = {"number": max(state["number"], number),
                 "unconfirmed": unconfirmed + ([number] if number not in used else []),
                 "pending": number}
        write_last_key(repo, rcfg["key"], after, fatal=True)
        args = ["issue", "create", "-R", repo, "--title", title, "--body", body]
        if labels:
            args += ["--label", ",".join(labels)]
        try:
            url = gh(args).strip()
        except GhError as e:
            if e.kind in REJECTED_FAILURES:
                # GitHub refused the create before it could make an issue, so
                # the key is free again: the record goes back to what it was
                # before this open.
                write_last_key(repo, rcfg["key"], {**state, "unconfirmed": unconfirmed})
            raise
        write_last_key(repo, rcfg["key"], {**after, "pending": None})
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    number = url.rsplit("/", 1)[-1]
    journal.emit("ticket_opened", "ticket", repo=repo, ticket=int(number) if number.isdigit() else None,
                 key=key, labels=labels, proof=proof)
    print(json.dumps({"repo": repo, "key": key, "title": title, "labels": labels, "proof": proof, "url": url}))


def cmd_list(a):
    cfg = load_config()
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(os.path.join(CACHE_DIR, "list.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cache = read_cache()
        if cache and not a.fresh and cache_age(cache) < CACHE_TTL:
            out = {**cache, "stale": False, "cached": True}
        else:
            try:
                data = {"fetchedAt": now(), "issues": fetch_list(cfg, fresh=a.fresh)}
            except GhError as e:
                if cache is None:
                    die(f"list failed ({e.kind}) and no cache exists: {e}")
                out = {**cache, "stale": True, "cached": True, "error": {"kind": e.kind, "message": str(e)}}
            else:
                write_cache(data)
                out = {**data, "stale": False, "cached": False}
    if a.json:
        print(json.dumps(out, indent=1))
        return
    if out["stale"]:
        print(f"STALE ({out['error']['kind']}): {out['error']['message']}")
    for i in out["issues"]:
        flags = f" !{'; '.join(i['problems'])}" if i["problems"] else ""
        print(f"{i['repo']}#{i['number']} {i['stage']} p{i['priority']} {i['type']} {i['builder'] or '-'}/{i['reviewer'] or '-'} {i['title']}{flags}")
    print(f"{len(out['issues'])} issues, fetched {out['fetchedAt']}")


def fetch_issue(repo, n):
    return gh_json(["issue", "view", str(n), "-R", repo, "--json", "id,number,title,body,state,labels,comments,url,blockedBy"])


def template_markers(cfg, lines):
    """The markers that carry the sections of a ticket body.

    A section name is read by its words, not by its separator. Case, spacing,
    the separators "/" and ",", and the word "and" between the words do not
    change which section a heading names, so the configured "Data/secrets and
    stop conditions" and the written "Data, secrets and stop conditions" are
    one section. Only those separators are separators: every other character
    is part of a word, so "Contexte" names another section than "Context".
    """

    def canonical(text):
        words = [w for w in re.split(r"[\s/,]+", text.lower()) if w and w != "and"]
        return " ".join(words)

    # A label line: the section name, then a colon, then the section text. The
    # name may be wrapped in bold, and it may name the section with a
    # separator that differs from the configured one. The name starts the
    # line, so a list item such as "- Context: ..." is not a label line.
    label = re.compile(r"^\s*(?:\*\*)?\s*(?P<label>[0-9A-Za-z][^:]*?)\s*(?:\*\*)?\s*:\s*(?:\*\*)?(?P<rest>.*)$")

    names = {}
    for section in cfg["template"]:
        # The first configured section wins when two names read the same.
        names.setdefault(canonical(section), section)
    markers = []
    for i, line in enumerate(lines):
        m = HEADING.match(line)
        if m:
            text = canonical(m.group(2).strip().strip("*").strip().rstrip(":").strip())
            if text in names:
                markers.append((i, names[text], len(m.group(1)), ""))
            continue
        m = label.match(line)
        if m:
            text = canonical(m.group("label"))
            if text in names:
                markers.append((i, names[text], 0, m.group("rest")))
    return markers


def template_status(cfg, body):
    lines = body.splitlines()
    markers = template_markers(cfg, lines)
    status = {}
    for section in cfg["template"]:
        found = next((m for m in markers if m[1] == section), None)
        if found is None:
            status[section] = "missing"
            continue
        start, _, level, rest = found
        stops = [m[0] for m in markers if m[0] > start]
        if level:
            stops += [j for j in range(start + 1, len(lines)) if (h := HEADING.match(lines[j])) and len(h.group(1)) <= level]
        end = min(stops, default=len(lines))
        content = re.sub(r"<!--.*?-->", "", "\n".join([rest] + lines[start + 1:end]), flags=re.S).strip()
        status[section] = "ok" if content else "empty"
    return status


def blocker_repo(node):
    # gh issue view --json blockedBy returns nodes without "repository", so the
    # repo comes from the node url (owner/repo before /issues/).
    repository = node.get("repository") or {}
    name = repository.get("nameWithOwner")
    if name:
        return name
    match = BLOCKER_URL.match(node.get("url") or "")
    if not match:
        raise Refuse(f"cannot tell which repo blocker #{node.get('number')} lives in")
    return match.group(1)


def blockers_of(issue):
    blocked = issue["blockedBy"]
    if blocked["totalCount"] > len(blocked["nodes"]):
        raise Refuse(f"blocker list truncated ({len(blocked['nodes'])} of {blocked['totalCount']})")
    return [{"repo": blocker_repo(n), "number": n["number"], "title": n["title"], "url": n["url"], "state": n["state"]} for n in blocked["nodes"]]


def body_section(body, name):
    """The text of a `## <name>` section, up to the next heading of the same level."""
    lines = body.splitlines()
    for i, line in enumerate(lines):
        match = HEADING.match(line)
        if not match or match.group(2).strip().rstrip(":").strip().lower() != name.lower():
            continue
        level = len(match.group(1))
        end = len(lines)
        for j in range(i + 1, len(lines)):
            head = HEADING.match(lines[j])
            if head and len(head.group(1)) <= level:
                end = j
                break
        return "\n".join(lines[i + 1:end]).strip()
    return None


def scope_files(body):
    lines = body.splitlines()
    start = next((i for i, line in enumerate(lines) if line.strip() == "In:"), None)
    files = []
    if start is None:
        return files
    for line in lines[start + 1:]:
        if line.startswith(("Out:", "Size:", "#")):
            break
        for token in re.findall(r"^- `([^`\s]+)`", line):
            if not ("/" in token or re.search(r"\.\w+$", token)):
                continue
            if token.startswith(("evidence/", "docs/", "evals/harbor/tasks/")) or token.endswith(".md"):
                continue
            if "fixtures" in token.split("/") or "proof" in token.rsplit("/", 1)[-1]:
                continue
            if token not in files:
                files.append(token)
    return files


def check_body(cfg, body, labels):
    for name, status in template_status(cfg, body).items():
        if status != "ok":
            return f"template section '{name}' is {status}"
    lines = body.splitlines()
    files = scope_files(body)
    cap = cfg.get("limits", {}).get("maxCodeFiles", MAX_CODE_FILES)
    if len(files) > cap and "type:large" not in labels:
        return f"Scope In names {len(files)} code files, the cap is {cap}"
    size = next((line for line in lines if line.startswith("Size:")), None)
    match = re.search(r"(\d[\d,]*) code lines", size or "")
    if match:
        value = match.group(1)
        cap = cfg.get("limits", {}).get("maxCodeLines", MAX_CODE_LINES)
        if int(value.replace(",", "")) > cap and "type:large" not in labels:
            return f"Size names {value} code lines, the cap is {cap}"
    proofs = re.findall(r"(?m)^\s*(?:\d+\.\s*)?Proof command:[ \t]*(.*)$", body)
    if not proofs:
        return ("a behavior ticket needs a `Proof command:` block "
                "(docs and config tickets say `Proof command: none (prose)`)")
    return None


def body_sentences(body):
    """The body as plain sentences, without headings or fenced code."""
    text = re.sub(r"```.*?```", " ", body, flags=re.S)
    text = re.sub(r"(?m)^\s*#{1,6}\s+.*$", " ", text)
    parts = re.split(r"(?<=[.!?])\s+|\n\s*\n", text)
    return [" ".join(part.split()) for part in parts if part.strip()]


def requires_approval(sentence):
    """True when a sentence asks for a review or an approval before the build."""
    low = sentence.lower()
    if not any(trigger in low for trigger in TEXT_TRIGGERS):
        return False
    return any(keyword in low for keyword in TEXT_KEYWORDS)


def reference_state(repo, number):
    """closed, merged or open for a referenced issue or pull request."""
    key = (repo, number)
    if key in REF_STATE:
        return REF_STATE[key]
    try:
        item = gh_json(["api", f"repos/{repo}/issues/{number}"])
    except GhError as error:
        if "404" in str(error) or "Not Found" in str(error):
            REF_STATE[key] = None
            return None
        raise
    if "pull_request" in item:
        pull = gh_json(["api", f"repos/{repo}/pulls/{number}"])
        state = "merged" if pull.get("merged") else ("open" if pull.get("state") == "open" else "unmerged")
    else:
        state = item.get("state")
    REF_STATE[key] = state
    return state


def iso_time(text):
    """A GitHub timestamp as a comparable UTC datetime, or None."""
    if not text:
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S.%fZ"):
        try:
            return datetime.strptime(text, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue
    return None


def time_key(text):
    """A sort key for a GitHub timestamp; a missing timestamp sorts first."""
    return iso_time(text) or datetime.min.replace(tzinfo=timezone.utc)


def same_repo(named, repo):
    """True when two `owner/name` names point at the same repository."""
    if not named or not repo:
        return False
    return named.lower().split("/")[-2:] == repo.lower().split("/")[-2:]


def references_issue(body, number, repo=None):
    """True when the body references issue `number` with a reference keyword.

    The keyword carries the numbers that follow it on the same line, so
    `Refs #160, #161` names both, and `owner/name#160` names the issue only
    when the repository is the one in play.
    """
    for line in (body or "").splitlines():
        match = PR_REF_WORD.search(line)
        if not match:
            continue
        for token in PR_REF_NUMBER.finditer(line[match.end():]):
            named_repo, token_number = token.group(1), int(token.group(2))
            if token_number != number:
                continue
            if named_repo and repo and not same_repo(named_repo, repo):
                continue
            return True
    return False


def referencing_pulls(repo, number):
    """The pull requests in `repo` whose body references issue `number`.

    The issue timeline names every pull request that mentions the issue, and
    the pull request itself says whether the mention is a reference. A pull
    request in another repository never counts.
    """
    events = gh_json(["api", "--paginate", f"repos/{repo}/issues/{number}/timeline?per_page=100"])
    found = {}
    for event in events:
        if event.get("event") != "cross-referenced":
            continue
        source = (event.get("source") or {}).get("issue") or {}
        if "pull_request" not in source:
            continue
        if not same_repo((source.get("repository") or {}).get("full_name"), repo):
            continue
        pull_number = source.get("number")
        if pull_number in found:
            continue
        if not references_issue(source.get("body") or "", number, repo):
            continue
        pull = gh_json(["api", f"repos/{repo}/pulls/{pull_number}"])
        if not references_issue(pull.get("body") or "", number, repo):
            continue
        found[pull_number] = {
            "number": pull_number,
            "state": pull.get("state"),
            "merged": bool(pull.get("merged")),
            "mergedAt": pull.get("merged_at"),
            "createdAt": pull.get("created_at"),
            "changedFiles": pull.get("changed_files"),
        }
    return sorted(found.values(), key=lambda pull: pull["number"])


def is_restart_comment(body):
    """True when a coordinator comment says the work starts again.

    A restart is the coordinator's own decision, the comment that opens with
    `Coordinator` and says the work is not done. The intent comment
    `ticket start` posts is not a restart: it is the start itself, and
    counting it would let a relaunch past the guard that stops it.
    """
    text = (body or "").strip()
    if not text.lower().startswith("coordinator"):
        return False
    low = text.lower()
    return bool(RESTART_PATTERN.search(low))


def coordinator_restart_time(issue):
    """When the coordinator last restarted the work on the issue."""
    newest = None
    for comment in issue.get("comments") or []:
        if not is_restart_comment(comment.get("body") or ""):
            continue
        created = comment.get("createdAt") or ""
        if newest is None or created > newest:
            newest = created
    return newest


def pull_files(repo, number, changed_files=None):
    """The paths a pull request changed, or None when GitHub cannot say.

    None means the start cannot tell whether the merge delivered anything, so
    the merge keeps counting as delivery. Only a known list of documentation
    paths takes a merge out of the delivery count. A list shorter than the
    pull request's own `changed_files` count is a truncated read, and a
    truncated read is not a known list.
    """
    try:
        pages = gh_json(["api", "--paginate", "--slurp",
                         f"repos/{repo}/pulls/{number}/files?per_page=100"])
    except (GhError, ValueError):
        return None
    entries = prompt_paths.page_entries(pages)
    if entries is None:
        return None
    if not prompt_paths.list_is_complete(entries, changed_files):
        return None
    paths = []
    for entry in entries:
        paths.extend(prompt_paths.entry_paths(entry))
    return paths


def delivers_ticket(path):
    """True when a changed path is outside the plan and documentation paths."""
    lowered = path.lower()
    name = lowered.rsplit("/", 1)[-1]
    if lowered.startswith(RULE_PATH_PREFIXES) or name in RULE_FILE_NAMES:
        return True
    return not (lowered.startswith(DOC_PATH_PREFIXES) or lowered.endswith(DOC_PATH_SUFFIXES))


def gate_merge_comment(issue, number):
    """True when a gate comment says the merge of `number` delivered the issue.

    The coordinator writes `VERDICT: PASS. Merged via #N` when a pull request
    closed the ticket, and that sentence is delivery even when the diff is
    only documentation.
    """
    for comment in issue.get("comments") or []:
        for match in CLOSE_VERDICT_PASS.finditer(comment.get("body") or ""):
            if int(match.group(1)) == number:
                return True
    return False


def pull_guard_reasons(repo, issue, notices=None):
    """Why a start must be refused because a pull request already carries the issue.

    An open pull request means the work is already in flight. A merged one
    means the work landed, unless the coordinator restarted the issue after
    that merge, or the merge only touched plans and documents and the gate did
    not record it as the merge that closed the ticket. A merge that changed
    nothing outside the documentation paths says so on `notices`, and the
    start goes ahead.
    """
    if notices is None:
        notices = []
    pulls = referencing_pulls(repo, issue["number"])
    if not pulls:
        return []
    open_pulls = [pull for pull in pulls if pull["state"] == "open"]
    if open_pulls:
        newest = max(open_pulls, key=lambda pull: time_key(pull["createdAt"]))
        return [f"open pull request #{newest['number']} already references this issue"]
    restart = iso_time(coordinator_restart_time(issue))
    blocking = []
    for pull in pulls:
        if not pull["merged"]:
            continue
        merged_at = iso_time(pull["mergedAt"])
        if restart is not None and merged_at is not None and merged_at <= restart:
            continue
        files = pull_files(repo, pull["number"], pull.get("changedFiles"))
        if files and not any(delivers_ticket(name) for name in files) and not gate_merge_comment(issue, pull["number"]):
            notices.append(f"merged PR #{pull['number']} changed only docs; not treated as delivery")
            continue
        blocking.append(pull)
    if blocking:
        newest = max(blocking, key=lambda pull: time_key(pull["mergedAt"]))
        return [f"already merged via #{newest['number']}; close the issue"]
    return []


def own_body(body):
    """The body without preserved contracts and code, which name other tickets."""
    return FENCED_BLOCK.sub(" ", DETAILS_BLOCK.sub(" ", body))


def blocked_by_section(cfg, body):
    """The body text of the ticket's own `Blocked by` section, or None.

    The section is read with the same markers the template check uses, so the
    blocker check looks at the section the template check accepted: a
    `## Blocked by` heading or a `Blocked by:` line, with any list under the
    line. The one difference is `<details>`: the template check reads a
    preserved contract inside one, the blocker check skips it, so a body
    whose only `Blocked by` sits inside `<details>` passes the blocker check.
    """
    lines = own_body(body).splitlines()
    markers = template_markers(cfg, lines)
    for start, section, level, rest in markers:
        if section != SECTION_NAME:
            continue
        if level:
            stops = [m[0] for m in markers if m[0] > start]
            stops += [j for j in range(start + 1, len(lines)) if (h := HEADING.match(lines[j])) and len(h.group(1)) <= level]
            end = min(stops, default=len(lines))
            return re.sub(r"<!--.*?-->", "", "\n".join([rest] + lines[start + 1:end]), flags=re.S).strip()
        content = [rest]
        pending = []
        for follow in lines[start + 1:]:
            text = follow.strip()
            if not text:
                pending.append(follow)
                continue
            if not (follow[:1].isspace() or text[0] in "-*+"):
                break
            content.extend(pending)
            pending = []
            content.append(follow)
        return "\n".join(content).strip()
    return None


def resolve_key_issue(repo, key, number):
    """The issue whose title starts with `<key>-<number>`, or None."""
    cache = (repo, key, number)
    if cache in KEY_ISSUE:
        return KEY_ISSUE[cache]
    prefix = f"{key}-{number}"
    found = None
    for page in range(1, 11):
        query = gh_json(["api", "-X", "GET", "search/issues", "-f", f"q=repo:{repo} is:issue in:title \"{key}-{number}\"",
                         "-f", "per_page=100", "-f", f"page={page}"])
        items = query.get("items", [])
        for item in items:
            title = item["title"]
            rest = title[len(prefix):]
            if item.get("pull_request"):
                continue
            if title.startswith(prefix) and not rest[:1].isdigit():
                found = item["number"]
                break
        if found is not None or len(items) < 100:
            break
    KEY_ISSUE[cache] = found
    return found


def comment_text(repo, comment_id):
    """The body of a comment, or an empty string when it cannot be read."""
    cache = (repo, comment_id)
    if cache not in COMMENT_TEXT:
        try:
            COMMENT_TEXT[cache] = gh_json(["api", f"repos/{repo}/issues/comments/{comment_id}"]).get("body") or ""
        except GhError:
            COMMENT_TEXT[cache] = ""
    return COMMENT_TEXT[cache]


def verdict_recorded(repo, issue):
    """True when a comment carrying `VERDICT: PASS` is linked or posted on the issue.

    The body itself is not evidence: every ticket repeats the gate line
    `Final line exactly VERDICT: PASS or VERDICT: FAIL`.
    """
    texts = [issue.get("body") or ""] + [(c.get("body") or "") for c in (issue.get("comments") or [])]
    for text in texts:
        for match in COMMENT_URL.finditer(text):
            if VERDICT_PASS in comment_text(match.group(1), match.group(2)):
                return True
    for comment in issue.get("comments") or []:
        if VERDICT_PASS in (comment.get("body") or ""):
            return True
    return False


def section_blocker_reasons(cfg, repo, issue):
    """Every reference in the `Blocked by` section that is not met yet."""
    section = blocked_by_section(cfg, issue.get("body") or "")
    if not section:
        return []
    text = re.sub(r"<!--.*?-->", "", section, flags=re.S).strip()
    if not text:
        return []
    first = text.splitlines()[0].strip().lower().rstrip(".:")
    if first in ("none", "n/a", "nil", "-"):
        return []
    key = cfg["repos"][repo]["key"]
    reasons = []
    seen = set()

    def check(target_repo, number, label):
        if (target_repo, number) in seen:
            return
        seen.add((target_repo, number))
        state = reference_state(target_repo, number)
        if state in ("closed", "merged"):
            return
        if state is None:
            reasons.append(f"{label} could not be read")
        elif state == "open":
            reasons.append(f"{label} is still open")
        else:
            reasons.append(f"{label} is not merged")

    masked = REPO_REF.sub(" ", text)
    for match in REPO_REF.finditer(text):
        check(match.group(1), int(match.group(2)), f"{match.group(1)}#{match.group(2)}")
    if key:
        for match in re.finditer(rf"\b{re.escape(key)}-(\d+)\b", masked):
            number = resolve_key_issue(repo, key, match.group(1))
            label = f"{key}-{match.group(1)}"
            if number is None:
                if label in seen:
                    continue
                seen.add(label)
                reasons.append(f"{label} has no issue in {repo} whose title starts with '{label}'")
            else:
                check(repo, number, f"{label} (#{number})")
    for match in BARE_REF.finditer(masked):
        check(repo, int(match.group(1)), f"{repo}#{match.group(1)}")
    return reasons


def approval_reasons(cfg, repo, issue):
    """Sentences that ask for an approval before the build and have no verdict."""
    sentences = body_sentences(issue.get("body") or "")
    hits = [sentence for sentence in sentences if requires_approval(sentence)]
    if not hits or verdict_recorded(repo, issue):
        return []
    return [f'the body requires an approval before building: "{sentence}"' for sentence in hits]


def text_blocker_reasons(cfg, repo, issue):
    """Every prerequisite the body names that the ticket does not meet yet."""
    return section_blocker_reasons(cfg, repo, issue) + approval_reasons(cfg, repo, issue)


def resolve_models(cfg, ticket):
    """The builder entry and the reviewer entry a ticket starts with.

    A builder label puts that entry first in the build list. Blocked
    providers are skipped. The builder's selection is resolved for the
    ticket's type, so a router entry names the route that type runs. The
    reviewer is the first review entry of a vendor other than the
    builder's."""
    blocked = model_list.blocked_identities()
    builder = model_list.first_available("build", ticket["builder"], blocked, ticket["type"])
    if builder is None:
        raise Refuse("every builder is blocked")
    builder = {**builder, "selection": model_list.selection_for(builder, ticket["type"])}
    reviewers = model_list.reviewers([builder["selection"]], ticket["reviewer"], blocked)
    if not reviewers:
        raise Refuse(f"every reviewer of a vendor other than {builder['vendor']} is blocked")
    return builder, reviewers[0]


def parse_ticket(cfg, repo, issue):
    rcfg = repo_config(cfg, repo)
    groups, _ = split_labels(cfg, [l["name"] for l in issue["labels"]])
    key, key_issues = key_problems(rcfg, issue["title"])
    return {
        "repo": repo,
        "number": issue["number"],
        "url": issue["url"],
        "key": key,
        "keyProblems": key_issues,
        "title": issue["title"],
        "state": issue["state"],
        "body": issue["body"],
        "groups": groups,
        "problems": label_problems(cfg, groups) + key_issues,
        "stage": one(groups["stage"]),
        "type": one(groups["type"]),
        "priority": one(groups["priority"]),
        "builder": builder_alias(one(groups["builder"])),
        "reviewer": one(groups["reviewer"]),
    }


def ledger_of(issue, login):
    entries = []
    for comment in issue["comments"]:
        if comment["author"]["login"] != login:
            continue
        for match in LEDGER_LINE.finditer(comment["body"]):
            try:
                entry = json.loads(match.group(1))
            except json.JSONDecodeError:
                raise Refuse(f"malformed ledger line in comment {comment['id']}")
            entries.append({**entry, "commentId": comment["id"]})
    return entries


def scope_overlap(repo, issue):
    own = scope_files(issue["body"])
    if not own:
        return []
    started = gh_json(["issue", "list", "-R", repo, "--label", STARTED_LABEL, "--state", "open",
                       "--json", "number,body"])
    prs = gh_json(["pr", "list", "-R", repo, "--state", "open", "--json", "number,body,files"])
    hits = set()
    for other in started:
        if other["number"] != issue["number"]:
            hits.update((other["number"], p) for p in scope_files(other.get("body") or "") if p in own)
    for pull in prs:
        if references_issue(pull.get("body"), issue["number"], repo):
            continue
        hits.update((pull["number"], f["path"]) for f in pull.get("files") or [] if f["path"] in own)
    return sorted(hits)


def validate_start(cfg, repo, issue, check_text=True):
    rcfg = repo_config(cfg, repo)
    t = parse_ticket(cfg, repo, issue)
    # The pull request guard comes before the other checks so the refusal
    # names the pull request that already carries the issue.
    pull_notices = []
    pull_reasons = pull_guard_reasons(repo, issue, pull_notices)
    if pull_reasons:
        raise Refuse(pull_reasons[0])
    for notice in pull_notices:
        print(notice, file=sys.stderr)
    # A hold is Shyam's own block. It is checked before the state, key and
    # label rules, so a held ticket says that it waits for Shyam, whatever
    # else it is missing.
    if t["groups"][HOLD_FAMILY]:
        raise Refuse(f"on hold ({HOLD_LABEL}); only Shyam clears it")
    if t["state"] != "OPEN":
        suffix = ""
        if check_text:
            reasons = text_blocker_reasons(cfg, repo, issue)
            if reasons:
                suffix = "; text blockers: " + "; ".join(reasons)
        raise Refuse(f"issue is {t['state'].lower()}{suffix}")
    if rcfg["key"] is None:
        raise Refuse(f"repo {repo} has no key configured")
    if t["keyProblems"]:
        raise Refuse(t["keyProblems"][0])
    groups = t["groups"]
    if not groups["type"]:
        raise Refuse("missing type label")
    for family in ("stage", "type"):
        if len(groups[family]) != 1:
            raise Refuse(f"needs exactly one {family} label, found {len(groups[family])}")
    for family in ("priority", "builder", "reviewer"):
        if len(groups[family]) > 1:
            raise Refuse(f"more than one {family} label: {', '.join(groups[family])}")
    if t["type"] not in cfg["labels"]["type"]:
        raise Refuse(f"unknown type label {t['type']}")
    if t["stage"] not in cfg["labels"]["stage"]:
        raise Refuse(f"unknown stage label {t['stage']}")
    if t["priority"] and t["priority"] not in cfg["labels"]["priority"]:
        raise Refuse(f"unknown priority label {t['priority']}")
    for family, valid in (("builder", builder_ids()), ("reviewer", reviewer_ids())):
        if t[family] and t[family] not in valid:
            raise Refuse(f"unknown {family} alias {t[family]}")
    bad = {s: v for s, v in template_status(cfg, t["body"]).items() if v != "ok"}
    if bad:
        raise Refuse("template sections " + ", ".join(f"{s} ({v})" for s, v in bad.items()))
    open_blockers = [b for b in blockers_of(issue) if b["state"] == "OPEN"]
    reasons = text_blocker_reasons(cfg, repo, issue) if check_text else []
    suffix = ("; text blockers: " + "; ".join(reasons)) if reasons else ""
    if open_blockers:
        raise Refuse("blocked by open " + ", ".join(f"{b['repo']}#{b['number']}" for b in open_blockers) + suffix)
    if reasons:
        raise Refuse("text blockers: " + "; ".join(reasons))
    overlaps = scope_overlap(repo, issue)
    if overlaps:
        raise Overlap(overlaps)
    builder, reviewer = resolve_models(cfg, t)
    t["builderAlias"], t["reviewerAlias"] = builder["id"], reviewer["id"]
    t["builderSelection"] = builder["selection"]
    return t


def queue_items(repo, n):
    try:
        with open(os.path.join(QUEUE_DIR, "queue.json")) as f:
            items = json.load(f)["items"]
    except FileNotFoundError:
        return []
    prefix = f"ticket:{repo}#{n}:a"
    return [i for i in items if str(i["args"].get("clientRequestId", "")).startswith(prefix)]


def intents(ledger):
    return [e for e in ledger if e.get("kind") == "intent"]


def assert_not_active(cfg, t, ledger):
    prior = intents(ledger)
    queued = queue_items(t["repo"], t["number"])
    if queued:
        raise Refuse(f"already started: queued as coordq #{queued[0]['id']}")
    for attempt in prior:
        thread = thread_for_attempt(cfg, t, [attempt])
        if thread is None:
            continue
        if thread["status"] in LIVE_STATUSES:
            raise Refuse(f"already started: thread {thread['threadId']} is {thread['status']}")


def strip_machine_lines(body):
    return re.sub(r"<!--.*?-->", "", body, flags=re.S).strip()


def quotes_shyam(body):
    """True when a quoted span is attributed to Shyam.

    The name has to sit next to the quote and something has to attribute the
    quote to it, so "Shyam, the builder reported \\"approval missing\\"" is not
    a Shyam quote while "Shyam said \\"go\\"" is.
    """
    mentions = list(SHYAM.finditer(body))
    if not mentions:
        return False
    quotes = []
    for pattern in QUOTE_SPANS:
        quotes.extend(pattern.finditer(body))
    for mention in mentions:
        m_start, m_end = mention.start(), mention.end()
        before = body[max(0, m_start - QUOTE_WINDOW):m_start]
        after = body[m_end:m_end + QUOTE_WINDOW]
        for quote in quotes:
            q_start, q_end = quote.start(), quote.end()
            if q_start >= m_end and q_start - m_end <= QUOTE_WINDOW:
                gap = after[:q_start - m_end]
                if ATTRIBUTED.search(gap) or (":" in gap and len(gap) <= 40):
                    return True
            elif q_end <= m_start and m_start - q_end <= QUOTE_WINDOW:
                gap = before[max(0, q_end - (m_start - QUOTE_WINDOW)):]
                if ATTRIBUTED.search(gap) or (":" in gap and len(gap) <= 40):
                    return True
                if m_start - q_end <= 40 and ATTRIBUTED.search(after[:30]):
                    return True
    return False


def is_coordinator_decision(comment):
    body = (comment.get("body") or "").strip()
    if not body:
        return False
    if body.lower().startswith("coordinator"):
        return True
    return quotes_shyam(body)


def coordinator_decisions(issue):
    picked = [c for c in (issue.get("comments") or []) if is_coordinator_decision(c)]
    picked.sort(key=lambda c: (c.get("createdAt") or "", c.get("id") or ""))
    blocks = []
    for comment in picked:
        text = strip_machine_lines(comment.get("body") or "")
        if not text:
            continue
        day = (comment.get("createdAt") or "")[:10]
        author = (comment.get("author") or {}).get("login") or "unknown"
        block = f"### {day} · {author}\n\n{text}"
        if comment.get("url"):
            block += f"\n\nSource: {comment['url']}"
        blocks.append(block)
    return blocks


def brief_reviewer(cfg, t):
    return t["reviewerAlias"]


def fill_run_ids(body, request_id):
    """Replace the run id the body asks for with the concrete one.

    Only a run id that the body introduces as the run instruction is filled,
    so a historical or prerequisite run id stays as written.
    """
    def replace(match):
        start = match.start()
        gap = body[max(0, start - 40):start]
        cue = RUN_ID_CUE.search(gap)
        if cue and RUN_ID_GAP.match(gap[cue.end():]):
            return request_id
        return match.group(0)
    return RUN_ID.sub(replace, body)


def assemble_brief(cfg, t, request_id, issue):
    """The brief the builder receives: the ticket body, the concrete run id and
    every coordinator decision comment, which override the body."""
    body = fill_run_ids(t["body"], request_id)
    filled = request_id in body
    head = [f"Ticket: {t['url']}", f"Reviewer for the gate: {brief_reviewer(cfg, t)}"]
    if not filled:
        head.append(f"Run id: `{request_id}`")
    parts = ["\n".join(head), ANSWER_FORMAT, body]
    decisions = coordinator_decisions(issue)
    if decisions:
        parts.append(DECISIONS_HEADING + "\n\n" + "\n\n".join(decisions))
    return "\n\n".join(parts)


def machine_line(entry):
    return f"<!-- coordinator-ticket {json.dumps(entry, separators=(',', ':'))} -->"


def post_comment(repo, n, text):
    gh(["issue", "comment", str(n), "-R", repo, "--body", text])


def default_branch(repo):
    return gh(["repo", "view", repo, "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name"]).strip()


def build_start(cfg, t, attempt, issue):
    rcfg = cfg["repos"][t["repo"]]
    request_id = f"ticket:{t['repo']}#{t['number']}:a{attempt}"
    payload = {
        "projectId": rcfg["projectId"],
        "message": assemble_brief(cfg, t, request_id, issue),
        "clientRequestId": request_id,
        "workspaceStrategy": {"type": "worktree", "baseRef": f"origin/{default_branch(t['repo'])}",
                              "startFromOrigin": True},
        "taskType": t["type"],
        "modelSelection": t["builderSelection"],
    }
    title_rest = t["title"][len(t["key"]):].lstrip(" ·-:·").strip()
    title = f"{t['key']} · {title_rest}"
    priority = COORDQ_PRIORITY[int(t["priority"])] if t["priority"] else NO_PRIORITY
    command = [COORDQ, "start", json.dumps(payload), "--title", title, "--priority", str(priority)]
    return request_id, command, payload


def with_ticket_lock(repo, n):
    os.makedirs(CACHE_DIR, exist_ok=True)
    f = open(os.path.join(CACHE_DIR, f"start-{repo.replace('/', '_')}-{n}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Refuse("another ticket start for this issue is running")
    return f


def authed_login():
    return gh_gateway.cached_login(QUEUE_DIR, lambda: gh(["api", "user", "-q", ".login"]).strip())


def cmd_start(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    if getattr(a, "force_text_blockers", False):
        print("text blocker checks skipped (--force-text-blockers)", flush=True)
    try:
        repo_config(cfg, repo)
        lock = with_ticket_lock(repo, n)
        issue = fetch_issue(repo, n)
        refusal = None
        try:
            t = validate_start(cfg, repo, issue, check_text=not a.force_text_blockers)
        except Refuse as e:
            refusal = e
            t = parse_ticket(cfg, repo, issue)
        if isinstance(refusal, Overlap) and not a.dry_run:
            journal.emit("start_deferred", "ticket", repo=repo, ticket=n,
                         overlaps=[{"ref": r, "path": p} for r, p in refusal.overlaps])
        if refusal is not None and not a.print_brief:
            raise refusal
        ledger = ledger_of(issue, authed_login())
        attempt = max([e["attempt"] for e in intents(ledger)], default=0) + 1
        request_id = f"ticket:{repo}#{n}:a{attempt}"
        brief = assemble_brief(cfg, t, request_id, issue)
        if a.print_brief and (not a.dry_run or refusal is not None):
            print(brief)
            if refusal is not None:
                print(f"\nnote: a start right now would be refused: {refusal}")
            return
        if refusal is not None:
            raise refusal
        assert_not_active(cfg, t, ledger)
        request_id, command, payload = build_start(cfg, t, attempt, issue)
        stamp = now()
        body_hash = hashlib.sha256(t["body"].encode()).hexdigest()[:16]
        intent = {"kind": "intent", "attempt": attempt, "requestId": request_id, "bodyHash": body_hash,
                  "builder": t["builderAlias"], "reviewer": t["reviewerAlias"], "at": stamp}
        intent_text = f"Starting {t['key']} attempt {attempt}. Builder: {t['builderAlias']}, reviewer: {t['reviewerAlias']}.\n\n{machine_line(intent)}"
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    if a.dry_run:
        print("checks passed")
        print("intent comment:\n" + intent_text + "\n")
        strategy = payload["workspaceStrategy"]
        print(f"workspace: {strategy['type']} from {strategy['baseRef']}")
        print("command:\n" + shlex.join(command) + "\n")
        print(f"receipt comment (after coordq):\n<!-- coordinator-ticket {{\"kind\":\"receipt\",\"attempt\":{attempt},\"requestId\":\"{request_id}\",\"coordq\":\"<coordq output>\"}} -->\n")
        print(f"then swap label stage:{t['stage']} for {STARTED_LABEL} in one edit")
        if a.print_brief:
            print("brief:\n" + brief)
        return
    if attempt == 1:
        journal.emit("assigned", "ticket", repo=repo, ticket=n, attempt=attempt, arm=os.environ.get("COORD_ARM"))
    post_comment(repo, n, intent_text)
    try:
        result = run(command, COORDQ_TIMEOUT)
    except subprocess.TimeoutExpired:
        die(f"coordq start timed out after {COORDQ_TIMEOUT}s; intent attempt {attempt} is on the issue, check coordq list before retrying")
    if result.returncode != 0:
        die(f"coordq start failed: {result.stderr.strip()}; intent attempt {attempt} is on the issue, stage label kept")
    output = result.stdout.strip()
    print(output)
    journal.emit("ticket_started", "ticket", builder=t["builderAlias"], reviewer=t["reviewerAlias"],
                 taskType=payload.get("taskType"), coordq=output, **journal.parse_request_id(request_id))
    receipt = {"kind": "receipt", "attempt": attempt, "requestId": request_id, "coordq": output}
    receipt_text = f"{t['key']} attempt {attempt}: coordq says \"{output}\".\n\n{machine_line(receipt)}"
    posted = False
    for tries in range(3):
        try:
            post_comment(repo, n, receipt_text)
            posted = True
            break
        except GhError as e:
            print(f"receipt comment failed ({e.kind}): {e}", file=sys.stderr)
            time.sleep(2)
    swap_stage(repo, n, f"stage:{t['stage']}", STARTED_LABEL)
    if not posted:
        die(f"started, but the receipt comment could not be posted after 3 tries; coordq output was: {output}")


STARTED_LABEL_READY = set()


def ensure_started_label(repo):
    if repo not in STARTED_LABEL_READY:
        gh(["label", "create", STARTED_LABEL, "-R", repo, "--color", FAMILY_COLORS["stage"],
            "--description", "A builder thread has the ticket", "--force"])
        STARTED_LABEL_READY.add(repo)


def swap_stage(repo, n, old, new):
    """Replace the one stage label `old` with `new` in a single edit.

    A failed edit changes no label, so the ticket keeps `old`. The restore
    below re-asserts that and the message names the state that is left."""
    edit = ["issue", "edit", str(n), "-R", repo]
    try:
        ensure_started_label(repo)
        gh(edit + ["--add-label", new, "--remove-label", old])
    except GhError as e:
        try:
            gh(edit + ["--add-label", old, "--remove-label", new])
        except GhError as restore:
            die(f"stage swap {old} -> {new} failed ({e.kind}): {e}; restoring {old} also failed ({restore.kind}): {restore}; "
                f"{repo}#{n} may have no stage label, check it by hand")
        die(f"stage swap {old} -> {new} failed ({e.kind}): {e}; {repo}#{n} has {old} and not {new}")


def parse_pr_ref(ref):
    """The repository and the pull request number in an `owner/repo#number` reference."""
    match = re.fullmatch(r"([^/\s#]+/[^/\s#]+)#(\d+)", ref)
    if not match:
        die(f"bad pull request reference {ref!r}, expected owner/repo#number", 2)
    return match.group(1), int(match.group(2))


def fetch_pull(repo, number):
    return gh_json(["pr", "view", str(number), "-R", repo, "--json",
                    "number,state,isDraft,title,body,headRefOid,baseRefName,url,changedFiles"])


def refs_issue(repo, body):
    """The issue number a pull request body references with `Refs #n`, or None.

    Only `Refs` and `Ref` count. A pull request body that mentions a number
    in prose names no issue, and a reference to another repository never
    counts.
    """
    for line in (body or "").splitlines():
        match = REFS_ISSUE.search(line)
        if not match:
            continue
        return int(match.group(1))
    return None


def check_ticket_key(repo, rcfg, title):
    """Check the key in an issue title against the key of the repository.

    An issue title that carries no key at all is not an error: the
    repository key still names the ticket, and the gate title needs it.
    """
    if rcfg.get("key") is None:
        raise Refuse(f"repo {repo} has no key configured")
    match = TITLE_KEY.match(title or "")
    if not match:
        return
    if match.group(1) != rcfg["key"]:
        raise Refuse(f"key prefix {match.group(1)} does not match repo key {rcfg['key']}")


def router_chain(route):
    """The models a router route can run, in order.

    The route table lives in the pi extension, so a builder thread that
    stores only a route still says which models it could have run.
    """
    try:
        with open(os.path.expanduser("~/.pi/agent/extensions/task-router.ts")) as f:
            source = f.read()
    except OSError:
        return []
    routes = re.search(r"const ROUTES: Record<string, string\[\]> = \{(.*?)\n\};", source, re.S)
    if not routes:
        return []
    chain = re.search(r"^\s*" + re.escape(route.removeprefix("task/")) + r":\s*\[([^\]]*)\]",
                      routes.group(1), re.M)
    if not chain:
        return []
    try:
        entries = json.loads("[" + chain.group(1).rstrip().rstrip(",") + "]")
    except ValueError:
        return []
    return [entry for entry in entries if isinstance(entry, str)]


def builder_models(issue, login):
    """The model the builder thread of the issue ran, and whether it is live.

    The builder thread is the one the ledger of the issue names and the
    queue receipt points at. The newest attempt that the queue dispatched
    wins, and its newest run names the model that ran. A builder that
    stored only a router route names the models that route can run. A
    builder whose model cannot be read at all leaves the models empty.
    """
    try:
        with open(os.path.join(QUEUE_DIR, "dispatch-receipts.json")) as f:
            receipts = json.load(f)
    except (FileNotFoundError, ValueError):
        receipts = {}
    entries = sorted(intents(ledger_of(issue, login)), key=lambda e: e["attempt"])
    for entry in reversed(entries):
        thread_id = receipts.get(entry.get("requestId"))
        if not thread_id:
            continue
        result = t3_call("t3_thread_read", {"threadId": thread_id, "limit": 5})
        thread = result.get("thread") or {}
        live = thread.get("status") in LIVE_STATUSES
        runs = sorted(result.get("recentRuns") or [],
                      key=lambda run: run.get("ordinal") or 0, reverse=True)
        for run in runs:
            model = run.get("executedModel")
            if isinstance(model, str) and model:
                return [model], live
        stored, instance = thread.get("model"), thread.get("providerInstanceId")
        if instance == "router" and isinstance(stored, str) and stored:
            return router_chain(stored), live
        if isinstance(stored, str) and stored and instance:
            return ["claude" if instance == "claudeAgent" else stored], live
        return [], live
    return [], False


def gate_reviewer(builder_models):
    """The first unblocked review entry of a vendor other than the builder's."""
    reviewers = model_list.reviewers(builder_models)
    if not reviewers:
        raise Refuse("every gate reviewer of a vendor other than the builder's is blocked")
    return reviewers[0]


def gate_live(title, gate_id):
    """Why a gate thread for this pull request head is already on its way, or None.

    A head is taken three ways: a queue item carries it, the queue's
    gatedHeads map names it, or a gate thread already ran for it. The last
    one matters because a gate that finished leaves nothing live, and a
    second gate on the same head would try to merge it again.
    """
    try:
        with open(os.path.join(QUEUE_DIR, "queue.json")) as f:
            queue = json.load(f)
    except (FileNotFoundError, ValueError):
        queue = {}
    for item in queue.get("items") or []:
        if (item.get("args") or {}).get("clientRequestId") == gate_id:
            return f"queued as coordq #{item['id']}"
    heads = queue.get("gatedHeads") or {}
    if gate_id in heads:
        # A head records its queue item, or the record that also carries the
        # retry count once a gate for it died without a verdict.
        entry = heads[gate_id]
        item = entry.get("id") if isinstance(entry, dict) else entry
        return f"a gate for this head is already recorded as coordq #{item}"
    try:
        with open(os.path.join(QUEUE_DIR, "dispatch-receipts.json")) as f:
            receipts = json.load(f)
    except (FileNotFoundError, ValueError):
        receipts = {}
    if receipts.get(gate_id):
        return f"a gate thread already ran for this head (thread {receipts[gate_id]})"
    # The tool schema caps `limit` at 100, and a larger value is refused by the
    # server, so the page size is the schema maximum.
    result = t3_call("t3_thread_list", {"allProjects": True, "limit": 100,
                                        "statuses": LIVE_STATUSES, "includeSubagents": False})
    for thread in result.get("threads") or []:
        if thread.get("title") == title:
            return f"thread {thread['threadId']} is {thread.get('status')}"
    return None


def check_publisher(repo, head, rcfg):
    """True when the check of the pull request comes from the check publisher."""
    statuses = gh_json(["api", f"repos/{repo}/commits/{head}/statuses?per_page=100"])
    checks = [s for s in statuses if s.get("context") == GATE_CHECK_CONTEXT]
    return bool(rcfg.get("macPublisher", repo == GATE_PUBLISHER_REPO)) or bool(checks)


def ascend_repo(repo, rcfg):
    """True when the repository stops at the verdict instead of merging."""
    return (bool(rcfg.get("ascend"))
            or repo.split("/")[0] != "shyamsivakumar"
            or any(marker in repo for marker in ASCEND_MARKERS))


def gate_brief(repo, rcfg, issue_number, pr, head, base, publisher, ascend, proof=None, proof_path=None, proof_state=None, prompt=False):
    """The brief the gate thread receives, with every value filled in."""
    from gate_policy import build_gate_brief
    return build_gate_brief(rcfg, repo, issue_number, pr, head, publisher, base,
                            fast_forward_main=False, ascend_override=ascend,
                            proof=proof, proof_path=proof_path, proof_state=proof_state,
                            prompt=prompt)


def pull_changed_count(repo, number):
    """The pull request's own changed-file count, or None when unreadable.

    The count is what tells a complete file list from a capped one, so a list
    read without it is refused rather than trusted.
    """
    try:
        pull = gh_json(["api", f"repos/{repo}/pulls/{number}"])
    except (GhError, ValueError):
        return None
    count = pull.get("changed_files") if isinstance(pull, dict) else None
    return count if isinstance(count, int) else None


def prompt_pull(repo, number, changed_files=None, base=None, head=None, attempts=2):
    """HOLD, CLEAR or UNKNOWN for the paths the pull request changed.

    The merge base and the head are pinned by the caller, so their trees are
    read first: a file list is read by pull-request number and describes
    whatever head GitHub holds at that moment, which lets a code-only
    revision clear a prompt-changing head that is restored before the merge.
    An unreadable tree diff is retried, then UNKNOWN: `ticket gate` refuses
    rather than building a brief that could order a prompt merge.

    A caller with no pinned pair has only the file list, which is read and
    must be complete before it decides anything.
    """
    if base and head:
        return prompt_paths.scan_diff(
            lambda endpoint: gh_json(["api", endpoint]), repo, base, head, attempts)
    count = changed_files if isinstance(changed_files, int) else pull_changed_count(repo, number)
    for _ in range(max(1, attempts)):
        state = prompt_paths.prompt_scan(pull_files(repo, number, count))
        if state != prompt_paths.UNKNOWN:
            return state
    return prompt_paths.UNKNOWN


def prompt_hold(repo, number, changed_files=None, base=None, head=None):
    """True when the gate brief must say the pull request never merges itself.

    A list GitHub could not give refuses the gate instead of reading as code:
    a brief built without it could order a merge of prompt text.
    """
    state = prompt_pull(repo, number, changed_files, base, head)
    if state == prompt_paths.UNKNOWN:
        raise Refuse(f"the changed files of {repo}#{number} could not be read, so a brief "
                     "here could order a merge of prompt text; retry the gate")
    return state == prompt_paths.HOLD


def with_gate_lock(repo, pr):
    """The lock that keeps two gates for one pull request head apart."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    f = open(os.path.join(CACHE_DIR, f"gate-{repo.replace('/', '_')}-{pr}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Refuse("another gate for this pull request is running")
    return f


def cmd_gate(a):
    import proof_file
    cfg = load_config()
    repo, number = parse_pr_ref(a.ref)
    try:
        rcfg = repo_config(cfg, repo)
        pull = fetch_pull(repo, number)
        head = pull["headRefOid"]
        if pull["state"] != "OPEN":
            raise Refuse(f"pull request #{number} is {pull['state'].lower()}")
        if pull.get("isDraft"):
            raise Refuse(f"pull request #{number} is a draft")
        issue_number = refs_issue(repo, pull.get("body"))
        if issue_number is None:
            raise Refuse(f"pull request #{number} references no issue")
        issue = fetch_issue(repo, issue_number)
        check_ticket_key(repo, rcfg, issue["title"])
        models, live = builder_models(issue, authed_login())
        if a.print_model:
            print(json.dumps(model_list.reviewers(models)))
            return
        reviewer = gate_reviewer(models)
        model = reviewer["selection"]
        publisher = check_publisher(repo, head, rcfg)
        ascend = ascend_repo(repo, rcfg)
        base = pull.get("baseRefName") or "main"
        title = f"{rcfg['key']}-{issue_number} review #{number} {head[:8]}"
        proof_path = proof_file.path_for(rcfg.get("key"), issue_number)
        proof_state, proof = proof_file.fetch(repo, proof_path, head)
        brief = gate_brief(repo, rcfg, issue_number, number, head, base, publisher, ascend,
                           proof=proof, proof_path=proof_path, proof_state=proof_state,
                           prompt=prompt_hold(repo, number, pull.get("changedFiles"),
                                              base, head))
        gate_id = f"gate:{repo}#{number}:{head}"
        payload = {"projectId": rcfg["projectId"], "title": title, "taskType": "review", "modelSelection": model,
                   "runtimeMode": "full-access", "workspaceStrategy": {"type": "root"},
                   "clientRequestId": gate_id, "message": brief}
        command = [COORDQ, "start", json.dumps(payload), "--title", title, "--priority", str(GATE_PRIORITY)]
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    if a.print_brief:
        print(brief)
        return
    try:
        lock = with_gate_lock(repo, number)
        live = gate_live(title, gate_id)
        if live:
            raise Refuse(f"a gate thread for this head is already on its way: {live}")
    except Refuse as e:
        die(f"refused: {e}", 2)
    if a.dry_run:
        print("checks passed")
        print(f"title: {title}")
        print(f"reviewer: {reviewer['id']} ({model['instanceId']} {model['model']})")
        print(f"builder model: {models[0] if models else ('unknown, builder is live' if live else 'unknown')}")
        print("command:\n" + shlex.join(command) + "\n")
        print("brief:\n" + brief)
        return
    try:
        result = run(command, COORDQ_TIMEOUT)
    except subprocess.TimeoutExpired:
        die(f"coordq start timed out after {COORDQ_TIMEOUT}s; check coordq list before retrying")
    if result.returncode != 0:
        die(f"coordq start failed: {result.stderr.strip()}")
    print(result.stdout.strip())


def thread_for_attempt(cfg, t, ledger):
    prior = sorted(intents(ledger), key=lambda e: e["attempt"])
    if not prior:
        return None
    latest = prior[-1]
    try:
        with open(os.path.join(QUEUE_DIR, "dispatch-receipts.json")) as f:
            receipts = json.load(f)
    except FileNotFoundError:
        receipts = {}
    thread_id = receipts.get(f"ticket:{t['repo']}#{t['number']}:a{latest['attempt']}")
    if not thread_id:
        return None
    result = t3_call("t3_thread_read", {"threadId": thread_id, "limit": 1})
    thread = result["thread"]
    if thread["threadId"] != thread_id:
        raise Refuse("thread identity mismatch")
    return thread


def close_check_module():
    """The close checklist module, loaded from the bin directory."""
    bin_dir = os.path.dirname(os.path.abspath(__file__))
    if bin_dir not in sys.path:
        sys.path.insert(0, bin_dir)
    import close_check
    return close_check


def builder_thread(repo, number):
    """The thread that built the ticket, when the ledger knows it."""
    try:
        cfg = load_config()
        repo_config(cfg, repo)
        issue = fetch_issue(repo, number)
        ticket = parse_ticket(cfg, repo, issue)
        ledger = ledger_of(issue, authed_login())
        for attempt in sorted(intents(ledger), key=lambda entry: entry["attempt"], reverse=True):
            thread = thread_for_attempt(cfg, ticket, [attempt])
            if thread:
                return thread["threadId"]
    except (Refuse, GhError, OSError, ValueError, KeyError, SystemExit):
        return None
    return None


def cmd_close(a):
    repo, number = parse_ref(a.ref)
    if repo.split("/")[0] != "shyamsivakumar":
        raise Refuse("issue completion is personal repositories only")
    pull = gh_json(["pr", "view", str(a.pr), "-R", repo, "--json",
                    "state,headRefOid,body,mergeCommit"])
    if (pull.get("state") != "MERGED" or pull.get("headRefOid") != a.head
            or refs_issue(repo, pull.get("body")) != number
            or not (pull.get("mergeCommit") or {}).get("oid")):
        raise Refuse("completion requires the referenced merged PR on the exact reviewed head")
    report = t3_call("t3_thread_read", {"threadId": a.gate_thread, "view": "messages",
                                      "limit": 80, "maxCharsPerItem": 12000})
    replies = [item.get("text", "").rstrip() for item in report.get("items", [])
               if item.get("type") == "assistant_message"]
    reply = replies[-1] if replies else ""
    if not complete_pass(reply, a.head) and not (
            complete_pass(reply, a.head, provides=False)
            and prompt_pull(repo, a.pr) == prompt_paths.HOLD):
        raise Refuse("completion requires exact-head gate verification of Provides, CHECK and VERDICT")
    merge = pull["mergeCommit"]["oid"]
    close_check = close_check_module()
    items = close_check.run_check(repo, a.pr, number)["items"]
    failed = close_check.blocking(items)
    if failed:
        builder = builder_thread(repo, number)
        body = close_check.report(items, f"{repo}#{number}")
        comment = (f"The close checklist did not pass, so the ticket stays open and the work goes "
                   f"back to its builder.\n\n```\n{body}\n```\n")
        if builder:
            comment += f"Builder thread: {builder}.\n"
            message = (f"The close checklist failed on {repo}#{number} (merged via #{a.pr} at "
                       f"{merge}). Fix the failing item and open a new pull request.\n\n{body}")
            payload = {"threadId": builder, "message": message}
            try:
                run([COORDQ, "start", json.dumps(payload), "--tool", "t3_thread_send",
                     "--priority", "800", "--title", f"close-check {repo}#{number}"], CALL_TIMEOUT)
            except (subprocess.TimeoutExpired, OSError) as exc:
                comment += f"The send to the builder thread did not go through: {exc}\n"
        gh(["issue", "comment", str(number), "-R", repo, "--body", comment])
        journal.emit("close_failed", "ticket", repo=repo, ticket=number, pr=a.pr, head=a.head,
                     check=failed[0]["item"])
        raise Refuse("the close checklist failed; the ticket stays open")
    gh(["issue", "close", str(number), "-R", repo, "--comment",
        f"Provides verified by gate {a.gate_thread} on {a.head}; merged via #{a.pr} ({merge})."])
    journal.emit("ticket_closed", "ticket", repo=repo, ticket=number, pr=a.pr, head=a.head,
                 thread=a.gate_thread, merge=merge)
    print(f"closed {repo}#{number} via {merge}")


def cmd_abandon(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    try:
        repo_config(cfg, repo)
        issue = fetch_issue(repo, n)
        t = parse_ticket(cfg, repo, issue)
        if t["state"] != "OPEN":
            raise Refuse(f"issue is {t['state'].lower()}")
        ledger = ledger_of(issue, authed_login())
        threads = [thread_for_attempt(cfg, t, [attempt]) for attempt in intents(ledger)] if t["key"] else []
        live_threads = {thread["threadId"]: thread for thread in threads
                        if thread and thread["status"] in LIVE_STATUSES}
        queued = queue_items(repo, n)
        entry = {"kind": "abandon", "reason": a.reason, "at": now()}
        gh(["issue", "close", str(n), "-R", repo, "--reason", "not planned",
            "--comment", f"Abandoned: {a.reason}\n\n{machine_line(entry)}"])
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    journal.emit("ticket_abandoned", "ticket", repo=repo, ticket=n)
    print(f"closed {repo}#{n} as not planned")
    for thread in live_threads.values():
        t3_call("t3_thread_interrupt", {"threadId": thread["threadId"], "stop": True})
        print(f"interrupted thread {thread['threadId']} (was {thread['status']})")
    for item in queued:
        result = run([COORDQ, "drop", str(item["id"])], CALL_TIMEOUT)
        if result.returncode != 0:
            die(f"coordq drop #{item['id']} failed: {result.stderr.strip()}")
        print(result.stdout.strip())
    if not queued and not live_threads:
        print("no live thread or queued item to stop")


def cmd_show(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    try:
        repo_config(cfg, repo)
        issue = fetch_issue(repo, n)
        t = parse_ticket(cfg, repo, issue)
        ledger = ledger_of(issue, authed_login())
        thread = thread_for_attempt(cfg, t, ledger) if t["key"] and intents(ledger) else None
        queued = queue_items(repo, n)
        out = {
            "repo": repo,
            "number": n,
            "id": issue["id"],
            "url": t["url"],
            "key": t["key"],
            "title": t["title"],
            "state": t["state"],
            "body": t["body"],
            "bodyHash": hashlib.sha256(t["body"].encode()).hexdigest()[:16],
            "stage": t["stage"],
            "priority": int(t["priority"]) if t["priority"] else None,
            "type": t["type"],
            "builder": t["builder"],
            "reviewer": t["reviewer"],
            "problems": t["problems"],
            "template": template_status(cfg, t["body"]),
            "blockers": blockers_of(issue),
            "ledger": ledger,
            "queued": [{"id": i["id"], "title": i["title"]} for i in queued],
            "latestAttempt": {
                "attempt": max((e["attempt"] for e in intents(ledger)), default=None),
                "threadId": thread["threadId"] if thread else None,
                "status": thread["status"] if thread else ("queued" if queued else
                          ("not running (no thread recorded)" if intents(ledger) else None)),
            },
        }
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    print(json.dumps(out, indent=1))


def set_target(cfg, family, value):
    if value == "none":
        return None
    valid = {
        "stage": cfg["labels"]["stage"],
        "priority": cfg["labels"]["priority"],
        "builder": builder_ids(),
        "reviewer": reviewer_ids(),
    }[family]
    if value not in valid:
        raise Refuse(f"unknown {family} {value!r}, expected one of: {', '.join(valid)}, none")
    return value


def cmd_set(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    wanted = {f: getattr(a, f) for f in ("stage", "priority", "builder", "reviewer") if getattr(a, f) is not None}
    if not wanted:
        die("nothing to set: pass --priority, --builder, --reviewer or --stage", 2)
    try:
        repo_config(cfg, repo)
        targets = {f: set_target(cfg, f, v) for f, v in wanted.items()}
        issue = gh_json(["issue", "view", str(n), "-R", repo, "--json", "labels"])
        names = [l["name"] for l in issue["labels"]]
        groups, _ = split_labels(cfg, names)
        pair = {f: targets[f] if f in targets else one(groups[f]) for f in ("builder", "reviewer")}
        if pair["builder"] and pair["reviewer"]:
            builder_vendor = next(e["vendor"] for e in model_list.entries("build") if e["id"] == pair["builder"])
            reviewer_vendor = next(e["vendor"] for e in model_list.entries("review") if e["id"] == pair["reviewer"])
            if builder_vendor == reviewer_vendor:
                raise Refuse(f"builder {pair['builder']} and reviewer {pair['reviewer']} are both vendor {builder_vendor}")
        add, remove = [], []
        for family, value in targets.items():
            remove += [f"{family}:{v}" for v in groups[family] if v != value]
            if value and value not in groups[family]:
                add.append(f"{family}:{value}")
        if add or remove:
            args = ["issue", "edit", str(n), "-R", repo]
            if add:
                args += ["--add-label", ",".join(add)]
            if remove:
                args += ["--remove-label", ",".join(remove)]
            gh(args)
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    print(json.dumps(sorted((set(names) | set(add)) - set(remove))))


def main():
    p = argparse.ArgumentParser(prog="ticket")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("labels")
    s.add_argument("--apply", action="store_true")
    s.set_defaults(fn=ensure_labels)
    s = sub.add_parser("open", help="open a ticket with a minted key")
    s.add_argument("--repo", required=True, help="owner/repo")
    s.add_argument("--title", required=True, help="the ticket title; the key is minted when it has none")
    s.add_argument("--body", default="")
    s.add_argument("--body-file")
    s.add_argument("--label", default="", help="comma separated labels")
    s.add_argument("--require-key", action="store_true", help="refuse a title without a key instead of minting one")
    s.add_argument("--dry-run", action="store_true", help="print the title this would use and stop")
    s.add_argument("--repo-dir", help="checkout that holds origin/main for the proof run (default: the current directory)")
    s.set_defaults(fn=cmd_open)
    s = sub.add_parser("list")
    s.add_argument("--json", action="store_true")
    s.add_argument("--fresh", action="store_true")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("start")
    s.add_argument("ref")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--force-text-blockers", action="store_true",
                   help="skip the text blocker checks (native blockers still apply)")
    s.add_argument("--print-brief", action="store_true",
                   help="print the brief this start would send, then stop without starting")
    s.set_defaults(fn=cmd_start)
    s = sub.add_parser("gate")
    s.add_argument("ref", help="the pull request to gate, owner/repo#number")
    s.add_argument("--dry-run", action="store_true",
                   help="print the gate this would queue, then stop without queueing")
    s.add_argument("--print-brief", action="store_true",
                   help="print the gate brief this pull request would get, then stop without queueing")
    s.add_argument("--print-model", action="store_true",
                   help="print the reviewers this pull request may use, in order, as JSON, then stop")
    s.set_defaults(fn=cmd_gate)
    s = sub.add_parser("close")
    s.add_argument("ref")
    s.add_argument("--pr", required=True, type=int)
    s.add_argument("--head", required=True)
    s.add_argument("--gate-thread", required=True)
    s.set_defaults(fn=cmd_close)
    s = sub.add_parser("abandon")
    s.add_argument("ref")
    s.add_argument("--reason", required=True)
    s.set_defaults(fn=cmd_abandon)
    s = sub.add_parser("set")
    s.add_argument("ref")
    s.add_argument("--priority")
    s.add_argument("--builder")
    s.add_argument("--reviewer")
    s.add_argument("--stage")
    s.set_defaults(fn=cmd_set)
    s = sub.add_parser("show")
    s.add_argument("ref")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)
    a = p.parse_args()
    try:
        a.fn(a)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")


if __name__ == "__main__":
    main()
