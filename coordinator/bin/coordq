#!/usr/bin/env python3
import argparse, fcntl, json, os, re, signal, subprocess, sys, time
from pathlib import Path

# The modules below live next to this script. A caller that loads this file
# by path, as the tests and the installer checks do, does not put that
# directory on the path, so these imports would fail without this line.
_BIN_DIR = str(Path(__file__).resolve().parent)
if _BIN_DIR not in sys.path:
    sys.path.insert(0, _BIN_DIR)

from gate_bar import GATE_BAR
import prompt_paths
from tick_health import tick_alarm
import gh_gateway

# Every gh call here goes through the helper, and the helper uses this
# module's launcher, so a test that replaces `subprocess` still sees them.
gh_gateway.set_runner(lambda: subprocess.run)

DIR = os.environ.get("COORDQ_DIR", os.path.expanduser("~/Code/coordinator/queue"))
T3MCP = os.environ.get("COORDQ_T3MCP", "t3mcp")
# The tick reads the threads with `coordq status`, so the t3mcp call it
# makes is bounded: a call that hangs is skipped and named, never waited
# on without end.
T3MCP_TIMEOUT = 60
LIVE_STATUSES = ["running", "starting", "preparing", "queued"]
MAX_ATTEMPTS = 3
TERMINAL_STATUSES = ["completed", "interrupted", "failed", "cancelled", "rolled_back"]
# A launch learns its thread only after the call, so its reservedThreads record
# carries this prefix and reconcile knows the thread may not be listed live yet.
LAUNCH_RECORD = "launch:"
# One message is one item. A started item is recorded for this long, so the
# same message is refused while the thread that took it still works it, while
# a message the board asks for again after its thread stopped still goes out.
MESSAGE_TTL = float(os.environ.get("COORDQ_MESSAGE_TTL", "1800"))
# A reservation covers one step in flight. Past this age the step is over,
# whatever its reply said, so the slot it holds goes back to the queue.
RESERVATION_TIMEOUT = float(os.environ.get("COORDQ_RESERVATION_TIMEOUT", "180"))
import models as model_list

BUILD_TASK_TYPES = ("standard", "large", "ui", "research", "rca", "chore", "worker", "risky", "design")
TASK_TYPES = BUILD_TASK_TYPES + ("fix", "review", "panel")
DISPATCHABLE_TOOLS = ["t3_thread_launch", "t3_thread_send"]
RULES_PATH = os.environ.get("COORDQ_RULES", os.path.expanduser("~/.coordinator/AGENT-RULES.md"))
RULES_SKIP_TITLE = re.compile(r"\b(?:review|critique)\b|\bmerge relay\b", re.IGNORECASE)
# The board refill. When the machine has free slots,
# the dispatcher starts tickets from the board, at most once per interval.
TICKET_BIN = os.environ.get("COORDQ_TICKET", "ticket")
TICKETS_CONFIG = os.environ.get("COORDQ_TICKETS_CONFIG", os.path.expanduser("~/.coordinator/tickets.json"))
REFILL_INTERVAL = int(os.environ.get("COORDQ_REFILL_INTERVAL", "300"))
REFILL_BUDGET = float(os.environ.get("COORDQ_REFILL_BUDGET", "120"))
REFILL_MAX = int(os.environ.get("COORDQ_REFILL_MAX", "40"))
REFILL_LIMIT = int(os.environ.get("COORDQ_REFILL_LIMIT", "1000"))
# The file that holds the refusals of the earlier passes. A candidate whose
# board state has not changed since its last refusal is skipped, so the scan
# walks past it and reaches the tickets further down the board.
REFILL_STATE_FILE = "refill-state.json"
# A refusal is kept this long. The board state of a ticket can change without
# the ticket itself changing, for example when a blocker closes, so a refusal
# is retried when it grows old.
REFILL_RETRY_AGE = float(os.environ.get("COORDQ_REFILL_RETRY_AGE", "3600"))
# The ticket CLI exits with this code when it refuses a ticket, and also for
# a usage error. A refusal says so in its own output, and `is_refusal` reads
# that answer, because the exit code alone cannot tell the two apart.
REFUSE_CODE = 2
# The ticket CLI exits with 1 for a missing or unknown issue and for a
# failed check. A refusal says so in its own first line.
REFUSE_PREFIX = "refused:"
STAGE = "stage:todo"
# The gate keeps a PR that it cannot gate on a report file, so the coordinator
# tick can see it. A PR that is skipped on the same head this many times is
# stuck; a new head starts the count again.
STUCK_COUNT = 3
# The calls kept in reserve before an optional read is skipped. The lane
# driver, gatekeep and the shift share this one floor.
FLOOR = gh_gateway.floor()
STUCK_FILE = "gatekeep-stuck.txt"
# A gate that dies without a verdict is queued again, but a reviewer that
# cannot run at all fails the same way, so a retry with no end relaunches it
# on every run. A head is retried at most GATE_RETRY_LIMIT times, with
# GATE_RETRY_BACKOFF seconds between retries after the first, and then given
# up until its head changes.
GATE_RETRY_LIMIT = int(os.environ.get("COORDQ_GATE_RETRY_LIMIT", "2"))
GATE_RETRY_BACKOFF = float(os.environ.get("COORDQ_GATE_RETRY_BACKOFF", "300"))
# The board action keys. A board action for one head is one send, so the
# key of that action belongs to one queue item. The map holds the key of
# every action the queue has taken, with the item that took it and what
# the queue did with it, so a second send of the same action is refused
# with the id of the first one. The map is optional: a queue file without
# it is a queue that has taken no board action yet.
ACTION_KEYS = "actionKeys"
TITLE_KEY = re.compile(r"^([A-Za-z][A-Za-z0-9]*)-(\d+)\b")
REVIEW_TITLE = re.compile(r"\breview\b", re.IGNORECASE)
ROUTER_SOURCE = os.path.expanduser("~/.pi/agent/extensions/task-router.ts")


def path(name):
    return os.path.join(DIR, name)


def die(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def log(message):
    with open(path("dispatch.log"), "a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")


def cap():
    with open(path("config.json")) as f:
        return json.load(f)["cap"]


def load():
    if not os.path.exists(path("queue.json")):
        return {"next": 1, "items": []}
    with open(path("queue.json")) as f:
        return json.load(f)


def save(queue):
    tmp = path("queue.json.tmp")
    with open(tmp, "w") as f:
        json.dump(queue, f, indent=1)
    os.replace(tmp, path("queue.json"))


def gate_state(value):
    """The gate state of one recorded head.

    gatedHeads maps a head to its queue item, and to the record
    `{id, retries, at, givenUp}` once a gate for the head has died without
    a verdict. A value written before that record is the bare queue item
    id, which is a head with no retry behind it.
    """
    if isinstance(value, dict):
        retries = value.get("retries")
        at = value.get("at")
        return {"id": value.get("id"),
                "retries": retries if isinstance(retries, int) and not isinstance(retries, bool) else 0,
                "at": at if isinstance(at, (int, float)) and not isinstance(at, bool) else None,
                "givenUp": bool(value.get("givenUp"))}
    return {"id": value, "retries": 0, "at": None, "givenUp": False}


def gate_label(state):
    """The recorded gate of one head, for a refusal that names it."""
    return f"coordq #{state['id']}" if state["id"] is not None else "an earlier gate"


def task_list(task_type):
    return {"fix": "fix", "review": "review", "panel": "panel"}.get(task_type, "build")


def with_model(args):
    task_type = args.get("taskType")
    if task_type not in TASK_TYPES:
        return None, f"refused: a launch needs a taskType, got {task_type!r}. Accepted taskTypes: {', '.join(sorted(TASK_TYPES))}"
    resolved = dict(args)
    if not resolved.get("modelSelection"):
        if task_type == "panel":
            return None, "refused: a panel launch names its model from the panel list"
        entry = model_list.first_available(task_list(task_type))
        if entry is None:
            return None, f"refused: every model for taskType {task_type!r} is blocked"
        resolved["modelSelection"] = entry["selection"]
    else:
        list_name = task_list(task_type)
        allowed = model_list.find(resolved["modelSelection"], (list_name,))
        if allowed is None:
            return None, (f"refused: taskType {task_type!r} runs on a model from the {list_name} list, "
                          f"but the payload names {resolved['modelSelection']!r}")
        if model_list.is_blocked(allowed["selection"]):
            return None, (f"refused: {model_list.identity(allowed['selection'])} is blocked, "
                          f"so taskType {task_type!r} cannot run on it")
        resolved["modelSelection"] = allowed["selection"]
    return resolved, None


LEGACY_ROUTE_TASK_TYPES = {f"task/{name}": name for name in ("standard", "ui", "research", "rca", "chore")}


def queued_launch_args(tool, args):
    """A launch queued before taskType was required carries none, so the list that names its model classifies it.

    A router route the old task table stored becomes its task type and resolves through the current build
    list. A model no list names stays unclassified and is refused at dispatch."""
    if tool != "t3_thread_launch" or "taskType" in args or not args.get("modelSelection"):
        return args
    selection = args["modelSelection"]
    if selection.get("instanceId") == "router" and selection.get("model") in LEGACY_ROUTE_TASK_TYPES:
        return {**{k: v for k, v in args.items() if k != "modelSelection"},
                "taskType": LEGACY_ROUTE_TASK_TYPES[selection["model"]]}
    for list_name, task_type in (("review", "review"), ("build", "worker"), ("fix", "fix")):
        if model_list.find(args["modelSelection"], (list_name,)):
            return {**args, "taskType": task_type}
    return args


def is_gate_model(selection):
    return model_list.find(selection, ("review",)) is not None


def tool_refusal(tool):
    return f"tool {tool!r} is not dispatchable. Accepted tools: {', '.join(DISPATCHABLE_TOOLS)}"


def read_rules():
    try:
        with open(RULES_PATH) as f:
            return f.read().strip()
    except OSError as e:
        raise RuntimeError(f"cannot read agent rules {RULES_PATH}: {e.strerror}") from e


def wants_rules(args, task_type=None):
    if not args.get("message") or task_type == "review" or is_gate_model(args.get("modelSelection")):
        return False
    return not RULES_SKIP_TITLE.search(str(args.get("title") or ""))


def with_rules(args, rules):
    return {**args, "message": f"## Agent rules\n\n{rules}\n\n## Brief\n\n{args['message']}"}


def call(tool, args, rules=None):
    if tool == "t3_thread_launch":
        task_type = args.get("taskType")
        args, refusal = with_model(args)
        if refusal:
            return 1, refusal
        if wants_rules(args, task_type):
            if rules is None:
                return 1, "agent rules were not loaded"
            args = with_rules(args, rules)
        args = {key: value for key, value in args.items() if key != "taskType"}
    # The call is bounded: a t3mcp that hangs must not hold the tick that
    # asked for it, and the answer says which call was skipped.
    try:
        run = subprocess.run([T3MCP, "call", tool, "-"], input=json.dumps(args),
                             capture_output=True, text=True, timeout=T3MCP_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 1, f"t3 call {tool} timed out after {T3MCP_TIMEOUT}s"
    return run.returncode, (run.stdout if run.returncode == 0 else run.stderr).strip()


def live():
    code, out = call("t3_thread_list", {"allProjects": True, "limit": 1, "statuses": LIVE_STATUSES,
                                        "includeSubagents": False})
    return json.loads(out)["total"] if code == 0 else None


def tool_for(args):
    return "t3_thread_send" if "threadId" in args else "t3_thread_launch"


class Lock:
    def __init__(self, blocking, name="queue.lock"):
        self.blocking = blocking
        self.name = name

    def __enter__(self):
        self.f = open(path(self.name), "w")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if self.blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            self.f.close()
            return None
        return self

    def __exit__(self, *exc):
        if self.f and not self.f.closed:
            self.f.close()


def active_thread_ids():
    ids = set()
    cursor = None
    while True:
        args = {"allProjects": True, "limit": 100, "statuses": LIVE_STATUSES,
                "includeSubagents": False}
        if cursor is not None:
            args["cursor"] = cursor
        code, out = call("t3_thread_list", args)
        if code:
            raise RuntimeError("cannot read active thread IDs")
        result = json.loads(out)
        ids.update(row["threadId"] for row in result["threads"])
        next_cursor = result.get("nextCursor")
        if next_cursor is None:
            return ids
        if cursor is not None and next_cursor <= cursor:
            raise RuntimeError("active thread pagination did not advance")
        cursor = next_cursor


def thread_status(thread_id):
    code, out = call("t3_thread_read", {"threadId": thread_id, "limit": 1})
    if code:
        raise RuntimeError(f"cannot read thread {thread_id}")
    return json.loads(out).get("thread", {}).get("status")


def message_identity(item):
    """The title and the target of one message.

    The title is the one the caller supplied, under `messageTitle`. A send the
    caller left untitled carries its thread id as its display title, and that
    is not a message identity: two callers can send two different
    instructions to one thread without a title, and neither is the other's
    duplicate. An item written before the identity was kept falls back to its
    title, which its caller supplied.

    The target is the thread the message goes to. A launch has no thread yet,
    so its client request names the work it starts: a second launch for the
    same work is the same message.
    """
    args = item.get("args") or {}
    target = str(args.get("threadId") or args.get("clientRequestId") or "")
    if "messageTitle" in item:
        title = item.get("messageTitle") or ""
    else:
        # An item written before the identity was kept. Its title is the
        # caller's when the payload names it and when it is not the thread id
        # the old code fell back to: an untitled send stored its thread id
        # there, and that says nothing about what the caller meant.
        title = item.get("title") or ""
        if title and title == target and args.get("title") != title:
            title = ""
    return (str(title), target)


def prune_messages(queue, live_ids=None):
    """Drop the started-message records that are no longer running.

    A record whose thread is still live is kept however old it is: that
    thread is working the message now, so the queue must keep refusing a
    second copy of it (ticket #544 counts a running item). The age only
    retires a record once its thread is gone. An unreadable thread list
    (live_ids None) keeps every record, the same way duplicate_message
    counts an unreadable list as a duplicate: a refused start costs one
    attempt, and dropping the record costs a second thread on the work.

    Returns whether anything was dropped, so a caller saves only a change.
    """
    started = queue.get("started") or []
    now = time.time()
    kept = [record for record in started
            if isinstance(record, dict)
            and (live_ids is None
                 or record.get("thread") in live_ids
                 or now - float(record.get("at") or 0) < MESSAGE_TTL)]
    changed = len(kept) != len(started)
    queue["started"] = kept
    return changed


def dispatch_is_active(queue, record):
    """Whether a started record is the dispatch running on its thread now.

    A thread runs one message at a time, so a later message started on the
    same thread makes the earlier one spent: the thread moved on, and a caller
    asking for the earlier message again is asking for real work. A record
    whose thread is not known yet (a launch whose reply carried none) cannot
    be ordered against another, so it stays active.
    """
    thread = record.get("thread") or ""
    if not thread:
        return True
    at = record.get("at") or 0
    for other in queue.get("started") or []:
        if other is record or not isinstance(other, dict):
            continue
        if other.get("thread") != thread:
            continue
        later = other.get("at") or 0
        if later > at or (later == at and (other.get("id") or 0) > (record.get("id") or 0)):
            return False
    return True


def duplicate_message(queue, title, target, live_ids=None, started_before=None):
    """The queued or running item that already carries this message, or None.

    A started message counts while the thread that took it is live, and only
    while it is the latest message started on that thread: once a later
    message starts there, the earlier one is spent and asking for it again is
    real work. An unreadable thread list counts a record too, because a refused
    start costs one attempt while a second copy of the message costs a second
    thread on the same work.

    An action key names one board action, but it does not make a second copy
    of the same message a different message: the queue names a message by its
    title and its target, and the lane puts the whole head in its title, so
    messages for different heads stay distinct without the key. A message with
    no title or no target is never a duplicate: without a title the caller
    supplied, or without a thread or a client request, there is nothing to
    tell two of them apart, and refusing one would drop work the queue was
    asked to start.
    """
    if not title or not target:
        return None
    for item in queue.get("items") or []:
        if message_identity(item) != (title, target):
            continue
        return "queued", item.get("id")
    for record in queue.get("started") or []:
        if (record.get("title"), record.get("target")) != (title, target):
            continue
        if not dispatch_is_active(queue, record):
            # A later message started on this thread, so this one is spent and
            # asking for it again is real work.
            continue
        if live_ids is None:
            # An unreadable thread list cannot say a thread stopped.
            return "started", record.get("id")
        if started_before is not None and (record.get("id"), record.get("at")) not in started_before:
            # Recorded after the list was read, so the list cannot say whether
            # its thread is live, and it is the message just taken.
            return "started", record.get("id")
        if str(record.get("id")) in (queue.get("reserved") or {}):
            # The queue still holds this launch's slot: a launch learns its
            # thread only after the call, so a record whose thread the list
            # does not show yet is an unfinished launch, not a spent message.
            return "started", record.get("id")
        if record.get("thread") in live_ids:
            return "started", record.get("id")
    return None


def started_snapshot(queue):
    """The started-message records as they stood before the thread list read.

    A record added since then names a message another start has just taken,
    and the list cannot say whether its thread is live, so it counts as
    running.
    """
    return {(record.get("id"), record.get("at"))
            for record in queue.get("started") or [] if isinstance(record, dict)}


def record_started(queue, item, thread):
    """Remember a message the queue started, so it is not queued again."""
    title, target = message_identity(item)
    queue.setdefault("started", []).append({"id": item.get("id"), "title": title,
                                            "target": target, "thread": thread or "",
                                            "actionKey": item.get("actionKey") or "",
                                            "at": time.time()})


def started_thread(queue, item, key):
    """The thread a dispatched item works, as far as the queue knows it."""
    if item.get("tool") == "t3_thread_send":
        return str((item.get("args") or {}).get("threadId") or "")
    record = (queue.get("reservedThreads") or {}).get(key) or ""
    if isinstance(record, str) and record.startswith(LAUNCH_RECORD):
        return record[len(LAUNCH_RECORD):]
    return ""


def live_thread_ids():
    """The live thread ids, or None when they cannot be read."""
    try:
        return active_thread_ids()
    except (RuntimeError, ValueError, KeyError, TypeError, OSError):
        return None


def reservation_snapshot(queue):
    """The reservations as they stood when the thread list was read.

    A reservation taken after that read is not judged by it: the thread it
    names may have been free when the list was made, and busy a moment later.
    """
    threads = queue.get("reservedThreads") or {}
    return {key: {"at": at, "thread": threads.get(key)}
            for key, at in (queue.get("reserved") or {}).items()}


def thread_status_or_none(thread):
    """The status of `thread`, or None when it cannot be read."""
    try:
        return thread_status(thread)
    except (RuntimeError, ValueError, TypeError, AttributeError):
        return None


def launch_statuses(queue, live_ids):
    """The status of every launch the snapshot holds that is not live.

    The lookups happen before the writer lock is taken, so a slow t3 call
    never blocks a start. A launch thread can finish before any pass lists it
    live, so its status is what says whether its slot is still in use.
    """
    statuses = {}
    reserved = queue.get("reserved") or {}
    threads = queue.get("reservedThreads") or {}
    now = time.time()
    for key, at in reserved.items():
        record = threads.get(key)
        if not (isinstance(record, str) and record.startswith(LAUNCH_RECORD)):
            continue
        if now - float(at) >= RESERVATION_TIMEOUT:
            continue
        thread = record[len(LAUNCH_RECORD):]
        if not thread or thread in live_ids:
            continue
        statuses[thread] = thread_status_or_none(thread)
    return statuses


def reconcile_reservations(queue, active, statuses=None, snapshot=None):
    """Release the reservations no thread uses any more.

    With `snapshot` only the reservations that stood when the thread list was
    read are judged: a reservation taken since then names a thread the list
    cannot speak for, and releasing it would free a slot a live launch holds.
    """
    reserved = queue.setdefault("reserved", {})
    threads = queue.setdefault("reservedThreads", {})
    known = {} if statuses is None else statuses
    released = 0
    for key, at in list(reserved.items()):
        record = threads.get(key)
        if snapshot is not None:
            before = snapshot.get(key)
            if before is None or before.get("at") != at or before.get("thread") != record:
                continue
        launched = isinstance(record, str) and record.startswith(LAUNCH_RECORD)
        thread = record[len(LAUNCH_RECORD):] if launched else record
        expired = time.time() - at >= RESERVATION_TIMEOUT
        seen = bool(thread) and thread in active
        finished = False
        if launched and not (expired or seen):
            # A launch thread can finish before any pass lists it live.
            if thread and thread not in known:
                # With a snapshot the statuses were read before the writer
                # lock was taken. A launch they do not cover keeps its slot:
                # looking it up here would hold every start for the length of
                # a t3 call.
                known[thread] = None if snapshot is not None else thread_status_or_none(thread)
            finished = known.get(thread) in TERMINAL_STATUSES
        if not (expired or seen or finished):
            continue
        if expired:
            log(f"EXPIRED reservation #{key} after {int(RESERVATION_TIMEOUT)}s")
        elif finished:
            log(f"released reservation #{key}: thread {thread} is {known[thread]}")
        reserved.pop(key)
        threads.pop(key, None)
        released += 1
    if released:
        save(queue)


def undispatchable_tool(item):
    for tool in [item.get("tool")] + [step.get("tool") for step in item.get("pre", [])]:
        if tool not in DISPATCHABLE_TOOLS:
            return tool
    return None


def drain():
    statuses = {}
    while True:
        queue = load()
        dispatchable = []
        dropped = set()
        for item in queue["items"]:
            if item.get("attempts", 0) >= MAX_ATTEMPTS:
                dropped.add(item["id"])
                queue.setdefault("failed", []).append(item)
                release_action_key(queue, item)
                log(f"DROPPED #{item['id']} after {item['attempts']} attempts: {item.get('last_error', 'unknown error')}")
                continue
            tool = undispatchable_tool(item)
            if tool is None:
                dispatchable.append(item)
                continue
            dropped.add(item["id"])
            release_action_key(queue, item)
            log(f"REFUSED #{item['id']}: {tool_refusal(tool)}")
        if dropped:
            queue["items"] = [i for i in queue["items"] if i["id"] not in dropped]
            save(queue)
        ready = sorted((i for i in dispatchable if i.get("attempts", 0) < MAX_ATTEMPTS), key=lambda i: (-i["priority"], i["id"]))
        n = live()
        if n is None:
            log("cannot read thread count, nothing started")
            return
        try:
            active = active_thread_ids()
        except (RuntimeError, ValueError, KeyError, TypeError) as e:
            log(f"{e}, nothing started")
            return
        reconcile_reservations(queue, active, statuses)
        if prune_messages(queue, active):
            save(queue)
        if not ready:
            return
        n = max(n, len(active))
        if n + len(queue["reserved"]) >= cap():
            log(f"at cap {n + len(queue['reserved'])}/{cap()}, {len(ready)} waiting")
            return
        item = ready[0]
        try:
            steps = [{"tool": step["tool"], "args": queued_launch_args(step["tool"], step["args"])}
                     for step in item.get("pre", []) + [{"tool": item["tool"], "args": item["args"]}]]
            needs_rules = any(step["tool"] == "t3_thread_launch" and wants_rules(step["args"]) for step in steps)
        except model_list.ModelsError as e:
            log(f"#{item['id']} not started, the model files cannot be read: {e}")
            return
        rules = None
        if needs_rules:
            try:
                rules = read_rules()
            except RuntimeError as e:
                log(f"{e}, nothing started")
                return
        reservation = str(item["id"])
        keys = [f"{reservation}:pre:{time.time_ns()}:{i}" for i in range(len(steps) - 1)] + [reservation]
        if n + len(queue["reserved"]) + len(steps) > cap():
            log(f"waiting for {len(steps)} slots for #{item['id']}")
            return
        for key, step in zip(keys, steps):
            queue["reserved"][key] = time.time()
            if step["tool"] == "t3_thread_send":
                queue["reservedThreads"][key] = step["args"]["threadId"]
        if item.get("actionKey"):
            set_action_key_state(queue, item["actionKey"], "reserved")
        save(queue)
        code, out = 0, ""
        for index, (key, step) in enumerate(zip(keys, steps)):
            try:
                code, out = call(step["tool"], step["args"], rules)
            except model_list.ModelsError as e:
                for unused in keys[index:]:
                    queue["reserved"].pop(unused, None)
                    queue["reservedThreads"].pop(unused, None)
                item["pre"] = item.get("pre", [])[index:]
                if item.get("actionKey"):
                    set_action_key_state(queue, item["actionKey"], "queued")
                save(queue)
                log(f"#{item['id']} not started, the model files cannot be read: {e}")
                return
            except (OSError, subprocess.SubprocessError, ValueError) as e:
                code, out = 1, str(e)
            if code != 0:
                for unused in keys[index:]:
                    queue["reserved"].pop(unused, None)
                    queue["reservedThreads"].pop(unused, None)
                item["pre"] = item.get("pre", [])[index:]
                save(queue)
                break
            if step["tool"] == "t3_thread_launch":
                try:
                    result = json.loads(out)
                    thread = result.get("thread", result).get("threadId")
                    if isinstance(thread, str) and thread:
                        queue["reservedThreads"][key] = LAUNCH_RECORD + thread
                except (ValueError, TypeError, AttributeError):
                    log(f"reservation #{key} retained: launch reply has no thread ID")
            save(queue)
        request_id = item["args"].get("clientRequestId")
        if code == 0 and request_id and item["tool"] == "t3_thread_launch":
            try:
                result = json.loads(out)
                thread_id = result.get("thread", result).get("threadId")
                if not isinstance(thread_id, str) or not thread_id:
                    raise ValueError("successful launch has no threadId")
            except (ValueError, TypeError, AttributeError) as e:
                item["attempts"] = MAX_ATTEMPTS - 1
                code, out = 1, f"invalid launch reply: {e}"
        if code == 0 and item["tool"] == "t3_thread_launch":
            try:
                result = json.loads(out)
                thread_id = result.get("thread", result).get("threadId")
                if not isinstance(thread_id, str) or not thread_id:
                    raise ValueError("successful launch has no threadId")
                queue["reservedThreads"][reservation] = LAUNCH_RECORD + thread_id
            except (ValueError, TypeError, AttributeError) as e:
                log(f"reservation #{reservation} retained: {e}")
        if code == 0:
            if request_id and item["tool"] == "t3_thread_launch":
                receipts_path = path("dispatch-receipts.json")
                receipts = {}
                if os.path.exists(receipts_path):
                    with open(receipts_path) as f:
                        receipts = json.load(f)
                receipts[request_id] = thread_id
                if request_id.startswith("gate:"):
                    receipts[":".join(request_id.split(":")[:3])] = thread_id
                with open(receipts_path + ".tmp", "w") as f:
                    json.dump(receipts, f)
                os.replace(receipts_path + ".tmp", receipts_path)
            queue["items"] = [i for i in queue["items"] if i["id"] != item["id"]]
            record_started(queue, item, started_thread(queue, item, reservation))
            if item.get("actionKey"):
                set_action_key_state(queue, item["actionKey"], "dispatched")
            save(queue)
            log(f"started #{item['id']} {item['tool']} {item['title']!r} (was {n}/{cap()})"
                + (f" key {item['actionKey']}" if item.get("actionKey") else ""))
        else:
            queue["reserved"].pop(reservation, None)
            queue["reservedThreads"].pop(reservation, None)
            if item.get("actionKey"):
                set_action_key_state(queue, item["actionKey"], "queued")
            item["attempts"] = item.get("attempts", 0) + 1
            item["last_error"] = out[:200]
            if request_id and request_id.startswith("gate:"):
                key = ":".join(request_id.split(":")[:3])
                model = failed_gate_reviewer(queue, key, item["args"]["modelSelection"], out)
                if model:
                    item["args"]["modelSelection"] = model
                    item["args"]["clientRequestId"] = key + ":" + model["model"] + ":retry"
                    item["attempts"] = 0
                    log(f"gate retry {key}: {model['model']}")
                else:
                    item["attempts"] = MAX_ATTEMPTS
            save(queue)
            log(f"FAILED #{item['id']} attempt {item['attempts']}: {out[:200]}")


def action_key_record(queue, key):
    """The record of one action key: the item that took it and its state.

    A record written before the state was kept is a bare item id. Its
    state is read from the queue, because the item may still be waiting
    there: a key of a queued item is queued, and a key of an item that is
    nowhere in the queue was dispatched."""
    record = (queue.get(ACTION_KEYS) or {}).get(key)
    if record is None:
        return None
    if isinstance(record, dict):
        item_id, state = record.get("id"), record.get("state")
    else:
        item_id, state = record, None
    if item_id is None:
        # A record without an item id cannot be read. The key stays held:
        # a held key costs one refused start, while a released key sends
        # the same board action twice.
        return {"id": None, "state": "dispatched"}
    return {"id": item_id, "state": action_key_state(queue, item_id, state)}


def set_action_key_state(queue, key, state):
    """Record what the queue did with the item that holds an action key.

    The record is written back into the queue, so a record that carried
    only an item id keeps the state from now on.
    """
    record = action_key_record(queue, key)
    if record is None:
        return
    queue.setdefault(ACTION_KEYS, {})[key] = {"id": record["id"], "state": state}


def release_action_key(queue, item):
    """Give an action key back when its item leaves the queue unsent.

    An item that gave up, that was refused as undispatchable, or that was
    dropped by hand never reached the thread, so the board action is still
    open and the same key may be queued again.
    """
    key = item.get("actionKey")
    if key:
        (queue.get(ACTION_KEYS) or {}).pop(key, None)


def action_key_state(queue, item_id, state=None):
    """What the queue is doing with the item that holds an action key.

    A key is held from the moment the item is queued, through the
    reservation the dispatcher takes while it starts, and after the item
    is gone from the queue, so the same board action is never sent twice.
    """
    if state in {"queued", "reserved", "dispatched"}:
        return state
    if item_id is not None:
        wanted = str(item_id)
        if any(str(item.get("id")) == wanted for item in queue.get("items", [])):
            return "queued"
        if wanted in (queue.get("reserved") or {}):
            return "reserved"
    return "dispatched"


def cmd_start(a):
    args = json.loads(a.args)
    tool = a.tool or tool_for(args)
    if tool not in DISPATCHABLE_TOOLS:
        die(f"refused: {tool_refusal(tool)}")
    if a.title and tool == "t3_thread_launch":
        args.setdefault("title", a.title)
    if tool == "t3_thread_launch":
        task_type = args.get("taskType")
        requested = args
        args, refusal = with_model(args)
        if refusal:
            die(refusal)
        if not requested.get("modelSelection"):
            args = requested
        if wants_rules(args, task_type):
            try:
                read_rules()
            except RuntimeError as e:
                die(f"refused: {e}")
    # The thread list is read before the writer lock is taken: a slow t3 call
    # under it would hold every other start for its length. The started-message
    # records it speaks for are snapshotted first, because a record added since
    # then cannot be judged by it.
    started_before = started_snapshot(load())
    live = live_thread_ids() if started_before else None
    with Lock(True):
        queue = load()
        key = (getattr(a, "action_key", None) or "").strip()
        if key:
            record = action_key_record(queue, key)
            if record is not None:
                where = (f"as coordq #{record['id']}" if record.get("id") is not None
                         else "with an unreadable queue item")
                die(f"refused: the action key {key} is already "
                    f"{action_key_state(queue, record.get('id'), record.get('state'))} "
                    f"{where}")
        explicit = a.title or args.get("title") or ""
        item = {"id": queue["next"], "tool": tool, "args": args,
                "title": explicit or args.get("threadId", ""), "messageTitle": explicit,
                "priority": a.priority}
        title, target = message_identity(item)
        if prune_messages(queue, live):
            save(queue)
        duplicate = duplicate_message(queue, title, target, live,
                                      started_before if started_before else None)
        if duplicate:
            die(f"refused: duplicate message {title!r} for {target or 'a new thread'}: "
                f"already {duplicate[0]} as coordq #{duplicate[1]}")
        if key:
            item["actionKey"] = key
        queue["next"] += 1
        queue["items"].append(item)
        if key:
            queue.setdefault(ACTION_KEYS, {})[key] = {"id": item["id"], "state": "queued"}
        # A gate request takes its head with it, so gatekeep does not queue
        # a second gate for the same head.
        request_id = str(args.get("clientRequestId") or "")
        if request_id.startswith("gate:"):
            heads = queue.setdefault("gatedHeads", {})
            if request_id in heads:
                die(f"refused: a gate for this head is already recorded as "
                    f"{gate_label(gate_state(heads[request_id]))}")
            heads[request_id] = {"id": item["id"], "retries": 0, "at": None, "givenUp": False}
        save(queue)
        drain()
        if any(i["id"] == item["id"] for i in load()["items"]):
            print(f"queued #{item['id']}")
        else:
            print(f"started #{item['id']}")


def last_refill():
    """The time of the last refill attempt, or None when there was none."""
    try:
        with open(path("refill.last")) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return None


def mark_refill():
    """Record a refill attempt. A dry run records it too, so a diagnostic
    cannot be mistaken for a free refill window."""
    tmp = path("refill.last.tmp")
    with open(tmp, "w") as f:
        f.write(str(time.time()))
    os.replace(tmp, path("refill.last"))


def search_stage_todo(owner):
    """The open stage:todo issues of one owner, oldest first."""
    run = gh_gateway.run(["gh", "search", "issues", "--owner", owner, "--state", "open",
                          "--label", STAGE, "--sort", "created", "--order", "asc",
                          "--limit", str(REFILL_LIMIT),
                          "--json", "repository,number,title,createdAt,updatedAt,labels"],
                         timeout=40, limit=FLOOR)
    if run.returncode:
        raise RuntimeError(f"GitHub search failed for {owner}: {run.stderr.strip()[:200]}")
    return json.loads(run.stdout)


def stage_todo(candidate):
    """True when the ticket carries the one stage label the board means.

    A ticket whose stage label is spelled another way, or that carries two
    stage labels, is one the ticket CLI refuses, so the scan skips it.
    """
    names = [label["name"] if isinstance(label, dict) else str(label)
             for label in candidate.get("labels") or []]
    return [name for name in names if name.startswith("stage:")] == [STAGE]


def live_lane_repositories(config):
    occupied = set()
    try:
        with open(path("dispatch-receipts.json")) as f:
            receipts = json.load(f)
    except FileNotFoundError:
        receipts = {}
    cursor = None
    while True:
        args = {"allProjects": True, "limit": 100, "statuses": LIVE_STATUSES,
                "includeSubagents": False}
        if cursor is not None:
            args["cursor"] = cursor
        code, out = call("t3_thread_list", args)
        if code:
            raise RuntimeError("cannot read live lane threads")
        result = json.loads(out)
        for thread in result["threads"]:
            identities = [key for key, value in receipts.items()
                          if value == thread["threadId"]]
            identities.append(str(thread.get("clientRequestId") or ""))
            for repo, settings in config["repos"].items():
                title = str(thread.get("title") or "")
                prefix = settings.get("key", "") + "-"
                if (any(re.match(r"(?:ticket|gate):" + re.escape(repo) + r"#\d+:", key)
                        for key in identities)
                        or (settings.get("key") and title.startswith(prefix))):
                    occupied.add(repo)
        next_cursor = result.get("nextCursor")
        if next_cursor is None:
            return occupied
        if cursor is not None and next_cursor <= cursor:
            raise RuntimeError("live lane pagination did not advance")
        cursor = next_cursor


def lane_candidates(rows, occupied):
    def order(row):
        names = [label["name"] if isinstance(label, dict) else str(label)
                 for label in row.get("labels") or []]
        priorities = [int(name.split(":")[1]) for name in names
                      if re.fullmatch(r"priority:\d+", name)]
        section = re.search(r"(?im)^## Blocked by\s*\n(.*?)(?=^## |\Z)",
                            row.get("body") or "", re.S)
        blockers = [int(n) for n in re.findall(r"#(\d+)", section.group(1))] if section else []
        return (min(priorities, default=999), tuple(blockers), row["number"],
                row["repository"]["nameWithOwner"])

    busy = set(occupied)
    for row in rows:
        names = [label["name"] if isinstance(label, dict) else str(label)
                 for label in row.get("labels") or []]
        if "stage:started" in names:
            busy.add(row["repository"]["nameWithOwner"])
    selected = []
    for row in sorted(rows, key=order):
        repo = row["repository"]["nameWithOwner"]
        if repo not in busy and stage_todo(row):
            selected.append(row)
            busy.add(repo)
    return selected


def board_candidates():
    with open(TICKETS_CONFIG) as f:
        cfg = json.load(f)
    occupied = live_lane_repositories(cfg)
    rows = []
    for repo in cfg["repos"]:
        run = gh_gateway.run(["gh", "api", "--paginate", "--slurp",
                              f"repos/{repo}/issues?state=open&per_page=100"],
                             timeout=40, limit=FLOOR)
        if run.returncode:
            raise RuntimeError(f"open issue snapshot failed for {repo}")
        for page in json.loads(run.stdout):
            for row in page:
                if "pull_request" not in row:
                    rows.append({**row, "repository": {"nameWithOwner": repo},
                                 "updatedAt": row["updated_at"]})
    return lane_candidates(rows, occupied)


def ticket_start(repo, number, dry_run):
    """Run the ticket CLI on one ticket. A refused ticket exits non-zero and
    changes nothing, so a refusal is a skip and not a start. The ticket CLI
    exits 2 for a refusal and for a usage error, and 1 for a failed check,
    so the exit code alone does not say which one it was; `is_refusal` reads
    the answer out of the output.

    The ticket CLI starts the queue entry itself, so a timeout has to take
    that child with it: the whole process group is killed, or the start
    keeps running after the dispatcher gave up on it."""
    command = [TICKET_BIN, "start", f"{repo}#{number}"]
    if dry_run:
        command.append("--dry-run")
    try:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   text=True, start_new_session=True)
    except OSError as e:
        return 1, f"ticket start could not run: {e}"
    try:
        stdout, stderr = process.communicate(timeout=240)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            process.kill()
        process.communicate()
        return 1, "ticket start timed out after 240s"
    return process.returncode, ((stdout or "") + (stderr or "")).strip()


def one_line(text):
    """The output of the ticket CLI on one line, so a log entry stays a line."""
    return " ".join(text.split())


def is_refusal(code, out):
    """True when the ticket CLI refused the ticket. The exit code is not
    enough: 2 also covers a usage error, and 1 covers a failed check."""
    if code != REFUSE_CODE:
        return False
    return any(line.startswith(REFUSE_PREFIX) for line in out.splitlines())


def load_refill_state():
    """The refusals of the earlier passes and the count of the passes."""
    try:
        with open(path(REFILL_STATE_FILE)) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    if not isinstance(state, dict):
        state = {}
    if not isinstance(state.get("refusals"), dict):
        state["refusals"] = {}
    try:
        state["passes"] = int(state.get("passes") or 0)
    except (TypeError, ValueError):
        state["passes"] = 0
    return state


def save_refill_state(state):
    tmp = path(REFILL_STATE_FILE + ".tmp")
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1)
    os.replace(tmp, path(REFILL_STATE_FILE))


def candidate_key(candidate):
    return f"{candidate['repository']['nameWithOwner']}#{candidate['number']}"


def candidate_state(candidate):
    """The state of a candidate as the board shows it: when it last changed,
    what it is called and which labels it carries. A refusal is worth
    retrying when this differs from the state the refusal was made on."""
    labels = sorted(label["name"] if isinstance(label, dict) else str(label)
                    for label in candidate.get("labels") or [])
    return json.dumps([candidate.get("updatedAt"), candidate.get("title"), labels])


def unchanged_refusal(refusals, key, state, now):
    """The refusal of an earlier pass for this candidate, when the candidate
    has not changed since and the refusal is not older than the retry age."""
    prior = refusals.get(key)
    if not isinstance(prior, dict) or prior.get("state") != state:
        return None
    try:
        age = now - float(prior.get("at") or 0)
    except (TypeError, ValueError):
        return None
    if age < 0 or age > REFILL_RETRY_AGE:
        return None
    return prior


def used_slots():
    """The live threads plus the queued items, or None when the count is
    unreadable. The queue counts, because a queued item already holds a
    slot."""
    n = live()
    if n is None:
        return None
    return n + len(load()["items"])


def refill(a):
    """Fill free slots from the board.

    The refill runs when live plus queued work is below the
    cap, and at most once per REFILL_INTERVAL seconds. Every candidate is a
    ticket the ticket CLI may refuse, and a refusal starts nothing, so the
    scan moves on to the next candidate.

    A refused candidate is recorded with its reason, and the next pass skips
    it while the board shows the same state. The scan therefore walks past
    the tickets that cannot start and reaches the tickets further down the
    board, which the old first-REFILL_MAX window never did.
    """
    with Lock(False, "refill.lock") as lock:
        if lock is None:
            log("refill skipped: another refill is running")
            return
        n = used_slots()
        if n is None:
            log("refill skipped: cannot read the live thread count")
            return
        limit = cap()
        if n >= limit:
            log(f"refill skipped: at cap {n}/{limit}")
            return
        last = last_refill()
        if last is not None and time.time() - last < REFILL_INTERVAL:
            log(f"refill skipped: throttled, the last refill was {int(time.time() - last)}s ago")
            return
        mark_refill()
        try:
            candidates = board_candidates()
        except (OSError, RuntimeError, ValueError, KeyError) as e:
            log(f"refill stopped: {e}")
            return
        if not candidates:
            log("refill stopped: the board has no open stage:todo ticket")
            return
        deadline = time.time() + REFILL_BUDGET
        state = load_refill_state()
        pass_no = state["passes"] + 1
        refusals = state["refusals"]
        filled = 0
        attempted = 0
        skipped = 0
        examined = 0
        seen = {candidate_key(candidate) for candidate in candidates}
        pass_refusals = []
        for candidate in candidates:
            if attempted >= REFILL_MAX:
                log(f"refill stopped: the pass attempt budget of {REFILL_MAX} is spent")
                break
            if time.time() > deadline:
                log("refill stopped: the refill budget is spent")
                break
            key = candidate_key(candidate)
            board_state = candidate_state(candidate)
            prior = unchanged_refusal(refusals, key, board_state, time.time())
            if prior:
                skipped += 1
                examined += 1
                continue
            used = used_slots()
            if used is None:
                log("refill stopped: cannot read the live thread count")
                break
            # Every start of this refill took a slot, and the count can lag
            # behind it, so the slots this refill filled count too. The higher
            # of the two counts wins, so a slow count never starts too many.
            used = max(used, n + filled)
            if used >= limit:
                log(f"refill stopped: the slots are full ({used}/{limit})")
                break
            repo = candidate["repository"]["nameWithOwner"]
            number = candidate["number"]
            code, out = ticket_start(repo, number, a.dry_run)
            attempted += 1
            examined += 1
            if code != 0:
                if is_refusal(code, out):
                    refusals[key] = {"state": board_state, "reason": one_line(out)[:200],
                                     "at": time.time(), "pass": pass_no}
                    pass_refusals.append({"key": key, "reason": one_line(out)[:200]})
                    log(f"refill refused {key}: {one_line(out)[:200]}")
                else:
                    # A failure of the check is not a refusal of the ticket.
                    # It is not recorded, so the next pass tries the ticket
                    # again instead of hiding it for the retry age.
                    log(f"refill could not check {key}: {one_line(out)[:200]}")
                continue
            filled += 1
            refusals.pop(key, None)
            if a.dry_run:
                log(f"refill would start {key}")
            elif out.startswith("queued"):
                log(f"refill queued {key}: {one_line(out)[:120]}")
            else:
                log(f"refill started {key}")
        # A candidate that left the board keeps no refusal, so the file holds
        # the state of the board and nothing else.
        for key in [k for k in refusals if k not in seen]:
            del refusals[key]
        # A dry run changes nothing, so it writes no state and counts no
        # pass. A diagnostic must not hide a ticket from the next real pass.
        if not a.dry_run:
            state["passes"] = pass_no
            state["refusals"] = refusals
            state["last_pass"] = {"pass": pass_no, "at": time.time(), "examined": examined,
                                  "skipped": skipped, "attempted": attempted, "started": filled,
                                  "refusals": pass_refusals}
            save_refill_state(state)
        log(f"refill pass {pass_no}: examined {examined} candidate(s) of {len(candidates)}, "
            f"skipped {skipped} unchanged refusal(s), attempted {attempted}, started {filled}")


def safe_refill(a):
    try:
        refill(a)
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as e:
        log(f"refill failed: {e}")


def cmd_dispatch(a):
    with open(path("dispatch.last"), "w") as f:
        f.write(str(int(time.time())))
    if a.dry_run:
        log("dry run: the queue is left alone")
        safe_refill(a)
        return
    with Lock(False) as lock:
        if lock is None:
            log("lock held by another run, skipping")
            return
        drain()
    safe_refill(a)


def cmd_create(a):
    args = json.loads(a.args)
    if args.get("message"):
        die("refused: create is for idle threads, this has a message. Use coordq start.")
    args, refusal = with_model(args)
    if refusal:
        die(refusal)
    if "projectId" not in args and not args.get("workspaceStrategy"):
        args["scratch"] = True
    code, out = call("t3_thread_launch", args)
    print(out)
    sys.exit(code)


def cmd_list(a):
    for i in sorted(load()["items"], key=lambda i: (-i["priority"], i["id"])):
        print(f"#{i['id']} p{i['priority']} {i['tool']} {i['title']}" + (f" (failed {i['attempts']}x)" if i.get("attempts") else ""))


def cmd_drop(a):
    with Lock(True):
        queue = load()
        kept = [i for i in queue["items"] if i["id"] != a.id]
        if len(kept) == len(queue["items"]):
            die(f"no queue item #{a.id}")
        for item in queue["items"]:
            if item["id"] == a.id:
                # The item never reached the thread, so the board action it
                # carried is still open.
                release_action_key(queue, item)
        queue["items"] = kept
        save(queue)
    print(f"dropped #{a.id}")


def cmd_status(a):
    # A reservation outlives its launch when nothing reconciles it, so the read
    # reconciles before it reports: a slot a finished launch no longer needs
    # never shows as held. The thread list and the launch statuses are read
    # before the writer lock is taken, because a t3 call under the lock would
    # hold every start for its length, and the reservations they speak for are
    # snapshotted first, so a launch reserved after the read is left alone.
    before = load()
    snapshot = reservation_snapshot(before)
    live_ids = active_thread_ids() if snapshot else None
    statuses = launch_statuses(before, live_ids) if live_ids is not None else {}
    stuck = [f"{pr} {value['head']} {value['reason']}"
             for pr, value in sorted(load_counts().items())
             if value.get("count", 0) >= STUCK_COUNT]
    threads = live()
    # A start can enqueue between a read and a write, and saving an older
    # snapshot would drop the item it just queued. So the queue is read,
    # reconciled and written under the same lock the start takes.
    with Lock(True):
        queue = load()
        if live_ids is not None:
            try:
                reconcile_reservations(queue, live_ids, statuses, snapshot)
            except (RuntimeError, ValueError, KeyError, TypeError, OSError) as e:
                log(f"status left the reservations alone: {e}")
            queue = load()
        report = {"cap": cap(), "live": threads, "reserved": queue.get("reserved", {}),
                  "queued": len(queue["items"]), "failed": queue.get("failed", []),
                  "stuck": stuck, "tickAlarm": tick_alarm()}
    print(json.dumps(report))



def gh_json(endpoint, optional=True, fresh=False):
    """Read one endpoint as JSON.

    `optional` is what the floor applies to: the polling reads that run on
    a timer, and not an explicit `gate` an operator asked for."""
    run = gh_gateway.run(["gh", "api", "--paginate", "--slurp", endpoint],
                         timeout=40, limit=FLOOR if optional else None,
                         fresh=fresh)
    if run.returncode:
        raise RuntimeError(f"GitHub request failed: {endpoint}")
    pages = json.loads(run.stdout)
    rows = []
    for page in pages if isinstance(pages, list) else [pages]:
        if isinstance(page, list):
            rows.extend(page)
        else:
            rows.append(page)
    return rows


def load_receipts():
    try:
        with open(path("dispatch-receipts.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def issue_key(repo, number):
    """The ticket key of an issue, taken from its title ('MO-233 · ...').

    The key number is not the issue number: issue 226 of mac-ops is the
    ticket MO-233.
    """
    rows = gh_json(f"repos/{repo}/issues/{number}")
    if not rows:
        return None
    match = TITLE_KEY.match(rows[0].get("title") or "")
    return match.group(0) if match else None


def builder_thread_for_key(key):
    code, out = call("t3_thread_list", {"allProjects": True, "titleContains": f"{key} ·", "limit": 100})
    if code:
        raise RuntimeError(f"cannot list the threads of {key}")
    threads = [t for t in json.loads(out).get("threads", [])
               if not REVIEW_TITLE.search(t.get("title") or "")]
    if not threads:
        return None
    newest = max(threads, key=lambda t: (t.get("createdAt") or "", t.get("threadId") or ""))
    return newest.get("threadId")


def builder_thread_for_issue(repo, issue):
    """The builder thread of an issue, found through the ticket key.

    A build that no `ticket start` receipt covers has no receipt to read.
    """
    key = issue_key(repo, issue)
    if not key:
        return None
    return builder_thread_for_key(key)


def router_chain(route):
    """The fallback chain of a pi task route, in the order the router tries it."""
    try:
        with open(ROUTER_SOURCE) as f:
            source = f.read()
    except OSError:
        return None
    routes = re.search(r"const ROUTES: Record<string, string\[\]> = \{(.*?)\n\};", source, re.S)
    name = route.removeprefix("task/")
    chain = re.search(r"^\s*" + re.escape(name) + r":\s*\[([^\]]*)\]", routes[1], re.M) if routes and route.startswith("task/") else None
    if not chain:
        return None
    try:
        entries = json.loads("[" + chain[1].rstrip().rstrip(",") + "]")
    except ValueError:
        return None
    if not entries or not all(isinstance(m, str) and "/" in m for m in entries):
        return None
    return entries


def read_builder_thread(thread_id):
    code, out = call("t3_thread_read", {"threadId": thread_id, "limit": 1, "runLimit": 5})
    if code:
        raise RuntimeError("cannot read builder run")
    result = json.loads(out)
    return result.get("thread", {}), result.get("recentRuns", [])


def is_anthropic(model):
    lowered = model.lower()
    return "claude" in lowered or "anthropic" in lowered


def builder_models(thread, runs):
    """The models the builder run executed.

    The run reports the model it executed. A run that reports none gives no
    evidence, and a router route is no evidence either: its chain says what
    the router would run, not what it ran. A block that expired since the
    build hides which model the router fell back to, so a route that can run
    an Anthropic model gives no evidence at all.
    """
    models = executed_models(runs[0]) if runs else []
    if models:
        return models
    instance, stored = thread.get("providerInstanceId"), thread.get("model")
    if instance == "router" or (isinstance(stored, str) and stored.startswith("task/")):
        entries = router_chain(stored if isinstance(stored, str) else "")
        if not entries or any(is_anthropic(m) for m in entries):
            return []
        return entries
    if not isinstance(stored, str) or not stored or not instance:
        return []
    return ["claude" if instance == "claudeAgent" else stored]


def reviewer_model(models):
    """The first unblocked review model of a vendor other than the builder's, or None."""
    reviewers = model_list.reviewers(models)
    return reviewers[0]["selection"] if reviewers else None


def quota_failure(value):
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except ValueError:
            return False
    if not isinstance(value, dict):
        return False
    if "thread" in value:
        thread = value.get("thread") or {}
        runs = value.get("recentRuns") or []
        failure = next((run for run in runs
                        if run.get("runId") == thread.get("latestRunId")), thread)
        if failure.get("status") != "failed":
            return False
    else:
        failure = value
    error = failure.get("error")
    if isinstance(error, dict):
        text = " ".join(str(error.get(field) or "") for field in ("code", "message"))
    elif isinstance(error, str):
        text = error
    else:
        return False
    return any(word in text.lower() for word in (
        "spend limit", "usage limit", "quota exhausted", "quota exceeded",
        "insufficient_quota", "exceeded your current quota"))


def fallback_reviewer(queue, key, current, models=()):
    listed = [model_list.identity(e["selection"]) for e in model_list.entries("review")]
    if model_list.identity(current) not in listed:
        return None
    later = listed[listed.index(model_list.identity(current)) + 1:]
    tried = queue.setdefault("gateReviewers", {}).setdefault(key, [])
    for entry in model_list.reviewers(models):
        identity = model_list.identity(entry["selection"])
        if identity in later and identity not in tried:
            tried.append(identity)
            return entry["selection"]
    return None


def failed_gate_reviewer(queue, key, current, failure, models=()):
    selection = fallback_reviewer(queue, key, current, models)
    if selection is not None:
        return selection
    state = queue.setdefault("gateInfrastructure", {}).setdefault(key, {"retries": 0})
    state.update(status="needs-you", reason="Gate reviewer chain exhausted")
    return None


def gate_changed_count(repo, number):
    """The pull request's own changed-file count, or None when unreadable.

    The count is what tells a complete file list from a capped one, so a list
    read without it is deferred rather than trusted. Every read here is
    paginated and slurped, so one pull request arrives as the single row of
    a list: the count is read from that row, never from the list itself.
    """
    try:
        rows = gh_json(f"repos/{repo}/pulls/{number}")
    except (RuntimeError, ValueError, subprocess.SubprocessError):
        return None
    pull = rows[0] if isinstance(rows, list) and rows else rows
    count = pull.get("changed_files") if isinstance(pull, dict) else None
    return count if isinstance(count, int) else None


BASE_PIN_TTL = 60
_base_pins = {}


def pinned_base(repo, base):
    """The commit a base branch points at, read once a minute per branch.

    A compare that names the branch moves with the branch and can never be
    cached. A compare of two commits cannot move, so the branch is pinned to
    its commit first and the compare is kept on disk.
    """
    pin = _base_pins.get((repo, base))
    if pin and time.time() - pin[1] < BASE_PIN_TTL:
        return pin[0]
    rows = gh_json(f"repos/{repo}/git/ref/heads/{base}")
    sha = ((rows[0] if rows else {}).get("object") or {}).get("sha")
    if not isinstance(sha, str) or not sha:
        raise RuntimeError(f"cannot read the commit of {repo} {base}")
    _base_pins[(repo, base)] = (sha, time.time())
    return sha


def gate_prompt_state(repo, number, changed_files=None, base=None, head=None, attempts=2):
    """HOLD, CLEAR or UNKNOWN for the paths one pull request changed.

    The paths are classified from the merge base and the head the gate
    pinned, never from the pull request's current file list. A file list is
    read by pull-request number, so it describes whatever head GitHub holds
    at that moment: a code-only revision with the same file count could
    clear a prompt-changing head, and `--match-head-commit` still merges
    when the prompt head is restored before the merge. The trees of the two
    pinned commits cannot move, so their diff is the answer. A read GitHub
    cannot give is retried, then reported UNKNOWN, because CLEAR is what
    authorizes the merge a gate brief orders.

    A caller with no pinned pair has only the file list; that list is read
    and a truncated or short one is UNKNOWN, never CLEAR.
    """
    if base and head:
        try:
            pinned = pinned_base(repo, base)
        except RuntimeError:
            return prompt_paths.UNKNOWN
        return prompt_paths.scan_diff(gh_json, repo, pinned, head, attempts)
    count = changed_files if isinstance(changed_files, int) else gate_changed_count(repo, number)
    for _ in range(max(1, attempts)):
        try:
            pages = gh_json(f"repos/{repo}/pulls/{number}/files?per_page=100")
        except (RuntimeError, ValueError, subprocess.SubprocessError):
            continue
        files = pages
        if not isinstance(files, list):
            continue
        if not prompt_paths.list_is_complete(files, count):
            continue
        return prompt_paths.prompt_scan(prompt_paths.entries_paths(files))
    return prompt_paths.UNKNOWN


# A gate request the queue must not build: the changed files could not be read,
# so the brief could order a merge of prompt text. The caller defers it.
DEFER = object()


def gate_args(settings, repo, issue, number, head, publisher, model, proof=None, proof_path=None, proof_state=None, prompt=False, base="main"):
    """The launch arguments of the gate for one pull request.

    One brief for every gate: the queue's own gatekeeper and the tick's
    backstop build the same request here, so a gate reads the same
    whichever way it was queued."""
    key = f"gate:{repo}#{number}:{head}"
    from gate_policy import build_gate_brief
    message = build_gate_brief(settings, repo, issue, number, head, publisher, base=base,
                               proof=proof, proof_path=proof_path, proof_state=proof_state,
                               prompt=prompt)
    return {"projectId": settings["projectId"], "title": f"{settings['key']}-{issue if issue is not None else 'PR'} review #{number} {head[:8]}",
            "taskType": "review", "modelSelection": model, "runtimeMode": "full-access", "workspaceStrategy": {"type": "root"},
            "clientRequestId": key, "message": message}


def gate_proof(settings, repo, issue, head):
    """The proof file a pull request carries, and the path it was read from.

    The gate reads the record of the checks the builder ran. A pull
    request that carries no proof file reads as none, never as a pass, and
    a read that failed reads as unproven, never as none.
    """
    import proof_file
    path = proof_file.path_for(settings.get("key"), issue)
    state, text = proof_file.fetch(repo, path, head)
    return state, text, path


def gate_candidates(config):
    """The gate candidates and the skips of one gatekeep run.

    Every event carries the pull request it belongs to, so the caller can
    count the skips of a pull request and report the ones it cannot gate.
    """
    login_run = gh_gateway.run(["gh", "api", "user", "--jq", ".login"],
                               timeout=40, limit=FLOOR)
    if login_run.returncode:
        raise RuntimeError("cannot identify authenticated GitHub user")
    login = login_run.stdout.strip()
    receipts = load_receipts()
    skipped = set()
    noted = set()
    for repo, settings in config["repos"].items():
        for pr in gh_json(f"repos/{repo}/pulls?state=open&per_page=100", fresh=True):
            if pr["draft"]:
                continue
            head, number = pr["head"]["sha"], pr["number"]
            body = pr.get("body") or ""
            refs = re.findall(r"\bRefs #(\d+)\b", body)
            for issue in dict.fromkeys(refs):
                ledger = []
                for comment in gh_json(f"repos/{repo}/issues/{issue}/comments?per_page=100"):
                    if comment["user"]["login"] != login:
                        continue
                    for match in re.finditer(r"<!-- coordinator-ticket (\{.*?\}) -->", comment["body"]):
                        ledger.append(json.loads(match[1]))
                completed = [e for e in ledger if e.get("kind") == "receipt"]
                if not completed:
                    continue
                receipt = max(completed, key=lambda e: e["attempt"])
                intents = [e for e in ledger if e.get("kind") == "intent"]
                if intents and max(e["attempt"] for e in intents) != receipt["attempt"]:
                    continue
                # The receipt names the builder run. A build that no receipt
                # covers is found through the ticket key of the issue.
                thread_id = receipts.get(receipt["requestId"]) or builder_thread_for_issue(repo, issue)
                if not thread_id:
                    if (repo, number) not in skipped:
                        print(f"skip {repo}#{number}: builder run not found", file=sys.stderr)
                        skipped.add((repo, number))
                        yield {"kind": "skip", "pr": f"{repo}#{number}", "head": head,
                               "reason": "builder run not found"}
                    continue
                thread, runs = read_builder_thread(thread_id)
                models = builder_models(thread, runs)
                if models:
                    model = reviewer_model(models)
                    if model is None:
                        yield {"kind": "skip", "pr": f"{repo}#{number}", "head": head,
                               "reason": "every gate reviewer of a vendor other than the builder's is blocked"}
                        continue
                else:
                    # A build whose executed model is not known is still
                    # gated, on the backstop reviewer. The check below
                    # still decides whether the pull request is gated.
                    model = backstop_model(thread, runs)
                    if model is None:
                        yield {"kind": "skip", "pr": f"{repo}#{number}", "head": head,
                               "reason": "every gate reviewer is blocked"}
                        continue
                    if (repo, number) not in noted:
                        print(f"backstop {repo}#{number}: executed model unavailable, reviewer "
                              f"{model['instanceId']} {model['model']}", file=sys.stderr)
                        noted.add((repo, number))
                # The gatekeep scan is optional polling: the floor applies.
                statuses = gh_json(f"repos/{repo}/commits/{head}/statuses?per_page=100")
                checks = [x for x in statuses if x["context"] == "srw/agent-check"]
                publisher = settings.get("macPublisher", repo == "shyamsivakumar/strategy-replay-workbench") or bool(checks)
                if publisher:
                    passed = bool(checks) and checks[0]["state"] == "success"
                else:
                    passed = f"Builder check: PASS {head}" in body.splitlines()
                if not passed:
                    continue
                key = f"gate:{repo}#{number}:{head}"
                proof_state, proof, proof_path = gate_proof(settings, repo, issue, head)
                prompt = gate_prompt_state(repo, number, pr.get("changed_files"),
                                           (pr.get("base") or {}).get("ref"), head)
                if prompt == prompt_paths.UNKNOWN:
                    print(f"skip {repo}#{number}: changed files unreadable, gate deferred",
                          file=sys.stderr)
                    yield {"kind": "skip", "pr": f"{repo}#{number}", "head": head,
                           "reason": "changed-file list unreadable, gate deferred"}
                    break
                yield {"kind": "candidate", "pr": f"{repo}#{number}", "head": head, "key": key,
                       "builderModels": models,
                       "args": gate_args(settings, repo, issue, number, head, publisher, model,
                                         proof=proof, proof_path=proof_path, proof_state=proof_state,
                                         prompt=prompt == prompt_paths.HOLD,
                                         base=(pr.get("base") or {}).get("ref") or "main")}
                break
            else:
                found = gate_request(repo, pr, settings, config, receipts, login)
                if found is DEFER:
                    print(f"skip {repo}#{number}: changed files unreadable, gate deferred",
                          file=sys.stderr)
                    yield {"kind": "skip", "pr": f"{repo}#{number}", "head": head,
                           "reason": "changed-file list unreadable, gate deferred"}
                    continue
                if found:
                    key, args, models = found
                    yield {"kind": "candidate", "pr": f"{repo}#{number}", "head": head,
                           "key": key, "builderModels": models, "args": args}


def executed_models(value):
    if isinstance(value, dict):
        found = [value["executedModel"]] if isinstance(value.get("executedModel"), str) else []
        return found + [m for child in value.values() for m in executed_models(child)]
    if isinstance(value, list):
        return [m for child in value for m in executed_models(child)]
    return []


def cmd_gatekeep(a):
    with open(a.config) as f:
        config = json.load(f)
    # The gate is an optional read: below the shared floor it waits for the
    # quota instead of spending the last calls and stalling every caller.
    remaining = gh_gateway.remaining_or_none()
    if remaining and min(remaining.values()) < FLOOR:
        print(f"gatekeep skipped: below the API floor {FLOOR} {remaining}", flush=True)
        return
    try:
        counts = load_counts()
        seen = set()
        stuck = []
        attempted = set()
        for event in gate_candidates(config):
            if event["kind"] == "skip":
                pr = event["pr"]
                previous = counts.get(pr)
                count = previous["count"] + 1 if previous and previous.get("head") == event["head"] else 1
                counts[pr] = {"head": event["head"], "count": count, "reason": event["reason"]}
                seen.add(pr)
                if count >= STUCK_COUNT:
                    stuck.append((pr, event["head"], event["reason"]))
                continue
            counts.pop(event["pr"], None)
            key, args = event["key"], event["args"]
            with Lock(True):
                queue = load()
                heads = queue.setdefault("gatedHeads", {})
                if key in attempted:
                    continue
                state = gate_state(heads.get(key))
                retries = 0
                if key in heads:
                    # A head whose retries ran out is left alone until its
                    # head changes, so a reviewer that cannot run is not
                    # relaunched on every run.
                    if state["givenUp"]:
                        continue
                    receipts = load_receipts()
                    thread_id = receipts.get(key)
                    if not thread_id:
                        continue
                    code, out = call("t3_thread_read", {"threadId": thread_id, "maxCharsPerItem": 20000})
                    if code:
                        continue
                    data = json.loads(out)
                    thread = data.get("thread") or {}
                    texts = [i.get("text") or "" for i in (data.get("items") or [])
                             if i.get("type") == "assistant_message"]
                    report = texts[-1].rstrip() if texts else ""
                    if thread.get("status") not in {"failed", "interrupted", "completed"}:
                        continue
                    if report.endswith(("VERDICT: PASS", "VERDICT: FAIL")):
                        continue
                    retries = state["retries"] + 1
                    if retries > GATE_RETRY_LIMIT:
                        print(f"gave up {key} after {state['retries']} retries without a verdict",
                              flush=True)
                        if not a.dry_run:
                            heads[key] = {**state, "givenUp": True}
                            save(queue)
                        continue
                    if state["retries"] and time.time() - float(state["at"] or 0) < GATE_RETRY_BACKOFF:
                        continue
                    current = {"instanceId": thread.get("providerInstanceId"),
                               "model": thread.get("model")}
                    model = failed_gate_reviewer(queue, key, current, data, event.get("builderModels", []))
                    if model is None:
                        if not a.dry_run:
                            heads[key] = {**state, "givenUp": True}
                            save(queue)
                        continue
                    args["modelSelection"] = model
                    args["clientRequestId"] = key + ":" + model["model"] + ":retry"
                    print(f"regating {event['pr']}: {event['head'][:8]} (gate died without a verdict)", flush=True)
                    if not a.dry_run:
                        del heads[key]
                        save(queue)
                        del receipts[key]
                        receipt_path = path("dispatch-receipts.json")
                        with open(receipt_path + ".tmp", "w") as f:
                            json.dump(receipts, f)
                        os.replace(receipt_path + ".tmp", receipt_path)
                attempted.add(key)
                print(("would queue " if a.dry_run else "queued ") + key
                      + " reviewer " + args["modelSelection"]["instanceId"] + " " + args["modelSelection"]["model"],
                      flush=True)
                if a.dry_run:
                    continue
                item = {"id": queue["next"], "tool": "t3_thread_launch", "args": args,
                        "title": args["title"], "priority": 5000, "builderModels": event.get("builderModels", [])}
                queue["next"] += 1
                queue["items"].append(item)
                heads[key] = {"id": item["id"], "retries": retries,
                              "at": time.time() if retries else None, "givenUp": False}
                save(queue)
        write_counts(counts, seen, stuck, a.dry_run)
    except gh_gateway.ApiBudgetExhausted as e:
        # The quota fell below the floor mid-run: the gate is optional, so
        # this run stops where it is instead of spending the last calls.
        print(f"gatekeep skipped: {e}", flush=True)
    except (RuntimeError, ValueError, KeyError, OSError, subprocess.TimeoutExpired) as e:
        die(f"gatekeep stopped: {e}")


def load_counts():
    counts = load().get("gatekeepSkips")
    return counts if isinstance(counts, dict) else {}


def write_counts(counts, seen, stuck, dry_run):
    """Keep the skip counts and write the report of the stuck pull requests.

    The file is written from scratch every run, so a pull request that is
    gated or gone leaves it.
    """
    for pr, head, reason in stuck:
        print(f"stuck {pr} {head} {reason}", file=sys.stderr)
    if dry_run:
        return
    kept = {pr: value for pr, value in counts.items() if pr in seen}
    with Lock(True):
        queue = load()
        queue["gatekeepSkips"] = kept
        # The reviewers tried for a head are kept while the head is in the
        # queue, so a fallback is not retried on every run. A head the queue
        # no longer holds gives up its history.
        queue["gateReviewers"] = {key: value
                                  for key, value in (queue.get("gateReviewers") or {}).items()
                                  if key in (queue.get("gatedHeads") or {})}
        save(queue)
    lines = [f"{pr} {head} {reason}" for pr, head, reason in sorted(stuck)]
    tmp = path(STUCK_FILE + ".tmp")
    with open(tmp, "w") as f:
        f.write("".join(line + "\n" for line in lines))
    os.replace(tmp, path(STUCK_FILE))


def cmd_fix(a):
    """Send a failed gate's findings back to the builder of one pull request.

    The gate's own report is the finding, so this reads it from the gate
    thread and sends it to the thread that built the pull request. The
    builder thread is the one the coordinator started for the ticket, so
    the findings go back to the builder that holds the work."""
    repo, number = parse_ref(a.ref)
    try:
        with open(path("dispatch-receipts.json")) as f:
            receipts = json.load(f)
    except (OSError, ValueError) as e:
        die(f"refused: the dispatch receipts could not be read: {e}")
    # An explicit request is not optional polling: the floor is not applied,
    # so a below-floor quota still lets the operator's read through.
    run = gh_gateway.run(["gh", "api", f"repos/{repo}/pulls/{number}"], timeout=40)
    if run.returncode:
        die(f"refused: {repo}#{number} could not be read: {run.stderr.strip()[:200]}")
    pr = json.loads(run.stdout)
    if pr.get("state") != "open":
        die(f"refused: {repo}#{number} is not open")
    head = pr["head"]["sha"]
    key = f"fix:{repo}#{number}:{head}"
    # The findings of one head go back once. The gate and the tick may both
    # ask for the same fix, and a builder that already fixed them must not
    # be asked again.
    with Lock(True):
        heads = load().setdefault("fixedHeads", {})
        if key in heads:
            die(f"refused: findings for this head were already sent as coordq #{heads[key]}")
    gate_thread = receipts.get(f"gate:{repo}#{number}:{head}")
    if not gate_thread:
        die(f"refused: no gate has looked at {repo}#{number} at {head}")
    code, out = call("t3_thread_read", {"threadId": gate_thread, "maxCharsPerItem": 20000})
    if code:
        die("refused: the gate thread could not be read")
    try:
        data = json.loads(out)
    except ValueError:
        die("refused: the gate thread could not be read")
    texts = [i.get("text") or "" for i in (data.get("items") or [])
             if i.get("type") == "assistant_message"]
    report = texts[-1] if texts else ""
    if not report.rstrip().endswith("VERDICT: FAIL"):
        die(f"refused: the gate of {repo}#{number} did not end VERDICT: FAIL")
    issue = 0
    for line in (pr.get("body") or "").splitlines():
        match = re.search(r"\bRefs?\s+#(\d+)", line)
        if match:
            issue = int(match.group(1))
            break
    if not issue:
        die(f"refused: {repo}#{number} names no ticket, so it has no builder")
    prefix = f"ticket:{repo}#{issue}:a"
    builder, attempt = "", 0
    for receipt_key, value in receipts.items():
        if not receipt_key.startswith(prefix):
            continue
        try:
            number_of_attempt = int(receipt_key[len(prefix):])
        except ValueError:
            continue
        if number_of_attempt > attempt:
            builder, attempt = value, number_of_attempt
    if not builder:
        die(f"refused: no builder thread is known for {repo}#{issue}")
    message = (
        f"The Opus gate on PR #{number} at {head} returned VERDICT: FAIL. "
        "Fix every critical and major finding below (minors if small), run "
        "the check, push, update the PR body's Builder check line to the new "
        "head, and report.\n\n" + report[-6000:]
    )
    args = {"threadId": builder, "message": message}
    with Lock(True):
        queue = load()
        heads = queue.setdefault("fixedHeads", {})
        if key in heads:
            die(f"refused: findings for this head were already sent as coordq #{heads[key]}")
        item = {"id": queue["next"], "tool": "t3_thread_send", "args": args,
                "title": f"{repo}#{number} gate findings", "priority": 300}
        queue["next"] += 1
        queue["items"].append(item)
        heads[key] = item["id"]
        save(queue)
    print(f"queued a finding for {repo}#{number} -> builder {builder}")


def backstop_model(thread, runs):
    return reviewer_model([])


def check_names_head(body, head, publisher, checks):
    """Return True when the builder's check names this head.

    The check is the line the builder wrote in the pull request body,
    `Builder check: PASS <head>`, or the agent check the repository
    publishes on the head. A trailing note after the head (the command
    that produced it) does not change the verdict."""
    for line in (body or "").splitlines():
        if re.match(rf"^Builder check: PASS {re.escape(head)}(?:\s|$)", line.strip()):
            return True
    if publisher:
        return bool(checks) and checks[0]["state"] == "success"
    return False


def gate_request(repo, pr, settings, config, receipts, login, optional=True,
                 fresh=False):
    """Return the gate request of one open pull request, or None.

    The backstop gates a head the queue's own gatekeeper left alone. The
    builder's check must name the head: a gate that cannot read the diff
    would only report the check, and recording the head would block it
    from then on. The gate model follows the builder's own rule."""
    head, number = pr["head"]["sha"], pr["number"]
    body = pr.get("body") or ""
    for issue in dict.fromkeys(re.findall(r"\bRefs #(\d+)\b", body)):
        thread_id = builder_thread_for_issue(repo, issue)
        if not thread_id:
            continue
        thread, runs = read_builder_thread(thread_id)
        model = reviewer_model(builder_models(thread, runs))
        if model is None:
            return None
        statuses = gh_json(f"repos/{repo}/commits/{head}/statuses?per_page=100",
                           optional=optional, fresh=fresh)
        checks = [x for x in statuses if x["context"] == "srw/agent-check"]
        publisher = settings.get("macPublisher", repo == "shyamsivakumar/strategy-replay-workbench") or bool(checks)
        if not check_names_head(body, head, publisher, checks):
            return None
        key = f"gate:{repo}#{number}:{head}"
        proof_state, proof, proof_path = gate_proof(settings, repo, issue, head)
        prompt = gate_prompt_state(repo, number, pr.get("changed_files"),
                                   (pr.get("base") or {}).get("ref"), head)
        if prompt == prompt_paths.UNKNOWN:
            return DEFER
        return key, gate_args(settings, repo, issue, number, head, publisher, model,
                               proof=proof, proof_path=proof_path, proof_state=proof_state,
                               prompt=prompt == prompt_paths.HOLD,
                               base=(pr.get("base") or {}).get("ref") or "main"), builder_models(thread, runs)
    statuses = gh_json(f"repos/{repo}/commits/{head}/statuses?per_page=100",
                       optional=optional, fresh=fresh)
    checks = [x for x in statuses if x["context"] == "srw/agent-check"]
    publisher = settings.get("macPublisher", repo == "shyamsivakumar/strategy-replay-workbench") or bool(checks)
    if not check_names_head(body, head, publisher, checks):
        return None
    model = backstop_model({}, [])
    if model is None:
        return None
    key = f"gate:{repo}#{number}:{head}"
    proof_state, proof, proof_path = gate_proof(settings, repo, None, head)
    prompt = gate_prompt_state(repo, number, pr.get("changed_files"),
                               (pr.get("base") or {}).get("ref"), head)
    if prompt == prompt_paths.UNKNOWN:
        return DEFER
    return key, gate_args(settings, repo, None, number, head, publisher, model,
                           proof=proof, proof_path=proof_path, proof_state=proof_state,
                           prompt=prompt == prompt_paths.HOLD,
                           base=(pr.get("base") or {}).get("ref") or "main"), []


def parse_ref(ref):
    """Return the repository and number of an owner/repo#number reference."""
    match = re.fullmatch(r"([^/\s#]+/[^/\s#]+)#(\d+)", ref)
    if not match:
        die(f"bad reference {ref!r}, expected owner/repo#number")
    return match.group(1), int(match.group(2))


def cmd_gate(a):
    """Queue the gate for one open pull request head.

    The queue's own gatekeeper gates the pull requests whose builder
    check names their head. This is the tick's backstop: it gates the
    head the tick names, so a head no gate looked at is not left
    ungated. The head is recorded in the queue's own list, so a head is
    never gated twice."""
    repo, number = parse_ref(a.ref)
    with open(a.config) as f:
        config = json.load(f)
    settings = (config.get("repos") or {}).get(repo)
    if not settings:
        die(f"refused: {repo} is not on the board")
    # An explicit request is not optional polling: the floor is not applied,
    # so a below-floor quota still lets the operator's read through.
    run = gh_gateway.run(["gh", "api", f"repos/{repo}/pulls/{number}"], timeout=40)
    if run.returncode:
        die(f"refused: {repo}#{number} could not be read: {run.stderr.strip()[:200]}")
    pr = json.loads(run.stdout)
    if pr.get("state") != "open":
        die(f"refused: {repo}#{number} is not open")
    if pr.get("draft"):
        die(f"refused: {repo}#{number} is a draft")
    head = pr["head"]["sha"]
    key = f"gate:{repo}#{number}:{head}"
    with Lock(True):
        heads = load().setdefault("gatedHeads", {})
        state = gate_state(heads.get(key))
        # An operator asking for a gate explicitly still gets it, so a head
        # the automatic retry gave up on is queued again. The retry count is
        # kept, because the reviewer that could not run has not changed.
        if key in heads and not state["givenUp"]:
            die(f"refused: a gate for this head is already recorded as {gate_label(state)}")
    login_run = gh_gateway.run(["gh", "api", "user", "--jq", ".login"], timeout=40)
    if login_run.returncode:
        die("refused: the authenticated GitHub user is unknown")
    login = login_run.stdout.strip()
    # An explicit gate is a required read: the floor applies to polling.
    found = gate_request(repo, pr, settings, config, load_receipts(), login,
                         optional=False, fresh=True)
    if found is DEFER:
        die(f"refused: the changed files of {repo}#{number} could not be read, and a gate "
            "that cannot read them might order a merge of prompt text. Retry the gate.")
    if not found:
        die(
            f"refused: no passing builder check of {repo}#{number} names the "
            f"head {head}, so a gate for this head would only report CHECK: "
            "FAIL and would block the head from then on. Wait for the builder "
            "to push the check for this head."
        )
    key, args, models = found
    with Lock(True):
        queue = load()
        heads = queue.setdefault("gatedHeads", {})
        state = gate_state(heads.get(key))
        if key in heads and not state["givenUp"]:
            die(f"refused: a gate for this head is already recorded as {gate_label(state)}")
        item = {"id": queue["next"], "tool": "t3_thread_launch", "args": args,
                "title": args["title"], "priority": 5000, "builderModels": models}
        queue["next"] += 1
        queue["items"].append(item)
        # The explicit gate is recorded as undecided again, so a second
        # explicit gate for the same head is refused while this one is live.
        # Its retry count stays at the limit, so if it dies without a verdict
        # the next gatekeep run gives up on the head again, in one line,
        # instead of reopening the automatic retries.
        heads[key] = {**state, "id": item["id"], "givenUp": False}
        save(queue)
    print("queued " + key
          + " reviewer " + args["modelSelection"]["instanceId"] + " " + args["modelSelection"]["model"])


def main():
    p = argparse.ArgumentParser(prog="coordq")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("args")
    s.add_argument("--title")
    s.add_argument("--priority", type=int, default=0)
    s.add_argument("--tool")
    s.add_argument("--action-key",
                   help="the board action key this item carries, as action:owner/repo#number:head. "
                        "The key is held by one queue item, so a second item with the same key is refused.")
    s.set_defaults(fn=cmd_start)
    c = sub.add_parser("create")
    c.add_argument("args")
    c.set_defaults(fn=cmd_create)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    d = sub.add_parser("drop")
    d.add_argument("id", type=int)
    d.set_defaults(fn=cmd_drop)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    d = sub.add_parser("dispatch")
    d.add_argument("--dry-run", action="store_true",
                   help="start nothing: the queue is left alone and the refill only reports")
    d.set_defaults(fn=cmd_dispatch)
    g = sub.add_parser("gatekeep")
    g.add_argument("--dry-run", action="store_true")
    g.add_argument("--config", default=os.path.expanduser("~/.coordinator/tickets.json"))
    g.set_defaults(fn=cmd_gatekeep)
    o = sub.add_parser("gate")
    o.add_argument("ref", help="the pull request to gate, as owner/repo#number")
    o.add_argument("--config", default=os.path.expanduser("~/.coordinator/tickets.json"))
    o.set_defaults(fn=cmd_gate)
    f = sub.add_parser("fix")
    f.add_argument("ref", help="the pull request whose findings go back, as owner/repo#number")
    f.set_defaults(fn=cmd_fix)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
