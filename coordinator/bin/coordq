#!/usr/bin/env python3
import argparse, fcntl, json, os, re, subprocess, sys, time

DIR = os.environ.get("COORDQ_DIR", os.path.expanduser("~/Code/coordinator/queue"))
T3MCP = os.environ.get("COORDQ_T3MCP", "t3mcp")
LIVE_STATUSES = ["running", "starting", "preparing", "queued"]
MAX_ATTEMPTS = 3
WORKER_MODEL = {"instanceId": "minimax", "model": "minimax/MiniMax-M3.1-Flash"}
SOL_MODEL = {"instanceId": "codex", "model": "gpt-6.1-sol"}
OPUS_MODEL = {"instanceId": "claudeAgent", "model": "claude-opus-5-5"}
TASK_MODELS = {
    "standard": {"instanceId": "router", "model": "task/standard"},
    "large": {"instanceId": "router", "model": "task/standard"},
    "ui": {"instanceId": "router", "model": "task/ui"},
    "research": {"instanceId": "router", "model": "task/research"},
    "rca": {"instanceId": "router", "model": "task/rca"},
    "chore": {"instanceId": "router", "model": "task/chore"},
    "worker": {"instanceId": "router", "model": "task/standard"},
    "panel": WORKER_MODEL,
    "risky": SOL_MODEL,
    "design": SOL_MODEL,
    "review": OPUS_MODEL,
}
DISPATCHABLE_TOOLS = ["t3_thread_launch", "t3_thread_send"]
RULES_PATH = os.environ.get("COORDQ_RULES", os.path.expanduser("~/.coordinator/AGENT-RULES.md"))
RULES_SKIP_TITLE = re.compile(r"\b(?:review|critique)\b|\bmerge relay\b", re.IGNORECASE)
# The board refill. When the queue is empty and the machine has free slots,
# the dispatcher starts tickets from the board, at most once per interval.
TICKET_BIN = os.environ.get("COORDQ_TICKET", "ticket")
TICKETS_CONFIG = os.environ.get("COORDQ_TICKETS_CONFIG", os.path.expanduser("~/.coordinator/tickets.json"))
REFILL_INTERVAL = int(os.environ.get("COORDQ_REFILL_INTERVAL", "300"))
REFILL_BUDGET = float(os.environ.get("COORDQ_REFILL_BUDGET", "120"))
REFILL_MAX = int(os.environ.get("COORDQ_REFILL_MAX", "40"))
REFILL_LIMIT = int(os.environ.get("COORDQ_REFILL_LIMIT", "200"))
STAGE = "stage:todo"


def path(name):
    return os.path.join(DIR, name)


def die(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def log(message):
    with open(path("dispatch.log"), "a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")


def cap():
    with open(path("config.json")) as f:
        return json.load(f)["cap"]


def load():
    if not os.path.exists(path("queue.json")):
        return {"next": 1, "items": []}
    with open(path("queue.json")) as f:
        return json.load(f)


def save(queue):
    tmp = path("queue.json.tmp")
    with open(tmp, "w") as f:
        json.dump(queue, f, indent=1)
    os.replace(tmp, path("queue.json"))


def with_model(args):
    task_type = args.get("taskType")
    if task_type and task_type not in TASK_MODELS:
        return None, f"refused: unknown taskType {task_type!r}. Accepted taskTypes: {', '.join(sorted(TASK_MODELS))}"
    resolved = dict(args)
    resolved.pop("taskType", None)
    if not resolved.get("modelSelection"):
        if not task_type:
            return None, "refused: a launch needs a taskType or a modelSelection"
        resolved["modelSelection"] = TASK_MODELS[task_type]
    elif task_type == "review" and not is_gate_model(resolved["modelSelection"]):
        return None, (f"refused: taskType 'review' runs on the gate model "
                      f"{{'instanceId': 'claudeAgent', 'model': 'claude-opus-5-5'}}, "
                      f"but the payload names {resolved['modelSelection']!r}")
    return resolved, None


def is_gate_model(selection):
    return (isinstance(selection, dict)
            and selection.get("instanceId") == OPUS_MODEL["instanceId"]
            and selection.get("model") == OPUS_MODEL["model"])


def tool_refusal(tool):
    return f"tool {tool!r} is not dispatchable. Accepted tools: {', '.join(DISPATCHABLE_TOOLS)}"


def read_rules():
    try:
        with open(RULES_PATH) as f:
            return f.read().strip()
    except OSError as e:
        raise RuntimeError(f"cannot read agent rules {RULES_PATH}: {e.strerror}") from e


def wants_rules(args, task_type=None):
    if not args.get("message") or task_type == "review" or is_gate_model(args.get("modelSelection")):
        return False
    return not RULES_SKIP_TITLE.search(str(args.get("title") or ""))


def with_rules(args, rules):
    return {**args, "message": f"## Agent rules\n\n{rules}\n\n## Brief\n\n{args['message']}"}


def call(tool, args, rules=None):
    if tool == "t3_thread_launch":
        task_type = args.get("taskType")
        args, refusal = with_model(args)
        if refusal:
            return 1, refusal
        if wants_rules(args, task_type):
            if rules is None:
                return 1, "agent rules were not loaded"
            args = with_rules(args, rules)
    run = subprocess.run([T3MCP, "call", tool, "-"], input=json.dumps(args), capture_output=True, text=True)
    return run.returncode, (run.stdout if run.returncode == 0 else run.stderr).strip()


def live():
    code, out = call("t3_thread_list", {"allProjects": True, "limit": 1, "statuses": LIVE_STATUSES,
                                        "includeSubagents": False})
    return json.loads(out)["total"] if code == 0 else None


def tool_for(args):
    return "t3_thread_send" if "threadId" in args else "t3_thread_launch"


class Lock:
    def __init__(self, blocking, name="queue.lock"):
        self.blocking = blocking
        self.name = name

    def __enter__(self):
        self.f = open(path(self.name), "w")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if self.blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            self.f.close()
            return None
        return self

    def __exit__(self, *exc):
        if self.f and not self.f.closed:
            self.f.close()


def wait_until_counted(before):
    for _ in range(10):
        n = live()
        if n is not None and n > before:
            return
        time.sleep(1)


def undispatchable_tool(item):
    for tool in [item.get("tool")] + [step.get("tool") for step in item.get("pre", [])]:
        if tool not in DISPATCHABLE_TOOLS:
            return tool
    return None


def drain():
    while True:
        queue = load()
        dispatchable = []
        dropped = set()
        for item in queue["items"]:
            tool = undispatchable_tool(item)
            if tool is None:
                dispatchable.append(item)
                continue
            dropped.add(item["id"])
            log(f"REFUSED #{item['id']}: {tool_refusal(tool)}")
        if dropped:
            queue["items"] = [i for i in queue["items"] if i["id"] not in dropped]
            save(queue)
        ready = sorted((i for i in dispatchable if i.get("attempts", 0) < MAX_ATTEMPTS), key=lambda i: (-i["priority"], i["id"]))
        if not ready:
            return
        n = live()
        if n is None:
            log("cannot read thread count, nothing started")
            return
        if n >= cap():
            log(f"at cap {n}/{cap()}, {len(ready)} waiting")
            return
        item = ready[0]
        steps = item.get("pre", []) + [{"tool": item["tool"], "args": item["args"]}]
        rules = None
        if any(step["tool"] == "t3_thread_launch" and wants_rules(step["args"]) for step in steps):
            try:
                rules = read_rules()
            except RuntimeError as e:
                log(f"{e}, nothing started")
                return
        code, out = 0, ""
        for step in steps:
            code, out = call(step["tool"], step["args"], rules)
            if code != 0:
                break
        request_id = item["args"].get("clientRequestId")
        if code == 0 and request_id and item["tool"] == "t3_thread_launch":
            try:
                result = json.loads(out)
                thread_id = result.get("thread", result).get("threadId")
                if not isinstance(thread_id, str) or not thread_id:
                    raise ValueError("successful launch has no threadId")
            except (ValueError, TypeError, AttributeError) as e:
                item["attempts"] = MAX_ATTEMPTS - 1
                code, out = 1, f"invalid launch reply: {e}"
        if code == 0:
            if request_id and item["tool"] == "t3_thread_launch":
                receipts_path = path("dispatch-receipts.json")
                receipts = {}
                if os.path.exists(receipts_path):
                    with open(receipts_path) as f:
                        receipts = json.load(f)
                receipts[request_id] = thread_id
                with open(receipts_path + ".tmp", "w") as f:
                    json.dump(receipts, f)
                os.replace(receipts_path + ".tmp", receipts_path)
            queue["items"] = [i for i in queue["items"] if i["id"] != item["id"]]
            save(queue)
            log(f"started #{item['id']} {item['tool']} {item['title']!r} (was {n}/{cap()})")
            wait_until_counted(n)
        else:
            item["attempts"] = item.get("attempts", 0) + 1
            save(queue)
            log(f"FAILED #{item['id']} attempt {item['attempts']}: {out[:200]}")


def cmd_start(a):
    args = json.loads(a.args)
    tool = a.tool or tool_for(args)
    if tool not in DISPATCHABLE_TOOLS:
        die(f"refused: {tool_refusal(tool)}")
    if a.title and tool == "t3_thread_launch":
        args.setdefault("title", a.title)
    if tool == "t3_thread_launch":
        task_type = args.get("taskType")
        args, refusal = with_model(args)
        if refusal:
            die(refusal)
        if wants_rules(args, task_type):
            try:
                read_rules()
            except RuntimeError as e:
                die(f"refused: {e}")
    with Lock(True):
        queue = load()
        item = {"id": queue["next"], "tool": tool, "args": args, "title": a.title or args.get("title") or args.get("threadId", ""), "priority": a.priority}
        queue["next"] += 1
        queue["items"].append(item)
        # A gate request takes its head with it, so gatekeep does not queue
        # a second gate for the same head.
        request_id = str(args.get("clientRequestId") or "")
        if request_id.startswith("gate:"):
            heads = queue.setdefault("gatedHeads", {})
            if request_id in heads:
                die(f"refused: a gate for this head is already recorded as coordq #{heads[request_id]}")
            heads[request_id] = item["id"]
        save(queue)
        drain()
        if any(i["id"] == item["id"] for i in load()["items"]):
            print(f"queued #{item['id']}")
        else:
            print(f"started #{item['id']}")


def last_refill():
    """The time of the last refill attempt, or None when there was none."""
    try:
        with open(path("refill.last")) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return None


def mark_refill():
    """Record a refill attempt. A dry run records it too, so a diagnostic
    cannot be mistaken for a free refill window."""
    tmp = path("refill.last.tmp")
    with open(tmp, "w") as f:
        f.write(str(time.time()))
    os.replace(tmp, path("refill.last"))


def search_stage_todo(owner):
    """The open stage:todo issues of one owner, oldest first."""
    run = subprocess.run(["gh", "search", "issues", "--owner", owner, "--state", "open",
                          "--label", STAGE, "--sort", "created", "--order", "asc",
                          "--limit", str(REFILL_LIMIT),
                          "--json", "repository,number,title,createdAt"],
                         capture_output=True, text=True, timeout=40)
    if run.returncode:
        raise RuntimeError(f"GitHub search failed for {owner}: {run.stderr.strip()[:200]}")
    return json.loads(run.stdout)


def board_candidates():
    """The open stage:todo issues of the repos in tickets.json, oldest first."""
    with open(TICKETS_CONFIG) as f:
        cfg = json.load(f)
    repos = set(cfg["repos"])
    owners = sorted({repo.split("/")[0] for repo in repos})
    found = {}
    for owner in owners:
        for row in search_stage_todo(owner):
            repo = row["repository"]["nameWithOwner"]
            if repo in repos:
                found[(repo, row["number"])] = row
    return sorted(found.values(),
                  key=lambda r: (r["createdAt"], r["repository"]["nameWithOwner"], r["number"]))


def ticket_start(repo, number, dry_run):
    """Run the ticket CLI on one ticket. A refused ticket exits non-zero and
    changes nothing, so a refusal is a skip and not a start."""
    command = [TICKET_BIN, "start", f"{repo}#{number}"]
    if dry_run:
        command.append("--dry-run")
    try:
        run = subprocess.run(command, capture_output=True, text=True, timeout=240)
    except subprocess.TimeoutExpired:
        return 1, "ticket start timed out"
    return run.returncode, ((run.stdout or "") + (run.stderr or "")).strip()


def used_slots():
    """The live threads plus the queued items, or None when the count is
    unreadable. The queue counts, because a queued item already holds a
    slot."""
    n = live()
    if n is None:
        return None
    return n + len(load()["items"])


def refill(a):
    """Fill free slots from the board.

    The refill runs only when the queue is empty and the machine is below the
    cap, and at most once per REFILL_INTERVAL seconds. Every candidate is a
    ticket the ticket CLI may refuse, and a refusal starts nothing, so the
    scan moves on to the next candidate.
    """
    with Lock(False, "refill.lock") as lock:
        if lock is None:
            log("refill skipped: another refill is running")
            return
        queue = load()
        if queue["items"]:
            log(f"refill skipped: the queue holds {len(queue['items'])} item(s)")
            return
        n = live()
        if n is None:
            log("refill skipped: cannot read the live thread count")
            return
        limit = cap()
        if n >= limit:
            log(f"refill skipped: at cap {n}/{limit}")
            return
        last = last_refill()
        if last is not None and time.time() - last < REFILL_INTERVAL:
            log(f"refill skipped: throttled, the last refill was {int(time.time() - last)}s ago")
            return
        mark_refill()
        try:
            candidates = board_candidates()
        except (OSError, RuntimeError, ValueError, KeyError) as e:
            log(f"refill stopped: {e}")
            return
        if not candidates:
            log("refill stopped: the board has no open stage:todo ticket")
            return
        deadline = time.time() + REFILL_BUDGET
        filled = 0
        scanned = 0
        for candidate in candidates[:REFILL_MAX]:
            scanned += 1
            if time.time() > deadline:
                log("refill stopped: the refill budget is spent")
                break
            used = used_slots()
            if used is None:
                log("refill stopped: cannot read the live thread count")
                break
            # Every start of this refill took a slot, and the count can lag
            # behind it, so the slots this refill filled count too. The higher
            # of the two counts wins, so a slow count never starts too many.
            used = max(used, n + filled)
            if used >= limit:
                log(f"refill stopped: the slots are full ({used}/{limit})")
                break
            repo = candidate["repository"]["nameWithOwner"]
            number = candidate["number"]
            code, out = ticket_start(repo, number, a.dry_run)
            if code != 0:
                log(f"refill refused {repo}#{number}: {out[:200]}")
                continue
            filled += 1
            if a.dry_run:
                log(f"refill would start {repo}#{number}")
            elif out.startswith("queued"):
                log(f"refill queued {repo}#{number}: {out[:120]}")
            else:
                log(f"refill started {repo}#{number}")
        if len(candidates) > scanned:
            log(f"refill scanned {scanned} candidate(s), {len(candidates) - scanned} left for the next refill")


def cmd_dispatch(a):
    with open(path("dispatch.last"), "w") as f:
        f.write(str(int(time.time())))
    if a.dry_run:
        log("dry run: the queue is left alone")
        refill(a)
        return
    with Lock(False) as lock:
        if lock is None:
            log("lock held by another run, skipping")
            return
        drain()
    try:
        refill(a)
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as e:
        log(f"refill failed: {e}")


def cmd_create(a):
    args = json.loads(a.args)
    if args.get("message"):
        die("refused: create is for idle threads, this has a message. Use coordq start.")
    args, refusal = with_model(args)
    if refusal:
        die(refusal)
    if "projectId" not in args and not args.get("workspaceStrategy"):
        args["scratch"] = True
    code, out = call("t3_thread_launch", args)
    print(out)
    sys.exit(code)


def cmd_list(a):
    for i in sorted(load()["items"], key=lambda i: (-i["priority"], i["id"])):
        print(f"#{i['id']} p{i['priority']} {i['tool']} {i['title']}" + (f" (failed {i['attempts']}x)" if i.get("attempts") else ""))


def cmd_drop(a):
    with Lock(True):
        queue = load()
        kept = [i for i in queue["items"] if i["id"] != a.id]
        if len(kept) == len(queue["items"]):
            die(f"no queue item #{a.id}")
        queue["items"] = kept
        save(queue)
    print(f"dropped #{a.id}")


def cmd_status(a):
    print(json.dumps({"cap": cap(), "live": live(), "queued": len(load()["items"])}))



def gh_json(endpoint):
    run = subprocess.run(["gh", "api", "--paginate", "--slurp", endpoint],
                         capture_output=True, text=True, timeout=40)
    if run.returncode:
        raise RuntimeError(f"GitHub request failed: {endpoint}")
    pages = json.loads(run.stdout)
    return [row for page in pages for row in page]


def gate_candidates(config):
    login_run = subprocess.run(["gh", "api", "user", "--jq", ".login"],
                               capture_output=True, text=True, timeout=40)
    if login_run.returncode:
        raise RuntimeError("cannot identify authenticated GitHub user")
    login = login_run.stdout.strip()
    with open(path("dispatch-receipts.json")) as f:
        receipts = json.load(f)
    skipped = set()
    for repo, settings in config["repos"].items():
        for pr in gh_json(f"repos/{repo}/pulls?state=open&per_page=100"):
            if pr["draft"]:
                continue
            head, number = pr["head"]["sha"], pr["number"]
            body = pr.get("body") or ""
            refs = re.findall(r"\bRefs #(\d+)\b", body)
            for issue in dict.fromkeys(refs):
                ledger = []
                for comment in gh_json(f"repos/{repo}/issues/{issue}/comments?per_page=100"):
                    if comment["user"]["login"] != login:
                        continue
                    for match in re.finditer(r"<!-- coordinator-ticket (\{.*?\}) -->", comment["body"]):
                        ledger.append(json.loads(match[1]))
                completed = [e for e in ledger if e.get("kind") == "receipt"]
                if not completed:
                    continue
                receipt = max(completed, key=lambda e: e["attempt"])
                intents = [e for e in ledger if e.get("kind") == "intent"]
                if intents and max(e["attempt"] for e in intents) != receipt["attempt"]:
                    continue
                thread_id = receipts.get(receipt["requestId"])
                if not thread_id:
                    print(f"skip {repo}#{number}: builder dispatch receipt unavailable", file=sys.stderr)
                    continue
                code, out = call("t3_thread_read", {"threadId": thread_id, "limit": 1})
                if code:
                    raise RuntimeError("cannot read builder run")
                result = json.loads(out)
                runs = result.get("recentRuns", [])
                models = executed_models(runs[0]) if runs else []
                if not models:
                    thread = result.get("thread", {})
                    instance, stored = thread.get("providerInstanceId"), thread.get("model")
                    reason = None
                    if not isinstance(stored, str) or not stored or not instance:
                        reason = "stored builder model unavailable"
                    elif instance == "router":
                        try:
                            with open(os.path.expanduser("~/.pi/agent/extensions/task-router.ts")) as f:
                                source = f.read()
                            routes = re.search(r"const ROUTES: Record<string, string\[\]> = \{(.*?)\n\};", source, re.S)
                            chain = re.search(r"^\s*" + re.escape(stored.removeprefix("task/")) + r":\s*\[([^\]]*)\]", routes[1], re.M) if routes and stored.startswith("task/") else None
                            entries = json.loads("[" + chain[1].rstrip().rstrip(",") + "]") if chain else []
                            if not entries or not all(isinstance(m, str) and "/" in m for m in entries):
                                reason = "router chain unavailable"
                            elif any("claude" in m.lower() or "anthropic" in m.lower() for m in entries):
                                reason = "router chain includes Claude"
                            else:
                                models = entries
                        except (OSError, ValueError):
                            reason = "router chain unavailable"
                    else:
                        models = ["claude" if instance == "claudeAgent" else stored]
                    if reason:
                        if (repo, number) not in skipped:
                            print(f"skip {repo}#{number}: {reason}", file=sys.stderr)
                            skipped.add((repo, number))
                        continue
                statuses = gh_json(f"repos/{repo}/commits/{head}/statuses?per_page=100")
                checks = [x for x in statuses if x["context"] == "srw/agent-check"]
                publisher = settings.get("macPublisher", repo == "shyamsivakumar/strategy-replay-workbench") or bool(checks)
                if publisher:
                    passed = bool(checks) and checks[0]["state"] == "success"
                else:
                    passed = f"Builder check: PASS {head}" in body.splitlines()
                if not passed:
                    continue
                model = SOL_MODEL if any("claude" in m.lower() for m in models) else OPUS_MODEL
                key = f"gate:{repo}#{number}:{head}"
                ascend = settings.get("ascend", False) or repo.split('/')[0] != "shyamsivakumar" or any(x in repo for x in ("action-underwriting-hub", "ascend-mcp", "data-ops", "/dbt", "/omni"))
                merge = ("Ascend repo: do not merge; stop at the verdict." if ascend else
                         f"If and only if CHECK and VERDICT are PASS on {head}, run `gh pr merge {number} -R {repo} --squash --match-head-commit {head}`; report the merge commit or refusal.")
                close = (" Ascend repo: do not close the issue." if ascend else
                         f" Only when that merge produced a merge commit, close the ticket: run `gh issue close {issue} -R {repo} --comment \"VERDICT: PASS. Merged via #{number} (<merge commit sha>).\"` with <merge commit sha> the merge commit you reported. On VERDICT: FAIL, or when the merge did not happen, close nothing.")
                check = (f"Confirm srw/agent-check success on {head} using gh api repos/{repo}/commits/{head}/statuses."
                         if publisher else f"Confirm the exact PR-body line `Builder check: PASS {head}`.")
                message = f"""{settings['key']}-{issue} review and merge · #{number} {head}
Type: review gate · finish in 4 minutes. Task: https://github.com/{repo}/issues/{issue}
Read the ticket and diff only: `git fetch origin && git diff origin/main...{head}`. Check out nothing. Do NOT rerun the suite.
{check} Re-read prior gate findings and say whether each is resolved.
Tag findings critical, major, minor with file:line. Runtime changes outside the task, unrelated test weakening, circular proof and workflow files are major; secrets are critical.
Reconfirm the PR head is {head}; otherwise CHECK: FAIL. End `CHECK: PASS {head}` or `CHECK: FAIL {head}`, then exactly `VERDICT: PASS` or `VERDICT: FAIL`.
{merge}{close} Never call emp. Never print secrets."""
                yield key, {"projectId": settings["projectId"], "title": f"{settings['key']}-{issue} review #{number} {head[:8]}",
                            "modelSelection": model, "runtimeMode": "full-access", "workspaceStrategy": {"type": "root"},
                            "clientRequestId": key, "message": message}
                break


def executed_models(value):
    if isinstance(value, dict):
        found = [value["executedModel"]] if isinstance(value.get("executedModel"), str) else []
        return found + [m for child in value.values() for m in executed_models(child)]
    if isinstance(value, list):
        return [m for child in value for m in executed_models(child)]
    return []


def cmd_gatekeep(a):
    with open(a.config) as f:
        config = json.load(f)
    try:
        for key, args in gate_candidates(config):
            with Lock(True):
                queue = load()
                heads = queue.setdefault("gatedHeads", {})
                if key in heads:
                    continue
                print(("would queue " if a.dry_run else "queued ") + key, flush=True)
                if a.dry_run:
                    continue
                item = {"id": queue["next"], "tool": "t3_thread_launch", "args": args,
                        "title": args["title"], "priority": 5000}
                queue["next"] += 1
                queue["items"].append(item)
                heads[key] = item["id"]
                save(queue)
    except (RuntimeError, ValueError, KeyError, OSError, subprocess.TimeoutExpired) as e:
        die(f"gatekeep stopped: {e}")


def main():
    p = argparse.ArgumentParser(prog="coordq")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("args")
    s.add_argument("--title")
    s.add_argument("--priority", type=int, default=0)
    s.add_argument("--tool")
    s.set_defaults(fn=cmd_start)
    c = sub.add_parser("create")
    c.add_argument("args")
    c.set_defaults(fn=cmd_create)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    d = sub.add_parser("drop")
    d.add_argument("id", type=int)
    d.set_defaults(fn=cmd_drop)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    d = sub.add_parser("dispatch")
    d.add_argument("--dry-run", action="store_true",
                   help="start nothing: the queue is left alone and the refill only reports")
    d.set_defaults(fn=cmd_dispatch)
    g = sub.add_parser("gatekeep")
    g.add_argument("--dry-run", action="store_true")
    g.add_argument("--config", default=os.path.expanduser("~/.coordinator/tickets.json"))
    g.set_defaults(fn=cmd_gatekeep)
    a = p.parse_args()
    a.fn(a)


main()
