#!/usr/bin/env python3
import json, os, socket, sqlite3, subprocess, sys, threading, time

SOCKET = os.environ.get("EMP_HUB_SOCKET", os.path.expanduser("~/.empryo-hub/hub.sock"))


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


class HubError(Exception):
    pass


def ask(request):
    with socket.socket(socket.AF_UNIX) as s:
        try:
            s.connect(SOCKET)
        except OSError as e:
            raise HubError(f"cannot reach emp-hub at {SOCKET}: {e}")
        s.sendall((json.dumps(request) + "\n").encode())
        reply = s.makefile("rb").readline()
    if not reply:
        raise HubError("emp-hub closed the connection without a reply")
    response = json.loads(reply)
    if not response["ok"]:
        raise HubError(response["error"])
    return response["result"]


def hub_pid():
    try:
        return ask({"method": "call", "tool": "emp_hub_status", "arguments": {}})["pid"]
    except HubError:
        return None


def drain_cancel():
    print(json.dumps(ask({"method": "call", "tool": "emp_hub_drain_cancel", "arguments": {}})))


def drain(restart):
    old = hub_pid()
    print(f"draining hub pid {old}: no new turns start; waiting for running turns to finish", flush=True)
    result = ask({"method": "call", "tool": "emp_hub_drain", "arguments": {}})
    print(json.dumps(result), flush=True)
    if result.get("cancelled"):
        print("drain cancelled; hub keeps running")
        return
    if not restart or not result["drained"]:
        return
    deadline = time.time() + 120
    while time.time() < deadline:
        time.sleep(1)
        pid = hub_pid()
        if pid and pid != old:
            print(f"hub restarted: pid {pid}")
            return
    fail("the hub did not come back within 120 s")


def session_gone(thread):
    session = thread.get("journalSessionId")
    cwd = thread.get("cwd")
    if not session or not cwd:
        return False
    if os.path.isdir(f"{cwd}/.empryo/sessions/{session}"):
        return False
    try:
        with sqlite3.connect("file:" + os.path.expanduser("~/.empryo/threads.db") + "?mode=ro", uri=True) as db:
            row = db.execute("SELECT session_dir FROM threads WHERE id = ?", (session,)).fetchone()
    except sqlite3.Error:
        return True
    return not (row and os.path.isdir(row[0]))


ACTIVE = ("preparing", "queued", "starting", "running", "waiting")


def follow(thread_id, read_only=False):
    interactive = sys.stdin.isatty() and not read_only
    prompt = "> " if interactive else ""
    lock = threading.Lock()

    def say(text, redraw=True):
        with lock:
            print(f"\r\033[K{text}" if interactive else text, flush=True)
            if interactive and redraw:
                print(prompt, end="", flush=True)

    def steer():
        for line in sys.stdin:
            message = line.strip()
            if not message:
                continue
            say(f"[you] {message}")
            try:
                result = ask({"method": "call", "tool": "emp_thread_send", "arguments": {"threadId": thread_id, "message": message}})
                say(f"[sent] {json.dumps(result)}")
            except HubError as e:
                say(f"[send failed] {e}")

    if not read_only:
        threading.Thread(target=steer, daemon=True).start()
    position = 0
    announced = False
    try:
        while True:
            view = ask({"method": "call", "tool": "emp_thread_read", "arguments": {"threadId": thread_id, "view": "activity", "afterPosition": position, "limit": 100}})
            for item in view["items"]:
                label = item["type"].replace("_", " ")
                say(f"[{item['createdAt'][11:19]}] {label}: {(item.get('text') or item.get('title') or item.get('stopReason') or '')}")
            position = view["nextPosition"]
            if view["thread"]["status"] in ACTIVE:
                announced = False
            elif not view["hasMore"] and not announced:
                if session_gone(view["thread"]):
                    say("\nThe worktree is gone; this is the saved transcript.", redraw=False)
                else:
                    say(f"\nRun {view['thread']['status']}. To continue, open the task from the Herdr board.", redraw=False)
                if not read_only:
                    return
                announced = True
            if not view["hasMore"]:
                time.sleep(1)
    except KeyboardInterrupt:
        print()


def hc_json(*args):
    out = subprocess.run([os.path.expanduser("~/.local/bin/hc"), *args], capture_output=True, text=True)
    return json.loads(out.stdout or out.stderr)


def show_kind(thread):
    if thread["status"] in ACTIVE:
        return "follow"
    if not thread.get("journalSessionId"):
        return "history"
    return "history" if session_gone(thread) else "empryo"


def show_argv(kind, thread):
    if kind == "empryo":
        return ["/opt/homebrew/bin/empryo", "--session", thread["journalSessionId"], "--cwd", thread["cwd"]]
    return [os.path.realpath(__file__), "follow", "--read-only", thread["threadId"]]


def show_terminal(thread_id):
    name = "show-" + thread_id[4:12]
    thread = ask({"method": "call", "tool": "emp_thread_read", "arguments": {"threadId": thread_id, "limit": 1}})["thread"]
    if thread["status"] not in ACTIVE and not thread.get("journalSessionId") and not thread.get("runCount"):
        fail("no Empryo session yet; send a message first")
    kind = show_kind(thread)
    existing = hc_json("get", name, "--json")
    if "error" not in existing and existing["finished_ms"] is None:
        label = existing.get("labels", {}).get("emp.show")
        if label in (kind, "empryo"):
            return existing["address"]
        subprocess.run([os.path.expanduser("~/.local/bin/hc"), "kill", name], capture_output=True)
    cwd = ["--cwd", thread["cwd"]] if kind == "empryo" else []
    started = hc_json("run", "--bg", "--json", "--name", name, *cwd, "--label", f"emp.show={kind}", "--outlive-parent", "--no-notify", "--rm", *show_argv(kind, thread))
    if started.get("error", {}).get("kind") == "name_taken":
        return hc_json("get", name, "--json")["address"]
    if "error" in started:
        fail(f"could not start {name}: {started['error']['message']}")
    return started["address"]


def show(target):
    address = show_terminal(target) if target.startswith("emp:") else target
    deadline = time.time() + 5
    while True:
        out = subprocess.run([os.path.expanduser("~/.local/bin/herdr-app"), "do", "terminal.peek", "--terminal", address], capture_output=True, text=True)
        error = json.loads(out.stdout or '{"error": "herdr-app printed nothing"}').get("error")
        if not error:
            return
        if "no running terminal" not in error or time.time() > deadline:
            fail(error)
        time.sleep(0.05)


def main():
    args = sys.argv[1:]
    if args[:1] == ["tools"]:
        print("\n".join(ask({"method": "tools"})))
    elif args[:1] == ["schema"] and len(args) == 2:
        print(json.dumps(ask({"method": "schema", "tool": args[1]}), indent=2))
    elif args[:1] == ["call"] and len(args) in (2, 3):
        raw = args[2] if len(args) == 3 else "{}"
        arguments = json.loads(sys.stdin.read() if raw == "-" else raw)
        print(json.dumps(ask({"method": "call", "tool": args[1], "arguments": arguments}), indent=2))
    elif args == ["drain", "--cancel"]:
        drain_cancel()
    elif args[:1] == ["drain"] and set(args[1:]) <= {"--restart"}:
        drain("--restart" in args)
    elif args[:1] == ["follow"] and len(args) == 2:
        follow(args[1])
    elif args[:2] == ["follow", "--read-only"] and len(args) == 3:
        follow(args[2], read_only=True)
    elif args[:1] == ["show"] and len(args) == 2:
        show(args[1])
    else:
        fail("usage: emp follow [--read-only] <threadId> | show <threadId | terminal> | drain [--restart | --cancel] | tools | schema <tool> | call <tool> [json-args | -]", 2)


try:
    main()
except HubError as e:
    fail(str(e))
