{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "executor": {
      "type": "http",
      "url": "http://127.0.0.1:4789/mcp",
      "timeout": 120000,
      "headers": {
        "Authorization": "!/usr/bin/jq -r '\"Bearer \" + .token' ~/.executor/server-control/auth.json"
      }
    }
  },
  "disabledServers": [
    "context7",
    "github",
    "linear",
    "notion",
    "vercel"
  ]
}
