    "emp_thread_merge": (obj({**THREAD_ID, "dryRun": BOOL, "expectedRevision": {"type": "string", "description": "The revision a dry run returned. The merge is refused, naming what changed, if the pull request head, merge state, checks or review differ now. Omit it for the earlier behaviour."}}, ["threadId"]), tool_thread_merge),
    "emp_thread_materialize": (obj({"threadId": STR, "syncTitles": BOOL}), tool_thread_materialize),
    "emp_thread_update": (obj({**THREAD_ID, "action": {"type": "string", "enum": ["rename"]}, "title": STR, "clientRequestId": STR}, ["threadId", "action", "title"]), tool_thread_update),
