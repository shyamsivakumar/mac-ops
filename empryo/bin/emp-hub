    "delegate_task": (obj({"parentThreadId": STR, "task": STR, "title": STR, "taskType": {"type": "string", "enum": TASK_TYPES}, "mode": {"type": "string", "enum": MODES}, "modelSelection": MODEL_SELECTION, "target": obj({"providerInstanceId": STR, "driverKind": STR, "model": STR, "options": {}})}, ["parentThreadId", "task"]), tool_delegate_task),
}


def dispatch(request):
    method = request["method"]
    if method == "tools":
        return sorted(TOOLS)
    tool = request.get("tool")
    if tool not in TOOLS:
        raise HubError(f"unknown tool {tool!r}")
    schema, handler = TOOLS[tool]
    if method == "schema":
        return schema
    arguments = request.get("arguments") or {}
    validate(schema, arguments)
    return handler(arguments)


CALLER = threading.local()
SOL_LOCAL, LOCAL_PEERPID = 0, 2


ENGINE_TAG = re.compile(r"\bEMP_HUB_THREAD=(\S+)")
UNRESOLVED_CALLER = "unresolved-caller"


def ps_output(*args):
    return subprocess.run(["ps", *args], capture_output=True, text=True, timeout=3).stdout.strip()


def resolve_caller():
    pid = getattr(CALLER, "pid", 0)
    if pid is None:
        return UNRESOLVED_CALLER
    if pid == 0:
        return None
    environment = ps_output("-E", "-ww", "-p", str(pid), "-o", "command=")
    if not environment:
        return UNRESOLVED_CALLER
    tagged = ENGINE_TAG.search(environment)
    if tagged:
        return tagged.group(1)
    engines = {proc.proc.pid: key for key, proc in list(ENGINES.items())}
    for _ in range(32):
        if pid in engines:
            return engines[pid]
        if pid <= 1:
            return None
        parent = ps_output("-o", "ppid=", "-p", str(pid))
        if not parent:
            return UNRESOLVED_CALLER
        pid = int(parent)
    return UNRESOLVED_CALLER


def caller_thread():
    try:
        return resolve_caller()
    except (OSError, ValueError, subprocess.SubprocessError):
        return UNRESOLVED_CALLER


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            CALLER.pid = self.request.getsockopt(SOL_LOCAL, LOCAL_PEERPID)
        except OSError:
            CALLER.pid = None
        try:
            result = {"ok": True, "result": dispatch(json.loads(self.rfile.readline()))}
        except HubError as e:
            result = {"ok": False, "error": str(e)}
        except Exception as e:
            log(f"internal error: {type(e).__name__}: {e}")
            result = {"ok": False, "error": f"internal error: {type(e).__name__}: {e}"}
        self.wfile.write((json.dumps(result) + "\n").encode())


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def main():
    for directory in (HUB_DIR, WORKTREES, TRANSCRIPTS):
        os.makedirs(directory, exist_ok=True)
    detach_shared_tabs()
    for thread in THREADS.data.values():
        thread["itemCount"] = len(read_items(thread))
        thread.setdefault("taskType", None)
        thread.setdefault("mode", "auto")
        thread["model"] = empryo_model(thread["modelSelection"])
        if thread["status"] in LIVE and not thread.get("pendingTurn"):
            thread["status"] = "interrupted"
            thread["activeRunId"] = None
            if thread["runs"]:
                thread["runs"][-1].update(status="interrupted", stopReason="hub_restart", completedAt=now_iso())
            append_item(thread, {"type": "run_finished", "status": "interrupted", "stopReason": "hub_restart", "usage": None})
    THREADS.save()
    if os.path.exists(SOCKET):
        os.unlink(SOCKET)
    threading.Thread(target=forever, args=("scheduler", SCHEDULER_TICK_SECONDS, scheduler_tick), daemon=True).start()
    threading.Thread(target=forever, args=("reaper", REAPER_TICK_SECONDS, reaper_tick), daemon=True).start()
    resume_pending_turns()
    log(f"hub listening on {SOCKET} with {len(PROJECTS.data)} projects and {len(THREADS.data)} threads")
    Server(SOCKET, Handler).serve_forever()


main()
