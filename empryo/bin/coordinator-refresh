#!/usr/bin/env python3
import argparse, json, os, re, subprocess, sys, time

NOTES = os.path.expanduser("~/Code/coordinator/notes.md")
DONE_TIMEOUT = 300
POLL = 5
FRESH_CONTEXT_MAX = 150_000

HANDOFF_PROMPT = (
    "Write a handoff now: append to ~/Code/coordinator/notes.md under '## Handoff {stamp}' the standing decisions, "
    "open promises to Shyam, what's queued and why, and anything you're waiting on. Reply DONE when written."
)
FIRST_PROMPT = (
    "Read CLAUDE.md, notes.md (latest Handoff first) and `empq status`, then give Shyam a short status grouped by project."
)


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def sh(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60)


def handoff_count():
    with open(NOTES) as f:
        return len(re.findall(r"^## Handoff ", f.read(), re.M))


def assistant_texts_since(transcript, offset):
    with open(transcript, "rb") as f:
        f.seek(offset)
        lines = f.read().decode(errors="replace").splitlines()
    for line in lines:
        entry = json.loads(line)
        if entry.get("type") == "assistant":
            blocks = entry["message"]["content"]
            yield "".join(b.get("text", "") for b in blocks if b.get("type") == "text")


def wait_for_done(transcript, offset):
    deadline = time.time() + DONE_TIMEOUT
    while time.time() < deadline:
        if any(re.search(r"\bDONE\W*$", text.strip()) for text in assistant_texts_since(transcript, offset)):
            return True
        time.sleep(POLL)
    return False


def replied_since(transcript, offset):
    try:
        return any(True for _ in assistant_texts_since(transcript, offset))
    except (json.JSONDecodeError, KeyError, OSError):
        return False


def main():
    p = argparse.ArgumentParser(prog="coordinator-refresh")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true", help="run even when the Coordinator is mid-turn")
    args = p.parse_args()

    health = json.loads(sh(["emp-health"]).stdout)["coordinator"]
    terminal, status, transcript = health["terminal"], health["status"], health["transcript"]
    if terminal is None:
        die("Coordinator terminal not found in herdr-app ls")
    if status == "working" and not args.force:
        die(f"Coordinator ({terminal}) is mid-turn. Wait for it to finish or pass --force.", 2)

    stamp = time.strftime("%Y-%m-%d %H:%M")
    handoff = HANDOFF_PROMPT.format(stamp=stamp)
    steps = [
        f"hc send {terminal} {handoff!r}",
        f"wait up to {DONE_TIMEOUT}s for an assistant reply ending in DONE in {transcript}, and a new '## Handoff' heading in notes.md",
        f"hc keys {terminal} / c l e a r, then hc keys {terminal} enter",
        f"hc send {terminal} {FIRST_PROMPT!r}",
        f"confirm the Coordinator replied and its context is under {FRESH_CONTEXT_MAX // 1000}k, in a new transcript or the same one",
    ]
    if args.dry_run:
        print(f"Coordinator terminal {terminal}, status {status}, context {health['context_tokens']} tokens")
        print("\n".join(f"{n}. {s}" for n, s in enumerate(steps, 1)))
        return

    server = sh(["hc", "server", "status"])
    if server.returncode != 0 or '"core"' not in server.stdout:
        die("herdr core is not running; refusing to run hc (it would start one with this environment)")

    offset, handoffs = os.path.getsize(transcript), handoff_count()
    sh(["hc", "send", terminal, handoff])
    if not wait_for_done(transcript, offset):
        die(f"No DONE from the Coordinator within {DONE_TIMEOUT}s. Nothing was cleared.")
    if handoff_count() <= handoffs:
        die("Coordinator said DONE but notes.md has no new '## Handoff' heading. Nothing was cleared.")

    sh(["hc", "keys", terminal, "/", "c", "l", "e", "a", "r"])
    time.sleep(1)
    sh(["hc", "keys", terminal, "enter"])
    time.sleep(3)

    tokens_before = health["context_tokens"]
    sent = os.path.getsize(transcript)
    sh(["hc", "send", terminal, FIRST_PROMPT])
    deadline = time.time() + 180
    while time.time() < deadline:
        now = json.loads(sh(["emp-health"]).stdout)["coordinator"]
        tokens = now["context_tokens"]
        fresh = now["transcript"] != transcript or (tokens_before is not None and tokens is not None and tokens < tokens_before / 2 and replied_since(transcript, sent))
        if tokens is not None and tokens < FRESH_CONTEXT_MAX and fresh:
            print(f"Coordinator restarted: transcript {now['transcript']}, context {tokens} tokens")
            return
        time.sleep(POLL)
    die(f"First message sent, but no reply with context under {FRESH_CONTEXT_MAX // 1000}k within 180s. /clear may not have taken effect.")


main()
