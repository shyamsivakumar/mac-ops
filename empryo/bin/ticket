#!/usr/bin/env python3
import argparse, fcntl, hashlib, json, os, re, shlex, subprocess, sys, time
from datetime import datetime, timezone

T3MCP = os.environ.get("TICKET_T3MCP", "t3mcp")
EMPQ = os.environ.get("TICKET_EMPQ", "empq")
QUEUE_DIR = os.environ.get("EMPQ_DIR", os.path.expanduser("~/Code/coordinator/queue"))
CACHE_DIR = os.environ.get("TICKET_CACHE", os.path.expanduser("~/.cache/tickets"))
CACHE_TTL = 60
GH_TIMEOUT = 40
CALL_TIMEOUT = 30
EMPQ_TIMEOUT = 120
LIVE_STATUSES = ["preparing", "queued", "starting", "running", "waiting"]
STAGES = ("stage:backlog", "stage:todo")
FAMILIES = ("stage", "priority", "type", "builder", "reviewer")
FAMILY_COLORS = {"stage": "1d76db", "priority": "d93f0b", "type": "0e8a16", "builder": "5319e7", "reviewer": "fbca04"}
EMPQ_PRIORITY = {1: 3, 2: 2, 3: 1, 4: 0}
NO_PRIORITY = 0
LEDGER_LINE = re.compile(r"<!-- empryo-ticket (\{.*\}) -->")
TITLE_KEY = re.compile(r"^([A-Za-z][A-Za-z0-9]*)-(\d+)\b")
BLOCKER_URL = re.compile(r"^https?://[^/]+/([^/\s#]+/[^/\s#]+)/issues/\d+")
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
TIME_FORMAT = "%Y-%m-%dT%H:%M:%S.%fZ"


class Refuse(Exception):
    pass


class GhError(Exception):
    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).strftime(TIME_FORMAT)[:-4] + "Z"


def parse_time(text):
    return datetime.strptime(text, TIME_FORMAT)


def config_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.join(here, "..", "config", "tickets.json"), os.path.expanduser("~/.empryo/tickets.json")):
        if os.path.exists(candidate):
            return candidate
    die("tickets.json not found next to the script or in ~/.empryo")


def load_config():
    with open(config_path()) as f:
        return json.load(f)


def label_names(cfg):
    names = []
    for stage in cfg["labels"]["stage"]:
        names.append(("stage", f"stage:{stage}"))
    for p in cfg["labels"]["priority"]:
        names.append(("priority", f"priority:{p}"))
    for t in cfg["labels"]["type"]:
        names.append(("type", f"type:{t}"))
    for alias in cfg["models"]:
        names.append(("builder", f"builder:{alias}"))
    for alias, model in cfg["models"].items():
        if not model.get("noGate"):
            names.append(("reviewer", f"reviewer:{alias}"))
    return names


def run(cmd, timeout, stdin=None):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)


def classify(stderr):
    text = stderr.lower()
    if "rate limit" in text or "secondary rate" in text or "abuse" in text or ("403" in text and "limit" in text):
        return "rate_limit"
    if "401" in text or "bad credentials" in text or "gh auth login" in text or "not logged in" in text or "authentication" in text or "requires authentication" in text:
        return "auth"
    if "error connecting" in text or "no such host" in text or "dial tcp" in text or "network" in text or "timeout" in text or "tls" in text or "connection" in text:
        return "offline"
    return "error"


def gh(args, stdin=None):
    try:
        result = run(["gh"] + args, GH_TIMEOUT, stdin)
    except subprocess.TimeoutExpired:
        raise GhError("offline", f"gh {' '.join(args[:2])} timed out after {GH_TIMEOUT}s")
    if result.returncode != 0:
        raise GhError(classify(result.stderr), result.stderr.strip() or f"gh exited {result.returncode}")
    return result.stdout


def gh_json(args):
    return json.loads(gh(args))


def t3_call(tool, args):
    try:
        result = run([T3MCP, "call", tool, "-"], CALL_TIMEOUT, json.dumps(args))
    except subprocess.TimeoutExpired:
        raise Refuse(f"t3 call {tool} timed out after {CALL_TIMEOUT}s")
    if result.returncode != 0:
        raise Refuse(f"t3 call {tool} failed: {result.stderr.strip()}")
    return json.loads(result.stdout)


def parse_ref(ref):
    match = re.fullmatch(r"([^/\s#]+/[^/\s#]+)#(\d+)", ref)
    if not match:
        die(f"bad ticket reference {ref!r}, expected owner/repo#number", 2)
    return match.group(1), int(match.group(2))


def repo_config(cfg, repo):
    if repo not in cfg["repos"]:
        raise Refuse(f"repo {repo} is not configured in tickets.json")
    return cfg["repos"][repo]


def ensure_labels(a):
    cfg = load_config()
    wanted = label_names(cfg)
    for repo in cfg["repos"]:
        existing = {l["name"].lower(): l for l in gh_json(["label", "list", "-R", repo, "--limit", "1000", "--json", "name,color"])}
        create, recolor, ok = [], [], 0
        for family, name in wanted:
            color = FAMILY_COLORS[family]
            have = existing.get(name.lower())
            if have is None:
                create.append((name, color))
            elif have["color"].lower() != color:
                recolor.append((name, color))
            else:
                ok += 1
        line = f"{repo}: {ok} ok, {len(create)} to create, {len(recolor)} to recolor"
        if create and len(create) < len(wanted):
            line += " [create: " + ", ".join(n for n, _ in create) + "]"
        if recolor:
            line += " [recolor: " + ", ".join(n for n, _ in recolor) + "]"
        print(line)
        if not a.apply:
            continue
        for name, color in create:
            gh(["label", "create", name, "-R", repo, "--color", color])
        for name, color in recolor:
            gh(["label", "edit", name, "-R", repo, "--color", color])
    if not a.apply:
        print(f"plan only ({len(wanted)} labels per repo); rerun with --apply to create and recolor")


def split_labels(cfg, names):
    groups = {f: [] for f in FAMILIES}
    other = []
    for name in names:
        family, _, value = name.partition(":")
        if family in groups and value:
            groups[family].append(value)
        else:
            other.append(name)
    return groups, other


def label_problems(cfg, groups):
    problems = []
    valid = {
        "stage": set(cfg["labels"]["stage"]),
        "priority": set(cfg["labels"]["priority"]),
        "type": set(cfg["labels"]["type"]),
        "builder": set(cfg["models"]),
        "reviewer": {a for a, m in cfg["models"].items() if not m.get("noGate")},
    }
    for family, values in groups.items():
        if len(values) > 1:
            problems.append(f"duplicate {family} labels: {', '.join(values)}")
        for value in values:
            if value not in valid[family]:
                problems.append(f"unknown {family} label: {value}")
    return problems


def key_problems(rcfg, title):
    match = TITLE_KEY.match(title)
    if rcfg["key"] is None:
        return (match.group(0) if match else None), []
    if not match:
        return None, ["missing key in title"]
    key = match.group(0)
    if match.group(1) != rcfg["key"]:
        return key, [f"key prefix {match.group(1)} does not match repo key {rcfg['key']}"]
    return key, []


def one(values):
    return values[0] if len(values) == 1 else None


def normalize_issue(cfg, repo, raw):
    rcfg = cfg["repos"][repo]
    groups, _ = split_labels(cfg, [l["name"] for l in raw["labels"]])
    key, problems = key_problems(rcfg, raw["title"])
    problems = label_problems(cfg, groups) + problems
    priority = one(groups["priority"])
    return {
        "repo": repo,
        "number": raw["number"],
        "url": raw["url"],
        "key": key,
        "title": raw["title"],
        "stage": one(groups["stage"]),
        "priority": int(priority) if priority and priority.isdigit() else None,
        "type": one(groups["type"]),
        "builder": one(groups["builder"]),
        "reviewer": one(groups["reviewer"]),
        "problems": problems,
        "updatedAt": raw["updatedAt"],
    }


def search_owner(owner, stage):
    limit = 100
    while True:
        rows = gh_json(["search", "issues", "--owner", owner, "--state", "open", "--label", stage, "--limit", str(limit),
                        "--json", "repository,number,title,labels,updatedAt,url"])
        if len(rows) < limit or limit >= 1000:
            return rows
        limit = min(limit * 2, 1000)


def fetch_list(cfg):
    owners = sorted({repo.split("/")[0] for repo in cfg["repos"]})
    seen = {}
    for owner in owners:
        for stage in STAGES:
            for row in search_owner(owner, stage):
                repo = row["repository"]["nameWithOwner"]
                if repo in cfg["repos"]:
                    seen[(repo, row["number"])] = normalize_issue(cfg, repo, row)
    issues = sorted(seen.values(), key=lambda i: (i["priority"] is None, i["priority"] or 0, i["updatedAt"]))
    return issues


def read_cache():
    try:
        with open(os.path.join(CACHE_DIR, "list.json")) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def write_cache(data):
    tmp = os.path.join(CACHE_DIR, "list.json.tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, os.path.join(CACHE_DIR, "list.json"))


def cache_age(cache):
    return time.time() - parse_time(cache["fetchedAt"]).replace(tzinfo=timezone.utc).timestamp()


def cmd_list(a):
    cfg = load_config()
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(os.path.join(CACHE_DIR, "list.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cache = read_cache()
        if cache and not a.fresh and cache_age(cache) < CACHE_TTL:
            out = {**cache, "stale": False, "cached": True}
        else:
            try:
                data = {"fetchedAt": now(), "issues": fetch_list(cfg)}
            except GhError as e:
                if cache is None:
                    die(f"list failed ({e.kind}) and no cache exists: {e}")
                out = {**cache, "stale": True, "cached": True, "error": {"kind": e.kind, "message": str(e)}}
            else:
                write_cache(data)
                out = {**data, "stale": False, "cached": False}
    if a.json:
        print(json.dumps(out, indent=1))
        return
    if out["stale"]:
        print(f"STALE ({out['error']['kind']}): {out['error']['message']}")
    for i in out["issues"]:
        flags = f" !{'; '.join(i['problems'])}" if i["problems"] else ""
        print(f"{i['repo']}#{i['number']} {i['stage']} p{i['priority']} {i['type']} {i['builder'] or '-'}/{i['reviewer'] or '-'} {i['title']}{flags}")
    print(f"{len(out['issues'])} issues, fetched {out['fetchedAt']}")


def fetch_issue(repo, n):
    return gh_json(["issue", "view", str(n), "-R", repo, "--json", "id,number,title,body,state,labels,comments,url,blockedBy"])


def template_markers(cfg, lines):
    names = {s.lower(): s for s in cfg["template"]}
    markers = []
    for i, line in enumerate(lines):
        m = HEADING.match(line)
        if m:
            text = m.group(2).strip().strip("*").strip().rstrip(":").strip().lower()
            if text in names:
                markers.append((i, names[text], len(m.group(1)), ""))
            continue
        for lower, section in names.items():
            m = re.match(rf"\s*(?:\*\*)?\s*{re.escape(lower)}\s*(?:\*\*)?\s*:\s*(?:\*\*)?(.*)$", line, re.I)
            if m:
                markers.append((i, section, 0, m.group(1)))
                break
    return markers


def template_status(cfg, body):
    lines = body.splitlines()
    markers = template_markers(cfg, lines)
    status = {}
    for section in cfg["template"]:
        found = next((m for m in markers if m[1] == section), None)
        if found is None:
            status[section] = "missing"
            continue
        start, _, level, rest = found
        stops = [m[0] for m in markers if m[0] > start]
        if level:
            stops += [j for j in range(start + 1, len(lines)) if (h := HEADING.match(lines[j])) and len(h.group(1)) <= level]
        end = min(stops, default=len(lines))
        content = re.sub(r"<!--.*?-->", "", "\n".join([rest] + lines[start + 1:end]), flags=re.S).strip()
        status[section] = "ok" if content else "empty"
    return status


def blocker_repo(node):
    # gh issue view --json blockedBy returns nodes without "repository", so the
    # repo comes from the node url (owner/repo before /issues/).
    repository = node.get("repository") or {}
    name = repository.get("nameWithOwner")
    if name:
        return name
    match = BLOCKER_URL.match(node.get("url") or "")
    if not match:
        raise Refuse(f"cannot tell which repo blocker #{node.get('number')} lives in")
    return match.group(1)


def blockers_of(issue):
    blocked = issue["blockedBy"]
    if blocked["totalCount"] > len(blocked["nodes"]):
        raise Refuse(f"blocker list truncated ({len(blocked['nodes'])} of {blocked['totalCount']})")
    return [{"repo": blocker_repo(n), "number": n["number"], "title": n["title"], "url": n["url"], "state": n["state"]} for n in blocked["nodes"]]


def resolve_models(cfg, ticket):
    if not ticket["type"]:
        raise Refuse("missing type label")
    builder = ticket["builder"] or cfg["types"].get(ticket["type"])
    reviewer = ticket["reviewer"] or cfg["types"]["review"]
    for role, alias in (("builder", builder), ("reviewer", reviewer)):
        if alias is None:
            raise Refuse(f"no {role} alias for type {ticket['type']}")
        if alias not in cfg["models"]:
            raise Refuse(f"unknown {role} alias {alias}")
    if cfg["models"][reviewer].get("noGate"):
        raise Refuse(f"reviewer {reviewer} cannot gate (noGate)")
    if cfg["models"][builder]["vendor"] == cfg["models"][reviewer]["vendor"]:
        raise Refuse(f"builder {builder} and reviewer {reviewer} are both vendor {cfg['models'][builder]['vendor']}")
    return builder, reviewer


def parse_ticket(cfg, repo, issue):
    rcfg = repo_config(cfg, repo)
    groups, _ = split_labels(cfg, [l["name"] for l in issue["labels"]])
    key, key_issues = key_problems(rcfg, issue["title"])
    return {
        "repo": repo,
        "number": issue["number"],
        "url": issue["url"],
        "key": key,
        "keyProblems": key_issues,
        "title": issue["title"],
        "state": issue["state"],
        "body": issue["body"],
        "groups": groups,
        "problems": label_problems(cfg, groups) + key_issues,
        "stage": one(groups["stage"]),
        "type": one(groups["type"]),
        "priority": one(groups["priority"]),
        "builder": one(groups["builder"]),
        "reviewer": one(groups["reviewer"]),
    }


def ledger_of(issue, login):
    entries = []
    for comment in issue["comments"]:
        if comment["author"]["login"] != login:
            continue
        for match in LEDGER_LINE.finditer(comment["body"]):
            try:
                entry = json.loads(match.group(1))
            except json.JSONDecodeError:
                raise Refuse(f"malformed ledger line in comment {comment['id']}")
            entries.append({**entry, "commentId": comment["id"]})
    return entries


def validate_start(cfg, repo, issue):
    rcfg = repo_config(cfg, repo)
    t = parse_ticket(cfg, repo, issue)
    if t["state"] != "OPEN":
        raise Refuse(f"issue is {t['state'].lower()}")
    if rcfg["key"] is None:
        raise Refuse(f"repo {repo} has no key configured")
    if t["keyProblems"]:
        raise Refuse(t["keyProblems"][0])
    groups = t["groups"]
    if not groups["type"]:
        raise Refuse("missing type label")
    for family in ("stage", "type"):
        if len(groups[family]) != 1:
            raise Refuse(f"needs exactly one {family} label, found {len(groups[family])}")
    for family in ("priority", "builder", "reviewer"):
        if len(groups[family]) > 1:
            raise Refuse(f"more than one {family} label: {', '.join(groups[family])}")
    if t["type"] not in cfg["labels"]["type"]:
        raise Refuse(f"unknown type label {t['type']}")
    if t["stage"] not in cfg["labels"]["stage"]:
        raise Refuse(f"unknown stage label {t['stage']}")
    if t["priority"] and t["priority"] not in cfg["labels"]["priority"]:
        raise Refuse(f"unknown priority label {t['priority']}")
    for family in ("builder", "reviewer"):
        if t[family] and t[family] not in cfg["models"]:
            raise Refuse(f"unknown {family} alias {t[family]}")
    bad = {s: v for s, v in template_status(cfg, t["body"]).items() if v != "ok"}
    if bad:
        raise Refuse("template sections " + ", ".join(f"{s} ({v})" for s, v in bad.items()))
    open_blockers = [b for b in blockers_of(issue) if b["state"] == "OPEN"]
    if open_blockers:
        raise Refuse("blocked by open " + ", ".join(f"{b['repo']}#{b['number']}" for b in open_blockers))
    t["builderAlias"], t["reviewerAlias"] = resolve_models(cfg, t)
    return t


def queue_items(repo, n):
    try:
        with open(os.path.join(QUEUE_DIR, "queue.json")) as f:
            items = json.load(f)["items"]
    except FileNotFoundError:
        return []
    prefix = f"ticket:{repo}#{n}:a"
    return [i for i in items if str(i["args"].get("clientRequestId", "")).startswith(prefix)]



def intents(ledger):
    return [e for e in ledger if e.get("kind") == "intent"]


def assert_not_active(cfg, t, ledger):
    prior = intents(ledger)
    queued = queue_items(t["repo"], t["number"])
    if queued:
        raise Refuse(f"already started: queued as empq #{queued[0]['id']}")
    for attempt in prior:
        thread = thread_for_attempt(cfg, t, [attempt] + [e for e in ledger if e.get("kind") == "receipt"])
        if thread is None:
            continue
        if thread["status"] in LIVE_STATUSES:
            raise Refuse(f"already started: thread {thread['threadId']} is {thread['status']}")


def machine_line(entry):
    return f"<!-- empryo-ticket {json.dumps(entry, separators=(',', ':'))} -->"


def post_comment(repo, n, text):
    gh(["issue", "comment", str(n), "-R", repo, "--body", text])


def default_branch(repo):
    return gh(["repo", "view", repo, "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name"]).strip()


def build_start(cfg, t, attempt):
    rcfg = cfg["repos"][t["repo"]]
    request_id = f"ticket:{t['repo']}#{t['number']}:a{attempt}"
    payload = {
        "projectId": rcfg["projectId"],
        "message": f"Ticket: {t['url']}\nReviewer for the gate: {t['reviewerAlias']}\n\n{t['body']}",
        "clientRequestId": request_id,
        "workspaceStrategy": {"type": "worktree", "baseRef": f"origin/{default_branch(t['repo'])}"},
        "modelSelection": cfg["models"][t["builderAlias"]]["selection"],
    }
    title_rest = t["title"][len(t["key"]):].lstrip(" ·-:·").strip()
    title = f"{t['key']} · {title_rest}"
    priority = EMPQ_PRIORITY[int(t["priority"])] if t["priority"] else NO_PRIORITY
    command = [EMPQ, "start", json.dumps(payload), "--title", title, "--priority", str(priority)]
    return request_id, command, payload


def with_ticket_lock(repo, n):
    os.makedirs(CACHE_DIR, exist_ok=True)
    f = open(os.path.join(CACHE_DIR, f"start-{repo.replace('/', '_')}-{n}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Refuse("another ticket start for this issue is running")
    return f


def authed_login():
    return gh(["api", "user", "-q", ".login"]).strip()


def cmd_start(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    try:
        repo_config(cfg, repo)
        lock = with_ticket_lock(repo, n)
        issue = fetch_issue(repo, n)
        t = validate_start(cfg, repo, issue)
        ledger = ledger_of(issue, authed_login())
        assert_not_active(cfg, t, ledger)
        attempt = max([e["attempt"] for e in intents(ledger)], default=0) + 1
        request_id, command, payload = build_start(cfg, t, attempt)
        stamp = now()
        body_hash = hashlib.sha256(t["body"].encode()).hexdigest()[:16]
        intent = {"kind": "intent", "attempt": attempt, "requestId": request_id, "bodyHash": body_hash,
                  "builder": t["builderAlias"], "reviewer": t["reviewerAlias"], "at": stamp}
        intent_text = f"Starting {t['key']} attempt {attempt}. Builder: {t['builderAlias']}, reviewer: {t['reviewerAlias']}.\n\n{machine_line(intent)}"
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    if a.dry_run:
        print("checks passed")
        print("intent comment:\n" + intent_text + "\n")
        strategy = payload["workspaceStrategy"]
        print(f"workspace: {strategy['type']} from {strategy['baseRef']}")
        print("command:\n" + shlex.join(command) + "\n")
        print(f"receipt comment (after empq):\n<!-- empryo-ticket {{\"kind\":\"receipt\",\"attempt\":{attempt},\"requestId\":\"{request_id}\",\"empq\":\"<empq output>\"}} -->\n")
        print(f"then remove label stage:{t['stage']}")
        return
    post_comment(repo, n, intent_text)
    try:
        result = run(command, EMPQ_TIMEOUT)
    except subprocess.TimeoutExpired:
        die(f"empq start timed out after {EMPQ_TIMEOUT}s; intent attempt {attempt} is on the issue, check empq list before retrying")
    if result.returncode != 0:
        die(f"empq start failed: {result.stderr.strip()}; intent attempt {attempt} is on the issue, stage label kept")
    output = result.stdout.strip()
    print(output)
    receipt = {"kind": "receipt", "attempt": attempt, "requestId": request_id, "empq": output}
    receipt_text = f"{t['key']} attempt {attempt}: empq says \"{output}\".\n\n{machine_line(receipt)}"
    posted = False
    for tries in range(3):
        try:
            post_comment(repo, n, receipt_text)
            posted = True
            break
        except GhError as e:
            print(f"receipt comment failed ({e.kind}): {e}", file=sys.stderr)
            time.sleep(2)
    gh(["issue", "edit", str(n), "-R", repo, "--remove-label", f"stage:{t['stage']}"])
    if not posted:
        die(f"started, but the receipt comment could not be posted after 3 tries; empq output was: {output}")


def thread_for_attempt(cfg, t, ledger):
    prior = sorted(intents(ledger), key=lambda e: e["attempt"])
    if not prior:
        return None
    latest = prior[-1]
    thread_id = next((e["threadId"] for e in ledger
                      if e.get("kind") == "receipt" and e.get("attempt") == latest["attempt"]
                      and e.get("threadId")), None)
    if not thread_id:
        try:
            with open(os.path.join(QUEUE_DIR, "dispatch-receipts.json")) as f:
                receipts = json.load(f)
        except FileNotFoundError:
            receipts = {}
        thread_id = receipts.get(f"ticket:{t['repo']}#{t['number']}:a{latest['attempt']}")
    if not thread_id:
        return None
    result = t3_call("t3_thread_read", {"threadId": thread_id, "limit": 1})
    thread = result["thread"]
    if thread["threadId"] != thread_id:
        raise Refuse("thread identity mismatch")
    return thread


def cmd_abandon(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    try:
        repo_config(cfg, repo)
        issue = fetch_issue(repo, n)
        t = parse_ticket(cfg, repo, issue)
        if t["state"] != "OPEN":
            raise Refuse(f"issue is {t['state'].lower()}")
        ledger = ledger_of(issue, authed_login())
        thread = thread_for_attempt(cfg, t, ledger) if t["key"] and intents(ledger) else None
        queued = queue_items(repo, n)
        entry = {"kind": "abandon", "reason": a.reason, "at": now()}
        gh(["issue", "close", str(n), "-R", repo, "--reason", "not planned",
            "--comment", f"Abandoned: {a.reason}\n\n{machine_line(entry)}"])
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    print(f"closed {repo}#{n} as not planned")
    if thread and thread["status"] in LIVE_STATUSES:
        t3_call("t3_thread_interrupt", {"threadId": thread["threadId"]})
        print(f"interrupted thread {thread['threadId']} (was {thread['status']})")
    for item in queued:
        result = run([EMPQ, "drop", str(item["id"])], CALL_TIMEOUT)
        if result.returncode != 0:
            die(f"empq drop #{item['id']} failed: {result.stderr.strip()}")
        print(result.stdout.strip())
    if not queued and not (thread and thread["status"] in LIVE_STATUSES):
        print("no live thread or queued item to stop")


def cmd_show(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    try:
        repo_config(cfg, repo)
        issue = fetch_issue(repo, n)
        t = parse_ticket(cfg, repo, issue)
        ledger = ledger_of(issue, authed_login())
        thread = thread_for_attempt(cfg, t, ledger) if t["key"] and intents(ledger) else None
        queued = queue_items(repo, n)
        out = {
            "repo": repo,
            "number": n,
            "id": issue["id"],
            "url": t["url"],
            "key": t["key"],
            "title": t["title"],
            "state": t["state"],
            "body": t["body"],
            "bodyHash": hashlib.sha256(t["body"].encode()).hexdigest()[:16],
            "stage": t["stage"],
            "priority": int(t["priority"]) if t["priority"] else None,
            "type": t["type"],
            "builder": t["builder"],
            "reviewer": t["reviewer"],
            "problems": t["problems"],
            "template": template_status(cfg, t["body"]),
            "blockers": blockers_of(issue),
            "ledger": ledger,
            "queued": [{"id": i["id"], "title": i["title"]} for i in queued],
            "latestAttempt": {
                "attempt": max((e["attempt"] for e in intents(ledger)), default=None),
                "threadId": thread["threadId"] if thread else None,
                "status": thread["status"] if thread else ("queued" if queued else
                          ("not running (no thread recorded)" if intents(ledger) else None)),
            },
        }
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    print(json.dumps(out, indent=1))


def set_target(cfg, family, value):
    if value == "none":
        return None
    valid = {
        "stage": cfg["labels"]["stage"],
        "priority": cfg["labels"]["priority"],
        "builder": list(cfg["models"]),
        "reviewer": [a for a, m in cfg["models"].items() if not m.get("noGate")],
    }[family]
    if value not in valid:
        if family == "reviewer" and cfg["models"].get(value, {}).get("noGate"):
            raise Refuse(f"reviewer {value} cannot gate (noGate)")
        raise Refuse(f"unknown {family} {value!r}, expected one of: {', '.join(valid)}, none")
    return value


def cmd_set(a):
    cfg = load_config()
    repo, n = parse_ref(a.ref)
    wanted = {f: getattr(a, f) for f in ("stage", "priority", "builder", "reviewer") if getattr(a, f) is not None}
    if not wanted:
        die("nothing to set: pass --priority, --builder, --reviewer or --stage", 2)
    try:
        repo_config(cfg, repo)
        targets = {f: set_target(cfg, f, v) for f, v in wanted.items()}
        issue = gh_json(["issue", "view", str(n), "-R", repo, "--json", "labels"])
        names = [l["name"] for l in issue["labels"]]
        groups, _ = split_labels(cfg, names)
        pair = {f: targets[f] if f in targets else one(groups[f]) for f in ("builder", "reviewer")}
        type_ = one(groups["type"])
        if type_ and (pair["builder"] is None or pair["reviewer"] is None):
            pair["builder"] = pair["builder"] or cfg["types"].get(type_)
            pair["reviewer"] = pair["reviewer"] or cfg["types"]["review"]
        if pair["builder"] and pair["reviewer"]:
            if cfg["models"][pair["reviewer"]].get("noGate"):
                raise Refuse(f"reviewer {pair['reviewer']} cannot gate (noGate)")
            if cfg["models"][pair["builder"]]["vendor"] == cfg["models"][pair["reviewer"]]["vendor"]:
                raise Refuse(f"builder {pair['builder']} and reviewer {pair['reviewer']} are both vendor {cfg['models'][pair['builder']]['vendor']}")
        add, remove = [], []
        for family, value in targets.items():
            remove += [f"{family}:{v}" for v in groups[family] if v != value]
            if value and value not in groups[family]:
                add.append(f"{family}:{value}")
        if add or remove:
            args = ["issue", "edit", str(n), "-R", repo]
            if add:
                args += ["--add-label", ",".join(add)]
            if remove:
                args += ["--remove-label", ",".join(remove)]
            gh(args)
    except Refuse as e:
        die(f"refused: {e}", 2)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")
    print(json.dumps(sorted((set(names) | set(add)) - set(remove))))


def main():
    p = argparse.ArgumentParser(prog="ticket")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("labels")
    s.add_argument("--apply", action="store_true")
    s.set_defaults(fn=ensure_labels)
    s = sub.add_parser("list")
    s.add_argument("--json", action="store_true")
    s.add_argument("--fresh", action="store_true")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("start")
    s.add_argument("ref")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_start)
    s = sub.add_parser("abandon")
    s.add_argument("ref")
    s.add_argument("--reason", required=True)
    s.set_defaults(fn=cmd_abandon)
    s = sub.add_parser("set")
    s.add_argument("ref")
    s.add_argument("--priority")
    s.add_argument("--builder")
    s.add_argument("--reviewer")
    s.add_argument("--stage")
    s.set_defaults(fn=cmd_set)
    s = sub.add_parser("show")
    s.add_argument("ref")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)
    a = p.parse_args()
    try:
        a.fn(a)
    except GhError as e:
        die(f"gh failed ({e.kind}): {e}")


main()
