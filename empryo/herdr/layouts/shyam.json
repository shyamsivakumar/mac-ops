{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "hidden": true
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 60
          }
        }
      ],
      "size": {
        "px": 184
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "border": {
        "width": 1,
        "color": "border"
      },
      "radius": 8,
      "padding": 0,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "shy-tabs"
          },
          "size": {
            "px": 32
          },
          "window_drag": true
        },
        {
          "id": "work-split",
          "type": "row",
          "children": [
            {
              "id": "coordinator",
              "type": "column",
              "children": [
                {
                  "id": "chat",
                  "type": "block",
                  "content": {
                    "mod": "coordinator"
                  },
                  "background": "chrome",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 6
                }
              ],
              "size": {
                "px": 782
              },
              "min": 380,
              "max": 800,
              "padding": 4
            },
            {
              "id": "work-left",
              "type": "column",
              "children": [
                {
                  "id": "work-body",
                  "type": "row",
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "header": {
                            "content": {
                              "mod": "shy-pane"
                            },
                            "reveal": "always",
                            "height": 22,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 6,
                          "gap": 4,
                          "lone": true
                        }
                      },
                      "min": 480,
                      "floating": [
                        {
                          "id": "claude-resume-float",
                          "content": {
                            "mod": "claude-resume"
                          },
                          "edge": "bottom",
                          "align": "center"
                        }
                      ]
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "files"
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "reviewer"
                              }
                            }
                          ],
                          "active": "files"
                        }
                      ],
                      "size": {
                        "px": 420
                      },
                      "min": 280,
                      "max": 900,
                      "hidden": true
                    },
                    {
                      "id": "notifier",
                      "type": "block",
                      "content": {
                        "mod": "herdr-app-notifier"
                      },
                      "size": {
                        "px": 1
                      },
                      "hidden": true
                    }
                  ],
                  "padding": 4,
                  "gap": 4
                },
                {
                  "id": "cockpit",
                  "type": "column",
                  "children": [
                    {
                      "id": "board",
                      "type": "block",
                      "content": {
                        "mod": "cockpit"
                      },
                      "background": "chrome",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 6
                    }
                  ],
                  "size": {
                    "px": 459
                  },
                  "min": 160,
                  "max": 600,
                  "padding": 4
                }
              ],
              "padding": 0
            },
            {
              "id": "graph-col",
              "type": "column",
              "children": [
                {
                  "id": "graph",
                  "type": "block",
                  "content": {
                    "mod": "git-graph"
                  },
                  "background": "chrome",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 6
                }
              ],
              "size": {
                "px": 520
              },
              "min": 380,
              "max": 1100,
              "hidden": true,
              "padding": 4
            },
            {
              "id": "outputs-col",
              "type": "column",
              "children": [
                {
                  "id": "outputs",
                  "type": "block",
                  "content": {
                    "mod": "outputs"
                  },
                  "background": "chrome",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 6
                }
              ],
              "size": {
                "px": 520
              },
              "min": 380,
              "max": 1100,
              "hidden": true,
              "padding": 4
            }
          ],
          "padding": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "ops"
          },
          "size": {
            "px": 22
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "padding": 6,
  "theme": "catppuccin-mocha",
  "font": "JetBrainsMonoNL Nerd Font Mono",
  "font_size": 13,
  "ui_font": ".AppleSystemUIFont",
  "terminal_padding": [
    8,
    8
  ],
  "gap": 6,
  "titlebar": "none",
  "traffic_lights": [
    20,
    24
  ],
  "terminal_menu": "shy-menu"
}
