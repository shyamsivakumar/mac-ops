+def lane_ledger():
+    """The lane's ledger, or {} when it cannot be read.
+
+    The ledger is the lane's own record of the failed gate reviews of a
+    pull request. A ledger that cannot be read is no reason to stop the
+    gate: the pull request is gated as before, and the lane still holds
+    the round cap on its own side.
+    """
+    try:
+        with open(LANE_LEDGER) as handle:
+            ledger = json.load(handle)
+    except (OSError, ValueError):
+        return {}
+    return ledger if isinstance(ledger, dict) else {}
+
+
+def gate_rounds_used(repo, number, ledger):
+    """True when the lane's ledger says a pull request used its rounds.
+
+    The count is the lane's: the failed reviews it recorded for the pull
+    request, and the fix rounds it already sent, whichever is larger. A
+    pull request at or over the cap is re-cut into smaller pull requests
+    or taken over by Shyam, so gatekeep queues no gate for it.
+    """
+    state = ledger.get(f"rounds:{repo}#{number}")
+    if not isinstance(state, dict):
+        state = {}
+    try:
+        count = int(state.get("count", 0))
+    except (TypeError, ValueError):
+        count = 0
+    prefix = f"fix:{repo}#{number}:"
+    count = max(count, sum(1 for key in ledger if key.startswith(prefix)))
+    return count >= GATE_ROUND_CAP
+
+
