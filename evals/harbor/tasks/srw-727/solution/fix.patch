+async function recordBot2Day(ledgerPath, day, fixtureMode, env, fetchFn) {
+  if (fixtureMode) return;
+  const host = env.RAILWAY_SERVICE_BOT2_INTAKE_URL;
+  const secret = env.BOT2_WEBHOOK_SECRET;
+  if (!host || !secret) return;
+  let compiled;
+  try {
+    const response = await fetchFn("https://" + host.replace(/\/+$/, "") + "/today?date=" + encodeURIComponent(day), {
+      headers: {"x-bot2-secret": secret},
+      redirect: "error",
+      signal: AbortSignal.timeout(30000)
+    });
+    if (!response.ok) throw new Error("HTTP " + response.status);
+    compiled = await response.json();
+    if (!compiled || compiled.date !== day) throw new Error("response date mismatch");
+  } catch (error) {
+    process.stderr.write("daily shadow: Bot 2 day fetch unavailable\n");
+    return;
+  }
+  const fingerprint = sha256(language.stableStringify(compiled));
+  const prior = ledger.queryLedger(ledgerPath, {type: "bot2_day_compiled"}).filter((record) => record.event.day === day);
+  if (prior.some((record) => record.event.fingerprint === fingerprint)) return;
+  ledger.appendEvent(ledgerPath, {
+    type: "bot2_day_compiled",
+    dataset: fixtureMode ? "forward-shadow-iex-format-fixture" : "forward-shadow-iex",
+    partitionRole: "forward-shadow",
+    day,
+    fixtureMode,
+    fingerprint,
+    supersedesSeq: prior.length === 0 ? null : prior.at(-1).seq,
+    compiled,
+    recordedAt: new Date().toISOString()
+  });
+}
