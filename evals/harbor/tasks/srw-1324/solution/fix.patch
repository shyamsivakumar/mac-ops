+++ b/scripts/srw1322_exit_watchdog.cjs
@@ -0,0 +1,243 @@
+'use strict';
+
+/**
+ * SRW-1322: the exit watchdog — page the owner once per position when an
+ * exit that was due never reached the broker.
+ *
+ * Read-only: the broker adapter issues GET and nothing here can place an
+ * order. The sources are injected, so the proof (test_srw1322_exit_watchdog.js)
+ * replays a day offline.
+ *
+ * The rules it holds:
+ *   - one page per trade: the key is the trade id, which no order history can
+ *     change, so two trades on one contract are two pages; a trade's page also
+ *     covers the 0DTE backstop for its contract, and a restart keeps both;
+ *   - the broker's window is 60 s from the decision: a sell inside that
+ *     window answers one decision, a sell outside it does not, a sell is
+ *     matched to its own trade by order id when the ledger names one, and a
+ *     sell that is still working at the deadline answers the 0DTE backstop;
+ *   - everything is judged at the instant the broker was read, never later;
+ *   - a page is spent only when the owner was reached; an undelivered page
+ *     is retried on the next check;
+ *   - only what could be read is evaluated.
+ */
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const GRACE_MS = 60_000;
+const ZERO_DTE_MINUTE = 15 * 60 + 50; // 15:50 ET
+const ALPACA_PAPER_BASE = 'https://paper-api.alpaca.markets';
+
+/** The ET clock of an instant: its day, its minute of the day and the second inside that minute. */
+function etClock(ms) {
+  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', hour12: false, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(new Date(ms));
+  const read = type => parts.find(part => part.type === type)?.value;
+  return { day: `${read('year')}-${read('month')}-${read('day')}`, minutes: Number(read('hour')) % 24 * 60 + Number(read('minute')), seconds: Number(read('second')) };
+}
+
+/** OCC-21 symbol: root + YYMMDD + C/P + strike, so the expiry is inside the id. */
+function occExpiry(symbol) {
+  const match = /^([A-Z]{1,6})(\d{2})(\d{2})(\d{2})[CP]/.exec(String(symbol || '').replace(/\s+/g, '').toUpperCase());
+  return match ? `${2000 + Number(match[2])}-${match[3]}-${match[4]}` : null;
+}
+
+/** Bot 1's exit decisions: a queued CLOSE card. The OPEN card names the contract. */
+function closeDecisions(cards, symbols) {
+  for (const card of cards) {
+    const symbol = card.doc?.option?.symbol ?? card.doc?.option?.occ21;
+    if (card.type === 'OPEN' && card.tradeId && symbol) symbols.set(card.tradeId, String(symbol));
+  }
+  return cards
+    .filter(card => card.type === 'CLOSE' && card.tradeId && Number.isFinite(card.atMs) && symbols.has(card.tradeId))
+    .map(card => ({ bot: 'bot1', tradeId: card.tradeId, symbol: symbols.get(card.tradeId), decidedAtMs: card.atMs, reason: String(card.doc?.exit_ref ?? 'close_card') }));
+}
+
+/** Bot 1's own exit decisions: the trigger its trader logged on a trade that still holds quantity, whether or not a CLOSE card was published. */
+function traderDecisions(trades) {
+  return Object.values(trades || {}).flatMap(trade => {
+    const symbol = trade?.intent?.optionSymbol;
+    const trigger = (trade?.events || []).filter(event => event?.op === 'exit_trigger').pop();
+    if (!symbol || !trigger || !(trade.qtyLeft > 0) || !Number.isFinite(Date.parse(trigger.at))) return [];
+    return [{ bot: 'bot1', tradeId: String(trade.tradeId), symbol, decidedAtMs: Date.parse(trigger.at), reason: String(trigger.ref ?? 'exit_trigger') }];
+  });
+}
+
+/**
+ * Bot 2's exit decisions: a trade the machine decided to exit (it has an
+ * exit reason) while its ledger still holds the position. The ledger has no
+ * timestamp for the decision, so the window starts when the watchdog first
+ * sees it: the page can never land before the broker had its 60 s.
+ */
+function botDecisions(trades) {
+  return (Array.isArray(trades) ? trades : [])
+    .filter(trade => trade?.exit_reason && (trade.qty_left == null || trade.qty_left > 0) && (trade.contract || trade.ticker))
+    .map(trade => ({
+      bot: 'bot2', tradeId: String(trade.trade_id || trade.contract), symbol: String(trade.contract || trade.ticker),
+      decidedAtMs: null, exitOrderId: trade.exit_order_id || trade.exit_client_order_id || null,
+      reason: String(trade.exit_reason),
+    }));
+}
+
+/**
+ * The sell order that answers this decision, if one reached the broker in time.
+ * A decision that names its exit order is answered by that order and no other.
+ * One that does not is answered by a sell inside its window that no other
+ * decision claims and that no earlier decision already used, so two exits on
+ * one contract need two sells. A sell that was already working at the deadline
+ * answers the 0DTE backstop. No order answers a decision when it was submitted
+ * after the window closed.
+ */
+function answeringSell(orders, decision, from, until, claimed, used) {
+  return (orders || []).find(order => {
+    if (order?.symbol !== decision.symbol || String(order.side).toLowerCase() !== 'sell') return false;
+    const ids = [order.id, order.clientOrderId].filter(Boolean);
+    const inTime = order.submittedAtMs <= until;
+    if (decision.exitOrderId) return ids.includes(decision.exitOrderId) && inTime;
+    if (decision.backstop && order.open === true) return inTime;
+    if (ids.some(id => claimed.has(id)) || (!decision.backstop && used.has(order))) return false;
+    return order.submittedAtMs >= from && inTime;
+  });
+}
+
+/** One trade is one decision: a CLOSE card and a trader trigger for the same trade merge, counted from the earlier one. */
+function oncePerTrade(candidates) {
+  const byKey = new Map();
+  for (const decision of candidates) {
+    const key = decision.key ?? `trade:${decision.tradeId}`;
+    const known = byKey.get(key);
+    const earlier = known && !(Number.isFinite(decision.decidedAtMs) && decision.decidedAtMs < (known.decidedAtMs ?? Infinity)) ? known : decision;
+    byKey.set(key, { ...earlier, key, exitOrderId: known?.exitOrderId ?? decision.exitOrderId });
+  }
+  return [...byKey.values()];
+}
+
+/** How long to sleep before the next check: early by the last check's reads, so they end on the deadline. */
+function wakeDelayMs({ dueMs, nowMs, intervalMs, lastCheckMs }) {
+  return Math.max(250, Math.min(intervalMs, Number.isFinite(dueMs) ? dueMs - nowMs - lastCheckMs : Infinity));
+}
+
+/**
+ * The watchdog. It keeps the paged positions, the pages that have not landed
+ * yet and the first time it saw each decision, so one position is paged once
+ * — across restarts too, when a state file is given.
+ */
+function createExitWatchdog({ readBroker, readDecisions, page, now = Date.now, graceMs = GRACE_MS, stateFile = null, log = () => {} }) {
+  const paged = new Set();
+  const seen = new Map();
+  const deadlines = new Map();
+  if (stateFile) {
+    try {
+      for (const key of JSON.parse(fs.readFileSync(stateFile, 'utf8'))) paged.add(String(key));
+    } catch (error) {
+      log('NOTE', `exit watchdog state unreadable, starting empty: ${error.message}`);
+    }
+  }
+  function persist(pages) {
+    if (!stateFile || !pages.length) return;
+    // A state file that cannot be written must not break the check: the page
+    // went out, the restart protection is what is lost.
+    try {
+      fs.mkdirSync(path.dirname(stateFile), { recursive: true });
+      fs.writeFileSync(stateFile, JSON.stringify([...paged]));
+    } catch (error) { log('NOTE', `exit watchdog state not saved: ${error.message}`); }
+  }
+  /** The earliest moment a decision becomes due, so the caller can wake on it. */
+  function nextDeadlineAtMs() {
+    let earliest = null;
+    for (const deadline of deadlines.values()) if (earliest === null || deadline < earliest) earliest = deadline;
+    return earliest;
+  }
+  async function check() {
+    const timed = async read => ({ value: await read(), at: now() });
+    const [brokerRead, decisionRead] = await Promise.all([timed(readBroker), timed(readDecisions)]);
+    const broker = brokerRead.value;
+    const at = broker.readAtMs ?? brokerRead.at; // the orders snapshot ends here: a sell that came later is not in it, so nothing is judged at a later instant
+    const clock = etClock(at);
+    const candidates = [...decisionRead.value];
+    const zeroKey = symbol => `zero_dte:${symbol}@${clock.day}`;
+    // The 0DTE backstop: a position that expires today and is still open
+    // after 15:50 ET has an exit that is due, queued card or not.
+    if (clock.minutes >= ZERO_DTE_MINUTE) {
+      const dueAt = at - (clock.minutes - ZERO_DTE_MINUTE) * 60_000 - clock.seconds * 1000 - at % 1000; // 15:50:00 ET today
+      for (const position of broker.positions) {
+        if (occExpiry(position.symbol) !== clock.day) continue;
+        candidates.push({ bot: null, tradeId: position.symbol, symbol: position.symbol, decidedAtMs: dueAt, backstop: true, reason: 'zero_dte_1550', key: zeroKey(position.symbol) });
+      }
+    }
+    const decisions = oncePerTrade(candidates);
+    const claimed = new Set(decisions.map(decision => decision.exitOrderId).filter(Boolean));
+    // The broker's window is 60 s from the decision. A decision with a
+    // timestamp (a CLOSE card, a trigger, the 0DTE deadline) counts from it;
+    // one without (Bot 2's ledger) counts from the first time it was seen, so
+    // the page can never land before the broker had its window.
+    const windows = decisions
+      .map(decision => ({ decision, key: decision.key }))
+      .filter(({ decision, key }) => !paged.has(key) && broker.positions.some(position => position.symbol === decision.symbol))
+      .map(({ decision, key }) => {
+        const firstSeen = seen.get(key) ?? decisionRead.at;
+        seen.set(key, firstSeen);
+        const from = Number.isFinite(decision.decidedAtMs) ? decision.decidedAtMs : firstSeen;
+        return { decision, key, from, until: from + graceMs };
+      })
+      .sort((a, b) => Number(a.decision.backstop === true) - Number(b.decision.backstop === true) || a.from - b.from);
+    const pages = [];
+    const used = new Set();
+    deadlines.clear();
+    for (const { decision, key, from, until } of windows) {
+      const sell = answeringSell(broker.orders, decision, from, until, claimed, used);
+      if (sell && !decision.backstop) used.add(sell);
+      if (at < until) { deadlines.set(key, until); continue; }
+      if (sell) continue;
+      const delivered = await page({ ...decision, key, decidedAtMs: from }).catch(error => { log('ALERT', `exit watchdog page failed for ${decision.tradeId}: ${error.message}`); return false; });
+      if (delivered === true) {
+        paged.add(key);
+        if (!decision.backstop && occExpiry(decision.symbol) === clock.day) paged.add(zeroKey(decision.symbol));
+        pages.push({ ...decision, key });
+      }
+    }
+    persist(pages);
+    return pages;
+  }
+  return { check, paged, seen, nextDeadlineAtMs };
+}
+
+/** The broker, read only: open positions, the recent orders and the open orders. Every call is a GET. */
+function createAlpacaBrokerSource({ key, secret, base = ALPACA_PAPER_BASE, fetchImpl = fetch, now = Date.now }) {
+  const getJson = async pathname => {
+    const response = await fetchImpl(`${base}${pathname}`, { headers: { 'APCA-API-KEY-ID': key, 'APCA-API-SECRET-KEY': secret }, signal: AbortSignal.timeout(15_000) });
+    if (!response.ok) throw new Error(`alpaca_http_${response.status}`);
+    return response.json();
+  };
+  const timed = async pathname => ({ rows: await getJson(pathname), at: now() });
+  return async () => {
+    const [{ rows: positions }, { rows: recent, at: recentAt }, { rows: open, at: openAt }] = await Promise.all([
+      timed('/v2/positions'), timed('/v2/orders?status=all&limit=200&direction=desc'), timed('/v2/orders?status=open&limit=200&direction=desc'),
+    ]);
+    const toOrder = (row, working) => ({
+      id: row.id, clientOrderId: row.client_order_id, symbol: row.symbol, side: String(row.side || '').toLowerCase(),
+      submittedAtMs: Date.parse(row.submitted_at), filledQty: Number(row.filled_qty), open: working === true,
+    });
+    return {
+      // Sells are judged at the earlier of the two order reads: a slower positions read must not move the snapshot past a sell the orders never saw.
+      readAtMs: Math.min(recentAt, openAt),
+      positions: positions.filter(row => Number(row.qty) > 0).map(row => ({ symbol: row.symbol, qty: Number(row.qty) })),
+      // The open orders are read next to the recent ones: a working sell that
+      // 200 newer orders pushed out of the recent list is still open.
+      // One entry per order id, so a working sell listed twice answers one decision, not two.
+      orders: [...new Map([...recent.map(row => toOrder(row, false)), ...open.map(row => toOrder(row, true))].map(order => [order.id, order])).values()],
+    };
+  };
+}
+
+function renderExitMiss(miss) {
+  return [
+    miss.reason === 'zero_dte_1550'
+      ? 'A 0DTE position was still open after 15:50 ET and no sell order reached the broker in time.'
+      : `${miss.bot === 'bot2' ? 'Bot 2 (TradingView)' : 'Bot 1 (Discord cards)'} decided an exit (${miss.reason}) and no sell order reached the broker in time.`,
+    `Trade: ${miss.tradeId}.`, `Contract: ${miss.symbol}.`, `Decided: ${new Date(miss.decidedAtMs).toISOString()}.`,
+    'Action: check the exit path and the broker orders for this position.',
+  ].join('\n');
+}
+
+module.exports = { closeDecisions, traderDecisions, botDecisions, createExitWatchdog, createAlpacaBrokerSource, renderExitMiss, wakeDelayMs, etClock, occExpiry };
