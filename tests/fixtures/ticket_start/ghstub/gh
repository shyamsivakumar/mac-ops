#!/usr/bin/env python3
"""A stand-in for `gh` that serves one fixture issue and nothing else.

The proof runs the real `ticket start` path without touching GitHub, so this
answers the reads the CLI makes: the issue, the issue timeline, the login and
the default branch. Every other command fails loudly.
"""
import json
import os
import sys

FIXTURE = os.environ["TICKET_STUB_FIXTURE"]
REF = "shyamsivakumar/mac-ops#9001"

ISSUE = {
    "id": "1",
    "number": 9001,
    "title": "MO-9001 · Fixture for the ticket section matcher",
    "state": "OPEN",
    "labels": [{"name": name} for name in
               ("stage:todo", "type:chore", "priority:2", "builder:glm-5.3", "reviewer:astra")],
    "comments": [],
    "url": f"https://github.com/shyamsivakumar/mac-ops/issues/9001",
    "blockedBy": {"totalCount": 0, "nodes": []},
}


def main():
    args = sys.argv[1:]
    if args[:2] == ["issue", "view"]:
        issue = dict(ISSUE)
        with open(os.path.join(FIXTURE, "body.md")) as f:
            issue["body"] = f.read()
        print(json.dumps(issue))
    elif args[:1] == ["api"] and any("timeline" in a for a in args):
        print("[]")
    elif args[:2] == ["api", "user"]:
        print("shyamsivakumar")
    elif args[:2] == ["repo", "view"]:
        print("main")
    else:
        sys.exit(f"the gh stub answers no command: {args}")


if __name__ == "__main__":
    main()
